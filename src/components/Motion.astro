---
/**
 * Shared motion layer for the main pages: Lenis smooth scroll, GSAP scroll
 * reveals and the scroll-lit statement (src/scripts/motion.js), the motion
 * tokens CSS uses, and cross-page view transitions.
 *
 * The inline script hides reveal targets only once we know JS is running;
 * if motion.js never arrives, the 3s fallback shows everything anyway.
 */
---
<script is:inline>
(function(){
  var h = document.documentElement;
  // Resolves once an arriving page transition has finished (at once without one).
  // Heavy start-up work waits on it: run during the transition it drops frames.
  window.afterPageChange = new Promise(function(done){
    if (!('onpagereveal' in window)) return done();
    addEventListener('pagereveal', function(e){ e.viewTransition ? e.viewTransition.finished.finally(done) : done(); }, { once: true });
    setTimeout(done, 3000);
  });
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  h.classList.add('motion');
  // shortcut: trial picker for page-change styles (?vt=lift|beat, remembered); delete once one is chosen
  try {
    var vt = new URLSearchParams(location.search).get('vt');
    if (vt) localStorage.setItem('vt-style', vt); else vt = localStorage.getItem('vt-style');
    if (vt) h.dataset.vt = vt;
  } catch (e) {}
  setTimeout(function(){ if (!h.classList.contains('motion-on')) h.classList.remove('motion'); }, 3000);
  // Arrived through a page transition: what's on screen comes in with the
  // transition itself, so motion.js skips its reveal (one entrance, not two).
  addEventListener('pagereveal', function(e){
    if (!e.viewTransition) return;
    h.classList.add('vt-in', 'vt-bg');
    e.viewTransition.finished.finally(function(){ h.classList.remove('vt-bg'); });
  });
  // The page snapshot carries the page's background colour, and it sits over
  // the sky's own layer during a transition: clear it on both pages (just
  // before the old one is captured, and until the new one has settled) so the
  // sky shows through instead of a flat fill.
  addEventListener('pageswap', function(e){ if (e.viewTransition) h.classList.add('vt-bg'); });
  addEventListener('pageshow', function(e){ if (e.persisted) { h.classList.remove('vt-bg'); stay(); } });

  // beat: the page starts leaving on the click, while the next one loads (as
  // yuriroga.com and junothebakery.com do), instead of sitting still until it
  // arrives. Only the content goes: the sky, the nav and the project picture
  // that travels into the next page are kept.
  var undo = 0;
  function stay(){ clearTimeout(undo); h.classList.remove('leaving'); document.querySelectorAll('[data-leave]').forEach(function(el){ el.removeAttribute('data-leave'); }); }
  addEventListener('click', function(e){
    if (h.dataset.vt !== 'beat' || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
    var a = e.target.closest && e.target.closest('a[href]');
    if (!a || (a.target && a.target !== '_self') || a.hasAttribute('download') || a.origin !== location.origin) return;
    if (a.pathname === location.pathname && a.search === location.search) return; // same page, or a #section on it
    var keep = [].filter.call(document.querySelectorAll('#site-identity, #site-nav, #sky, #px-clouds, #word-vine, .sky-life, .page-grain, [style*="view-transition-name"]'),
      function(el){ return !el.classList.contains('pw-img') || a.contains(el); }); // Home: only the clicked project's picture travels
    (function walk(list){
      [].forEach.call(list, function(el){
        if (/^(SCRIPT|STYLE|LINK|TEMPLATE)$/.test(el.tagName) || keep.indexOf(el) > -1) return;
        if (keep.some(function(k){ return el.contains(k); })) walk(el.children); else el.setAttribute('data-leave', '');
      });
    })(document.body.children);
    h.classList.add('leaving');
    clearTimeout(undo); undo = setTimeout(stay, 4000); // the navigation never happened
  });
  addEventListener('pagehide', function(){ if (h.classList.contains('leaving')) try { sessionStorage.setItem('vt-left', Date.now()); } catch (e) {} });
  // the old page already left on the click: the new one needn't wait as long
  addEventListener('pagereveal', function(e){
    try { if (e.viewTransition && Date.now() - sessionStorage.getItem('vt-left') < 5000) h.classList.add('vt-early'); sessionStorage.removeItem('vt-left'); } catch (x) {}
  });
})();
</script>
<style is:global>
  :root{
    /* Motion rules: three kinds of moment. Things arrive a little slower
       than they leave; arrivals ease out, departures ease in. */
    --ease-out: cubic-bezier(.16, 1, .3, 1);
    --ease-in: cubic-bezier(.7, 0, .84, 0);
    --ease-inout: cubic-bezier(.65, 0, .35, 1);
    --dur-feedback: 150ms; --dur-feedback-out: 100ms; /* hover, focus, colour */
    --dur-change: 250ms;   --dur-change-out: 150ms;   /* dimming, labels, menus */
    --dur-travel: 450ms;   --dur-travel-out: 180ms;   /* page to page, card into page */
  }
  html.motion [data-reveal], html.motion [data-reveal-group]{ visibility:hidden; }
  html.motion.vt-in [data-reveal], html.motion.vt-in [data-reveal-group]{ visibility:visible; }
  html.vt-bg, html.vt-bg body{ background:transparent !important; }
  [data-scroll-lit] .lit-w{ color:var(--lit-off, #3a3d4a); transition:color .35s var(--ease-out); }
  [data-scroll-lit] .lit-w.lit, [data-scroll-lit].is-static .lit-w{ color:var(--lit-on, #f3f5fb); }

  /* Hover roll (data-roll, motion.js): a one-line window per run of text;
     each letter carries its copy as a text-shadow one line below and moves
     up by one line, 14ms after the letter before it. */
  .roll{ display:inline-flex; overflow:hidden; line-height:1.3; vertical-align:bottom; }
  .roll > span{ display:inline-block; white-space:pre; text-shadow:0 1.3em currentColor;
    transition:transform .5s var(--ease-out); transition-delay:calc(var(--i) * 14ms); }
  [data-roll]:hover .roll > span, [data-roll]:focus-visible .roll > span{ transform:translateY(-1.3em); }

  /* Page to page: the frame stays put and only the content moves (after
     junothebakery.com / hardholy.com). The nav is pulled out of the page
     snapshot so it never moves; each sky layer crossfades in place, since
     pages have different skies. The content lifts away fast and the new
     page settles up into place. Named project frames (work-<slug>) grow
     into their case-study hero. Chrome, Edge and Safari 18.2+; other
     browsers just navigate normally. */
  @view-transition{ navigation:auto; }
  #site-identity{ view-transition-name:site-identity; }
  #site-nav{ view-transition-name:site-nav; }
  #sky{ view-transition-name:sky; }
  .sky-life{ view-transition-name:sky-life; }
  #px-clouds{ view-transition-name:sky-clouds; }
  #word-vine{ view-transition-name:sky-vine; }
  /* named layers paint above the page by default; the (opaque) sky belongs under it */
  ::view-transition-group(sky), ::view-transition-group(sky-life),
  ::view-transition-group(sky-clouds), ::view-transition-group(sky-vine){ z-index:-1; }
  /* the jellyfish clips have black grounds that the layer's screen blend
     drops (SkyLife.astro); a snapshot loses that, so blend the group itself */
  ::view-transition-group(sky-life){ mix-blend-mode:screen; }
  /* the new page's jellyfish start after the transition (sky-cast-life.js), so
     the old ones hold still on screen until then instead of fading out */
  ::view-transition-old(sky-life){ animation:none; }
  ::view-transition-new(sky-life){ animation:none; opacity:0; }
  /* project frames: the one that has a partner on the next page morphs;
     the rest (:only-child below) leave and arrive with the content */
  .pw-img, .wk-img{ view-transition-class:work; }
  @media (prefers-reduced-motion: no-preference){
    ::view-transition-group(*){ animation-duration:var(--dur-travel); animation-timing-function:var(--ease-inout); }
    ::view-transition-group(site-identity), ::view-transition-group(site-nav){ animation:none; }
    ::view-transition-old(site-identity), ::view-transition-old(site-nav){ animation:none; display:none; }
    ::view-transition-new(site-identity), ::view-transition-new(site-nav){ animation:none; }
    ::view-transition-old(root), ::view-transition-old(*.work):only-child{ animation:vt-out var(--dur-travel-out) var(--ease-in) both; }
    ::view-transition-new(root), ::view-transition-new(*.work):only-child{ animation:vt-in var(--dur-travel) var(--ease-out) 60ms both; }
  }
  /* Trial style (data-vt from the ?vt= picker above); 'lift' or none = the rule above.
     beat (measured on yuriroga.com, aspaceabout.com, junothebakery.com): the old
     page leaves fast (160ms), the sky holds alone for a beat, the text rises in
     (320ms from 30px), and pictures fade in last. */
  @media (prefers-reduced-motion: no-preference){
    :root[data-vt=beat]::view-transition-old(root), :root[data-vt=beat]::view-transition-old(*.work):only-child{ animation:vt-beat-out 160ms cubic-bezier(.4,0,1,1) both; }
    :root[data-vt=beat]::view-transition-new(root), :root[data-vt=beat]::view-transition-new(*.work):only-child{ animation:vt-beat-in 320ms cubic-bezier(0,0,.2,1) 360ms both; }
    /* pictures that aren't travelling (named frames) fade in on their own, after the text */
    :root[data-vt=beat].vt-in main img:not([style*="view-transition-name"] img){ animation:vt-media-in 450ms cubic-bezier(0,0,.2,1) 560ms both; }
    /* the old page started leaving on the click (Motion's click handler) */
    :root[data-vt=beat] [data-leave]{ transition:opacity 160ms cubic-bezier(.4,0,1,1), translate 160ms cubic-bezier(.4,0,1,1) !important; }
    :root[data-vt=beat].leaving [data-leave]{ opacity:0 !important; translate:0 12px; }
    :root[data-vt=beat].vt-early::view-transition-new(root), :root[data-vt=beat].vt-early::view-transition-new(*.work):only-child{ animation-delay:160ms; }
    :root[data-vt=beat].vt-early.vt-in main img:not([style*="view-transition-name"] img){ animation-delay:360ms; }
  }
  @keyframes vt-beat-out{ to{ opacity:0; transform:translateY(12px); } }
  @keyframes vt-beat-in{ from{ opacity:0; transform:translateY(30px); } }
  @keyframes vt-media-in{ from{ opacity:0; } }
  @media (prefers-reduced-motion: reduce){
    ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*){ animation:none !important; }
  }
  @keyframes vt-out{ to{ opacity:0; transform:translateY(-14px); } }
  @keyframes vt-in{ from{ opacity:0; transform:translateY(18px); } }
</style>
<script>
  import '../scripts/motion.js';
</script>
