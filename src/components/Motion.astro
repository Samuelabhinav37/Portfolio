---
/**
 * Shared motion layer for the main pages: Lenis smooth scroll, GSAP scroll
 * reveals and the scroll-lit statement (src/scripts/motion.js), the motion
 * tokens CSS uses, and the page-to-page view transition (with Astro's ClientRouter).
 *
 * The inline script hides reveal targets only once we know JS is running;
 * if motion.js never arrives, the 3s fallback shows everything anyway.
 */
---
<script is:inline>
(function(){
  var h = document.documentElement;
  // Resolves once an arriving page transition has finished (at once on a full load).
  // Heavy start-up work waits on it: run during the transition it drops frames.
  window.afterPageChange = Promise.resolve();

  /* Pages with Astro's ClientRouter stay one document: a link swaps in the
     next page's content while the sky and the nav tools carry on
     (transition:persist). Every script sets itself up through
     onPage(fn): fn runs for this page and again after each swap, with a
     signal that aborts when its page is swapped out (pass it to window and
     document listeners, stop loops and timers on it). fn must check its own
     elements exist: it runs on every page. This script itself runs once. */
  var fns = [], life = new AbortController(), swapping = false;
  function call(fn){ try { fn(life.signal); } catch (err) { setTimeout(function(){ throw err; }); } }
  window.onPage = function(fn){
    fns.push(fn);
    if (swapping) return; // a script new to this visit, run by the router mid-swap: astro:page-load calls it
    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', function(){ call(fn); }, { once: true });
    else call(fn);
  };
  // what scripts set on <html> that must outlive a swap (the router copies the new page's attributes over)
  var KEEP_ATTRS = ['data-theme', 'data-cursor'], DROP_CLASSES = /^(vt-bg|leaving|vt-early|vt-in)$/;
  document.addEventListener('astro:before-swap', function(e){
    life.abort(); life = new AbortController(); swapping = true;
    var to = e.newDocument.documentElement;
    KEEP_ATTRS.forEach(function(a){ h.hasAttribute(a) ? to.setAttribute(a, h.getAttribute(a)) : to.removeAttribute(a); });
    h.classList.forEach(function(c){ if (!DROP_CLASSES.test(c)) to.classList.add(c); });
    if (e.viewTransition) {
      to.classList.add('vt-in', 'vt-bg');
      if (h.classList.contains('leaving')) to.classList.add('vt-early');
      // and after the content's fade-in (page-in), which outlasts the transition itself
      window.afterPageChange = e.viewTransition.finished.then(null, function(){}).then(function(){
        return Promise.all(document.getAnimations().filter(function(a){ return a.animationName === 'page-in'; })
          .map(function(a){ return a.finished.then(null, function(){}); }));
      });
      e.viewTransition.finished.finally(function(){ h.classList.remove('vt-bg'); });
    } else window.afterPageChange = Promise.resolve();
  });
  document.addEventListener('astro:page-load', function(){ if (!swapping) return; swapping = false; fns.forEach(call); });
  /* The router re-adds a page's new <script src> tags with createElement, which makes
     them async: they then run in whatever order they load (a page's knowledge base before
     the base file it builds on). async = false keeps them in page order, as on a full load. */
  var mk = document.createElement;
  document.addEventListener('astro:after-swap', function(){
    document.createElement = function(t){ var el = mk.apply(document, arguments); if (String(t).toLowerCase() === 'script') el.async = false; return el; };
  });
  document.addEventListener('astro:page-load', function(){ document.createElement = mk; });
  /* The router announces the new page to screen readers by reading document.title
     60ms after the swap, but title-manager.js is retyping the tab title by then
     (it starts from the old page's). So keep the new page's real title from the
     swap and put it in the announcer as soon as the router fills it in. */
  var pageTitle = '';
  document.addEventListener('astro:after-swap', function(){ pageTitle = document.title; }); // runs before title-manager's: this script is first in <head>
  document.addEventListener('astro:page-load', function(){
    if (!pageTitle) return;
    setTimeout(function(){ // the router adds its announcer just after this event
      var ann = document.querySelectorAll('.astro-route-announcer'), a = ann[ann.length - 1];
      if (!a) return;
      var mo = new MutationObserver(function(){ if (a.textContent && a.textContent !== pageTitle) { mo.disconnect(); a.textContent = pageTitle; } });
      mo.observe(a, { childList: true, characterData: true, subtree: true });
      setTimeout(function(){ mo.disconnect(); }, 1000);
    });
  });

  if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  h.classList.add('motion');
  setTimeout(function(){ if (!h.classList.contains('motion-on')) h.classList.remove('motion'); }, 3000);
  // a page whose content left (below) can come back from the back/forward cache: the router
  // hands a page without the ClientRouter (the 404, the tools) to a full load after leave()
  addEventListener('pageshow', function(e){ if (e.persisted) { h.classList.remove('vt-bg'); stay(); } });

  // The page starts leaving as the router starts loading the next one (as
  // yuriroga.com and junothebakery.com do), instead of sitting still until it
  // arrives. Only the content goes: the sky, the nav and the project picture
  // that travels into the next page are kept.
  var undo = 0;
  function stay(){ clearTimeout(undo); h.classList.remove('leaving'); document.querySelectorAll('[data-leave]').forEach(function(el){ el.removeAttribute('data-leave'); }); }
  document.addEventListener('astro:before-preparation', function(e){
    var a = e.sourceElement && e.sourceElement.closest && e.sourceElement.closest('a[href]');
    if (e.to.pathname === e.from.pathname) return;
    leave(a || document.createElement('a'));
    // let the content finish fading out (200ms) before the swap, however fast the next page loads
    var load = e.loader, faded = new Promise(function(r){ setTimeout(r, 200); });
    e.loader = function(){ return Promise.all([load(), faded]); };
  });
  // the arriving page's content fades in live (CSS [data-arrive]); the sky never stops
  document.addEventListener('astro:after-swap', function(){
    mark(document.createElement('a'), 'data-arrive');
    setTimeout(function(){ document.querySelectorAll('[data-arrive]').forEach(function(el){ el.removeAttribute('data-arrive'); }); }, 700);
  });
  // The page snapshot carries the page's background colour, and it sits over
  // the sky during a transition: clear it (once the next page is fetched, just
  // before the old one is captured, until the new one settles) so the sky
  // shows through instead of a flat fill.
  document.addEventListener('astro:after-preparation', function(){ h.classList.add('vt-bg'); });
  document.addEventListener('astro:page-load', function(){ stay(); if (!document.startViewTransition) h.classList.remove('vt-bg'); });
  function leave(a){
    mark(a, 'data-leave');
    h.classList.add('leaving');
    clearTimeout(undo); undo = setTimeout(stay, 4000); // the navigation never happened
  }
  // set attr on the page's content: everything but the sky, the nav and a travelling picture
  function mark(a, attr){
    var keep = [].filter.call(document.querySelectorAll('#site-identity, #site-nav, #sky-stage, #sky, #px-clouds, .sky-life, .page-grain, [style*="view-transition-name"]'),
      function(el){ return !el.classList.contains('pw-img') || a.contains(el); }); // Home: only the clicked project's picture travels
    (function walk(list){
      [].forEach.call(list, function(el){
        if (/^(SCRIPT|STYLE|LINK|TEMPLATE)$/.test(el.tagName) || keep.indexOf(el) > -1) return;
        if (keep.some(function(k){ return el.contains(k); })) walk(el.children); else el.setAttribute(attr, '');
      });
    })(document.body.children);
  }
})();
</script>
<style is:global>
  :root{
    /* Motion rules: three kinds of moment. Things arrive a little slower
       than they leave; arrivals ease out, departures ease in. */
    --ease-out: cubic-bezier(.16, 1, .3, 1);
    --ease-in: cubic-bezier(.7, 0, .84, 0);
    --ease-inout: cubic-bezier(.65, 0, .35, 1);
    --dur-feedback: 150ms; --dur-feedback-out: 100ms; /* hover, focus, colour */
    --dur-change: 250ms;   --dur-change-out: 150ms;   /* dimming, labels, menus */
    --dur-travel: 450ms;   --dur-travel-out: 180ms;   /* page to page, card into page */
  }
  html.motion [data-reveal], html.motion [data-reveal-group]{ visibility:hidden; }
  html.motion.vt-in [data-reveal], html.motion.vt-in [data-reveal-group]{ visibility:visible; }
  html.vt-bg, html.vt-bg body{ background:transparent !important; }
  /* typed labels (motion.js): letters keep their place and appear in turn behind a thin caret
     that takes no width; once done it blinks twice and fades */
  .type-ch{ opacity:0; } .type-ch.on{ opacity:1; }
  .type-caret{ display:inline-block; width:0; height:1em; vertical-align:-.12em; border-left:1px solid currentColor; margin-right:-1px; }
  .type-caret.done{ animation:type-blink 1.06s steps(1) 2, type-gone .3s ease-out 2.12s forwards; }
  @keyframes type-blink{ 50%{ opacity:0; } }
  @keyframes type-gone{ to{ opacity:0; } }
  .sr-only{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap; }
  [data-scroll-lit] .lit-w{ color:var(--lit-off, #3a3d4a); transition:color .35s var(--ease-out); }
  [data-scroll-lit] .lit-w.lit, [data-scroll-lit].is-static .lit-w{ color:var(--lit-on, #f3f5fb); }

  /* Hover roll (data-roll, motion.js): a one-line window per run of text;
     each letter carries its copy as a text-shadow one line below and moves
     up by one line, 14ms after the letter before it. */
  .roll{ display:inline-flex; overflow:hidden; line-height:1.3; vertical-align:bottom; }
  .roll > span{ display:inline-block; white-space:pre; text-shadow:0 1.3em currentColor;
    transition:transform .5s var(--ease-out); transition-delay:calc(var(--i) * 14ms); }
  [data-roll]:hover .roll > span, [data-roll]:focus-visible .roll > span{ transform:translateY(-1.3em); }

  /* Page to page (ClientRouter, same document): the frame stays put and only
     the content moves (after junothebakery.com / hardholy.com). The nav is
     pulled out of the page snapshot so it never moves. The sky layers are the
     same live elements on both sides (transition:persist), so they show live
     and the frozen copy of the old page's is dropped. Named project frames
     (work-<slug>) grow into their case-study hero. Chrome, Edge and Safari
     18+; elsewhere the router swaps the page without an animation. */
  #site-identity{ view-transition-name:site-identity; }
  #site-nav{ view-transition-name:site-nav; }
  /* project frames: the one that has a partner on the next page morphs;
     the rest (:only-child below) leave and arrive with the content */
  .pw-img, .wk-img{ view-transition-class:work; }
  /* A plain crossfade (oliverdupuy.com: opacity, cubic-bezier(.1,0,0,1)), done on
     the live page rather than on view-transition snapshots, so the sky, jellyfish,
     clouds and rays never stop or change look: the content fades out as the next
     page loads (leave(), 200ms), the swap itself is instant, and the new content
     fades in (450ms). Only a project picture with a partner on the next page
     morphs through the view transition. */
  ::view-transition-old(root), ::view-transition-old(*.work):only-child{ display:none; }
  ::view-transition-new(root), ::view-transition-new(*.work):only-child{ animation:none; }
  @media (prefers-reduced-motion: no-preference){
    ::view-transition-group(*){ animation-duration:var(--dur-travel); animation-timing-function:var(--ease-inout); }
    ::view-transition-group(root){ animation:none; }
    ::view-transition-group(site-identity), ::view-transition-group(site-nav){ animation:none; }
    ::view-transition-old(site-identity), ::view-transition-old(site-nav){ animation:none; display:none; }
    ::view-transition-new(site-identity), ::view-transition-new(site-nav){ animation:none; }
    [data-leave]{ transition:opacity 200ms cubic-bezier(.4,0,1,1) !important; }
    .leaving [data-leave]{ opacity:0 !important; }
    [data-arrive]{ animation:page-in 450ms cubic-bezier(.1,0,0,1) both; }
    /* a page's own tint on the live sky (Contact greys the jellyfish) eases in with the content instead of snapping */
    .sky-life{ transition:filter 450ms cubic-bezier(.1,0,0,1); }
  }
  @keyframes page-in{ from{ opacity:0; } }
  @media (prefers-reduced-motion: reduce){
    ::view-transition-group(*), ::view-transition-old(*), ::view-transition-new(*){ animation:none !important; }
  }
</style>
<script>
  import '../scripts/motion.js';
</script>
