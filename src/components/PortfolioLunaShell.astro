---
import LunaEngine from './LunaEngine.astro';

/**
 * Luna's creature/iframe shell for the portfolio pages. The actual canvas
 * eye-engine + Blob-iframe injection glue now lives in the shared
 * LunaEngine.astro (it was byte-identical to the blog's copy, confirmed via
 * diff, before being extracted). This file keeps only what's genuinely
 * specific to the portfolio pages: the wrap/positioning markup and CSS.
 * Each page's own mouse-tracking bridge / idle-action loop / KB / drawer
 * stays where it is today (those genuinely differ per page — different
 * target actions, different tuning constants) and is NOT part of either
 * shared component.
 *
 * `hasIntro` mirrors SiteMenu's prop: only the home page gates this behind
 * its own GSAP intro timeline (which sets `.style.opacity` directly by id,
 * same as it does for site-identity/menu-trigger).
 */
interface Props {
  hasIntro?: boolean;
}
const { hasIntro = false } = Astro.props;
---

<div id="luna-wrap" aria-hidden="true">
  <iframe id="luna-frame" title="Luna (decorative companion)" tabindex="-1" scrolling="no" sandbox="allow-scripts allow-same-origin"></iframe>
</div>

<style>
  #luna-wrap {
    position: fixed;
    right: 18px;
    top: calc(66vh + 80px);
    width: 120px;
    height: 120px;
    z-index: 999;
    transition: opacity 0.35s ease;
  }
  /* Below the mobile/tablet breakpoint (each page's own inline script toggles
     these classes via matchMedia), her default top:calc(66vh+80px) spot
     overlaps scrolling content for a much larger share of a narrow viewport
     than it does on desktop. Rather than hide her entirely, dock her to the
     bottom-right corner instead — same standard spot as a chat widget,
     always clear of in-flow content, still visible and tappable. */
  #luna-wrap.about-hidden, #luna-wrap.luna-hidden {
    top: auto;
    bottom: 16px;
    right: 14px;
  }
  #luna-frame {
    width: 100%;
    height: 100%;
    border: 0;
    background: transparent;
    display: block;
    /* Chrome only composites an iframe transparently when its used
       color-scheme matches the parent's. LunaEngine.astro's document
       declares dark; without this, the parent side of that match is
       undeclared here and Chrome paints an opaque white box under her —
       see LunaEngine.astro's fuller comment. */
    color-scheme: dark;
  }
</style>

{hasIntro && (
  <style>
    #luna-wrap { opacity: 0; }
  </style>
)}

<LunaEngine />
