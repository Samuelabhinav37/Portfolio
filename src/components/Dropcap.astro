---
/**
 * Opening paragraph. Used to render a boxed drop capital; the post type
 * system dropped it (a one-off 38px glyph), so it now renders the letter
 * back into an ordinary first paragraph. Kept as a component so existing
 * posts don't need editing:
 *   <Dropcap letter="I">n March 2026, a routine dependency update...</Dropcap>
 */
interface Props {
  letter: string;
}
const { letter } = Astro.props;
---

<p class="body-text">{letter}<slot /></p>
