---
/**
 * Opening paragraph, set like a novel's chapter opening: a drop capital
 * and the rest of the first line in small caps (blog.css, "Book pages").
 *   <Dropcap letter="I">n March 2026, a routine dependency update...</Dropcap>
 */
interface Props {
  letter: string;
}
const { letter } = Astro.props;
---

<p class="body-text opening"><span class="dropcap">{letter}</span><slot /></p>
