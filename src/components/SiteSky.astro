---
/**
 * The site background, shared by every page: black space with dim clouds,
 * stars and drifting jellyfish (the homepage sky), and the light theme's
 * day sky. The nav's sun/moon switch (SiteMenu themeToggle) flips
 * html[data-theme]; /scripts/theme.js, loaded in each page's <head>, sets it
 * before the first paint and tells sky.js to switch night and day.
 *
 * Light theme basics live here: --c-white is the site's "ink on dark"
 * colour, so flipping it to dark ink turns most rgba(var(--c-white), a) text
 * and lines over in one go. Each page overrides its own literal colours.
 */
import SkyBackground from './SkyBackground.astro';
import SkyLife from './SkyLife.astro';
---
<!-- one container, kept alive across ClientRouter page changes (transition:persist):
     the sky, its clouds, the jellyfish and the vine (their scripts add their
     layers beside #sky) carry on instead of starting over -->
<div id="sky-stage" transition:persist="sky-stage">
<SkyBackground tone="space" />
<!-- the sky cast: jellyfish, between the sky and the page -->
<SkyLife cast />
</div>
<!-- pixel-art clouds over the day sky only; built on first switch to light -->
<script is:inline defer src="/scripts/pixel-clouds.js?v=4"></script>
<!-- sunbeams by day, moonbeams by night, soft beams that shimmer and sway -->
<script is:inline defer src="/scripts/light-rays.js?v=4"></script>
<!-- the jellyfish in light mode: a more solid sprite -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><filter id="jelly-glow" x="-60%" y="-60%" width="220%" height="220%" color-interpolation-filters="sRGB"><feComponentTransfer><feFuncA type="linear" slope="1.6"/></feComponentTransfer></filter></svg>

<style is:global>
:root[data-theme="light"]{ --c-white:25,25,25; --c-bg:#fbfbfa; color-scheme:light; }
:root[data-theme="light"] #chrome-damp, :root[data-theme="light"] #subliminal-layer,
:root[data-theme="light"] #subliminal-flash, :root[data-theme="light"] .page-grain{ display:none; }
:root[data-theme="light"] #sky{ background:#8fb0e0; }
/* the jellyfish by day: made more solid (alpha x1.6 in #jelly-glow, what the old
   brightness(4) on the screened clip gave) */
:root[data-theme="light"] .sc-jelly{ filter:url(#jelly-glow) var(--jt, grayscale(0)); }
/* the sky's scanlines only vanish on black */
:root[data-theme="light"] #sky .sky-grain, :root[data-theme="light"] #sky::after{ display:none; }
html, body{ transition:background-color .4s ease; }
/* pixel clouds (pixel-clouds.js): over the sky, under the jellyfish and the page */
#px-clouds{ position:fixed; inset:0; z-index:1; pointer-events:none; overflow:hidden; }
#px-clouds .pxc{ position:absolute; left:0; top:0; image-rendering:pixelated; will-change:transform; animation:pxSway 15s linear infinite alternate; }
/* the sway: +-60px at 8px/s, on the compositor (pixel-clouds.js sets where in the swing each cloud starts) */
@keyframes pxSway{ from{ translate:-60px } to{ translate:60px } }
@media (prefers-reduced-motion:reduce){ #px-clouds .pxc{ animation:none; } }
/* light rays (light-rays.js): a small canvas stretched smooth over the screen,
   swaying slowly around the light off the top right (each beam shimmers in the script) */
/* 40px past every edge so the sway never shows the canvas edge */
#light-rays{ position:fixed; inset:-40px; width:calc(100% + 80px); height:calc(100% + 80px); z-index:1; pointer-events:none;
  transform-origin:90% -30%; animation:raySway 18s ease-in-out infinite alternate; }
@keyframes raySway{ from{ rotate:-1.6deg } to{ rotate:1.6deg } }
@media (prefers-reduced-motion:reduce){ #light-rays{ animation:none; } }
</style>
