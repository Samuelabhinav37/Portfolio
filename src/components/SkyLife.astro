---
/**
 * SkyLife: what lives in the contact page's sky.
 *
 * - jellyfish drifting through, each a short looping video of a jellyfish
 *   drawn in serif digits (bright parts are bigger, brighter numbers), moved
 *   around the sky by /scripts/sky-life.js, which also scatters a few tiny
 *   glitching stars (the same digit style, each a 3s loop that breathes and
 *   twice splits into red and cyan) and lets out the odd rising bubble.
 *
 * Why video: the drawing has thousands of glyphs per frame. Rendered ahead
 * of time (scratchpad digits.py) it costs the browser a hardware video
 * decode instead of laying out text every frame. The clips are digits on
 * black, so the layer is screen-blended: black drops out against the dark
 * sky and only the digits show, with no alpha channel needed.
 *
 * The layer is fixed between the sky and the page content (.field-wrap is
 * z-index 40) and never takes pointer events.
 *
 * `cast` swaps all of this for the blog's sky cast (/scripts/sky-cast-life.js):
 * jellyfish drifting up,
 * with soft stars and bubbles.
 */
interface Props {
  cast?: boolean;
  /** only the jellyfish and their bubbles (no stars), for a page with its own backdrop */
  jellies?: boolean;
}
const { cast, jellies } = Astro.props;
---

{cast ? (
  <>
    <div class="sky-life" aria-hidden="true"></div>
    <script is:inline defer src="/scripts/shared-clip.js"></script>
    <script is:inline defer src="/scripts/sky-cast-life.js?v=7"></script>
  </>
) : jellies ? (
  <>
    <div class="sky-life" aria-hidden="true">
      <div id="life-jellies" data-no-stars></div>
      <svg id="life-sky"></svg>
    </div>
    <script is:inline defer src="/scripts/shared-clip.js"></script>
    <script is:inline defer src="/scripts/sky-life.js"></script>
  </>
) : (
  <>
    <div class="sky-life" aria-hidden="true">
      <div id="life-jellies"></div>
      <svg id="life-sky"></svg>
    </div>
    <script is:inline defer src="/scripts/shared-clip.js"></script>
    <script is:inline defer src="/scripts/sky-life.js"></script>
  </>
)}

<style>
  /* no box of its own: a full-screen blended (or filtered) layer made the whole
     page composite at half speed. Each jellyfish, star and bubble is its own
     small fixed layer instead. */
  .sky-life{ display:contents; }
  #life-sky{ position:absolute; inset:0; width:100%; height:100%; overflow:visible; opacity:0.75;
    font-family:'Times New Roman', Times, serif; white-space:pre; }

  /* every clip here is drawn on black and screened onto the sky, so a
     jellyfish drifting over another doesn't show its black box */
  :global(.life-jelly), :global(.life-star){ mix-blend-mode:screen; }

  #life-jellies{ position:absolute; inset:0; }
  :global(.life-jelly){ position:absolute; left:0; top:0; display:block; height:auto; aspect-ratio:240 / 420;
    background:#000; opacity:0.85; will-change:transform; }
  :global(.life-star){ position:absolute; display:block; aspect-ratio:1; background:#000;
    transform:translate(-50%, -50%); }

  /* the homepage sky cast (sky-cast-life.js builds these) */
  /* The jellyfish stay videos on purpose: a playing video makes Chrome pace the
     whole page at an even half of a fast screen's rate (72 on 144Hz). As a
     sprite the page averaged more frames but uneven ones, which looked worse. */
  :global(.sc-layer){ display:contents; }
  :global(.sc-jelly), :global(.sc-star), :global(.sc-bubble){ z-index:2; pointer-events:none; }
  /* --jt: a page's own tint (Contact greys the cast); always the same five functions so it can ease */
  :global(.sc-star){ filter:var(--jt, none); }
  :global(.sc-jelly){ position:fixed; left:0; top:0; display:block; height:auto; aspect-ratio:240 / 420;
    background:#000; mix-blend-mode:screen; opacity:0; will-change:transform, opacity; filter:brightness(2.5) var(--jt, grayscale(0) sepia(0) hue-rotate(0deg) saturate(1) brightness(1)); }
  /* soft points of light that brighten and dim, each at its own pace */
  :global(.sc-star){ position:fixed; border-radius:50%;
    background:radial-gradient(circle, rgba(255,249,236,1) 0, rgba(255,246,228,.45) 25%, rgba(255,246,228,0) 70%);
    animation:sc-twinkle var(--d) ease-in-out var(--o) infinite alternate; }
  @keyframes sc-twinkle{ from{ opacity:var(--lo); } to{ opacity:var(--hi); } }
  :global(.sc-bubble){ position:fixed; border:.8px solid rgba(236,223,200,.6); border-radius:50%;
    animation:sc-rise var(--d) linear forwards; }
  @keyframes sc-rise{ 0%{ opacity:0; transform:translate(0, 0); } 50%{ opacity:1; } 100%{ opacity:0; transform:translate(var(--dx), -45px); } }
  @media (prefers-reduced-motion: reduce){ :global(.sc-star){ animation:none; opacity:var(--hi); } }
</style>
