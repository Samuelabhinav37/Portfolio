---
import type { CollectionEntry } from 'astro:content';
import { SITE } from '../config';

interface Props {
  posts: CollectionEntry<'blog'>[];
  /** Post's language — only ever passed explicitly by BlogPost.astro for a
   *  translated post; defaults to English otherwise. */
  lang?: 'en' | 'es';
}
const { posts, lang = 'en' } = Astro.props;

// timeZone: 'UTC' — see BlogPost.astro's dateLabel for why this matters
// (pubDate parses as UTC midnight; formatting without pinning the zone can
// silently roll the displayed month back a day on some build machines).
const fmt = (d: Date) =>
  d.toLocaleString(lang === 'es' ? 'es-ES' : 'en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' });
const heading = lang === 'es' ? 'Más historias' : 'More stories';
---

{posts.length > 0 && (
  <div class="more-stories">
    <h2 class="more-stories-heading">{heading}</h2>
    <div class="more-stories-rule"></div>
    <div class="stories-grid">
      {posts.map((p) => (
        // p.id is the raw content-collection id — for a translation that's
        // locale-prefixed (e.g. "es/some-post"), which lives under /es/blog/
        // rather than /blog/, not just /blog/<id>/ for every locale.
        <a class="story-card" href={p.id.startsWith('es/') ? `/es/blog/${p.id.slice(3)}/` : `/blog/${p.id}/`}>
          <div class="story-image">
            {p.data.cardImage
              ? <img src={p.data.cardImage} alt={p.data.cardImageAlt ?? ''} loading="lazy" />
              : <div class="story-image-ph" aria-hidden="true"></div>}
            <div class="story-shimmer"></div>
          </div>
          <div class="story-category">{p.data.category}</div>
          <h3 class="story-title">{p.data.title}</h3>
          <div class="story-keywords">
            {[...p.data.mitre, ...p.data.tags].slice(0, 3).map((t) => (
              <span class="keyword-pill">{t}</span>
            ))}
          </div>
          <div class="story-meta">
            <span>{SITE.author}</span><span class="story-meta-sep">/</span>
            <span>{fmt(p.data.pubDate)}</span>
            {p.data.readTime && <><span class="story-meta-sep">/</span><span>{p.data.readTime} Min</span></>}
          </div>
        </a>
      ))}
    </div>
  </div>
)}
