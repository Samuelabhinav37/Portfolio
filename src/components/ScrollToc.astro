---
/* Notion-style floating contents for long pages: one dash per [data-toc]
   element on the page (label = the attribute value, [data-toc-sub] = short
   dash), current one longer and brighter, hover or focus opens a card of
   links. Shown only after the first section has scrolled up. Built by
   /scripts/scroll-toc.js; blog posts keep their own .etoc. */
---
<nav class="stoc" id="stoc" aria-label="On this page" hidden>
  <ol class="stoc-dashes" aria-hidden="true"></ol>
  <div class="stoc-card"><ol></ol></div>
</nav>
<script is:inline defer src="/scripts/scroll-toc.js"></script>

<style is:global>
.stoc { position: fixed; right: 18px; top: 50%; transform: translateY(-50%); z-index: 900; /* above home #projects-section (301), below nav and Kai */ opacity: 0; pointer-events: none; transition: opacity .3s; }
.stoc.is-shown, .stoc:focus-within { opacity: 1; pointer-events: auto; }
.stoc-dashes { list-style: none; margin: 0; padding: 10px 6px 10px 28px; display: grid; gap: 10px; justify-items: end; }
.stoc-dashes li { display: block; width: 16px; height: 2px; border-radius: 2px; background: rgba(255,255,255,.38); transition: width .25s, background .25s; }
.stoc-dashes li.top { width: 22px; }
.stoc-dashes li.is-active { width: 24px; background: #fff; }
:root[data-theme="light"] .stoc-dashes li { background: rgba(55,53,47,.22); }
:root[data-theme="light"] .stoc-dashes li.is-active { background: #37352f; }
.stoc-card {
  position: absolute; right: calc(100% - 20px); top: 50%; width: 240px; max-height: 70vh; overflow: auto; padding: 6px;
  border: 1px solid rgba(55,53,47,.09); border-radius: 10px; background: #fff; box-shadow: 0 0 0 1px rgba(15,15,15,.05), 0 3px 6px rgba(15,15,15,.1), 0 9px 24px rgba(15,15,15,.2);
  opacity: 0; pointer-events: none; transform: translate(8px, -50%); transition: opacity .18s ease, transform .18s ease;
}
.stoc.is-open .stoc-card, .stoc:focus-within .stoc-card { opacity: 1; pointer-events: auto; transform: translate(0, -50%); }
.stoc-card ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 1px; }
.stoc-card a { display: block; padding: 6px 10px; border-radius: 6px; font: 400 13px/1.35 'Inter', -apple-system, 'Segoe UI', sans-serif; color: rgba(55,53,47,.65); text-decoration: none; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.stoc-card a.sub { padding-left: 22px; }
.stoc-card a:hover { background: rgba(55,53,47,.06); color: #37352f; }
.stoc-card a.is-active { color: #37352f; font-weight: 500; }
@media (max-width: 1100px), (hover: none) { .stoc { display: none; } }
@media (prefers-reduced-motion: reduce) { .stoc, .stoc-dashes li, .stoc-card { transition: none; } }
</style>
