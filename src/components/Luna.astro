let personaEnergy=1, personaCalm=0, personaName=null;
function applyPersona(key){
  const P=PERSONAS[key]; if(!P) return;
  personaName=key; personaEnergy=P.energy; personaCalm=P.calm;
  override=P.getup.slice(); applyGetup();        // persona sets her default dress (an override)
  setMood(P.mood);                                // ...and her resting carriage
  if(P.quirk==='slowblink') blinkNow(320); else doAction(P.quirk);   // signature greeting
  voiceEl.innerHTML='<b>'+P.tone+'</b><br>'+P.voice;
  tag.innerHTML='PERSONA — <b>'+P.label+'</b> · '+P.arch;
