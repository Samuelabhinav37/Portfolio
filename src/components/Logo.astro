---
/**
 * The site logo: the constellation mark from favicon.svg and the name in
 * capitals. After femalefaces.org's wordmark, each letter holds three other
 * cuts of itself (serif italic, pixel, typewriter) stacked in one grid cell,
 * so the cell is as wide as its widest cut and swapping never shifts the
 * line. public/scripts/logo.js does the swapping: a letter changes as the
 * pointer crosses it, and two letters change while the page is scrolled.
 * public/404.html carries a copy of this markup and CSS (it is a static file).
 */
interface Props {
  href?: string;   // no href on the page the logo links to (the homepage)
  class?: string;
}
const { href, class: cls } = Astro.props;
const Tag = href ? 'a' : 'div';
const letters = [...'SAMUEL'];
---

<Tag class:list={['logo', cls]} href={href} aria-label={href ? 'Samuel Abhinav, home' : undefined}>
  <svg class="logo-mark" viewBox="0 0 32 32" aria-hidden="true">
    <g class="logo-lines"><line x1="23" y1="8" x2="15" y2="16" pathLength="1"/><line x1="15" y1="16" x2="12" y2="25" pathLength="1"/><line x1="15" y1="16" x2="7" y2="12" pathLength="1"/></g>
    <circle cx="23" cy="8" r="3"/><circle cx="15" cy="16" r="2.4"/><circle cx="12" cy="25" r="1.7"/><circle cx="7" cy="12" r="1.7"/>
  </svg>
  <span class="logo-word" aria-hidden="true">
    {letters.map((ch) => <span class="logo-l" data-v="0"><i>{ch}</i><i>{ch}</i><i>{ch}</i><i>{ch}</i></span>)}
  </span>
  {!href && <span class="logo-sr">Samuel Abhinav</span>}
</Tag>
<script is:inline defer src="/scripts/logo.js"></script>

<style is:global>
  .logo{ display:inline-flex; align-items:center; gap:10px; color:rgba(var(--c-white),.92); text-decoration:none; user-select:none; -webkit-tap-highlight-color:transparent; }
  .logo-mark{ width:24px; height:24px; flex:none; overflow:visible; }
  .logo-mark line{ stroke:#7f8ba8; stroke-width:1.6; stroke-linecap:round; stroke-dasharray:1; stroke-dashoffset:0; }
  .logo-mark circle{ fill:#c6d1e8; transition:transform .5s var(--ease-out, ease); transform-box:fill-box; transform-origin:center; }
  .logo-mark circle:first-of-type{ fill:#e2ebfd; }
  /* hover: the lines redraw from the bright star outwards, the stars pulse once */
  @media (hover:hover) and (prefers-reduced-motion:no-preference){
    .logo:hover .logo-lines line{ animation:logoDraw .7s var(--ease-out, ease) both; }
    .logo:hover .logo-lines line:nth-child(2){ animation-delay:.12s; }
    .logo:hover .logo-lines line:nth-child(3){ animation-delay:.2s; }
    .logo:hover .logo-mark circle{ transform:scale(1.25); }
  }
  @keyframes logoDraw{ from{ stroke-dashoffset:1; } }
  .logo-word{ display:inline-flex; font:600 15px/1 'Inter', 'Inter Tight', system-ui, sans-serif; letter-spacing:.16em; }
  .logo-l{ display:inline-grid; place-items:center; }
  .logo-l i{ grid-area:1 / 1; font-style:normal; visibility:hidden; }
  .logo-l i:nth-child(2){ font:italic 400 19px/1 'Cormorant Garamond', Georgia, serif; letter-spacing:0; }
  .logo-l i:nth-child(3){ font:400 10px/1 'Press Start 2P', monospace; letter-spacing:0; }
  .logo-l i:nth-child(4){ font:400 16px/1 'Special Elite', 'Courier New', monospace; letter-spacing:0; }
  .logo-l[data-v="0"] i:nth-child(1), .logo-l[data-v="1"] i:nth-child(2),
  .logo-l[data-v="2"] i:nth-child(3), .logo-l[data-v="3"] i:nth-child(4){ visibility:visible; }
  .logo-sr{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }
</style>
