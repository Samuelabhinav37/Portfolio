---
/**
 * <IocTable id="eof-2026-04" rows={[
 *   { type: 'Domain', value: 'cdn-assets-delivery[.]net', fanged: 'cdn-assets-delivery.net' },
 * ]} />
 * The copy button prefers `fanged` (the live form) when present.
 * Rendered as a post data table (same frame, header strip and numbering).
 */
interface Props {
  id: string;
  rows: { type: string; value: string; fanged?: string }[];
  /** Post's language — only ever passed explicitly from a translated MDX
   *  file (e.g. lang="es"); defaults to English otherwise. */
  lang?: 'en' | 'es';
}
const { id, rows, lang = 'en' } = Astro.props;
const es = lang === 'es';
const label = es ? 'Indicadores de compromiso' : 'Indicators of compromise';
const copyLabel = es ? 'Copiar' : 'Copy';
const copyAria = (type: string, value: string) =>
  es ? `Copiar indicador ${type}: ${value}` : `Copy ${type} indicator: ${value}`;
---

<figure class="post-figure is-table ioc-block">
  <div class="dtable">
    <table class="ioc-table">
      <thead><tr><th scope="col">{es ? 'Tipo' : 'Type'}</th><th scope="col">{es ? 'Indicador' : 'Indicator'}</th><th scope="col"><span class="sr-only">{copyLabel}</span></th></tr></thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td class="k">{r.type}</td>
            <td class="ioc-val" data-fanged={r.fanged}><code>{r.value}</code></td>
            <td class="ioc-act"><button class="ioc-copy" type="button" aria-label={copyAria(r.type, r.value)}>{copyLabel}</button></td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
  <figcaption>{label} ({id}).</figcaption>
</figure>
