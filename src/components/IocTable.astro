---
/**
 * <IocTable id="eof-2026-04" rows={[
 *   { type: 'Domain', value: 'cdn-assets-delivery[.]net', fanged: 'cdn-assets-delivery.net' },
 * ]} />
 * The copy button prefers `fanged` (the live form) when present.
 */
interface Props {
  id: string;
  rows: { type: string; value: string; fanged?: string }[];
  /** Post's language — only ever passed explicitly from a translated MDX
   *  file (e.g. lang="es"); defaults to English otherwise. */
  lang?: 'en' | 'es';
}
const { id, rows, lang = 'en' } = Astro.props;
const label = lang === 'es' ? 'Indicadores de compromiso' : 'Indicators of compromise';
const copyLabel = lang === 'es' ? 'Copiar' : 'Copy';
const copyAria = (type: string, value: string) =>
  lang === 'es' ? `Copiar indicador ${type}: ${value}` : `Copy ${type} indicator: ${value}`;
---

<div class="ioc-block">
  <div class="ioc-head"><span>{label}</span><span>{id}</span></div>
  <div class="ioc-table-wrap">
  <table class="ioc-table">
    {rows.map((r) => (
      <tr>
        <td class="ioc-type">{r.type}</td>
        <td class="ioc-val" data-fanged={r.fanged}>{r.value}</td>
        <td class="ioc-act"><button class="ioc-copy" type="button" aria-label={copyAria(r.type, r.value)}>{copyLabel}</button></td>
      </tr>
    ))}
  </table>
  </div>
</div>
