---
/**
 * Shared site chrome, after angelaricciardi.com: a fixed top line with the
 * name on the left, "Blog, Archive, About, Contact" as one comma-separated
 * list a little left of the middle, all in the site's serif, and the tool
 * strip (NavTools: latest posts, cursors, podcast, theme) at the right edge. The page you are on is bright, the others dim and
 * brighten on hover; on the home page (no current page) all are bright.
 *
 * Links other than the current page roll their letters up on hover, like
 * the footer links (data-roll, motion.js).
 *
 * `hasIntro` is only true on the home page, which fades the name and links
 * in with its intro (index-intro-sequence.js writes their opacity by id).
 */
interface Props {
  currentPath: '/' | '/about' | '/blog' | '/contact' | '/work' | '/photos';
  hasIntro?: boolean;
}
const { currentPath, hasIntro = false } = Astro.props;

import NavTools from './NavTools.astro';

const links = [
  { href: '/blog/', label: 'Blog' },
  { href: '/photos/', label: 'Archive' },
  { href: '/about/', label: 'About' },
  { href: '/contact/', label: 'Contact' },
];
const onLink = links.some((l) => l.href === currentPath + '/');
const here = (href: string) => (href === currentPath + '/' ? ('page' as const) : undefined);
---

<a class="sr-only sr-only-focusable" href="#site-nav">Skip to navigation</a>

<header id="site-identity">
  {currentPath === '/'
    ? <div class="name">Samuel Abhinav</div>
    : <a href="/" class="name">Samuel Abhinav</a>}
</header>

<nav id="site-nav" aria-label="Primary" class={onLink ? 'has-current' : undefined}>
  <span class="nav-list">{links.map((l, i) => (
    <>{i > 0 && <span class="sep" aria-hidden="true">, </span>}<a href={l.href} aria-current={here(l.href)} data-roll={here(l.href) ? undefined : ""}>{l.label}</a></>
  ))}</span>
  <NavTools />
</nav>

<style>
  /* Screen-reader-only: visually hidden but available to assistive tech.
     The focusable variant becomes visible when tabbed to (the skip link).
     Lives here rather than relying on each host page defining it globally,
     since the skip link itself is part of this component's own markup. */
  .sr-only {
    position: absolute !important; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0);
    white-space: nowrap; border: 0;
  }
  .sr-only-focusable:focus,
  .sr-only-focusable:focus-visible {
    position: fixed !important; top: 10px; left: 10px;
    width: auto; height: auto; margin: 0; padding: 8px 14px; clip: auto;
    z-index: 100000; background: var(--c-bg); color: #d6e0f4;
    border: 1px solid rgba(214,224,244,.4); border-radius: 6px;
    font: 13px/1 'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; letter-spacing: .04em;
  }

  /* the name and the links share one line in the site's serif */
  #site-identity, #site-nav {
    position: fixed; top: 16px; z-index: 1002;
    font: 500 1.15rem/1.2 'Cormorant Garamond', Georgia, serif;
    letter-spacing: 0.01em;
  }
  #site-identity { left: 28px; }
  #site-identity .name { color: rgba(var(--c-white),0.95); text-decoration: none; user-select: none; }
  /* the list a little left of the middle; the tool strip fills the rest of the line to the right edge.
     Like the reference: nothing behind the line, the page scrolls under it */
  #site-nav { font-size: 1rem; top: 10px; left: 36%; right: 28px; display: flex; align-items: center; justify-content: space-between; gap: 24px; white-space: nowrap; color: rgba(var(--c-white),0.95); }
  .nav-list { flex: none; }
  #site-nav a { color: inherit; text-decoration: none; transition: opacity 0.25s ease; }
  /* on a page of the list, the others (and the commas) dim and light up on hover */
  #site-nav.has-current a:not([aria-current]), #site-nav.has-current .sep { opacity: 0.45; }
  #site-nav.has-current a:not([aria-current]):hover, #site-nav a:focus-visible { opacity: 1; }
  #site-nav a[aria-current] { cursor: default; }
  /* a bigger tap area without moving the text */
  #site-nav a { position: relative; }
  #site-nav a::before { content: ''; position: absolute; inset: -12px -4px; }
  @media (max-width: 760px) {
    /* phones: one smaller line, so the name, the list and Contact fit side by side */
    #site-identity { font-size: 0.95rem; }
    #site-nav { font-size: 0.85rem; top: 10px; }
    #site-identity { left: 16px; }
    #site-nav { left: auto; right: 16px; gap: 10px; }
  }
</style>

{hasIntro && (
  <style>
    #site-identity, #site-nav { opacity: 0; transition: opacity 0.55s cubic-bezier(0.22,1,0.36,1); }
    body.intro-done #site-nav { opacity: 1; }
  </style>
)}

