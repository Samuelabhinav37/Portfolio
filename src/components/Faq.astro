---
/** Renders the visible accordion from the same frontmatter that feeds FAQPage JSON-LD. */
interface Props {
  faqs: { q: string; a: string }[];
  /** Post's language — only ever passed explicitly by BlogPost.astro for a
   *  translated post; defaults to English otherwise. */
  lang?: 'en' | 'es';
}
const { faqs, lang = 'en' } = Astro.props;
const es = lang === 'es';
const heading = es ? 'Preguntas frecuentes' : 'Frequently asked questions';
const kicker = es ? 'Preguntas' : 'Questions';
---

{faqs.length > 0 && (
  <section class="faq-section" id="section-faq" aria-labelledby="faq-heading">
    <div class="faq-head">
      <span class="faq-kicker">{kicker}</span>
      <h2 class="faq-heading" id="faq-heading">{heading}</h2>
    </div>
    <div class="faq-list">
      {faqs.map((f) => (
        <div class="faq-item">
          <button class="faq-q" type="button" aria-expanded="false">
            {f.q}<span class="faq-icon" aria-hidden="true">+</span>
          </button>
          <div class="faq-a"><div class="faq-a-inner" set:html={f.a} /></div>
        </div>
      ))}
    </div>
  </section>
)}
