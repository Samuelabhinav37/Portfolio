---
import Motion from '../components/Motion.astro';
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { SITE } from '../config';
import { BLOG_STRINGS, type BlogLocale } from '../data/blog-i18n';
import Faq from '../components/Faq.astro';
import Mitre from '../components/Mitre.astro';
import KaiPost from '../components/KaiPost.astro';
import ClarityAnalytics from '../components/ClarityAnalytics.astro';
import ErrorReporter from '../components/ErrorReporter.astro';
import '../styles/tokens.css';
import '../styles/blog.css';
import Fonts from '../components/Fonts.astro';
import Logo from '../components/Logo.astro';
import FieldTile from '../components/FieldTile.astro';
import { fieldCards } from '../data/field-cards';
import '../styles/field-tiles.css';

interface Props {
  post: CollectionEntry<'blog'>;
  headings: MarkdownHeading[];
  /** Auto word count used when readTime is not set in frontmatter. */
  words: number;
  /** Defaults to English. Only ever set explicitly by a locale-specific
   *  route (e.g. src/pages/es/blog/[...slug].astro) — every other caller
   *  gets the English chrome strings for free. */
  lang?: BlogLocale;
  /** URL of this same post in the other language, if a translation exists.
   *  Renders the language-switch link/hreflang tags; null/undefined hides
   *  them entirely so an untranslated post silently stays English-only
   *  instead of linking to a 404. */
  altHref?: string | null;
}

const { post, headings, words, lang = 'en', altHref = null } = Astro.props;
const d = post.data;

const i18n = BLOG_STRINGS[lang];
const otherLang: BlogLocale = lang === 'en' ? 'es' : 'en';
const altUrl = altHref ? new URL(altHref, Astro.site).href : null;

// End-of-post cards. A post's first tag names its series ("Analog Dawn");
// show the series posts that come after this one, then earlier ones, so the
// cards read as "keep going". A post with no series siblings falls back to
// the most recent posts on the blog. Translation entries (id with a '/')
// never appear here, and a translated post skips its own English original.
const ownId = post.id.replace(/^[a-z]{2}\//, '');
const others = await getCollection('blog', ({ id, data }) => !data.draft && !id.includes('/') && id !== ownId);
const series = d.tags[0];
const byDate = (a: CollectionEntry<'blog'>, b: CollectionEntry<'blog'>) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf();
const siblings = series ? others.filter((p) => p.data.tags[0] === series) : [];
let nextPosts = [
  ...siblings.filter((p) => p.data.pubDate >= d.pubDate).sort(byDate),
  ...siblings.filter((p) => p.data.pubDate < d.pubDate).sort((a, b) => byDate(b, a)),
].slice(0, 3);
if (!nextPosts.length) nextPosts = [...others].sort((a, b) => byDate(b, a)).slice(0, 3);
// the next posts as Field Notes tiles, from the same card data as the blog index
const listed = await getCollection('blog', ({ id, data }) => !data.draft && !id.includes('/'));
const cardById = new Map(fieldCards(listed).map((c) => [c.id, c]));
const nextCards = nextPosts.map((p) => cardById.get(p.id)).filter((c) => !!c);
// the scrolling "More stories" row: this series in reading order first, then
// every other post, newest first
const moreCards = [
  ...nextCards,
  ...[...listed].sort((a, b) => byDate(b, a)).map((p) => cardById.get(p.id)!).filter((c) => c.id !== ownId && !nextCards.includes(c)),
];
// the bottom bar: the posts published just before and after this one
const byDateAll = [...listed].sort(byDate);
const at = byDateAll.findIndex((p) => p.id === ownId);
const prevPost = at > 0 ? byDateAll[at - 1] : null;
const nextPost = at >= 0 && at < byDateAll.length - 1 ? byDateAll[at + 1] : null;
// Series parts, numbered by publish date oldest first, as on the blog index.
const run = siblings.length ? [...siblings, post].sort(byDate) : [];
const partOf = (id: string) => run.findIndex((p) => p.id.replace(/^[a-z]{2}\//, '') === id) + 1;
const partLabel = (n: number) => (lang === 'es' ? `Parte ${n} de ${run.length}` : `Part ${n} of ${run.length}`);
const ownPart = run.length ? partOf(ownId) : 0;

// Contents list: the post's own H2/H3s plus the FAQ, shown as a plain list
// of links near the top of the article, the way Vogue lists a guide's parts.
const faqHeading = lang === 'es' ? 'Preguntas frecuentes' : 'Frequently asked questions';
const toc = [
  ...headings.filter((h) => h.depth === 2 || h.depth === 3).map((h) => ({ slug: h.slug, text: h.text, sub: h.depth === 3 })),
  ...(d.faqs.length ? [{ slug: 'section-faq', text: faqHeading, sub: true }] : []),
];

/* ── Derived, never hand-edited ─────────────────────────────────────── */
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
// x-default should always resolve to the English (default) version.
const xDefaultUrl = lang === 'en' ? canonicalUrl : altUrl;
/* Share image: the post's ogImage, if it has one. The share dialog's
   preview uses the same file, left relative so it loads under any origin. */
const shareImage = d.ogImage;
const ogImage = shareImage ? new URL(shareImage, Astro.site).href : undefined;
const ogIsPreview = !!shareImage?.endsWith('.og.jpg');
const readTime = d.readTime ?? Math.max(1, Math.round(words / 220));
const pubIso = d.pubDate.toISOString().slice(0, 10);
const modIso = (d.updatedDate ?? d.pubDate).toISOString().slice(0, 10);
// timeZone: 'UTC' matters here — pubDate parses as UTC midnight (z.coerce.date()
// on a bare "2026-04-01"), so without pinning the format to UTC too, this
// silently renders in whatever timezone the build machine happens to be in
// (e.g. a west-of-UTC build server shows "MAR 2026" for an April 1 post).
const dateLabel = d.pubDate.toLocaleString(lang === 'es' ? 'es-ES' : 'en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC' });

const shareX =
  'https://x.com/intent/post?url=' +
  encodeURIComponent(canonicalUrl) +
  '&text=' +
  encodeURIComponent(`${d.title} — ${SITE.author}`);
const shareLi =
  'https://www.linkedin.com/sharing/share-offsite/?url=' + encodeURIComponent(canonicalUrl);
const shareDomain = new URL(SITE.links.portfolio).hostname;

/* ── JSON-LD: Article + Breadcrumb + FAQPage from the same frontmatter ── */
const stripHtml = (s: string) => s.replace(/<[^>]+>/g, '');
const graph: object[] = [
  {
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    author: { '@type': 'Person', name: SITE.author, url: SITE.links.portfolio },
    publisher: { '@type': 'Person', name: SITE.author },
    datePublished: pubIso,
    dateModified: modIso,
    mainEntityOfPage: canonicalUrl,
    image: ogImage,
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Blog', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: d.category },
      { '@type': 'ListItem', position: 3, name: d.title },
    ],
  },
];
if (d.faqs.length) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: stripHtml(f.a) },
    })),
  });
}
// JSON.stringify doesn't escape '<', so a stray "</script" in any frontmatter
// field would close this script tag early — escape it before embedding.
const jsonLd = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(
  /</g,
  '\\u003c'
);
---

<!doctype html>
<html lang={lang}>
  <head>
    <script is:inline>
    window.SITE=window.SITE||{};
    (function(){
      function computeLowPower(){
        window.SITE.LOW_POWER = matchMedia('(max-width:900px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches;
      }
      computeLowPower();
      var _lpT;
      addEventListener('resize', function(){ clearTimeout(_lpT); _lpT=setTimeout(computeLowPower, 150); }, {passive:true});
    })();
    </script>
    <meta charset="UTF-8" />
    <meta name="darkreader-lock" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {d.draft && <meta name="robots" content="noindex, nofollow" />}
    <title>{d.title}</title>

    <meta name="description" content={d.description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={d.title} />
    <meta property="og:description" content={d.description} />
    <meta property="og:site_name" content={`${SITE.author} · ${SITE.publication}`} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && ogIsPreview && <meta property="og:image:width" content="1200" />}
    {ogImage && ogIsPreview && <meta property="og:image:height" content="630" />}
    {ogImage && ogIsPreview && <meta property="og:image:type" content="image/jpeg" />}
    {ogImage && d.ogImageAlt && <meta property="og:image:alt" content={d.ogImageAlt} />}
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="article:published_time" content={pubIso} />
    <meta property="article:modified_time" content={modIso} />
    <meta property="article:section" content={d.category} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={d.title} />
    <meta name="twitter:description" content={d.description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {ogImage && d.ogImageAlt && <meta name="twitter:image:alt" content={d.ogImageAlt} />}
    <link rel="canonical" href={canonicalUrl} />
    {altUrl && (
      <>
        <link rel="alternate" hreflang={otherLang} href={altUrl} />
        <link rel="alternate" hreflang={lang} href={canonicalUrl} />
        {xDefaultUrl && <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />}
      </>
    )}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Fonts />
    <Motion />

    <script type="application/ld+json" set:html={jsonLd} />
    <style is:global>
      /* Copy/selection deterrent — requested explicitly. Doesn't stop a
         determined visitor (view-source, reader mode, screenshots all still
         work), but it does stop casual drag-select and Ctrl+C. Form fields are
         exempted so the contact form stays usable. */
      body{ -webkit-user-select:none; -moz-user-select:none; user-select:none; }
      input, textarea, [contenteditable], [contenteditable] *{
        -webkit-user-select:text; -moz-user-select:text; user-select:text;
      }
    </style>
    <script is:inline>
    (function(){
      document.addEventListener('copy', function(e){ e.preventDefault(); });
      document.addEventListener('cut', function(e){ e.preventDefault(); });
    })();
    </script>
    <ErrorReporter />
    <ClarityAnalytics />

  </head>

  <body>
    <a class="skip-link" href="#main-content">{i18n.skipToContent}</a>

    <!-- Reading-progress ring traced around the button itself (Cloudflare-blog
         pattern) instead of a separate bar fixed to the top of the viewport —
         see the .btt-ring rules in blog.css and the scroll handler in
         blog-client.js, which sets stroke-dashoffset from the actual radius
         below rather than a hardcoded circumference. -->
    <button id="back-to-top" aria-label={i18n.backToTop}>
      <svg class="btt-ring" viewBox="0 0 44 44" aria-hidden="true">
        <circle class="btt-ring-track" cx="22" cy="22" r="20" />
        <circle class="btt-ring-fill" cx="22" cy="22" r="20" />
      </svg>
      <svg viewBox="0 0 24 24" fill="none" stroke="rgba(var(--c-white),0.65)" stroke-width="2" stroke-linecap="round"><polyline points="18 15 12 9 6 15"/></svg>
    </button>

    <div id="topbar-scrim" aria-hidden="true"></div>
    <!-- Site identity (fixed corner logo) -->
    <div id="site-identity">
      <Logo href={SITE.links.portfolio} />
    </div>

    <button
      type="button"
      id="menu-trigger"
      aria-label={i18n.openMenu}
      aria-expanded="false"
      data-text-closed={lang === 'es' ? 'Menú' : 'Menu'}
      data-text-open={i18n.close}
      data-label-closed={i18n.openMenu}
      data-label-open={i18n.closeMenu}
    >{lang === 'es' ? 'Menú' : 'Menu'}</button>
    <nav id="menu-overlay" aria-label="Primary" aria-hidden="true" inert>
      <ul id="menu-list">
        <li><a href={SITE.links.about}><span>{i18n.navAbout}</span></a></li>
        <li><a href={SITE.links.blogIndex} class="active"><span>{i18n.navBlog}</span></a></li>
        <li><a href={SITE.links.contact}><span>{i18n.navContact}</span></a></li>
      </ul>
    </nav>

    <!-- Header: the topic label, headline, the series line (no author name:
         this is a single-author site), then the date and read time. Posts
         carry no pictures. -->
    <header class="post-hero no-pic" id="hero">
      <div class="post-hero-text">
        <a class="post-cat" href={SITE.links.blogIndex}>{d.category}</a>
        <h1 class="post-title">{d.title}</h1>
        {series && <p class="post-series">{ownPart ? `${series} · ${partLabel(ownPart)}` : series}</p>}
        <p class="post-date"><time datetime={pubIso}>{dateLabel}</time> · {readTime} {i18n.minRead.toLowerCase()}</p>
        {d.mitre.length > 0 && <div class="post-mitre">{d.mitre.map((t) => <Mitre id={t} />)}</div>}
      </div>
    </header>

    <!-- Listen: reads the post aloud with the browser's own voice, a
         sentence at a time (blog-client.js). Laid out like the audio players
         on news sites: play, skip back and forward 15 seconds, a progress
         bar you can click, the time as "2:15 / 7:40", and the speed. Hidden
         where the browser has no speech voice. -->
    <div class="post-audio" id="postAudio" hidden data-lang={lang === 'es' ? 'es' : 'en'}>
      <button type="button" class="pa-play" id="paPlay" aria-label={lang === 'es' ? 'Escuchar' : 'Listen'}>
        <svg class="pa-i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5z"/></svg>
        <svg class="pa-i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5h3.5v14H7zM13.5 5H17v14h-3.5z"/></svg>
      </button>
      <button type="button" class="pa-skip" id="paBack" aria-label={lang === 'es' ? 'Retroceder 15 segundos' : 'Back 15 seconds'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2L7 6l5 4V7a6 6 0 1 1-6 6H4a8 8 0 1 0 8-8z"/><text x="12" y="16.2" text-anchor="middle">15</text></svg>
      </button>
      <button type="button" class="pa-skip" id="paFwd" aria-label={lang === 'es' ? 'Avanzar 15 segundos' : 'Forward 15 seconds'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5V2l5 4-5 4V7a6 6 0 1 0 6 6h2a8 8 0 1 1-8-8z"/><text x="12" y="16.2" text-anchor="middle">15</text></svg>
      </button>
      <div class="pa-main">
        <div class="pa-top">
          <span class="pa-label">{lang === 'es' ? 'Escuchar' : 'Listen'}</span>
          <span class="pa-time" id="paTime"></span>
        </div>
        <div class="pa-bar" id="paBar" role="slider" tabindex="0" aria-label={lang === 'es' ? 'Progreso' : 'Progress'} aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"><span id="paFill"></span></div>
      </div>
      <button type="button" class="pa-speed" id="paSpeed" aria-label={lang === 'es' ? 'Velocidad' : 'Playback speed'}>1×</button>
    </div>

    <div class="container">
      <!-- Language notice — Cloudflare-blog-style: a plain, always-visible
           line right under the hero, only rendered when a translation of
           this exact post exists. -->
      {altHref && (
        <a href={altHref} class="lang-notice">
          <svg class="lang-notice__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
            <circle cx="12" cy="12" r="9" />
            <path d="M3 12h18M12 3c2.5 2.6 3.8 5.8 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.8-3.8-9s1.3-6.4 3.8-9z" />
          </svg>
          <span>{i18n.alsoAvailable(i18n.switchTo(otherLang))}</span>
        </a>
      )}

      <!-- The 800px text column, centred, the open space to its right
           holding the margin notes (.mnote). The share button sits at the
           screen's left edge, where Vogue keeps its bookmark. -->
      <div class="post-grid">
        <div class="post-side">
          <!-- Single share affordance: navigator.share() (the native OS share
               sheet) where supported, falling back to #shareDialog's own
               X/LinkedIn/copy-link tabs where it isn't. data-share-open="x"
               keeps blog-client.js's dialog wiring working for the fallback;
               the capture-phase listener below intercepts first when
               navigator.share exists. -->
          <button class="post-share" type="button" id="shareBtn" data-share-open="x" title={i18n.shareDialogTitle}><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M12 3v12M8 7l4-4 4 4M5 12v7a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-7"/></svg><span class="post-share-label">{lang === 'es' ? 'Compartir' : 'Share this story'}</span></button>
        </div>
        <script is:inline>
          (function(){
            var btn = document.getElementById('shareBtn');
            if(!btn) return;
            btn.addEventListener('click', function(e){
              if(navigator.share){
                e.preventDefault();
                e.stopImmediatePropagation();
                navigator.share({ title: document.title, url: location.href }).catch(function(){});
              }
            }, true);
          })();
        </script>
        <main class="article-col" id="main-content" tabindex="-1" data-label-anchor={i18n.linkToSection}>
          <!-- the summary, set apart as the piece's italic intro -->
          <p class="post-standfirst">{d.description}</p>
          {toc.length > 1 && (
            <nav class="toc-inline" aria-label={i18n.onThisPage}>
              <ul>{toc.map((h) => <li class:list={[h.sub && 'sub']}><a href={'#' + h.slug}>{h.text}</a></li>)}</ul>
            </nav>
          )}
          <slot />
        </main>
      </div>

      <Faq faqs={d.faqs as { q: string; a: string }[]} lang={lang} />

    </div><!-- /.container -->

    <!-- More stories: every other post in the blog index's tiles, in one row.
         The page scrolls as normal; with the pointer over the row, the wheel
         moves the row sideways until it reaches an end, then the page carries
         on (blog-client.js). Trackpads, touch and the arrows move it too. -->
    {moreCards.length > 0 && (
      <section class="post-next fn-vars" id="postMore" aria-labelledby="post-next-h">
        <h2 class="post-next-h" id="post-next-h">{lang === 'es' ? 'Más artículos' : 'More stories'}</h2>
        <div class="pm-wrap">
          <button type="button" class="pm-arrow pm-prev" aria-label={lang === 'es' ? 'Anteriores' : 'Previous stories'} disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
          <div class="pm-view" tabindex="-1"><div class="pm-track">{moreCards.map((c, i) => <FieldTile c={c} i={i} />)}</div></div>
          <button type="button" class="pm-arrow pm-next" aria-label={lang === 'es' ? 'Siguientes' : 'More stories'}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
        </div>
      </section>
    )}

    <!-- The bottom bar, always there: back to all stories, or on to the post
         published before or after this one -->
    <nav class="post-bar" aria-label={lang === 'es' ? 'Artículos' : 'Stories'}>
      <a href={SITE.links.blogIndex}>{lang === 'es' ? 'Todos los artículos' : 'All stories'}</a>
      <span class="post-bar-pn">
        {prevPost ? <a href={`/blog/${prevPost.id}/`} title={prevPost.data.title} rel="prev">{lang === 'es' ? 'Anterior' : 'Previous'}</a> : <span aria-disabled="true">{lang === 'es' ? 'Anterior' : 'Previous'}</span>}
        {nextPost ? <a href={`/blog/${nextPost.id}/`} title={nextPost.data.title} rel="next">{lang === 'es' ? 'Siguiente' : 'Next'}</a> : <span aria-disabled="true">{lang === 'es' ? 'Siguiente' : 'Next'}</span>}
      </span>
    </nav>

    <!-- On this page, pinned to the right edge (Notion-style floating
         contents, built on the parked toc-hover-reveal bar strip): one dash
         per section, the current one longer and brighter; hover or keyboard
         focus opens a card of headings. Dashes are decorative; the card's
         links are the real, always-focusable ones. Hidden under 1100px; the
         plain contents list near the top serves every width. Wired in blog-client.js. -->
    {toc.length > 1 && (
      <nav class="etoc" id="etoc" aria-label={i18n.onThisPage}>
        <ol class="etoc-dashes" aria-hidden="true">
          {toc.map((h) => <li><span data-toc={h.slug} class:list={[h.sub && 'sub']}></span></li>)}
        </ol>
        <div class="etoc-card">
          <div class="etoc-h">{i18n.onThisPage}</div>
          <ol>{toc.map((h) => <li><a href={'#' + h.slug} data-toc={h.slug} class:list={[h.sub && 'sub']}>{h.text}</a></li>)}</ol>
        </div>
      </nav>
    )}

    <footer class="post-footer">
      <span>&copy; {new Date().getFullYear()} {SITE.author}</span>
      <div class="f-links">
        <a href={SITE.links.linkedin} target="_blank" rel="me noopener"><svg class="fic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn</a>
        <a href={SITE.links.github} target="_blank" rel="me noopener"><svg class="fic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a>
        <a href={SITE.links.x} target="_blank" rel="me noopener" aria-label="X"><svg class="fic" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
        <a href={SITE.links.hackerone} target="_blank" rel="me noopener">HackerOne</a>
      </div>
    </footer>

    <!-- Share dialog — tabbed per-platform preview, mirrors the blog index's
         "See more" filter dialog (same centered-panel/backdrop/focus-trap
         pattern) so it reads as one system instead of a bolted-on widget. -->
    <div id="shareDialog" class="flt-dialog share-dialog" aria-hidden="true">
      <div class="flt-dialog__backdrop" data-share-close></div>
      <div class="flt-dialog__panel share-dialog__panel" role="dialog" aria-modal="true" aria-labelledby="shareTitle">
        <button type="button" class="flt-dialog__close" data-share-close aria-label={i18n.close}>&times;</button>
        <h3 class="flt-dialog__title" id="shareTitle">{i18n.shareDialogTitle}</h3>
        <p class="flt-dialog__sub share-dialog__sub">{i18n.shareDialogHint}</p>

        <div class="share-tabs" role="tablist" aria-label="Share destination">
          <button type="button" class="share-tab" data-share-tab="x" role="tab" aria-selected="false">X</button>
          <button type="button" class="share-tab" data-share-tab="linkedin" role="tab" aria-selected="false">LinkedIn</button>
          <button type="button" class="share-tab" data-share-tab="copy" role="tab" aria-selected="false">{i18n.copyLink}</button>
        </div>

        <div class="share-preview" data-share-panel="x" hidden>
          <div class="share-card share-card--x">
            <div class="share-card__img-wrap">
              {shareImage
                ? <img src={shareImage} alt="" class="share-card__img" loading="lazy" decoding="async" />
                : <div class="share-card__img share-card__img--ph" aria-hidden="true"></div>}
            </div>
            <div class="share-card__body">
              <div class="share-card__title">{d.title}</div>
              <div class="share-card__domain">{shareDomain}</div>
            </div>
          </div>
        </div>

        <div class="share-preview" data-share-panel="linkedin" hidden>
          <div class="share-card share-card--linkedin">
            <div class="share-card__img-wrap">
              {shareImage
                ? <img src={shareImage} alt="" class="share-card__img" loading="lazy" decoding="async" />
                : <div class="share-card__img share-card__img--ph" aria-hidden="true"></div>}
            </div>
            <div class="share-card__body">
              <div class="share-card__title">{d.title}</div>
              <div class="share-card__desc">{d.description}</div>
              <div class="share-card__domain">{shareDomain}</div>
            </div>
          </div>
        </div>

        <div class="share-preview" data-share-panel="copy" hidden>
          <div class="share-copy-row">
            <input type="text" class="share-copy-input" id="shareDialogUrl" readonly value={canonicalUrl} />
            <button type="button" class="share-copy-btn" id="shareDialogCopyBtn">{i18n.copy}</button>
          </div>
        </div>

        <a
          class="flt-dialog__apply share-dialog__go"
          id="shareDialogGo"
          href={shareX}
          target="_blank"
          rel="noopener"
          data-x-href={shareX}
          data-x-label={i18n.shareOnXGo}
          data-linkedin-href={shareLi}
          data-linkedin-label={i18n.shareOnLinkedInGo}
        >{i18n.shareOnXGo}</a>
      </div>
    </div>

    <KaiPost post={post} headings={headings} />

    <script src="../scripts/blog-client.js"></script>
  </body>
</html>
