      <section class="section certs" aria-labelledby="certs-h">
        <div class="wrap">
          <h2 id="certs-h">Certifications</h2>
          <ul>
            <li><a href="https://www.credly.com/users/samuelabhinav37">CompTIA Security+</a></li>
            <li><a href="https://www.credly.com/users/samuelabhinav37">CompTIA Network+</a></li>
            <li><a href="https://www.credly.com/users/samuelabhinav37">ISC2 Certified in Cybersecurity (CC)</a></li>
            <li><a href="https://www.credly.com/users/samuelabhinav37">ISC2 CCP</a></li>
