---
/**
 * PROTOTYPE — stored for future reference, not production code.
 * Snapshot of the leerob.com/conordewey.com/aakankshamirdha.com-inspired
 * minimalist redesign direction, iterated as a Claude Artifact across
 * several sessions (see docs/redesign-research.md for the design brief).
 * Kept here so the work is durable in git instead of only living on the
 * Artifact hosting link.
 *
 * Same dev-only / unlinked / noindex pattern as src/pages/tools/new-post.astro:
 * ships in full only in `astro dev`; `astro build` emits nothing real.
 * Not in sitemap.xml, not in robots.txt allow list, not linked from nav.
 *
 * Current state: single "stack" column layout (an earlier "rail" layout
 * and a live CISA-KEV dashboard column were both built then removed),
 * real blog titles pulled from src/content/blog frontmatter, 3 project
 * blurbs (Sentinel/Prism/Axon), certifications as a leerob-"Notes"-style
 * list, dark/light theme toggle, a "Kai" chat companion redesigned to
 * match her real body shape/colors from src/components/LunaEngine.astro,
 * and a `?ref=` recruiter fast-track banner demo (self-controlled entry
 * link, not visitor detection).
 *
 * When a direction is picked: fold the winner into src/pages/index.astro
 * properly (this markup/CSS is prototype-quality, not reusable as-is),
 * then delete this route.
 */
const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
{isDev ? (
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Samuel Abhinav</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500;600&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <style>
    /* Palette mirrors leerob.com: Tailwind gray/zinc ramps; hierarchy is
       carried by shade + weight + whitespace, not type size. */
    :root {
      --bg: #ffffff;
      --fg: #111827;        /* gray-900 */
      --fg-body: #1f2937;   /* gray-800 */
      --muted: #6b7280;     /* gray-500 */
      --hairline: #e5e7eb;  /* gray-200 */
      --hairline-strong: #d1d5db;
      --link: #3b82f6;      /* blue-500 */
      --link-hover: #1d4ed8;/* blue-700 */
      --prose-underline: none;

      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
      --font-word: 'Cormorant Garamond', Georgia, 'Times New Roman', serif;
    }

    @media (prefers-color-scheme: dark) {
      :root:not([data-theme="light"]) {
        --bg: #09090b;        /* zinc-950 */
        --fg: #e4e4e7;        /* zinc-200 */
        --fg-body: #d4d4d8;   /* zinc-300 */
        --muted: #6b7280;     /* gray-500 */
        --hairline: #27272a;  /* zinc-800 */
        --hairline-strong: #3f3f46;
        --link: #9ca3af;      /* gray-400 */
        --link-hover: #d1d5db;/* gray-300 */
        --prose-underline: underline;
      }
    }

    :root[data-theme="dark"] {
      --bg: #09090b;
      --fg: #e4e4e7;
      --fg-body: #d4d4d8;
      --muted: #6b7280;
      --hairline: #27272a;
      --hairline-strong: #3f3f46;
      --link: #9ca3af;
      --link-hover: #d1d5db;
      --prose-underline: underline;
    }

    *, *::before, *::after { box-sizing: border-box; }

    html {
      min-width: 360px;
      scrollbar-gutter: stable;
      -webkit-text-size-adjust: 100%;
    }
    @media (prefers-reduced-motion: no-preference) { html { scroll-behavior: smooth; } }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--fg-body);
      font-family: var(--font-sans);
      font-size: 1rem;
      line-height: 1.5;
      font-weight: 400;
      letter-spacing: -0.025em;
      text-rendering: optimizeLegibility;
      -webkit-font-smoothing: antialiased;
    }

    ::selection { background: rgba(59, 130, 246, 0.18); }

    .wrap { max-width: 60ch; margin-inline: auto; padding-inline: 2rem; }

    /* ─────────────── Shell ───────────────
       One settled layout: a centred column, a floating card nav sticky at
       the top. (Earlier rail/stack layout options and the aside dashboard
       column have been retired — this is the chosen version.) */
    .nav { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
    .wordmark {
      font-family: var(--font-word); font-weight: 500; font-size: 1.3rem;
      letter-spacing: 0.01em; line-height: 1; color: var(--fg);
      text-decoration: none; white-space: nowrap;
    }
    .wordmark:hover { opacity: 0.75; }
    .nav-right { display: flex; align-items: center; gap: 0.35rem; }
    .blog-link {
      color: var(--muted); text-decoration: none;
      font-size: 0.8125rem; font-weight: 500; padding: 0.4rem 0.7rem; border-radius: 6px;
    }
    .blog-link:hover { color: var(--fg); }
    .blog-link[aria-current="page"] { color: var(--fg); background: var(--hairline); }
    .theme-toggle {
      flex: none; width: 1.9rem; height: 1.9rem; display: grid; place-items: center;
      background: transparent; border: 1px solid var(--hairline); border-radius: 6px;
      color: var(--muted); cursor: pointer; padding: 0;
      transition: color 0.15s, border-color 0.15s;
    }
    .theme-toggle:hover { color: var(--fg); border-color: var(--hairline-strong); }
    .theme-toggle:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }
    .theme-toggle svg { width: 15px; height: 15px; display: block; }

    .nav-outer {
      position: sticky; top: 0; z-index: 20;
      display: flex; justify-content: center; padding: 0.8rem 2rem; pointer-events: none;
    }
    .nav {
      pointer-events: auto; width: 100%; max-width: 60ch;
      padding: 0.4rem 0.5rem 0.4rem 1rem;
      background: var(--bg); border: 1px solid var(--hairline); border-radius: 8px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.05), 0 8px 22px -12px rgba(0,0,0,0.18);
    }

    main { padding-top: 1.25rem; }

    /* ── Recruiter fast-track — a self-controlled entry point, not
       auto-detection (there's no reliable "this visitor is a recruiter"
       signal). Only appears when the URL itself asks for it: a link you'd
       place on your résumé/LinkedIn, e.g. samuelabhinav.com/?ref=resume.
       Anyone else never sees it. ── */
    .recruit-banner {
      margin: 0 0 2rem; padding: 0.9rem 1.1rem; border-radius: 10px;
      border: 1px solid var(--hairline-strong);
      background: color-mix(in srgb, var(--link) 6%, var(--bg));
    }
    .recruit-banner p { margin: 0 0 0.65rem; font-size: 0.9rem; }
    .recruit-banner p b { color: var(--fg); }
    .recruit-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
    .recruit-chip {
      font-size: 0.8125rem; font-weight: 500; text-decoration: none;
      padding: 0.3rem 0.7rem; border-radius: 999px;
      border: 1px solid var(--hairline-strong); color: var(--fg);
    }
    .recruit-chip:hover { border-color: var(--link); color: var(--link); }
    .recruit-dismiss {
      margin-left: auto; font: inherit; font-size: 0.75rem; color: var(--muted);
      background: none; border: 0; cursor: pointer; text-decoration: underline;
      text-underline-offset: 2px;
    }
    .recruit-dismiss:hover { color: var(--fg); }
    .view > .section + .section { margin-top: 3rem; }
    @media (prefers-reduced-motion: no-preference) {
      .view { animation: fade 0.16s ease both; }
      @keyframes fade { from { opacity: 0; } to { opacity: 1; } }
    }

    h1, h2, h3 { text-wrap: balance; }

    /* One true page title */
    h1 { font-size: 1.5rem; font-weight: 600; color: var(--fg); margin: 0 0 0.6rem; letter-spacing: -0.02em; }

    /* Section markers — quiet labels: smaller, semibold, muted */
    h2 {
      font-size: 0.9375rem; font-weight: 600; color: var(--muted);
      letter-spacing: 0.01em; margin: 0 0 0.85rem;
    }

    /* Block titles (project names) — full strength, the "loudest" body-level thing */
    h3 { font-size: 1rem; font-weight: 600; color: var(--fg); margin: 0 0 0.35rem; }

    p { margin: 0; color: var(--fg-body); line-height: 1.5; }
    p + p { margin-top: 1rem; }

    .bio a, .project p a, .writing-more a {
      color: var(--link);
      text-decoration-line: var(--prose-underline);
      text-underline-offset: 2px; text-decoration-color: var(--hairline-strong);
    }
    .bio a:hover, .project p a:hover { color: var(--link-hover); }
    a:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; border-radius: 2px; }

    /* ─────────────── Bio + socials ─────────────── */
    .bio p { max-width: 62ch; }
    .socials {
      margin-top: 1.4rem;
      display: flex; align-items: center; gap: 1.1rem; flex-wrap: wrap;
    }
    .socials a { color: var(--muted); display: inline-flex; align-items: center; transition: color 0.15s; }
    .socials a:hover { color: var(--fg); }
    .socials svg { width: 18px; height: 18px; fill: currentColor; display: block; }
    .socials .resume { font-size: 0.8125rem; font-weight: 500; text-decoration: none; color: var(--muted); }
    .socials .resume:hover { color: var(--fg); }

    /* ─────────────── Projects ─────────────── */
    .work { display: flex; flex-direction: column; gap: 1.75rem; }
    .project p { max-width: 62ch; }
    .project .num { font-variant-numeric: tabular-nums; }

    /* ─────────────── Kai — matches the real companion's actual body ───────────────
       The real widget (src/components/LunaEngine.astro) draws her as a dark
       CRT-shell rounded-square body (bodyPath: 66x60, r15 — a squircle, not a
       circle) with a lit inset "screen" and a cool moon-glow aura behind her
       in her default night costume. */
    .kai-mark { display: inline-grid; place-items: center; width: 18px; height: 18px; flex: none; }
    .k-kai {
      position: relative; width: 100%; height: 100%;
      border-radius: 27%; /* ratio of LunaEngine's bodyPath(-33,-30,66,60,15) */
      background: linear-gradient(180deg, #1b1d25 0%, #0b0c11 100%);
      box-shadow: inset 0 0 0 1px rgba(208, 216, 228, 0.4);
    }
    .k-kai::before { /* top-left highlight, same stop as LunaEngine's body `hl` gradient */
      content: ''; position: absolute; inset: 0; border-radius: inherit;
      background: radial-gradient(circle at 32% 26%, rgba(200, 216, 244, 0.4), transparent 60%);
    }
    .k-kai::after { /* her screen: same base #06060f + cool glow as the real `sg` gradient */
      content: ''; position: absolute; left: 21%; top: 24%; width: 58%; height: 48%;
      border-radius: 32%; background: #06060f;
      background-image: radial-gradient(circle at 50% 42%, rgba(150, 164, 190, 0.85), rgba(6, 6, 15, 0.9) 72%);
      box-shadow: 0 0 3px rgba(140, 175, 230, 0.55);
    }
    @media (prefers-reduced-motion: no-preference) {
      .k-kai { animation: kaiGlow 2.6s ease-in-out infinite; }
      @keyframes kaiGlow {
        0%, 100% { box-shadow: inset 0 0 0 1px rgba(208,216,228,0.4), 0 0 0 0 rgba(188, 197, 214, 0.5); }
        55% { box-shadow: inset 0 0 0 1px rgba(208,216,228,0.4), 0 0 0 4px rgba(188, 197, 214, 0); }
      }
    }

    .kai-pill {
      position: fixed; right: 14px; bottom: 14px; z-index: 60;
      display: inline-flex; align-items: center; gap: 8px;
      padding: 7px 13px 7px 9px; border-radius: 999px;
      background: var(--bg); border: 1px solid var(--hairline-strong);
      box-shadow: 0 4px 16px -6px rgba(0,0,0,0.25);
      font: inherit; font-size: 0.8125rem; font-weight: 500; color: var(--fg);
      cursor: pointer; transition: transform 0.12s ease;
    }
    .kai-pill:hover { transform: translateY(-1px); }
    .kai-pill:focus-visible { outline: 2px solid var(--link); outline-offset: 2px; }

    .kai-panel {
      position: fixed; right: 14px; bottom: 60px; z-index: 61;
      width: min(19rem, calc(100vw - 24px));
      background: var(--bg); border: 1px solid var(--hairline-strong);
      border-radius: 14px; box-shadow: 0 18px 44px -18px rgba(0,0,0,0.4);
      overflow: hidden;
    }
    @media (prefers-reduced-motion: no-preference) {
      .kai-panel { animation: kaiIn 0.14s ease both; }
      @keyframes kaiIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }
    }
    .kai-head {
      display: flex; align-items: center; gap: 9px;
      padding: 12px 14px; border-bottom: 1px solid var(--hairline);
    }
    .kai-head .kai-mark { width: 22px; height: 22px; }
    .kai-head b { font-size: 0.875rem; font-weight: 600; color: var(--fg); }
    .kai-head span { font-size: 0.75rem; color: var(--muted); }
    .kai-log {
      display: flex; flex-direction: column; gap: 8px;
      padding: 12px 14px; max-height: 15rem; overflow-y: auto;
    }
    .kai-msg { font-size: 0.8125rem; line-height: 1.45; max-width: 90%; }
    .kai-msg.kai-bot { color: var(--fg-body); }
    .kai-msg.kai-you { align-self: flex-end; color: var(--muted); }
    .kai-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 14px 12px; }
    .kai-chip {
      font: inherit; font-size: 0.75rem; color: var(--muted); cursor: pointer;
      padding: 5px 11px; border-radius: 999px;
      border: 1px solid var(--hairline-strong); background: var(--bg);
    }
    .kai-chip:hover { color: var(--fg); border-color: var(--muted); }
    .kai-form { display: flex; gap: 6px; padding: 10px 12px; border-top: 1px solid var(--hairline); }
    .kai-form input {
      flex: 1; min-width: 0; font: inherit; font-size: 0.8125rem;
      padding: 7px 10px; border-radius: 8px;
      border: 1px solid var(--hairline-strong); background: var(--bg); color: var(--fg);
    }
    .kai-form input:focus-visible { outline: 2px solid var(--link); outline-offset: 1px; }
    .kai-form button {
      font: inherit; font-size: 0.8125rem; font-weight: 500;
      padding: 7px 12px; border-radius: 8px; cursor: pointer;
      border: 1px solid var(--hairline-strong); background: var(--bg); color: var(--fg);
    }
    .kai-form button:hover { border-color: var(--muted); }

    /* ─────────────── Blog list ─────────────── */
    .posts { display: flex; flex-direction: column; }
    .year-label {
      font-size: 0.8125rem; color: var(--muted); margin: 1.5rem 0 0.35rem;
      font-variant-numeric: tabular-nums;
    }
    .posts .year-label:first-child { margin-top: 0; }
    .post {
      display: flex; align-items: baseline; justify-content: space-between;
      gap: 0.4rem 1.25rem; flex-wrap: wrap;
      padding: 0.62rem 0; border-top: 1px solid var(--hairline);
      text-decoration: none; color: var(--fg-body);
    }
    .post:last-child { border-bottom: 1px solid var(--hairline); }
    .post-title { line-height: 1.4; }
    .post:hover .post-title { color: var(--link-hover); }
    .post-meta {
      display: flex; align-items: baseline; gap: 0.7rem;
      font-size: 0.8125rem; color: var(--muted); white-space: nowrap;
    }
    .post-date { font-variant-numeric: tabular-nums; }
    .writing-more { margin-top: 1rem; font-size: 0.875rem; }

    /* ─────────────── Certifications — leerob "Notes" list ───────────────
       Two columns, small square bullets, muted link colour — same device
       his Notes section uses, not a plain single-column bulleted list. */
    .certs ul {
      margin: 0; padding: 0; list-style: none;
      display: grid; grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.5rem 2rem;
    }
    .certs li { position: relative; padding-left: 1.05rem; color: var(--fg-body); }
    .certs li::before {
      content: ''; position: absolute; left: 0; top: 0.5em;
      width: 6px; height: 6px; background: var(--muted);
    }
    .certs a { color: var(--link); text-decoration: none; text-underline-offset: 2px; }
    .certs a:hover { color: var(--link-hover); text-decoration: underline; }
    @media (max-width: 30rem) {
      .certs ul { grid-template-columns: 1fr; }
    }

    /* ─────────────── Footer ─────────────── */
    footer { margin-top: 3.5rem; padding: 2.5rem 2rem 3rem; }
    footer p {
      text-align: center; font-size: 0.8125rem; color: var(--muted);
      max-width: 60ch; margin-inline: auto;
    }
    footer p + p { margin-top: 0.5rem; }

    @media (max-width: 30rem) {
      /* narrow phones (~iPhone SE/mini and up): less side margin, not more —
         matches the "mobile just gets more content, same layout" principle,
         and gives the nav card's flex row (wordmark + Blog + toggle) enough
         room that it can't overflow past the card's rounded edge. */
      .wrap { padding-inline: 1.25rem; }
      .nav-outer { padding-inline: 0.75rem; }
      .nav { padding-inline: 0.6rem 0.4rem; }
      .nav-right { gap: 0.15rem; }
      .blog-link { padding-inline: 0.5rem; }
      .wordmark { font-size: 1.15rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
    }
  </style>
</head>
) : null}
{isDev ? (
<body>
  <div class="shell">
  <div class="nav-outer">
    <div class="nav">
      <a href="#" class="wordmark" data-nav-home>Samuel Abhinav</a>
      <div class="nav-right">
        <a href="#blog" class="blog-link" data-nav-blog>Blog</a>
        <button type="button" class="theme-toggle" aria-label="Toggle dark mode">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-sun>
            <circle cx="12" cy="12" r="4"></circle>
            <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
          </svg>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-moon>
            <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <main>
    <!-- ══════════ HOME ══════════ -->
    <div class="view" id="view-home">
      <div class="recruit-banner" id="recruit-banner" hidden>
        <div class="wrap">
          <p>Fast track — <b>Security Engineer</b>, open to detection / platform-security roles.</p>
          <div class="recruit-chips">
            <a class="recruit-chip" href="#s-sentinel">Sentinel</a>
            <a class="recruit-chip" href="#s-prism">Prism</a>
            <a class="recruit-chip" href="#s-axon">Axon</a>
            <a class="recruit-chip" href="#certs-h">Certifications</a>
            <a class="recruit-chip" href="https://samuelabhinav.com/resume.pdf">Résumé</a>
            <a class="recruit-chip" href="#bio">Contact</a>
            <button type="button" class="recruit-dismiss" id="recruit-dismiss">Not a recruiter? Dismiss</button>
          </div>
        </div>
      </div>
      <section class="section bio" id="bio">
        <div class="wrap">
          <p>I&rsquo;m a security engineer working on detection and response. I turn raw telemetry into alerts a tired analyst can act on at 3am, with side work in OT/ICS anomaly detection and risk-adaptive authentication. I hold an M.S. in Cybersecurity and a handful of certs.</p>
          <p>I also write a running series that reads present-day security problems through historical analogy: siege logistics, signals intelligence, insurance markets, and what they predict about the systems we build now. I&rsquo;m looking for a team that reads its own logs.</p>

          <div class="socials">
            <a href="https://github.com/Samuelabhinav37" aria-label="GitHub">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .5C5.37.5 0 5.78 0 12.29c0 5.2 3.44 9.6 8.21 11.16.6.11.82-.25.82-.56 0-.28-.01-1.02-.02-2-3.34.71-4.04-1.58-4.04-1.58-.55-1.37-1.34-1.74-1.34-1.74-1.09-.73.08-.72.08-.72 1.2.08 1.84 1.21 1.84 1.21 1.07 1.8 2.81 1.28 3.5.98.11-.76.42-1.28.76-1.57-2.67-.3-5.47-1.31-5.47-5.83 0-1.29.47-2.34 1.24-3.17-.12-.3-.54-1.52.12-3.16 0 0 1.01-.32 3.3 1.21a11.6 11.6 0 0 1 6.01 0c2.29-1.53 3.3-1.21 3.3-1.21.66 1.64.24 2.86.12 3.16.77.83 1.24 1.88 1.24 3.17 0 4.53-2.81 5.53-5.49 5.82.43.36.81 1.08.81 2.18 0 1.57-.01 2.84-.01 3.23 0 .31.22.68.83.56A12.02 12.02 0 0 0 24 12.29C24 5.78 18.63.5 12 .5z"/></svg>
            </a>
            <a href="https://www.linkedin.com/in/samuelabhinav" aria-label="LinkedIn">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.63-1.85 3.36-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.72V1.72C24 .77 23.2 0 22.22 0z"/></svg>
            </a>
            <a href="https://x.com/" aria-label="X">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 1.15h3.68l-8.04 9.19L24 22.85h-7.41l-5.8-7.58-6.64 7.58H.46l8.6-9.83L0 1.15h7.59l5.24 6.93 6.07-6.93zm-1.29 19.5h2.04L6.49 3.24H4.3l13.31 17.41z"/></svg>
            </a>
            <a href="https://samuelabhinav.com/contact" aria-label="Email">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm1 2.24V17h16V7.24l-8 5.2-8-5.2zM4.5 6l7.5 4.88L19.5 6h-15z"/></svg>
            </a>
            <a href="https://samuelabhinav.com/resume.pdf" class="resume">résumé</a>
