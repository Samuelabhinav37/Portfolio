  </main>
  </div><!-- /.shell -->

  <footer>
    <p>Prototype. Titles/dates are the real blog series; handles and some links are placeholders.</p>
  </footer>

  <button type="button" class="kai-pill" aria-expanded="false" aria-controls="kai-panel">
    <span class="kai-mark" aria-hidden="true"><span class="k-kai"></span></span>
    <span>Ask Kai</span>
  </button>
  <div class="kai-panel" id="kai-panel" role="dialog" aria-label="Kai" hidden></div>

  <script is:inline>
    (function () {
      var root = document.documentElement;

      /* ── Favicon: reuse the real site's constellation mark ── */
      try {
        var favSvg = "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'>"
          + "<rect width='32' height='32' rx='7' fill='#0b0f1a'/>"
          + "<g stroke='#7f8ba8' stroke-width='1.6' stroke-linecap='round'>"
          + "<line x1='23' y1='8' x2='15' y2='16'/><line x1='15' y1='16' x2='12' y2='25'/>"
          + "<line x1='15' y1='16' x2='7' y2='12'/></g>"
          + "<circle cx='23' cy='8' r='3' fill='#e2ebfd'/>"
          + "<circle cx='15' cy='16' r='2.4' fill='#c6d1e8'/>"
          + "<circle cx='12' cy='25' r='1.7' fill='#9aa6c2'/>"
          + "<circle cx='7' cy='12' r='1.7' fill='#9aa6c2'/></svg>";
        document.querySelectorAll("link[rel~='icon']").forEach(function (l) { l.remove(); });
        var fav = document.createElement('link');
        fav.rel = 'icon'; fav.type = 'image/svg+xml';
        fav.href = 'data:image/svg+xml,' + encodeURIComponent(favSvg);
        document.head.appendChild(fav);
      } catch (e) {}

      /* ── Theme ── */
      var sun = document.querySelector('[data-sun]');
      var moon = document.querySelector('[data-moon]');
      var btn = document.querySelector('.theme-toggle');
      var stored = null;
      try { stored = localStorage.getItem('theme'); } catch (e) {}
      if (stored === 'light' || stored === 'dark') root.setAttribute('data-theme', stored);
      function effective() {
        var t = root.getAttribute('data-theme');
        if (t) return t;
        return matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
      function paintToggle() {
        var dark = effective() === 'dark';
        sun.hidden = !dark; moon.hidden = dark;
      }
      paintToggle();
      btn.addEventListener('click', function () {
        var next = effective() === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('theme', next); } catch (e) {}
        paintToggle();
      });

      /* ── Recruiter fast-track banner — appears only when the URL itself
         carries a ?ref= param (any value; try it with ?ref=resume), which
         only happens if you clicked a link you placed yourself. Nothing
         about the visitor is inspected or guessed. ── */
      (function () {
        var params = new URLSearchParams(location.search);
        var banner = document.getElementById('recruit-banner');
        if (!params.has('ref')) return;
        var dismissed = false;
        try { dismissed = sessionStorage.getItem('recruitDismissed') === '1'; } catch (e) {}
        if (dismissed) return;
        banner.hidden = false;
        document.getElementById('recruit-dismiss').addEventListener('click', function () {
          banner.hidden = true;
          try { sessionStorage.setItem('recruitDismissed', '1'); } catch (e) {}
        });
      })();

      /* ── Real blog data — the actual "Analog Dawn" series + the one
         Threat Intel post, pulled from src/content/blog frontmatter
         (title/category/pubDate), newest first. ── */
      var POSTS = [
        { t: 'Floppy Disk Cold', c: 'Security Fundamentals', d: 'Oct 2026', y: 2026 },
        { t: 'Medieval Firewall', c: 'Security Fundamentals', d: 'Oct 2026', y: 2026 },
        { t: 'Two-Key Lock (Public-Key Cryptography)', c: 'Security Fundamentals', d: 'Oct 2026', y: 2026 },
        { t: 'Digital Handshake (SSL/TLS)', c: 'Security Fundamentals', d: 'Sep 2026', y: 2026 },
        { t: 'Adding Salt to the Recipe', c: 'Security Fundamentals', d: 'Sep 2026', y: 2026 },
        { t: 'Dictionary Attack & Rainbow Tables', c: 'Security Fundamentals', d: 'Sep 2026', y: 2026 },
        { t: 'One-Way Math Machine (Hashing)', c: 'Security Fundamentals', d: 'Sep 2026', y: 2026 },
        { t: 'Cleartext Catastrophes', c: 'Security Fundamentals', d: 'Aug 2026', y: 2026 },
        { t: 'First Password (MIT, 1961)', c: 'Security Fundamentals', d: 'Aug 2026', y: 2026 },
        { t: 'Wax Seal and the Signet Ring', c: 'Security Fundamentals', d: 'Aug 2026', y: 2026 },
        { t: 'Anatomy of a supply chain attack', c: 'Threat Intel', d: 'Apr 2026', y: 2026 }
      ];
      function row(p) {
        var a = document.createElement('a');
        a.className = 'post';
        a.href = 'https://samuelabhinav.com/blog';
        a.innerHTML =
          '<span class="post-title">' + p.t + '</span>' +
          '<span class="post-meta"><span class="post-cat">' + p.c + '</span>' +
          '<span class="post-date">' + p.d + '</span></span>';
        return a;
      }
      var recent = document.querySelector('[data-recent]');
      POSTS.slice(0, 4).forEach(function (p) { recent.appendChild(row(p)); });
      var all = document.querySelector('[data-all]');
      var lastYear = null;
      POSTS.forEach(function (p) {
        if (p.y !== lastYear) {
          var y = document.createElement('div');
          y.className = 'year-label'; y.textContent = p.y;
          all.appendChild(y); lastYear = p.y;
        }
        all.appendChild(row(p));
      });

      /* ── Kai: friendly, orb, and deferred (nothing builds until you ask) ── */
      (function () {
        var MARK = '<span class="kai-mark" aria-hidden="true"><span class="k-kai"></span></span>';

        var pill = document.querySelector('.kai-pill');
        var panel = document.getElementById('kai-panel');
        var built = false, log;

        // Ordered most-specific-first, since the first category with any
        // keyword hit wins — a question naming a project should get that
        // project's answer, not the generic "work" blurb.
        var ANSWERS = [
          [['sentinel'],
            'Sentinel runs Wazuh, Splunk, and Security Onion in parallel with Shuffle for SOAR and a local LLM doing first-pass triage. Took MITRE ATT&CK coverage from 9 techniques to 15.'],
          [['prism'],
            'Prism does federated anomaly detection for OT/ICS — a temporal VAE learns each site’s baseline and only masked model weights leave the plant. False positives stayed under 8% across 7 simulated sites.'],
          [['axon'],
            'Axon is risk-adaptive authentication: every attempt gets a live risk score from device, location, and behavior. Low risk passes silently, high risk gets a NIST 800-63B step-up.'],
          [['cert', 'certif', 'credential'],
            'Six so far: CompTIA Security+ and Network+, ISC2 CC and CCP, Azure Fundamentals (AZ-900), and Hack The Box CJCA. Listed near the bottom of the page.'],
          [['resume', 'résumé', 'cv'],
            'There’s a résumé link right next to the bio, top of the page.'],
          [['hire', 'available', 'job', 'role', 'opportunit', 'contact', 'email', 'reach', 'get in touch'],
            'Yes, looking for a detection or platform-security team. The fastest way in is the email icon near the top.'],
          [['blog', 'writ', 'post', 'article'],
            'Security problems read through historical analogy. The four newest are on the home page; the full list is under Blog.'],
          [['project', 'work on', 'build', 'do for work'],
            'Detection and response, mostly, plus OT/ICS anomaly detection and adaptive auth. The three projects above (Sentinel, Prism, Axon) go into detail.'],
          [['hi', 'hello', 'hey', 'sup'],
            'Hey! Ask me about the projects, the blog, certifications, or how to reach Samuel.'],
          [['who', 'kai', 'what are you'],
            'I’m Kai, a small guide to this site. I only know what’s on it.']
        ];
        function hasKeyword(q, kw) {
          // whole-word/phrase match (not raw substring) — otherwise short
          // keywords like "do" false-positive inside unrelated words
          // ("seldom" contains "do").
          return new RegExp('(^|[^a-z])' + kw.trim().replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '([^a-z]|$)', 'i').test(q);
        }
        function answer(q) {
          for (var i = 0; i < ANSWERS.length; i++)
            for (var j = 0; j < ANSWERS[i][0].length; j++)
              if (hasKeyword(q, ANSWERS[i][0][j])) return ANSWERS[i][1];
          return 'I only know this site. Try asking about a project by name (Sentinel, Prism, Axon), the blog, certifications, or how to get in touch.';
        }
        function add(cls, text) {
          var d = document.createElement('div');
          d.className = 'kai-msg ' + cls;
          d.textContent = text;
          log.appendChild(d);
          log.scrollTop = log.scrollHeight;
        }
        // The three topics her own greeting names — surfaced as one-tap
        // chips instead of making a visitor type them out.
        var STARTERS = ['What do you work on?', 'What’s the blog about?', 'How do I reach you?'];

        function ask(q) {
          add('kai-you', q);
          setTimeout(function () { add('kai-bot', answer(q)); }, 160);
        }
        function build() {
          panel.innerHTML =
            '<div class="kai-head">' + MARK +
            '<b>Kai</b><span>ask about this site</span></div>' +
            '<div class="kai-log"></div>' +
            '<div class="kai-chips"></div>' +
            '<form class="kai-form"><input type="text" aria-label="Ask Kai" ' +
            'placeholder="What does Samuel work on?" autocomplete="off"><button type="submit">Ask</button></form>';
          log = panel.querySelector('.kai-log');
          add('kai-bot', 'Hi, I’m Kai. Ask me what Samuel works on, what the blog covers, or how to reach him.');
          var chips = panel.querySelector('.kai-chips');
          STARTERS.forEach(function (q) {
            var b = document.createElement('button');
            b.type = 'button'; b.className = 'kai-chip'; b.textContent = q;
            b.addEventListener('click', function () { chips.remove(); ask(q); });
            chips.appendChild(b);
          });
          var form = panel.querySelector('.kai-form');
          var input = form.querySelector('input');
          form.addEventListener('submit', function (e) {
            e.preventDefault();
            var q = input.value.trim();
            if (!q) return;
            if (chips.isConnected) chips.remove();
            input.value = '';
            ask(q);
          });
          built = true;
          return input;
        }
        function open() {
          var input = built ? panel.querySelector('input') : build();
          panel.hidden = false;
          pill.setAttribute('aria-expanded', 'true');
          setTimeout(function () { input.focus(); }, 20);
        }
        function close() {
          panel.hidden = true;
          pill.setAttribute('aria-expanded', 'false');
        }
        pill.addEventListener('click', function () {
          panel.hidden ? open() : close();
        });
        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape' && !panel.hidden) { close(); pill.focus(); }
        });
        document.addEventListener('click', function (e) {
          if (!panel.hidden && !panel.contains(e.target) && !pill.contains(e.target)) close();
        });
      })();

      /* ── Hash router: #blog swaps the view ── */
      var home = document.getElementById('view-home');
      var blog = document.getElementById('view-blog');
      var navBlog = document.querySelector('[data-nav-blog]');
      function render() {
        var h = location.hash;
        var onBlog = h === '#blog';
        blog.hidden = !onBlog;
        home.hidden = onBlog;
        if (onBlog) navBlog.setAttribute('aria-current', 'page');
        else navBlog.removeAttribute('aria-current');
        if (onBlog) {
          window.scrollTo(0, 0);
        } else if (h && h.length > 1) {
          var el = home.querySelector(h);
          if (el) el.scrollIntoView({ block: 'start' });
          else window.scrollTo(0, 0);
        }
      }
      addEventListener('hashchange', render);
      document.querySelector('[data-nav-home]').addEventListener('click', function (e) {
        if (location.hash === '#blog') {
          e.preventDefault();
          history.replaceState(null, '', location.pathname + location.search);
          render();
        }
      });
      render();
    })();
  </script>
</body>
) : (
<body>
  <p>Not available in production.</p>
</body>
)}
</html>
