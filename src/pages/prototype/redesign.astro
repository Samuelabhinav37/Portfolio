    <!-- ══════════ BLOG ══════════ -->
    <div class="view" id="view-blog" hidden>
      <section class="section">
        <div class="wrap">
          <h1>Blog</h1>
          <p style="max-width:62ch;margin:0 0 1.5rem;color:var(--muted)">
            Present-day security problems, read through historical analogy.
