---
/* Served by Cloudflare Pages for any missing route. Kai is lost too, so it runs. */
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex">
<title>404 · Signal Lost · Samuel Abhinav</title>
<link href="/fonts/fonts.css" rel="stylesheet">
<style is:global>
  /* Same fixed-corner wordmark as every other page (SiteMenu.astro). */
  .wordmark{ position:fixed; top:14px; left:28px; z-index:10; font-family:'Cormorant Garamond',serif; font-weight:500; font-size:1.5rem; line-height:1; letter-spacing:.01em; color:rgba(255,255,255,.9); text-decoration:none; }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ min-height:100%; }
  body{
    background:#030307; color:rgba(205,214,226,0.92);
    font-family:'JetBrains Mono', monospace;
    display:flex; align-items:center; justify-content:center;
    text-align:center; padding:72px 16px 40px; min-height:100vh;
  }
  /* the same night sky, grain and vignette as About */
  .sky{ position:fixed; inset:0; z-index:0; pointer-events:none;
    background:url(/images/paint/stars-tile.webp) 0 0 / 1024px, url(/images/paint/wash-tile.webp) 0 0 / 1024px; }
  /* torn patches of the sky with glyph static behind them (after aura.build/404), drawn by the script below */
  .tears{ position:fixed; inset:0; z-index:0; pointer-events:none; width:100%; height:100%; }
  .grain{ position:fixed; inset:0; z-index:2147483000; pointer-events:none; }
  .grain::before{ content:""; position:absolute; inset:0; background:radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(2,4,12,.55) 100%); }
  .grain::after{ content:""; position:absolute; inset:0; background:url(/images/grain.webp) repeat; opacity:.06; }
  .wrap{ position:relative; z-index:1; width:100%; max-width:720px; }
  .sr{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }

  /* "404" in a calligraphy hand: each numeral is inked as an outline first, then fills, one after another */
  .ink{ display:block; width:min(440px, 86vw); height:auto; margin:0 auto -6px; overflow:visible; }
  .ink text{ font-family:'Pinyon Script', cursive; font-size:150px; fill:url(#ink-fill); stroke:#e9eef8; stroke-width:.9;
    stroke-dasharray:900; stroke-dashoffset:900; fill-opacity:0;
    animation:inkLine 2.2s cubic-bezier(.6,.05,.3,1) forwards, inkFill 1.2s ease forwards; }
  .ink text:nth-of-type(1){ animation-delay:.2s, 1.4s; }
  .ink text:nth-of-type(2){ animation-delay:.9s, 2.1s; }
  .ink text:nth-of-type(3){ animation-delay:1.6s, 2.8s; }
  @keyframes inkLine{ to{ stroke-dashoffset:0; } }
  @keyframes inkFill{ to{ fill-opacity:1; stroke-opacity:.25; } }
  .ink-glow{ filter:drop-shadow(0 0 18px rgba(150,180,235,.25)); }
  @media (prefers-reduced-motion: reduce){ .ink text{ animation:none; stroke-dashoffset:0; fill-opacity:1; stroke-opacity:.25; } }

  .status{ font-size:0.74rem; letter-spacing:0.35em; text-transform:uppercase; color:rgba(160,172,190,0.75); }
  .msg{ margin-top:0.8rem; font:400 0.95rem/1.5 'Inter Tight', -apple-system, 'Segoe UI', sans-serif; color:rgba(190,200,216,0.75); }

  /* the runner: Kai jumps the corrupted blocks while it looks for the page */
  .run{ position:relative; margin:2rem auto 0; border:1px solid rgba(205,214,226,0.12); border-radius:6px; background:rgba(4,6,12,.55);
    -webkit-backdrop-filter:blur(3px); backdrop-filter:blur(3px); }
  .run canvas{ display:block; width:100%; height:200px; cursor:pointer; touch-action:manipulation; }
  .run canvas:focus-visible{ outline:1px solid rgba(150,180,235,.6); outline-offset:3px; border-radius:6px; }
  .keys{ margin-top:.7rem; font-size:0.7rem; letter-spacing:.08em; color:rgba(120,132,150,0.75); }
  .keys kbd{ font:inherit; padding:1px 5px; border:1px solid rgba(205,214,226,0.18); border-radius:3px; color:rgba(200,210,226,.8); }

  .home{
    display:inline-block; margin-top:1.6rem; padding:0.7rem 1.4rem;
    font-size:0.78rem; letter-spacing:0.12em; text-transform:uppercase; text-decoration:none;
    color:rgba(220,228,240,0.9); border:1px solid rgba(205,214,226,0.18); border-radius:2px;
    transition:border-color .2s ease, background .2s ease;
  }
  .home:hover{ border-color:rgba(205,214,226,0.4); background:rgba(205,214,226,0.05); }
  @media (max-width:600px){ .run canvas{ height:170px; } .keys .desk{ display:none; } }
  @media (hover:none){ .keys .desk{ display:none; } }
  @media (hover:hover){ .keys .tap{ display:none; } }
</style>
</head>
<body>
  <div class="sky" aria-hidden="true"></div>
  <canvas class="tears" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <a class="wordmark" href="/">Samuel Abhinav</a>
  <main class="wrap">
    <h1 class="sr">404, page not found</h1>
    <svg class="ink ink-glow" viewBox="0 0 440 170" aria-hidden="true">
      <defs>
        <linearGradient id="ink-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f4f6fa"/><stop offset="1" stop-color="#9fb2d6"/>
        </linearGradient>
      </defs>
      <text x="40" y="130">4</text><text x="160" y="130">0</text><text x="280" y="130">4</text>
    </svg>
    <div class="status">signal lost</div>
    <p class="msg">That page isn't in my memory. It may have moved, or it never existed.</p>

    <div class="run">
      <canvas id="runner" tabindex="0" aria-label="Kai's runner game. Press space or tap to jump, down arrow to duck."></canvas>
    </div>
    <p class="keys"><span class="desk"><kbd>Space</kbd> jump · <kbd>↓</kbd> duck</span><span class="tap">Tap to jump</span></p>

    <a class="home" href="/">return to base</a>
  </main>

<script is:inline>
/* Torn sky, after aura.build/404: there the whole screen is a field of dim monospace
   glyphs and a few swap every second. Here the night sky stays, and only a few
   patches of it are missing, showing that glyph field through ragged holes. A patch
   moves now and then with a flicker, and a thin tear crosses the screen once in a
   while. Repaints about once a second (fast only while something flickers). */
(function(){
  var cv=document.querySelector('.tears');
  if(!cv || !cv.getContext) return;
  var x=cv.getContext('2d'), CW=10, CH=18, W=0, H=0, dpr=1;
  var GLYPHS='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!#$%&*+-=<>[]{}()/\\:;_@?';
  var TONES=['#2a2f3b','#323846','#3a4150','#444c5e','#76829c','#8a96b0'];
  var still=matchMedia('(prefers-reduced-motion: reduce)').matches;
  var patches=[], tear=null, flick=0;
  function rnd(n){ return Math.random()*n|0; }
  function cell(){ return { g:GLYPHS[rnd(GLYPHS.length)], c:TONES[Math.random()<.2 ? 4+rnd(2) : rnd(4)] }; }
  // a patch: a block of cells with a ragged edge, kept to the sides so the text stays clear
  function patch(){
    var cols=5+rnd(11), rows=2+rnd(4), side=Math.random()<.5;
    var maxC=Math.floor(W/CW), maxR=Math.floor(H/CH);
    var band=W>760 ? Math.floor(maxC*.3) : maxC;
    var c0=side ? rnd(Math.max(1, band-cols)) : maxC-cols-rnd(Math.max(1, band-cols));
    var p={ c0:Math.max(0,c0), r0:rnd(Math.max(1, maxR-rows)), cols:cols, rows:rows, cells:[] };
    for(var r=0;r<rows;r++) for(var c=0;c<cols;c++){
      var edge=r===0||c===0||r===rows-1||c===cols-1;
      if(edge ? Math.random()<.45 : Math.random()<.08) continue;
      var e=cell(); e.r=r; e.k=c; p.cells.push(e);
    }
    return p;
  }
  function size(){
    dpr=Math.min(devicePixelRatio||1, 2); W=innerWidth; H=innerHeight;
    cv.width=W*dpr; cv.height=H*dpr; x.setTransform(dpr,0,0,dpr,0,0);
    x.font='15px "JetBrains Mono", monospace'; x.textBaseline='top';
    patches=[]; for(var i=0;i<(W>760?5:3);i++) patches.push(patch());
  }
  function draw(){
    x.clearRect(0,0,W,H);
    patches.forEach(function(p, i){
      if(flick && i===0 && Math.random()<.5) return;
      p.cells.forEach(function(e){
        var px=(p.c0+e.k)*CW, py=(p.r0+e.r)*CH;
        x.fillStyle='rgba(9,11,17,.9)'; x.fillRect(px, py, CW, CH);
        x.fillStyle=e.c; x.fillText(e.g, px+1, py+1);
      });
    });
    if(tear){
      x.fillStyle='rgba(6,7,11,.9)'; x.fillRect(tear.x, tear.y, tear.w, CH);
      for(var k=0;k<tear.w/CW;k++){ var e=cell(); x.fillStyle=e.c; x.fillText(e.g, tear.x+k*CW+1, tear.y+1); }
    }
  }
  function swap(){ patches.forEach(function(p){ p.cells.forEach(function(e){ if(Math.random()<.06){ var n=cell(); e.g=n.g; e.c=n.c; } }); }); }
  size(); draw();
  addEventListener('resize', function(){ size(); draw(); });
  if(still) return;
  var next=Date.now()+4000, nextTear=Date.now()+6000;
  setInterval(function(){
    if(document.hidden) return;
    var now=Date.now();
    if(now>next){ flick=6; next=now+5000+rnd(6000); }
    if(flick){ flick--; if(!flick){ patches.shift(); patches.push(patch()); } }
    if(tear && now>tear.end) tear=null;
    if(!tear && now>nextTear){
      var w=W*(.25+Math.random()*.4);
      tear={ x:rnd(W-w), y:rnd(H/CH)*CH, w:w, end:now+180 }; nextTear=now+7000+rnd(9000);
    }
    if(flick || tear || now%1000<130) { swap(); draw(); }
  }, 120);
})();
</script>
<script is:inline src="/scripts/lost-runner.js"></script>
</body>
</html>
