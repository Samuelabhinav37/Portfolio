---
/* Served by Cloudflare Pages for any missing route. The whole page is an old CRT
   showing a game: a bulb sign says 404, and Kai is lost too, so it runs. */
// "404" on a theatre-style bulb sign: 5x7 digits inside a ring of chasing bulbs.
// Each bulb is a 6x6 pixel sprite (<symbol id="bulb">) coloured by CSS variables.
const FONT: Record<string, string[]> = {
  '4': ['00010', '00110', '01010', '10010', '11111', '00010', '00010'],
  '0': ['01110', '10001', '10011', '10101', '11001', '10001', '01110'],
};
const PITCH = 8, COLS = 23, ROWS = 11;
type Bulb = { x: number; y: number; cls: string; i?: number };
const bulbs: Bulb[] = [];
// the frame: every cell on the outer ring, numbered clockwise for the chase
const ring: [number, number][] = [];
for (let c = 0; c < COLS; c++) ring.push([c, 0]);
for (let r = 1; r < ROWS; r++) ring.push([COLS - 1, r]);
for (let c = COLS - 2; c >= 0; c--) ring.push([c, ROWS - 1]);
for (let r = ROWS - 2; r > 0; r--) ring.push([0, r]);
ring.forEach(([c, r], i) => bulbs.push({ x: c * PITCH, y: r * PITCH, cls: `chase c${i % 3}` }));
// the digits sit two cells in from the frame
[...'404'].forEach((d, i) => FONT[d].forEach((row, r) => [...row].forEach((v, c) => {
  const weak = d === '4' && r === 4 && c === (i ? 1 : 3);
  bulbs.push({ x: (2 + i * 7 + c) * PITCH, y: (2 + r) * PITCH, cls: v === '1' ? (weak ? 'lit weak' : 'lit') : 'off', i: i * 7 + c });
})));
// one bulb sprite: a = rim, b = glass, c = filament glow, h = highlight
const BULB = ['.aaaa.', 'abbbha', 'abccba', 'abccba', 'abbbba', '.aaaa.'];
const px: { x: number; y: number; k: string }[] = [];
BULB.forEach((row, y) => [...row].forEach((k, x) => { if (k !== '.') px.push({ x, y, k }); }));
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="robots" content="noindex">
<title>404 · Signal Lost · Samuel Abhinav</title>
<link href="/fonts/fonts.css" rel="stylesheet">
<style is:global>
  /* Same fixed-corner wordmark as every other page (SiteMenu.astro). */
  .wordmark{ position:fixed; top:14px; left:28px; z-index:10; font-family:'Cormorant Garamond',serif; font-weight:500; font-size:1.5rem; line-height:1; letter-spacing:.01em; color:rgba(255,255,255,.9); text-decoration:none; }
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ min-height:100%; }
  body{
    background:#030307; color:#dfe6f3;
    font-family:'Press Start 2P', monospace;
    display:flex; align-items:center; justify-content:center;
    text-align:center; padding:72px 16px 48px; min-height:100vh; overflow-x:hidden;
  }
  /* the same night sky as About */
  .sky{ position:fixed; inset:0; z-index:0; pointer-events:none;
    background:url(/images/paint/stars-tile.webp) 0 0 / 1024px, url(/images/paint/wash-tile.webp) 0 0 / 1024px; }
  /* signal corruption on the sky's block grid (after aura.build/404), drawn by the script below */
  .tears{ position:fixed; inset:0; z-index:0; pointer-events:none; width:100%; height:100%; }
  .sr{ position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; }

  /* ── the CRT: everything sits behind one tube ──
     scanlines and an RGB aperture grille over the whole screen, a bezel that rounds the
     corners and darkens the edges, a faint bright band rolling down, a slight flicker */
  .crt{ position:fixed; inset:0; z-index:2147483000; pointer-events:none; }
  .crt::before{ content:""; position:absolute; inset:0;
    background:
      repeating-linear-gradient(to bottom, rgba(0,0,0,.32) 0 1px, transparent 1px 3px),
      repeating-linear-gradient(90deg, rgba(255,40,40,.045) 0 1px, rgba(40,255,90,.035) 1px 2px, rgba(60,90,255,.05) 2px 3px);
    animation:crtFlicker 4s steps(1) infinite; }
  .crt::after{ content:""; position:absolute; inset:0; border-radius:34px / 28px;
    box-shadow:0 0 0 80px #000, inset 0 0 120px 30px rgba(0,0,0,.75), inset 0 0 14px 4px rgba(0,0,0,.9);
    background:radial-gradient(130% 110% at 50% 50%, transparent 60%, rgba(0,0,0,.35) 100%); }
  .crt-roll{ position:absolute; left:0; right:0; top:-30%; height:30%; background:linear-gradient(transparent, rgba(190,210,255,.045) 50%, transparent);
    animation:crtRoll 9s linear infinite; }
  .grain{ position:absolute; inset:0; background:url(/images/grain.webp) repeat; opacity:.07; }
  @keyframes crtRoll{ to{ transform:translateY(440%); } }
  @keyframes crtFlicker{ 0%{ opacity:1 } 37%{ opacity:.9 } 38%{ opacity:1 } 71%{ opacity:.94 } 72%{ opacity:1 } }

  /* power-on: a bright line, then the picture opens */
  .tube{ position:relative; z-index:1; width:100%; max-width:740px; }
  html.js .tube{ animation:tubeOn 1s cubic-bezier(.2,.8,.2,1) backwards; }
  @keyframes tubeOn{
    0%{ transform:scale(.6, .004); filter:brightness(5); opacity:1; }
    35%{ transform:scale(1, .004); filter:brightness(4); }
    65%{ transform:none; filter:brightness(1.6); }
    72%{ opacity:.6 } 80%{ opacity:1 } 100%{ transform:none; filter:none; }
  }
  /* a jolt during a glitch burst (the script toggles .jolt): the picture slips and splits */
  .tube.jolt{ transform:translateX(-4px) skewX(-1.5deg); filter:drop-shadow(-3px 0 rgba(255,40,90,.55)) drop-shadow(3px 0 rgba(40,200,255,.55)); }
  .tube.jolt .bulbs{ transform:translateX(9px); }

  /* ── the bulb sign ── lit bulbs glow warm, dead ones are dark glass; the ring chases */
  .sign{ display:block; width:min(460px, 88vw); height:auto; margin:0 auto 26px; overflow:visible; shape-rendering:crispEdges; }
  .sign .plate{ fill:#0b0705; stroke:#2a1d12; stroke-width:1; }
  .bulbs use{ --a:#2b2017; --b:#16100b; --c:#1d1610; --h:#4a3b2c; }
  .bulbs .lit{ --a:#c4661a; --b:#ffb347; --c:#ffe7a3; --h:#fffbe8; }
  .bulbs .lit, .bulbs .chase.on{ filter:drop-shadow(0 0 2px rgba(255,170,60,.9)) drop-shadow(0 0 7px rgba(255,140,30,.45)); }
  .bulbs .weak{ animation:bulbWeak 7s steps(1) 2.5s infinite; }
  @keyframes bulbWeak{ 0%,86%,90%,94%{ --a:#c4661a; --b:#ffb347; --c:#ffe7a3; --h:#fffbe8; } 88%,92%,96%,100%{ --a:#2b2017; --b:#16100b; --c:#1d1610; --h:#4a3b2c; filter:none; } }
  /* chase: one bulb in three lit, the pattern steps round the frame */
  .bulbs .chase{ animation:chase 1.05s steps(1) infinite; }
  .bulbs .c1{ animation-delay:-.35s; } .bulbs .c2{ animation-delay:-.7s; }
  @keyframes chase{
    0%{ --a:#c4661a; --b:#ffb347; --c:#ffe7a3; --h:#fffbe8; filter:drop-shadow(0 0 2px rgba(255,170,60,.9)) drop-shadow(0 0 7px rgba(255,140,30,.45)); }
    33.4%,100%{ --a:#2b2017; --b:#16100b; --c:#1d1610; --h:#4a3b2c; filter:none; }
  }
  /* the digits switch on in a sweep from the left when the tube warms up */
  html.js .bulbs .lit:not(.weak){ animation:litOn .6s steps(2) backwards; animation-delay:calc(var(--i) * 40ms + 900ms); }
  @keyframes litOn{ from{ --a:#2b2017; --b:#16100b; --c:#1d1610; --h:#4a3b2c; filter:none; } }
  @property --a{ syntax:'<color>'; inherits:true; initial-value:#2b2017; }
  @property --b{ syntax:'<color>'; inherits:true; initial-value:#16100b; }
  @property --c{ syntax:'<color>'; inherits:true; initial-value:#1d1610; }
  @property --h{ syntax:'<color>'; inherits:true; initial-value:#4a3b2c; }

  .status{ font-size:12px; letter-spacing:.2em; color:#ffb347; text-shadow:0 0 8px rgba(255,150,40,.6); animation:blink 1.1s steps(1) infinite; }
  @keyframes blink{ 50%{ opacity:0; } }
  .msg{ margin:16px auto 0; max-width:34em; font-size:10px; line-height:2; color:#b9c4d8; }

  /* ── the game screen ── */
  .run{ position:relative; margin:28px auto 0; padding:6px; background:#05060a;
    box-shadow:0 0 0 2px #c9d4ea, 0 0 0 4px #05060a, 0 0 0 6px #3a4152; }
  .run canvas{ display:block; width:100%; height:auto; aspect-ratio:360 / 110; image-rendering:pixelated; cursor:pointer; touch-action:manipulation; }
  .run canvas:focus-visible{ outline:2px solid #ffb347; outline-offset:8px; }
  .keys{ margin-top:18px; font-size:8px; line-height:2; color:#7d889e; }
  .keys kbd{ font:inherit; color:#dfe6f3; padding:3px 6px; margin:0 2px; background:#141824;
    box-shadow:0 -2px 0 0 #141824, 0 2px 0 0 #141824, -2px 0 0 0 #141824, 2px 0 0 0 #141824, 0 4px 0 0 #000; }

  /* ── a game-menu button: stepped pixel corners, a hard shadow that presses in, a blinking pointer ── */
  .home{ position:relative; display:inline-block; margin-top:30px; padding:14px 22px 14px 34px; font:12px/1 'Press Start 2P', monospace; color:#0b0705; text-decoration:none;
    background:#ffb347;
    box-shadow:0 -4px 0 0 #ffb347, 0 4px 0 0 #ffb347, -4px 0 0 0 #ffb347, 4px 0 0 0 #ffb347,
      0 8px 0 0 #8a4410, -4px 4px 0 0 #8a4410, 4px 4px 0 0 #8a4410, 0 0 22px 2px rgba(255,150,40,.35);
    transition:transform .06s steps(1), box-shadow .06s steps(1); }
  .home::before{ content:"▶"; position:absolute; left:13px; top:50%; transform:translateY(-50%); font-size:9px; animation:blink .8s steps(1) infinite; }
  .home:hover{ background:#ffc66b; }
  .home:active{ transform:translateY(6px);
    box-shadow:0 -4px 0 0 #ffb347, 0 4px 0 0 #ffb347, -4px 0 0 0 #ffb347, 4px 0 0 0 #ffb347, 0 4px 0 0 #8a4410, 0 0 22px 2px rgba(255,150,40,.35); }
  .home:focus-visible{ outline:2px solid #fff; outline-offset:10px; }

  @media (max-width:600px){ .keys .desk{ display:none; } .msg{ font-size:9px; } }
  @media (hover:none){ .keys .desk{ display:none; } }
  @media (hover:hover){ .keys .tap{ display:none; } }
  @media (prefers-reduced-motion: reduce){
    .crt::before, .crt-roll, .status, .home::before, .bulbs use{ animation:none !important; }
    html.js .tube{ animation:none; }
  }
</style>
<script is:inline>document.documentElement.classList.add('js');</script>
</head>
<body>
  <div class="sky" aria-hidden="true"></div>
  <canvas class="tears" aria-hidden="true"></canvas>
  <div class="crt" aria-hidden="true"><div class="grain"></div><div class="crt-roll"></div></div>
  <a class="wordmark" href="/">Samuel Abhinav</a>
  <main class="tube">
    <h1 class="sr">404, page not found</h1>
    <svg class="sign" viewBox={`-4 -4 ${COLS * PITCH + 6} ${ROWS * PITCH + 6}`} aria-hidden="true">
      <defs>
        <symbol id="bulb" viewBox="0 0 6 6" width="6" height="6">
          {px.map((p) => <rect x={p.x} y={p.y} width="1" height="1" style={`fill:var(--${p.k})`} />)}
        </symbol>
      </defs>
      <rect class="plate" x="-3" y="-3" width={COLS * PITCH + 4} height={ROWS * PITCH + 4} />
      <g class="bulbs">
        {bulbs.map((b) => <use href="#bulb" x={b.x} y={b.y} class={b.cls} style={b.i != null ? `--i:${b.i}` : undefined} />)}
      </g>
    </svg>
    <div class="status">SIGNAL LOST</div>
    <p class="msg">That page isn't in my memory. It may have moved, or it never existed.</p>

    <div class="run">
      <canvas id="runner" width="360" height="110" tabindex="0" aria-label="Kai's runner game. Press space or tap to jump, down arrow to duck."></canvas>
    </div>
    <p class="keys"><span class="desk"><kbd>SPACE</kbd> JUMP <kbd>↓</kbd> DUCK <kbd>P</kbd> PAUSE</span><span class="tap">TAP TO JUMP · SWIPE DOWN TO DUCK</span></p>

    <a class="home" href="/">RETURN TO BASE</a>
  </main>

<script is:inline>
/* Signal corruption over the night sky. Real broken video and images fail on the
   codec's 16px block grid and in short bursts, so this does the same to the sky
   itself (its two tiles are redrawn here at the CSS position, so the corrupt
   pixels are the real ones underneath):
     slip   a horizontal band jumps sideways, its red and blue channels split
     smear  a block region repeats one row of pixels downward, like video that
            lost its keyframe (datamosh)
     drop   a cluster of 16px blocks decodes badly: flat average colour (only the
            DC term survived), a block copied from elsewhere, or missing, showing
            dim glyph static as on aura.build/404
     run    from one block to the row's end the colour goes wrong (bad DC chain)
   Quiet between bursts, and the loop sleeps when nothing is showing. One or two
   small missing clusters stay a while. Off under reduced motion. */
(function(){
  var cv=document.querySelector('.tears');
  if(!cv || !cv.getContext || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var x=cv.getContext('2d'), sky=document.createElement('canvas'), sx=sky.getContext('2d', { willReadFrequently:true });
  var W=0, H=0, dpr=1, B=16, fx=[], raf=0, lastDraw=0, imgs=[], tube=document.querySelector('.tube');
  var GLYPHS='ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!#$%&*+-=<>[]{}()/\:;_@?';
  var TONES=['#2a2f3b','#323846','#3a4150','#444c5e','#76829c'];
  function rnd(n){ return Math.random()*n|0; }
  function pick(a){ return a[rnd(a.length)]; }

  function buildSky(){
    dpr=Math.min(devicePixelRatio||1, 2); W=innerWidth; H=innerHeight;
    cv.width=sky.width=Math.round(W*dpr); cv.height=sky.height=Math.round(H*dpr);
    x.setTransform(dpr,0,0,dpr,0,0); sx.setTransform(dpr,0,0,dpr,0,0);
    sx.fillStyle='#030307'; sx.fillRect(0,0,W,H);
    // same order as the CSS: wash underneath, stars on top, 1024px tiles from 0 0
    [imgs[1], imgs[0]].forEach(function(im){ for(var ty=0; ty<H; ty+=1024) for(var tx=0; tx<W; tx+=1024) sx.drawImage(im, tx, ty, 1024, 1024); });
  }
  // device-pixel helpers for reading the sky
  function d(v){ return Math.round(v*dpr); }
  function avg(bx, by){
    var px=sx.getImageData(d(bx), d(by), d(B), d(B)).data, r=0, g=0, b=0, n=px.length/4;
    for(var i=0;i<px.length;i+=4){ r+=px[i]; g+=px[i+1]; b+=px[i+2]; }
    return 'rgb('+(r/n|0)+','+(g/n|0)+','+(b/n|0)+')';
  }

  function slip(){
    var y=rnd(H/B)*B+rnd(B), h=3+rnd(26), dx=(Math.random()<.5?-1:1)*(6+rnd(44)), sh=2+rnd(3);
    var src=sx.getImageData(0, d(y), sky.width, d(h)), out=new ImageData(src.width, src.height), w=src.width;
    for(var r=0;r<src.height;r++) for(var c=0;c<w;c++){
      var o=(r*w+c)*4;
      var cr=Math.min(w-1, Math.max(0, c-d(dx)-d(sh))), cg=Math.min(w-1, Math.max(0, c-d(dx))), cb=Math.min(w-1, Math.max(0, c-d(dx)+d(sh)));
      out.data[o]=src.data[(r*w+cr)*4]; out.data[o+1]=src.data[(r*w+cg)*4+1]; out.data[o+2]=src.data[(r*w+cb)*4+2]; out.data[o+3]=255;
    }
    var band=document.createElement('canvas'); band.width=w; band.height=src.height; band.getContext('2d').putImageData(out,0,0);
    return { end:Date.now()+80+rnd(260), draw:function(){ x.drawImage(band, 0, y, W, h); } };
  }
  function smear(){
    var cols=3+rnd(8), rows=3+rnd(7), bx=rnd(W/B-cols)*B, by=rnd(H/B-rows)*B, row=by+rnd(B);
    return { end:Date.now()+600+rnd(1400), draw:function(){ x.drawImage(sky, d(bx), d(row), d(cols*B), Math.max(1,d(1)), bx, by, cols*B, rows*B); } };
  }
  function drop(life){
    // a random walk over the block grid makes a believable cluster
    var c=rnd(W/B), r=rnd(H/B), n=4+rnd(12), cells=[], seen={};
    for(var i=0;i<n;i++){
      var k=c+','+r;
      if(!seen[k] && c>=0 && r>=0){ seen[k]=1;
        var kind=Math.random(), cell={ x:c*B, y:r*B };
        if(kind<.35) cell.flat=avg(cell.x, cell.y);
        else if(kind<.55){ cell.fx=rnd(W/B)*B; cell.fy=rnd(H/B)*B; }
        else cell.glyph=1;
        cells.push(cell);
      }
      if(Math.random()<.6) c+=Math.random()<.5?-1:1; else r+=Math.random()<.5?-1:1;
    }
    return { end:Date.now()+(life||400+rnd(2000)), draw:function(){
      x.font='12px "JetBrains Mono", monospace'; x.textBaseline='middle'; x.textAlign='center';
      cells.forEach(function(e){
        if(e.flat){ x.fillStyle=e.flat; x.fillRect(e.x, e.y, B, B); }
        else if(e.fx!=null) x.drawImage(sky, d(e.fx), d(e.fy), d(B), d(B), e.x, e.y, B, B);
        else {
          x.fillStyle='#07080d'; x.fillRect(e.x, e.y, B, B);
          if(!e.g || Math.random()<.04){ e.g=pick(GLYPHS); e.t=TONES[Math.random()<.2 ? 4 : rnd(4)]; }
          x.fillStyle=e.t; x.fillText(e.g, e.x+B/2, e.y+B/2+1);
        }
      });
    } };
  }
  function run(){
    var r=rnd(H/B), from=rnd(W/B)*B, tint=pick(['rgba(255,0,170,.10)','rgba(0,255,140,.08)','rgba(255,170,0,.08)']);
    var shift=B*(1+rnd(3));
    return { end:Date.now()+150+rnd(350), draw:function(){
      x.drawImage(sky, d(from-shift), d(r*B), d(W-from), d(B), from, r*B, W-from, B);
      x.fillStyle=tint; x.fillRect(from, r*B, W-from, B);
    } };
  }

  function frame(t){
    raf=0;
    var now=Date.now();
    fx=fx.filter(function(f){ return f.end>now; });
    if(t-lastDraw>=33 || !fx.length){
      lastDraw=t; x.clearRect(0,0,W,H);
      fx.forEach(function(f){ f.draw(); });
    }
    if(fx.length) raf=requestAnimationFrame(frame);
  }
  function wake(){ if(!raf) raf=requestAnimationFrame(frame); }
  function burst(){
    if(!document.hidden && W){
      var n=1+rnd(3);
      for(var i=0;i<n;i++){ var r=Math.random(); fx.push(r<.4 ? slip() : r<.6 ? smear() : r<.85 ? drop() : run()); }
      // slips come in quick runs, like a signal dropping in and out
      if(Math.random()<.5) for(var j=0;j<2+rnd(3);j++) setTimeout(function(){ fx.push(slip()); wake(); }, 60+rnd(240));
      if(Math.random()<.35) fx.push(drop(7000+rnd(8000)));
      // now and then the whole picture jolts with the burst
      if(tube && Math.random()<.45){ tube.classList.add('jolt'); setTimeout(function(){ tube.classList.remove('jolt'); }, 70+rnd(110)); }
      wake();
    }
    setTimeout(burst, 2500+rnd(5500));
  }

  var left=2;
  ['/images/paint/stars-tile.webp','/images/paint/wash-tile.webp'].forEach(function(src, i){
    var im=new Image(); im.decoding='async'; im.addEventListener('load', function(){ if(--left===0){ buildSky(); fx.push(drop(9000)); wake(); setTimeout(burst, 1800); } }); im.src=src; imgs[i]=im;
  });
  var rt; addEventListener('resize', function(){ clearTimeout(rt); rt=setTimeout(function(){ if(!left){ buildSky(); wake(); } }, 200); });
})();
</script>
<script is:inline src="/scripts/lost-runner.js"></script>
</body>
</html>
