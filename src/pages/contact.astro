---
import Motion from '../components/Motion.astro';
import Glitches from '../components/Glitches.astro';
import SiteMenu from '../components/SiteMenu.astro';
import SkyBackground from '../components/SkyBackground.astro';
import ClarityAnalytics from '../components/ClarityAnalytics.astro';
import ErrorReporter from '../components/ErrorReporter.astro';
import KaiSite from '../components/KaiSite.astro';
import '../styles/tokens.css';
import Fonts from '../components/Fonts.astro';
import SkyLife from '../components/SkyLife.astro';
import ContactArtifacts from '../components/ContactArtifacts.astro';
import ContactSkyArtifacts from '../components/ContactSkyArtifacts.astro';

/* the date stamp in the card's header, dd.mm.yy, set at build */
const d = new Date();
const stamp = [d.getDate(), d.getMonth() + 1, d.getFullYear() % 100].map((n) => String(n).padStart(2, '0')).join('.');
/* and the postmark's, as a 1940s date stamp prints it: OCT 20 / 2026 */
const pmDay = d.toLocaleString('en-US', { month: 'short' }).toUpperCase() + ' ' + d.getDate();
const pmYear = String(d.getFullYear());

/* The page's colour: 'aged' is the sepia print in a faded brown sky; 'cool'
   is the site's usual navy night, with the card and picture cooled to match;
   'mono' is all of it in black and white; 'holo' turns the card, the picture
   and the console into a cyan hologram projected into the navy sky;
   'holo-mono' is that hologram in white light, sky creatures included. */
type Tone = 'aged' | 'cool' | 'mono' | 'holo' | 'holo-mono';
const tone = 'holo-mono' as Tone;
const bodyTone = tone === 'holo-mono' ? 'holo' : tone;
---

<!DOCTYPE html>
<html lang="en">
<head>
<script is:inline>
window.SITE=window.SITE||{};
(function(){
  function computeLowPower(){
    window.SITE.LOW_POWER = matchMedia('(max-width:900px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  computeLowPower();
  var _lpT;
  addEventListener('resize', function(){ clearTimeout(_lpT); _lpT=setTimeout(computeLowPower, 150); }, {passive:true});
})();
</script>
