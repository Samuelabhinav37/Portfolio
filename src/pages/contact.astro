  /* Matched to the homepage's settled brightness (was dimmed lower here
     for form legibility) so the background reads the same across pages. */
  window.SITE._bgBoost = 0.95;
  try { if (window.U && U.uBright) U.uBright.value = 0.6; } catch(e){}
  try { startBootSeq(); }
