  .socials{ margin-top:22px; display:flex; flex-wrap:wrap; align-items:baseline; gap:15px;
    font-family:'JetBrains Mono', monospace; font-size:0.58rem; letter-spacing:0.18em; }
  .socials .lead{ color:rgba(170,195,235,0.35); text-transform:uppercase; letter-spacing:0.2em; }
  .socials a{ color:rgba(215,226,245,0.72); text-decoration:none; position:relative; transition:color .3s; }
  .socials a:hover{ color:#fff; }
  .socials a::after{ content:''; position:absolute; left:0; bottom:-3px; height:1px; width:0;
    background:rgba(180,210,250,0.7); transition:width .3s; }
  .socials a:hover::after{ width:100%; }

