<link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;1,400&family=JetBrains+Mono:wght@400;500&family=Cormorant+Garamond:ital,wght@0,300;0,500;1,300&family=Hanken+Grotesk:wght@400;500&display=swap" rel="stylesheet">
<script is:inline src="/scripts/title-manager.js"></script>
<style is:global>
  *{ box-sizing:border-box; margin:0; padding:0; }
  html,body{ height:100%; }
  /* Extra dark-glass pane over the ambient background, this page only (not
     index). #bg-dim (shared component) sits BELOW #sc on purpose, so it
     never re-darkens ships/satellites CRAFT already brightened. Without
     index's constellation running here, that restraint reads as thin —
     moving this page's copy above #sc (z-index 2, tied with #bg-grain but
     later in DOM so it wins) and darkening it puts a real dim pane in
     front of the whole scene, ships included. Tuned to match the blog
     hero's frosted-glass overlay: light tint + a soft blur rather than a
     flat dark wash, so ships stay visible through it. */
  #bg-dim{ z-index:2; background:rgba(8,8,10,0.15);
    backdrop-filter:blur(4px); -webkit-backdrop-filter:blur(4px); }
  /* The site token is #080814. This page runs one notch below it on purpose:
     the craft are the only thing meant to hold light here, so the floor drops
     to near-black and lets them burn against it. */
  body{
    background:var(--c-bg); color:rgba(233,236,247,0.92);
    font-family:'EB Garamond', Georgia, serif;
    overflow:hidden; -webkit-font-smoothing:antialiased;
  }



  /* ══════════════ WINDOW STACK ══════════════
     Left: the clips, scattered as overlapping windows — different sizes,
     deliberately misaligned, each one lapping over its neighbour so the
     cluster reads as depth rather than a grid.
     Right: the form, alone, with room to breathe. */
  .field-wrap{
    position:fixed; inset:0; z-index:40;
    display:grid; grid-template-columns:1.12fr 0.88fr; grid-template-rows:1fr auto; align-items:center;
    column-gap:3vw; row-gap:12px; padding:64px 4.5vw 22px; max-width:1500px; margin:0 auto;
  }

  /* ── the stack: cards are absolutely placed, so they can overlap ── */
  .stack{ position:relative; width:100%; height:min(70vh, 660px);
    perspective:1400px; transform-style:preserve-3d; }

  /* ── page footer: squeezed into the fixed viewport as a second grid row,
     spanning both columns under the stack + form ── */
  .pg-footer{ grid-column:1 / -1; grid-row:2; display:flex; align-items:center;
    justify-content:space-between; flex-wrap:wrap; gap:10px 20px;
    padding-top:14px; border-top:1px solid rgba(var(--c-white),0.1);
    font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:.06em;
    color:rgba(200,215,240,0.4); }
  .pg-footer .f-links{ display:flex; align-items:center; gap:14px;
    letter-spacing:.14em; text-transform:uppercase; }
  .pg-footer .f-links a{ color:rgba(200,215,240,0.5); text-decoration:none;
    transition:color .25s; display:inline-flex; align-items:center; gap:6px; }
  .pg-footer .f-links a:hover{ color:#fff; }
  .pg-footer .f-links .fic{ width:12px; height:12px; fill:currentColor; opacity:0.9; flex:none; }
  @media (max-width:900px){
    .pg-footer{ grid-column:auto; grid-row:auto; margin-top:24px; padding:14px 20px; }
  }

  /* .card is the PARALLAX box — JS writes a transform here every frame.
     .card-inner is the VISUAL box — CSS owns its transform (entrance + hover).
     Splitting them means the two transforms never fight over one property. */
  .card{
    position:absolute;
    transform-style:preserve-3d;
    will-change:transform;
  }
  /* resting shadow is STATIC — never transitioned. The hover shadow is a
     separate layer whose opacity fades, so we only ever animate opacity and
     transform (compositor-only; no paint, no reflow). */
  .card::before{
    content:''; position:absolute; inset:0; border-radius:14px; z-index:-1;
    box-shadow:0 34px 70px -28px rgba(0,0,0,0.92);
    pointer-events:none;
  }
  .card::after{
    content:''; position:absolute; inset:0; border-radius:14px; z-index:-1;
    box-shadow:0 50px 96px -30px rgba(0,0,0,0.96);
    opacity:0; transition:opacity .5s ease; pointer-events:none;
  }
  .card:hover::after{ opacity:1; }

  .card-inner{
    position:absolute; inset:0; overflow:hidden; border-radius:14px;
    border:1px solid rgba(var(--c-white),0.16);
    background:rgba(26,29,44,0.72);
    /* entrance state — cards settle in rather than snapping on */
    opacity:0; transform:translateY(26px) scale(0.985);
    transition:opacity .95s cubic-bezier(.22,1,.36,1),
               transform .95s cubic-bezier(.22,1,.36,1),
               border-color .45s ease;
  }
  .stack.ready .card-inner{ opacity:1; transform:none; }
  .stack.ready .card:hover .card-inner{
    transform:translateY(-6px);
    border-color:rgba(180,210,250,0.3);
  }
  .card:hover{ z-index:20; }

  /* staggered reveal — the composition assembles itself */
  .c-globe .card-inner{ transition-delay:.05s; }

  .card-inner canvas.gl{ display:none; }
  .card-inner canvas.hud{ position:absolute; inset:0; width:100%; height:100%; z-index:1; pointer-events:none; }
  .card-inner img.src{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover;
     z-index:0; display:block; filter:grayscale(1) contrast(1.1) brightness(1.25); }
  .card-inner .recon-card{ display:none; }

  /* slot 04 — image base (darker, dormant field) + coded traveler canvas */
  .card-inner img.slot04-base{ filter:grayscale(1) contrast(1.05) brightness(0.95) !important; }
  .card-inner canvas.anim04{ position:absolute; inset:0; width:100%; height:100%; z-index:1; display:block; pointer-events:none; }
  .c-hard  .card-inner{ transition-delay:.13s; }
  .c-slot1 .card-inner{ transition-delay:.21s; }
  .c-mal   .card-inner{ transition-delay:.29s; }
  .c-side  .card-inner{ transition-delay:.37s; }
  .c-cyber .card-inner{ transition-delay:.45s; }
  .c-slot2 .card-inner{ transition-delay:.53s; }
  .c-slot3 .card-inner{ transition-delay:.61s; }

  .card .label{ position:absolute; top:15px; left:17px; z-index:3; pointer-events:none; }
  .card .label .a{ display:block; font-family:'Cormorant Garamond', serif; font-weight:500;
    font-size:1.06rem; line-height:1.16; color:rgba(var(--c-white),0.94); }
  .card .label .b{ display:block; font-family:'Cormorant Garamond', serif; font-weight:300;
    font-size:1.06rem; line-height:1.16; color:rgba(190,205,232,0.5); }
  /* ── reserved windows: holding space until the footage lands ──
     These rules used to sit on .card, which carries no border, no background
     and no radius — the visual box is .card-inner. The dashed border simply
     never rendered and the translucent fill was painted over. Retargeted. */
  .card.empty .card-inner{
    background:rgba(9,11,20,0.42);
    border-color:rgba(var(--c-white),0.06);
    border-style:dashed;
  }
  .card.empty::before{ box-shadow:0 24px 50px -30px rgba(0,0,0,0.8); }
  .card.empty::after{ box-shadow:0 34px 70px -32px rgba(0,0,0,0.85); }
  .stack.ready .card.empty:hover .card-inner{ border-color:rgba(180,210,250,0.2); }
  .card.empty .fill{
    position:absolute; inset:0; display:flex; flex-direction:column;
    align-items:center; justify-content:center; gap:7px; overflow:hidden;
    background:repeating-linear-gradient(45deg, rgba(var(--c-white),0.012) 0 1px, transparent 1px 10px);
  }
  .card.empty .fill .n{ font-family:'JetBrains Mono', monospace; font-size:1.35rem;
    letter-spacing:0.12em; color:rgba(var(--c-white),0.10); }
  .card.empty .fill .r{ font-family:'JetBrains Mono', monospace; font-size:0.46rem;
    letter-spacing:0.2em; text-transform:uppercase; color:rgba(170,195,235,0.26); }
  /* a slow sweep, so an empty window still reads as a live channel */
  /* animating `top` re-lays-out and repaints the card every frame, on three
     cards at once. transform runs on the compositor for free. */
  .card.empty .fill::after{
    content:''; position:absolute; left:0; right:0; top:0; height:100%;
    background:linear-gradient(90deg, transparent, rgba(190,215,255,0.16), transparent)
               top left / 100% 1px no-repeat;
    will-change:transform;
    animation:slotSweep 4.2s linear infinite;
  }
  /* full-height layer with the line drawn on its top edge, so translateY(100%)
     walks the line the exact height of the card no matter what that height is */
  @keyframes slotSweep{ from{ transform:translateY(0); } to{ transform:translateY(100%); } }
  @media (prefers-reduced-motion: reduce){ .card.empty .fill::after{ animation:none; opacity:0; } }

  /* the two portrait cards are narrow — tuck their type in */
  .c-globe .label, .c-side .label{ top:13px; left:14px; }
  .c-globe .label .a, .c-globe .label .b,
  .c-side .label .a,  .c-side .label .b{ font-size:0.95rem; }
  .c-side .tag, .c-cyber .tag{ font-size:0.46rem; letter-spacing:0.18em; }

  .card .tag{ position:absolute; bottom:12px; left:17px; z-index:3; pointer-events:none;
    font-family:'JetBrains Mono', monospace; font-size:0.5rem; letter-spacing:0.22em;
    text-transform:uppercase; color:rgba(170,195,235,0.36); }

  /* ── THE SCATTER — single source of truth ──────────────────────────────
     This used to be declared twice: an 8-card layout followed by an older
     5-card one, which won the cascade and left the three .empty slots sitting
     in the geometry of a layout that no longer existed. One block now, all
     eight windows, percentages so the composition holds at any size.
     Sizes are deliberately unequal — two portraits, one big landscape anchor,
     and a spread of smaller windows. The clips are 16:9 and crop via
     object-fit:cover; the globe and the malware blob are centred subjects, so
     they survive the crop. z-index climbs toward the centre of the cluster.
     Drop a clip into a slot and delete its .empty class.                    */
  .c-globe { left:0;   top:2%;  width:26%; height:52%; z-index:4; }  /* tall portrait  */
  .c-hard  { left:29%; top:0;   width:46%; height:28%; z-index:3; }  /* wide           */
  .c-slot1 { left:78%; top:4%;  width:22%; height:34%; z-index:2; }  /* reserved       */
  .c-mal   { left:18%; top:30%; width:54%; height:36%; z-index:8; }  /* the anchor     */
  .c-side  { left:69%; top:40%; width:22%; height:32%; z-index:7; }  /* small portrait */
  .c-cyber { left:3%;  top:58%; width:36%; height:26%; z-index:6; }  /* small wide     */
  .c-slot2 { left:41%; top:68%; width:26%; height:26%; z-index:7; }  /* reserved       */
  .c-slot3 { left:62%; top:74%; width:34%; height:22%; z-index:5; }  /* reserved       */


  /* ── THE CLIP ITSELF ───────────────────────────────────────────────────
     This had NO rule at all. The <video> was sitting at its intrinsic size
     inside the card, unstretched and uncropped — every comment in the file
     described an object-fit:cover crop that the stylesheet never performed.
     The poster is painted as the element's background, so the frame is
     already there before a single byte of video is fetched.                */
  .card .clip{
    position:absolute; inset:0; display:block;
    width:100%; height:100%;
    object-fit:cover; object-position:center;
    background-size:cover; background-position:center; background-repeat:no-repeat;
    z-index:0;
  }

  /* ── TINT + SCRIM ──────────────────────────────────────────────────────
     Both divs were in the markup on every card and neither had a rule, so
     the labels were sitting on raw footage and the clips punched through the
     page's dimmed palette. tint = duotone-ish cool wash that folds the
     footage back into the #080814 world. scrim = the legibility gradient the
     label and tag were relying on.                                          */
  .card .tint{
    position:absolute; inset:0; z-index:1; pointer-events:none;
    background:rgba(10,14,28,0.20);
    mix-blend-mode:multiply;
  }
  .card .scrim{
    position:absolute; inset:0; z-index:2; pointer-events:none;
    background:
      linear-gradient(180deg, rgba(4,6,14,0.4) 0%, rgba(4,6,14,0) 34%),
      linear-gradient(0deg,   rgba(4,6,14,0.38) 0%, rgba(4,6,14,0) 40%);
  }
  /* on hover the window opens up a little — the footage comes forward */
  .card .tint, .card .scrim{ transition:opacity .5s ease; }
  .stack.ready .card:hover .tint{ opacity:0.55; }

  /* ── the form: no card, no frame — just type on the ground ── */
  .form-panel{ width:100%; max-width:440px; justify-self:center; }
  .stepper{ display:flex; gap:14px; align-items:baseline; margin-bottom:20px;
    font-family:'JetBrains Mono', monospace; font-size:0.56rem; letter-spacing:0.22em;
    text-transform:uppercase; }
  .stepper .n{ color:rgba(var(--c-white),0.6); }
  .stepper .d{ color:rgba(170,195,235,0.38); }
  .form-title{ font-family:'Cormorant Garamond', serif; font-weight:300;
    font-size:clamp(1.7rem, 2.4vw, 2.25rem); line-height:1.12; white-space:nowrap;
    color:rgba(var(--c-white),0.93); margin-bottom:7px; }
  .form-title em{ font-style:italic; color:rgba(190,205,232,0.62); }
  .form-sub{ font-family:'EB Garamond', serif; font-style:italic; font-size:1rem;
    color:rgba(200,215,240,0.44); margin-bottom:30px; }
  .field{ margin-bottom:20px; border-bottom:1px solid rgba(var(--c-white),0.13); transition:border-color .35s; }
  .field:focus-within{ border-color:rgba(180,210,250,0.6); }
  .field label{ display:block; font-family:'JetBrains Mono', monospace; font-size:0.5rem;
    letter-spacing:0.22em; text-transform:uppercase; color:rgba(170,195,235,0.4); margin-bottom:5px; }
  .field label .req{ color:rgba(255,150,150,0.7); margin-left:3px; }
  .req-note{ font-family:'JetBrains Mono', monospace; font-size:0.45rem; letter-spacing:0.14em;
    text-transform:uppercase; color:rgba(var(--c-white),0.30); margin:-8px 0 18px; }
  .field input, .field textarea{ width:100%; background:none; border:none; outline:none;
    font-family:'EB Garamond', serif; font-size:1.08rem; color:rgba(233,236,247,0.95); padding:2px 0 9px; }
  .field textarea{ min-height:56px; line-height:1.45; resize:none; display:block; }
  .field input::placeholder, .field textarea::placeholder{ color:rgba(180,200,235,0.28); }
  /* Cloudflare's own chrome can't be restyled (cross-origin iframe), but a filter
     composites over the rendered pixels fine — dims/desaturates it to sit closer
     to the page's muted palette instead of popping as a bright foreign box. */
  #turnstile-widget{ margin:2px 0 20px; filter:grayscale(.4) brightness(.88) contrast(.94); }
  .cta{ width:100%; margin-top:6px; padding:14px; cursor:pointer;
    background:rgba(var(--c-white),0.94); color:#0a0c16; border:1px solid rgba(var(--c-white),0.94);
    border-radius:8px; font-family:'JetBrains Mono', monospace; font-size:0.58rem;
    letter-spacing:0.24em; text-transform:uppercase;
    transition:background .3s, color .3s, transform .12s; }
  .cta:hover{ background:transparent; color:rgba(var(--c-white),0.95); }
  .cta:active{ transform:translateY(1px); }
  .cta.sent{ background:rgba(89,212,153,0.9); border-color:rgba(89,212,153,0.9); color:#06120c; }

  /* ── validation + send status ──────────────────────────────────────────
     The form had no error state and no live region: a screen reader user got
     no signal at all that anything had happened when the button was pressed. */
  .field.invalid{ border-color:rgba(232,120,120,0.75); }
  .field .err{
    display:none; margin:5px 0 6px;
    font-family:'JetBrains Mono', monospace; font-size:0.5rem; letter-spacing:0.18em;
    text-transform:uppercase; color:rgba(232,140,140,0.85);
  }
  .field.invalid .err{ display:block; }
  .form-status{
    min-height:1.1em; margin-top:11px;
    font-family:'JetBrains Mono', monospace; font-size:0.55rem; letter-spacing:0.18em;
    text-transform:uppercase; color:rgba(170,195,235,0.5);
  }
  .form-status.ok{ color:rgba(120,220,170,0.85); }
  .form-status.bad{ color:rgba(232,140,140,0.85); }
  .cta[disabled]{ opacity:0.6; cursor:default; }
  .cta[disabled]:hover{ background:rgba(var(--c-white),0.94); color:#0a0c16; }

  /* keyboard users could not see where they were on this page at all */
  a:focus-visible, button:focus-visible, input:focus-visible, textarea:focus-visible{
    outline:1px solid rgba(180,210,250,0.85); outline-offset:3px; border-radius:2px;
  }
  .skip{
    position:fixed; top:-60px; left:16px; z-index:10002; padding:9px 14px;
    background:#0b0e1a; border:1px solid rgba(180,210,250,0.5); border-radius:8px;
    color:#fff; text-decoration:none;
    font-family:'JetBrains Mono', monospace; font-size:0.55rem; letter-spacing:0.2em;
    text-transform:uppercase; transition:top .25s ease;
  }
  .skip:focus{ top:16px; }

  /* ── narrow: the stack unpacks into a plain column, form beneath ── */
  @media (prefers-reduced-motion: reduce){
    .card-inner{ opacity:1; transform:none; transition:border-color .45s ease; }
    .stack.ready .card:hover .card-inner{ transform:none; }
  }

  @media (max-width:900px){
    .field-wrap{ position:absolute; inset:auto 0 auto 0; display:block;
      padding:92px 20px 48px; max-width:none; }
    body{ overflow-y:auto; }
    /* The 8-window stack (parallax cards + up to 8 concurrent per-frame
       recon-HUD canvas loops) is the heaviest thing on this page. Cut it
       entirely on phone/tablet rather than shrink it, so only the form
       shows — contact-window-stack.js and contact-recon-engine.js both
       skip booting it under window.SITE.LOW_POWER to match. */
    .stack{ display:none; }
    .form-panel{ max-width:none; }
    .form-title{ font-size:clamp(1.2rem, 5.8vw, 2rem); }
  }





#luna-portal {
  position:fixed;
  right:18px; top:min(calc(66vh + 80px), calc(100vh - 140px));   /* concentric with Luna's box */
  width:120px; height:120px;
  border-radius:50%;
  z-index:998;
  pointer-events:none; opacity:0;
  background:radial-gradient(circle,
    rgba(160,195,255,0.22) 0%,
    rgba(130,170,245,0.10) 38%,
    rgba(120,160,240,0.03) 58%,
    transparent 72%);
  box-shadow:0 0 18px 2px rgba(120,170,255,0.10);
}
