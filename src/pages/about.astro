/* Desktop (side-by-side, >980px) stays a fixed single viewport with no
   scroll — scale #about-inner down (never up past 1.12x) to fit whatever
   width/height it's given. Below 980px the layout stacks and is genuinely
   fluid instead (see the @media rules above), so this is a no-op there:
   real mobile/tablet content should reflow, not shrink to illegibility. */
var _aboutLastDpr = window.devicePixelRatio;
function scaleAboutInner() {
  var inner = document.getElementById('about-inner');
  if (!inner) return;
  if (matchMedia('(max-width:980px)').matches) {
    inner.style.transform = '';
    return;
  }
  // Browser zoom (ctrl +/-) shrinks window.innerWidth/innerHeight in CSS px
  // without the window actually getting smaller, so recomputing the fit-scale
  // on a zoom-triggered resize event would shrink the layout right back down,
  // canceling out a visitor's own zoom-in. Zoom moves devicePixelRatio; a real
  // window resize doesn't. Skip the recompute when dpr just changed (keep the
  // pre-zoom scale, which now reads larger thanks to the browser's own zoom),
  // and adopt the new dpr as the baseline so a genuine resize at this zoom
  // level still fits correctly afterward.
  if (window.devicePixelRatio !== _aboutLastDpr) {
    _aboutLastDpr = window.devicePixelRatio;
    return;
  }
  inner.style.transform = '';
  inner.style.transformOrigin = 'top center';
  var vw = window.innerWidth - 48;
  var vh = window.innerHeight - (window.innerHeight * 0.09 + 72 + 48);
  var naturalW = inner.scrollWidth;
  var naturalH = inner.scrollHeight;
  var scale = Math.min(vw / naturalW, vh / naturalH, 1.12);
  inner.style.transform = 'scale(' + scale + ')';
}
scaleAboutInner();
window.addEventListener('resize', scaleAboutInner);
window.addEventListener('load', function(){ setTimeout(scaleAboutInner, 100); });
</script>

<script is:inline>
/* The bento panel + arcade sit centered (#about-inner) and are rescaled by
   scaleAboutInner() to fit the viewport on desktop, so a hand-picked
   percentage margin would drift out of sync with the real layout as soon as
   the scale factor isn't 1. Force the scale pass now (it normally only runs
   on load/resize) and measure the actual rendered box, so background craft
   get the full real margin on every side instead of a guessed band. */
scaleAboutInner();
var _aiR = document.getElementById('about-inner').getBoundingClientRect();
var _vw = window.innerWidth, _vh = window.innerHeight;
var _pad = 0.01; // small buffer so craft don't hug the card edges
var _lx = Math.max(0, _aiR.left / _vw - _pad);
var _rx = Math.min(1, _aiR.right / _vw + _pad);
var _ty = Math.max(0, _aiR.top / _vh - _pad);
var _by = Math.min(1, _aiR.bottom / _vh + _pad);
window.SITE.NEBULA_SAFE_ZONES = [
  {x0:0,  y0:0, x1:_lx, y1:1},  // left margin
  {x0:_rx,y0:0, x1:1,   y1:1},  // right margin
  {x0:0,  y0:0, x1:1,   y1:_ty}, // top strip
  {x0:0,  y0:_by,x1:1,  y1:1},  // bottom strip
];
</script>
