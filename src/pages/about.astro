---
import Motion from '../components/Motion.astro';
import { ClientRouter } from 'astro:transitions';
import SiteMenu from '../components/SiteMenu.astro';
import SiteSky from '../components/SiteSky.astro';
import ClarityAnalytics from '../components/ClarityAnalytics.astro';
import ErrorReporter from '../components/ErrorReporter.astro';
import ScrollToc from '../components/ScrollToc.astro';
import KaiKeep from '../components/KaiKeep.astro';
import '../styles/tokens.css';
import { PROJECTS } from '../data/projects';
import Fonts from '../components/Fonts.astro';
// logos: Simple Icons (CC0), Devicon (MIT) and each project's own mark, made one colour so they take the text colour
const logos = import.meta.glob('../icons/toolkit/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>;
const logo = (slug: string) => logos[`../icons/toolkit/${slug}.svg`];
const toolkit: [string, string][] = [
  ['Splunk', 'splunk'], ['Microsoft Sentinel', 'sentinel'], ['Elastic', 'elastic'], ['Kibana', 'kibana'],
  ['Wazuh', 'wazuh'], ['Security Onion', 'securityonion'], ['Sigma', 'sigma'], ['ATT&CK', 'mitre'],
  ['Python', 'python'], ['PowerShell', 'powershell'], ['Ghidra', 'ghidra'], ['Terraform', 'terraform'],
  ['Docker', 'docker'], ['AWS', 'aws'], ['Azure', 'azure'],
];
const certs = ['Security+', 'Network+', 'ISC2 CC', 'AWS CCP', 'AZ-900', 'HTB CJCA'];
---

<!DOCTYPE html>
<html lang="en">
<head>
<script is:inline>
window.SITE=window.SITE||{};
(function(){
  function computeLowPower(){
    window.SITE.LOW_POWER = matchMedia('(max-width:900px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  computeLowPower();
  var _lpT;
  addEventListener('resize', function(){ clearTimeout(_lpT); _lpT=setTimeout(computeLowPower, 150); }, {passive:true});
})();
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="darkreader-lock">
<title>Samuel Abhinav — About</title>
<meta name="description" content="I got into security because I liked figuring out how things break. M.S. in Cybersecurity, a handful of certs, and three projects I'm genuinely proud of — currently looking for a team that reads its own logs.">
<link rel="canonical" href="https://samuelabhinav.com/about/">
<meta property="og:type" content="website">
<meta property="og:title" content="Samuel Abhinav — About">
<meta property="og:description" content="I got into security because I liked figuring out how things break. Turns out that's basically the whole job.">
<meta property="og:site_name" content="Samuel · Security Engineer">
<meta property="og:url" content="https://samuelabhinav.com/about/">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Samuel Abhinav — About">
<meta name="twitter:description" content="I got into security because I liked figuring out how things break. Turns out that's basically the whole job.">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<script is:inline src="/scripts/theme.js"></script>
<script is:inline src="/scripts/title-manager.js"></script>
<Fonts />
<ClientRouter fallback="swap" />
<Motion />
<style is:global>
/* Layout after angelaricciardi.com/information: one big statement with the key
   words in full ink and the rest grey, then small label | value rows, and the
   arcade game where that page has its photo, bottom right. The site sky
   (SiteSky) shows behind everything. */
* { margin:0; padding:0; box-sizing:border-box; }
html, body { background:var(--c-bg); overflow-x:hidden; }
:root{ --ab-ink:#f4f6fa; --ab-dim:rgba(244,246,250,.42); }
:root[data-theme="light"]{ --ab-ink:#191919; --ab-dim:rgba(25,25,25,.45); }
body { color:var(--ab-ink); font-family:'Inter Tight', 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  -webkit-font-smoothing:antialiased; }
.page-grain{ position:fixed; inset:0; z-index:2147483000; pointer-events:none; }
.page-grain::before{ content:""; position:absolute; inset:0; background:radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(2,4,12,.55) 100%); }
.page-grain::after{ content:""; position:absolute; inset:0; background:url(/images/grain.webp) repeat; opacity:.06; }

.ab{ position:relative; z-index:3; padding:120px 28px 40px; min-height:100vh; }
/* the page fades in, as on the reference */
html.motion .ab{ animation:abIn .7s ease-in-out both; }
@keyframes abIn{ from{ opacity:0; } }
/* the statement: bold and tight, grey, with the names and facts in full ink */
.ab-lede{ font-size:clamp(22px, 1.95vw, 28px); line-height:1.02; font-weight:600; letter-spacing:-.02em;
  color:var(--ab-dim); max-width:1400px; margin-bottom:56px; }
.ab-lede b{ font-weight:600; color:var(--ab-ink); }

.ab-info{ display:grid; grid-template-columns:minmax(0, 1fr) 460px; gap:40px; align-items:start; }
.ab-rows{ display:flex; flex-direction:column; gap:40px; font-size:13px; line-height:16px; font-weight:600; letter-spacing:-.01em; }
.row{ display:grid; grid-template-columns:170px minmax(0, 1fr); }
.row > h2{ font:inherit; color:var(--ab-dim); }
.row ul{ list-style:none; }
.row a, .work > a > span{ color:inherit; text-decoration:none; transition:opacity var(--dur-change-out) var(--ease-in); }
/* the row you point at stays lit, its neighbours dim (same rule as the home frames);
   work rows are display:contents, so their cells dim */
@media (hover:hover){
  .row ul:has(a:hover, a:focus-visible) a:not(:hover, :focus-visible),
  .work:has(a:hover, a:focus-visible) a:not(:hover, :focus-visible) > span{ opacity:.35; transition:opacity var(--dur-change) var(--ease-out); }
}
.row a[target="_blank"]::after{ content:' ↗'; }
.k{ color:var(--ab-dim); }

/* selected work: a plain table like the reference's client list */
.work{ display:grid; grid-template-columns:110px 150px 170px; column-gap:20px; }
.work > *{ display:contents; }
.work > * > span{ white-space:nowrap; overflow:hidden; }
/* logo + name pairs after 21st.dev's client strip, scrolled by the marquee below */
.tk{ white-space:nowrap; overflow:hidden; max-width:470px; font-size:14px; color:var(--ab-dim); }
.tk .t{ display:inline-flex; align-items:center; gap:7px; margin-right:22px; vertical-align:middle; transition:color var(--dur-feedback) var(--ease-out); }
.tk .t:hover{ color:var(--ab-ink); }
.tk .mq > span{ padding-right:0; } /* items carry their own gap, so the loop seam matches */
.tk svg{ height:16px; width:auto; flex:none; }
/* a cell too long for its column scrolls sideways in a loop (the script below adds .mq) */
.mq{ display:inline-flex; animation:mq var(--d, 12s) linear infinite; }
.mq > span{ padding-right:2.5em; }
@keyframes mq{ to{ transform:translateX(-50%); } }
@media (prefers-reduced-motion: reduce){ .mq{ animation:none; } }
.work .th > span{ color:var(--ab-dim); }

/* the game, where the reference has its photo */
.ab-game{ display:flex; flex-direction:column; gap:8px; font-size:13px; line-height:16px; font-weight:600; }
.ab-game p{ display:flex; justify-content:space-between; color:var(--ab-dim); }
.ab-game p b{ color:var(--ab-ink); font-weight:600; }
.game-stage{ position:relative; aspect-ratio:7 / 6; display:flex; border-radius:4px; overflow:hidden; background:#000;
  box-shadow:0 18px 40px rgba(0,0,0,.35); }
#game-iframe{ position:absolute; left:0; top:0; width:760px !important; height:652px; transform:scale(calc(460 / 760)); transform-origin:0 0; }
.game-stage.on{ animation:crtOn 1.1s var(--ease-out) both; }
@keyframes crtOn{
  0%{ transform:scale(.4, .004); filter:brightness(4); }
  30%{ transform:scale(1, .004); filter:brightness(4); }
  60%{ transform:none; filter:brightness(1.8); opacity:1; }
  68%{ opacity:.55; } 76%{ opacity:1; } 84%{ opacity:.8; }
  100%{ transform:none; filter:none; opacity:1; }
}
/* the cover hands the keyboard to the game, so arrow keys stop scrolling the page */
.game-play{ position:absolute; inset:0; z-index:2; display:grid; place-items:end center; padding-bottom:16%; border:0; cursor:pointer; color:#f4f6fa;
  background:none; transition:opacity .4s var(--ease-out); }
/* before the first click: a still of the game's start screen, nothing loaded or moving */
.game-stage:not(.on) .game-play{ background:#000 url(/images/arcade-poster.webp) 0 0 / 100% 100% no-repeat; }
.game-play:focus-visible{ outline:2px solid #f4f6fa; outline-offset:-4px; }
.game-play.gone{ opacity:0; pointer-events:none; }
@media (prefers-reduced-motion: reduce){ .game-stage.on{ animation:none; } }

@media (--bp-900){
  .ab{ padding:96px 16px 40px; }
  .ab-lede{ margin-bottom:64px; }
  .ab-info{ grid-template-columns:1fr; }
  .row{ grid-template-columns:1fr; gap:8px; }
  .work{ grid-template-columns:minmax(0, 1fr) auto; }
  .work .c3{ display:none; }
  /* the game (and its 70KB script) never boots on phones; see the boot script below */
  .ab-game{ display:none; }
}
</style>
<ErrorReporter />
<ClarityAnalytics />
</head>

<body>
<div class="page-grain" aria-hidden="true"></div>
<SiteSky />

<SiteMenu currentPath="/about" />

<main class="ab">
  <h1 class="ab-lede" data-reveal>
    <b>Samuel Abhinav</b> is a <b>security engineer</b> working on <b>detection, incident response</b> and <b>network security</b>.
    It started with a master's in Cybersecurity at <b>Iowa State University</b> and a habit of finding out how things break, then making sure they don't.
    Most days go into writing detections, triaging alerts and rebuilding attack chains from logs.
    The work so far includes <b>Moat</b>, an ad blocker that runs entirely in the browser, <b>Cluster</b>, which catches impersonation in Gmail from the headers alone, and <b>Sentinel</b>, a SOC lab where every rule has to fire on a real attack before it counts.
    Outside of that there are accepted bug bounty findings on <b>HackerOne</b> and six certifications.
    Currently looking for <b>SOC analyst, detection engineering</b> and <b>security engineering</b> roles.
  </h1>

  <div class="ab-info">
    <div class="ab-rows" data-reveal-group>
      <section class="row" data-toc="Contact">
        <h2>Contact</h2>
        <ul>
          <li><a href="mailto:hello@samuelabhinav.com">hello@samuelabhinav.com</a></li>
          <li><a href="https://www.linkedin.com/in/samuelabhinav/" target="_blank" rel="me noopener">LinkedIn</a></li>
          <li><a href="https://github.com/Samuelabhinav37" target="_blank" rel="me noopener">GitHub</a></li>
        </ul>
      </section>

      <section class="row" data-toc="Selected Work">
        <h2>Selected Work</h2>
        <div class="work">
          <div class="th"><span>Project</span><span>Type</span><span class="c3">Area</span></div>
          {PROJECTS.map((p) => (
            <a href={`/work/${p.slug}/`}><span>{p.name}</span><span>{p.tags[0]}</span><span class="c3">{p.tags.slice(1).join(', ')}</span></a>
          ))}
        </div>
      </section>

      <section class="row" data-toc="Toolkit">
        <h2>Toolkit</h2>
        <p class="tk">
          {toolkit.map(([name, slug]) => (
            <span class="t"><Fragment set:html={logo(slug)} />{name}</span>
          ))}
        </p>
      </section>

      <section class="row" data-toc="Certifications">
        <h2>Certifications</h2>
        <p>{certs.join(', ')}</p>
      </section>
    </div>

    <figure class="ab-game" id="arcade" data-toc="Arcade">
      <p><b>INFILTRATE // DEFEND</b><span>Play a round</span></p>
      <div class="game-stage">
        <button class="game-play" type="button" aria-label="Play INFILTRATE // DEFEND"></button>
<iframe id="game-iframe" title="INFILTRATE // DEFEND (playable arcade game)" data-srcdoc="&lt;!DOCTYPE html&gt;
&lt;html lang=&quot;en&quot;&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width,initial-scale=1&quot;&gt;
&lt;title&gt;INFILTRATE // DEFEND&lt;/title&gt;
&lt;link href=&quot;/fonts/fonts.css&quot; rel=&quot;stylesheet&quot;&gt;
&lt;style&gt;
:root{--c-white:255,255,255;--cyan:#00e5ff;--green:#00ff88;--gold:#ffcc00;--red:#ff2244;--purple:#cc44ff;--orange:#ff8800;}
*{margin:0;padding:0;box-sizing:border-box;image-rendering:pixelated;}
html,body{width:100%;height:100%;overflow:hidden;background:#000;color:#fff;font-family:'Press Start 2P',monospace;}
body::before{content:'';position:fixed;inset:0;z-index:999;pointer-events:none;
  background:repeating-linear-gradient(0deg,rgba(0,0,0,0.07) 0px,rgba(0,0,0,0.07) 1px,transparent 1px,transparent 4px);}
body::after{content:'';position:fixed;inset:0;z-index:998;pointer-events:none;
  background:radial-gradient(ellipse at center,transparent 65%,rgba(0,0,0,0.15) 100%);
  animation:flicker 12s infinite;}
@keyframes flicker{0%,94%,100%{opacity:1;}95%{opacity:.93;}96%{opacity:1;}99%{opacity:.95;}}
canvas#bg{position:fixed;inset:0;z-index:0;}
#flash{position:fixed;inset:0;z-index:997;opacity:0;pointer-events:none;}
.blink{animation:blink .95s step-start infinite;}
@keyframes blink{50%{opacity:0;}}
.screen{position:fixed;inset:0;z-index:10;display:flex;flex-direction:column;align-items:center;justify-content:center;opacity:0;pointer-events:none;}
.screen.on{opacity:1;pointer-events:all;}
/* Only the very first boot screen (title + &quot;press any key&quot;) stays
   monochrome, matching the rest of the site's grayscale visual language
   before the game itself takes over — every screen after that (mode/rules/
   theme select, and gameplay) keeps full color, since distinct hues there
   are load-bearing (themes, power-ups, walls vs. hiding spots all need to
   read apart). */
#s-boot{filter:grayscale(1);}

/* ── PROGRESS ─────────────────────────────────── */
#prog{position:fixed;top:0;left:0;right:0;z-index:30;height:20px;background:#000;border-bottom:1px solid rgba(var(--c-white),.06);display:flex;align-items:center;padding:0 14px;gap:10px;}
.ps{font-size:5px;letter-spacing:.14em;color:rgba(var(--c-white),.13);display:flex;align-items:center;gap:5px;transition:color .2s;}
.ps.cur{color:#fff;}.ps.done{color:rgba(var(--c-white),.35);}
.ps .d{width:4px;height:4px;background:rgba(var(--c-white),.12);transition:background .2s;}
.ps.cur .d{background:#fff;box-shadow:0 0 4px #fff;}.ps.done .d{background:rgba(var(--c-white),.35);}
#prog-div{flex:1;}
#back{position:fixed;top:0;left:10px;z-index:31;font-size:6px;letter-spacing:.14em;color:rgba(var(--c-white),.30);cursor:pointer;height:20px;display:flex;align-items:center;opacity:0;pointer-events:none;transition:.2s;}
#back::before{content:'';position:absolute;top:50%;left:50%;width:44px;height:44px;transform:translate(-50%,-50%);}
#back.on{opacity:1;pointer-events:all;}#back:hover{color:rgba(var(--c-white),.55);}
#ticker-w{position:fixed;bottom:0;left:0;right:0;z-index:30;height:20px;background:#000;border-top:1px solid rgba(var(--c-white),.05);overflow:hidden;}
#ticker{white-space:nowrap;font-size:5px;color:rgba(var(--c-white),.28);letter-spacing:.12em;display:inline-block;padding-top:4px;animation:tickscroll 32s linear infinite;}
@keyframes tickscroll{from{transform:translateX(100vw);}to{transform:translateX(-100%);}}

/* ══ S1 BOOT ══════════════════════════════════════════════ */
#s-boot{padding-bottom:0;gap:2px;}
.logo1{font-size:clamp(22px,4.5vw,38px);color:var(--cyan);letter-spacing:.12em;text-shadow:3px 3px 0 rgba(0,80,140,1),0 0 20px rgba(0,229,255,.5);}
.logo2{font-size:clamp(22px,4.5vw,38px);color:var(--green);letter-spacing:.12em;text-shadow:3px 3px 0 rgba(0,80,40,1),0 0 20px rgba(0,255,136,.5);}
.logosep{font-size:clamp(10px,2vw,14px);color:rgba(var(--c-white),.25);letter-spacing:.20em;display:block;margin:4px 0;}
.logobar{height:3px;margin:8px auto;width:180px;animation:lbar 1.0s steps(1) infinite;}
.logobar.c{background:var(--cyan);box-shadow:0 0 0 1px rgba(0,229,255,.3),3px 3px 0 rgba(0,60,120,1);}
.logobar.g{background:var(--green);animation-delay:.5s;box-shadow:0 0 0 1px rgba(0,255,136,.3),3px 3px 0 rgba(0,60,20,1);}
@keyframes lbar{0%,49%{opacity:1;width:180px;}50%,74%{opacity:0;width:180px;}75%,100%{opacity:1;width:120px;}}
.boot-sub{font-size:7px;color:rgba(var(--c-white),.45);letter-spacing:.18em;margin-top:12px;}
.boot-stats{display:grid;grid-template-columns:1fr 1fr;gap:1px;width:320px;margin:14px auto;border:2px solid rgba(var(--c-white),.18);}
.bs{display:flex;justify-content:space-between;padding:5px 9px;border-bottom:1px solid rgba(var(--c-white),.10);font-size:5px;}
.bs-l{color:rgba(var(--c-white),.50);letter-spacing:.08em;}.bs-v{color:var(--cyan);}
.boot-press{margin-top:16px;font-size:8px;letter-spacing:.18em;color:#fff;text-shadow:2px 2px 0 rgba(0,0,0,1);}

/* ══ S2 MODE ══════════════════════════════════════════════ */
#s-mode{padding:10px 0;}
.mode-prompt{font-size:8px;letter-spacing:.22em;color:rgba(var(--c-white),.40);margin-bottom:18px;}
.mode-row{display:flex;gap:14px;}
.mcard{width:210px;border:2px solid rgba(var(--c-white),.09);background:#000;cursor:pointer;display:flex;flex-direction:column;transition:border-color .12s;position:relative;overflow:hidden;}
.mcard::after{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:var(--ac);opacity:0;transition:opacity .15s;}
.mcard:hover{border-color:var(--ac);}.mcard:hover::after{opacity:1;}
.mcard[data-m=&quot;a&quot;]{--ac:var(--cyan);}.mcard[data-m=&quot;d&quot;]{--ac:var(--green);}
.mcard-sp{height:88px;background:#0a1220;display:flex;align-items:center;justify-content:center;border-bottom:2px solid rgba(var(--c-white),.04);position:relative;overflow:hidden;}
.mcard-sp::after{content:'';position:absolute;inset:0;background:repeating-linear-gradient(0deg,rgba(0,0,0,.25) 0,rgba(0,0,0,.25) 1px,transparent 1px,transparent 3px);pointer-events:none;}
.mcard-hd{padding:11px 13px 9px;border-bottom:1px solid rgba(var(--c-white),.04);}
.mc-role{font-size:5px;color:rgba(var(--c-white),.32);letter-spacing:.18em;margin-bottom:5px;}
.mc-name{font-size:13px;letter-spacing:.05em;}
.mcard-bd{padding:11px 13px 0;flex:1;}
.mc-tag{font-size:6px;color:rgba(var(--c-white),.38);line-height:2;margin-bottom:8px;}
.mc-obj{font-size:5px;color:rgba(var(--c-white),.30);padding:4px 0;border-bottom:1px solid rgba(var(--c-white),.04);display:flex;gap:6px;letter-spacing:.05em;line-height:1.8;}
.mc-obj::before{content:'▸';opacity:.3;flex-shrink:0;}
.mcard-btn{margin:10px 11px 12px;padding:8px;text-align:center;font-family:inherit;font-size:6px;letter-spacing:.13em;border:1px solid rgba(var(--c-white),.10);background:rgba(var(--c-white),.02);color:rgba(var(--c-white),.45);cursor:pointer;transition:all .12s;}
.mcard:hover .mcard-btn{border-color:var(--ac);color:var(--ac);}
.vs{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;}
.vs-t{font-size:11px;color:rgba(var(--c-white),.55);text-shadow:2px 2px 0 rgba(0,0,0,1),0 0 12px rgba(var(--c-white),.3);animation:vspulse 1.8s steps(1) infinite;}
@keyframes vspulse{0%,49%{opacity:1;}50%,100%{opacity:.3;}}
.vs-l{width:1px;height:50px;background:linear-gradient(to bottom,transparent,rgba(var(--c-white),.20),transparent);}

/* ══ S3 RULES ══════════════════════════════════════════════ */
#s-rules{padding:8px 16px;justify-content:center;}
.rules-w{width:660px;max-width:96vw;margin-top:0;}
.rules-hd{display:flex;align-items:center;gap:10px;margin-bottom:10px;}
.rules-badge{font-size:6px;letter-spacing:.16em;padding:5px 11px;border:1px solid;}
.rules-title{font-size:12px;letter-spacing:.05em;}
.rule-item{display:flex;align-items:flex-start;gap:10px;padding:7px 10px;border-bottom:1px solid rgba(var(--c-white),.06);}
.rule-item:first-child{border-top:1px solid rgba(var(--c-white),.06);}
.ri-icon{font-size:7px;width:24px;flex-shrink:0;text-align:center;font-family:inherit;color:rgba(var(--c-white),.55);letter-spacing:0;}
.ri-title{font-size:7px;letter-spacing:.10em;margin-bottom:4px;}
.ri-body{font-size:5px;color:rgba(var(--c-white),.42);line-height:1.7;letter-spacing:.04em;}
.pu-row{display:flex;gap:8px;margin:8px 0;}
.pu-chip{flex:1;border:1px solid rgba(var(--c-white),.10);padding:7px 10px;background:#000;}
.pu-nm{font-size:6px;letter-spacing:.12em;margin-bottom:4px;}
.pu-ic{font-size:11px;margin-bottom:4px;display:block;}
.pu-dc{font-size:5px;color:rgba(var(--c-white),.34);line-height:1.9;letter-spacing:.05em;}

/* ══ S4 THEME ══════════════════════════════════════════════ */
#s-theme{padding:8px 16px;justify-content:center;}
.theme-w{width:680px;max-width:96vw;margin-top:0;}
.th-hed{font-size:11px;letter-spacing:.05em;margin-bottom:3px;text-shadow:2px 2px 0 rgba(0,0,0,1);}
.th-sub{font-size:6px;color:rgba(var(--c-white),.35);letter-spacing:.12em;margin-bottom:10px;}
.mini-prev{width:100%;height:52px;border:1px solid rgba(var(--c-white),.12);position:relative;overflow:hidden;margin-bottom:10px;background:#000;}
#mini-canvas{display:block;}
.mini-lbl{position:absolute;bottom:4px;right:7px;font-size:4px;color:rgba(var(--c-white),.13);letter-spacing:.14em;}
.th-grid{display:flex;gap:7px;margin-bottom:10px;}
.th-tile{flex:1;cursor:pointer;border:2px solid rgba(var(--c-white),.07);background:#000;overflow:hidden;transition:border-color .12s;}
.th-tile:hover{border-color:rgba(var(--c-white),.22);}.th-tile.sel{border-color:var(--tc);}
.th-tile.sel .ttchk{background:var(--tc);color:#000;}
.ttsw{height:38px;}.ttnm{font-size:5px;letter-spacing:.10em;padding:5px 6px 2px;}.ttsg{font-size:4px;letter-spacing:.08em;padding:0 6px 4px;color:rgba(var(--c-white),.28);}
.ttchk{font-size:5px;margin:0 6px 5px;padding:2px 5px;border:1px solid rgba(var(--c-white),.14);color:rgba(var(--c-white),.25);display:inline-block;transition:all .10s;}
.launch-row{display:flex;align-items:center;gap:10px;}
.launch-btn{font-family:inherit;font-size:7px;letter-spacing:.14em;padding:10px 22px;cursor:pointer;background:#000;color:rgba(var(--c-white),.85);border:2px solid rgba(var(--c-white),.25);transition:all .12s;}
.launch-btn:not([disabled]):hover{background:rgba(var(--c-white),.05);border-color:rgba(var(--c-white),.38);color:#fff;}
.launch-btn[disabled]{opacity:.20;cursor:not-allowed;}
.lsum{font-size:5px;color:rgba(var(--c-white),.30);letter-spacing:.11em;line-height:1.7;}

/* ══ S5 GAME ══════════════════════════════════════════════ */
#s-game{padding:20px 0 20px;gap:0;justify-content:center;}
#game-wrap{position:relative;display:flex;flex-direction:column;align-items:center;gap:0;}
#game-hud{width:100%;display:flex;align-items:center;justify-content:space-between;padding:6px 8px;background:#000;border:1px solid rgba(var(--c-white),.07);border-bottom:none;font-size:6px;}
.hud-keys{display:flex;align-items:center;gap:8px;color:rgba(var(--c-white),.35);letter-spacing:.12em;}
.key-pip{width:8px;height:8px;border:1px solid rgba(var(--c-white),.20);transition:background .1s,border-color .1s,transform .1s;}
.key-pip.flash{animation:pipflash .35s steps(2) 2;}
@keyframes pipflash{0%{transform:scale(1.8);background:#fff;}100%{transform:scale(1);}}
.key-pip.got{background:var(--gold);border-color:var(--gold);box-shadow:0 0 5px var(--gold);}
.hud-mode{font-size:5px;letter-spacing:.14em;padding:3px 8px;border:1px solid;}
.hud-power{font-size:5px;letter-spacing:.12em;color:rgba(var(--c-white),.22);min-width:120px;text-align:right;transition:color .2s;}
#game-canvas-wrap{position:relative;}
canvas#gc{display:block;}
canvas#tc{position:absolute;top:0;left:0;pointer-events:none;opacity:0;transition:opacity .18s;}
#game-msg{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);
  background:rgba(0,0,0,.92);border:2px solid rgba(var(--c-white),.25);padding:20px 28px;text-align:center;z-index:50;display:none;}
#game-msg .gm-title{font-size:14px;letter-spacing:.08em;margin-bottom:10px;}
#game-msg .gm-sub{font-size:6px;color:rgba(var(--c-white),.42);letter-spacing:.10em;line-height:2;}
#game-msg .gm-btns{display:flex;gap:8px;margin-top:16px;justify-content:center;}
#game-bottom{width:100%;display:flex;align-items:center;justify-content:center;gap:20px;padding:5px 8px;background:#000;border:1px solid rgba(var(--c-white),.07);border-top:none;}
.gbot-hint{font-size:5px;color:rgba(var(--c-white),.14);letter-spacing:.10em;}

/* ══ NAV BUTTONS ══════════════════════════════════════════ */
.nav-btn{font-family:inherit;font-size:6px;letter-spacing:.13em;padding:9px 16px;cursor:pointer;background:#000;color:rgba(var(--c-white),.28);border:1px solid rgba(var(--c-white),.08);transition:all .13s;}
.nav-btn:hover{border-color:rgba(var(--c-white),.20);color:rgba(var(--c-white),.55);}
.nav-btn.pri{border-color:rgba(var(--c-white),.17);color:rgba(var(--c-white),.65);}
.nav-btn.pri:hover{border-color:rgba(var(--c-white),.33);color:#fff;}
.nav-row{display:flex;gap:8px;margin-top:8px;}

/* ══ MOBILE ══════════════════════════════════════════════
   This whole document had zero width-based media queries until now — every
   other screen (rules/theme select) already has a max-width:96vw safety net
   on its own container, but the boot stats grid and the mode-select role
   cards were both fixed-pixel with nothing to shrink them. The game panel
   itself can be as narrow as ~94vw of the host page's viewport (see about.astro's
   own @media max-width:980px rule on .game-panel), so on a real phone this
   iframe's own viewport can land well under the 320-488px these needed —
   and since html/body here are overflow:hidden, that overflow was silently
   clipped rather than scrollable, not just visually cramped. */
@media (max-width:480px){
  .boot-stats{ width:min(320px, 90vw); }
  .mode-row{ flex-direction:column; align-items:center; gap:10px; }
  .mcard{ width:min(210px, 90vw); }
  .vs{ flex-direction:row; gap:10px; }
  .vs-l{ width:50px; height:1px; background:linear-gradient(to right,transparent,rgba(var(--c-white),.20),transparent); }
}

