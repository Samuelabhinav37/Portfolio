&lt;style&gt;
:root{--cyan:#00e5ff;--green:#00ff88;--gold:#ffcc00;--red:#ff2244;--purple:#cc44ff;--orange:#ff8800;}
*{margin:0;padding:0;box-sizing:border-box;image-rendering:pixelated;}
