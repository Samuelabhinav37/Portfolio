<script is:inline>
/* The game's whole HTML/JS lives in data-srcdoc rather than srcdoc so the
   iframe never gets a document (and never starts its boot sequence / canvas
   loops) at all on phone/tablet — .game-panel is display:none there (see
   the max-width:900px rule above), but an iframe still parses+runs srcdoc
   content behind display:none, so hiding it with CSS alone wouldn't have
   stopped the game from actually running. */
(function(){
  var ifr = document.getElementById('game-iframe');
  if(!ifr) return;
  if(window.SITE && window.SITE.LOW_POWER){ ifr.remove(); return; }
  ifr.srcdoc = ifr.getAttribute('data-srcdoc');
  ifr.removeAttribute('data-srcdoc');
})();
</script>

