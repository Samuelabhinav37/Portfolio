<Fonts />
<Motion />
<style is:global>
* { margin:0; padding:0; box-sizing:border-box; }
html, body { background:var(--c-bg); color:rgba(var(--c-white),0.9); overflow-x:hidden; }
body { font-family:'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; -webkit-font-smoothing:antialiased; }

/* Night sky: the painted wash and star dust from scripts/paint, with the contact
   page's jellyfish (SkyLife); the homepage's film grain and vignette on top. */
.ab-sky{ position:fixed; inset:0; z-index:0; pointer-events:none;
  background:url(/images/paint/stars-tile.webp) 0 0 / 1024px, url(/images/paint/wash-tile.webp) 0 0 / 1024px; }
.page-grain{ position:fixed; inset:0; z-index:2147483000; pointer-events:none; }
.page-grain::before{ content:""; position:absolute; inset:0; background:radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(2,4,12,.55) 100%); }
.page-grain::after{ content:""; position:absolute; inset:0; background:url(/images/grain.webp) repeat; opacity:.06; }

/* ── Layout after fattah.me/info: label | index | content on a 12-column grid ── */
.ab{ position:relative; z-index:2; display:grid; grid-template-columns:repeat(12, 1fr); column-gap:16px;
  padding:clamp(120px, 15vh, 168px) var(--gut, clamp(16px, 3.2vw, 48px)) 0; max-width:1600px; margin:0 auto; }
/* Inter, like the reference: wider than the site's Inter Tight, so lines run long */
.ab{ font-family:'Inter', 'Inter Tight', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
.ab-label{ grid-column:1 / 3; font-size:13px; font-weight:500; color:#f4f6fa; }
.ab-index{ grid-column:3 / 5; align-self:start; position:sticky; top:128px; display:flex; flex-direction:column; gap:7px; }
.ab-index a{ font-size:13px; color:rgba(var(--c-white),0.42); text-decoration:none; transition:color var(--dur-fast); width:max-content; display:flex; gap:10px; }
.ab-index a:hover, .ab-index a.on{ color:#f4f6fa; }
.ix-n{ font-family:'JetBrains Mono', monospace; font-size:11px; opacity:.6; padding-top:1px; }
/* a game HUD over the index (after the FPS-style tracker in Robin Navas' "Roots to Leaves"):
   the section you are in, out of how many, and a ring for how far down the page you are */
.ab-hud{ display:flex; align-items:center; gap:10px; margin-bottom:14px; font-family:'JetBrains Mono', monospace; }
.ab-hud svg{ width:34px; height:34px; transform:rotate(-90deg); flex:none; }
.ab-hud circle{ fill:none; stroke-width:2; }
.hud-track{ stroke:rgba(var(--c-white),0.1); }
.hud-fill{ stroke:#9cc0ff; stroke-dasharray:1; stroke-dashoffset:calc(1 - var(--p, 0)); stroke-linecap:round; }
.hud-n{ font-size:18px; font-weight:500; color:#f4f6fa; font-variant-numeric:tabular-nums; }
.hud-of{ font-size:11px; color:rgba(var(--c-white),0.42); }
.ab-main{ grid-column:5 / 13; min-width:0; }
.ab-lbl{ font-size:13px; font-weight:600; color:rgba(var(--c-white),0.85); }
.card-hd .ab-lbl + .ab-lbl{ font-weight:400; color:rgba(var(--c-white),0.45); }

.ab-sec{ scroll-margin-top:120px; }
.ab-sec + .ab-sec{ margin-top:clamp(96px, 14vh, 150px); }
.ab-h{ font-size:20px; font-weight:700; letter-spacing:-.005em; color:#f4f6fa; margin-bottom:16px; width:max-content; max-width:100%; transform-origin:0 50%; }

/* intro: one long sentence across the whole column, as on fattah.me/info */
.ab-kicker{ display:block; font-size:13px; font-weight:600; color:#f4f6fa; margin-bottom:22px; }
.ab-intro{ font-size:clamp(22px, 1.8vw, 28px); font-weight:500; line-height:1.3; letter-spacing:-.01em; color:#f4f6fa; }
.ab-intro b{ font-weight:700; }
.ab-bio{ margin-top:30px; max-width:72ch; }
.ab-bio p{ font-size:18px; line-height:1.6; color:rgba(var(--c-white),0.62); }

/* headings arrive word by word, each rising out of a blur (split + trigger in the script below) */
html.motion [data-words]:not(.split){ visibility:hidden; }
[data-words] .w{ display:inline-block; opacity:0; filter:blur(8px); transform:translateY(.4em);
  transition:opacity .8s var(--ease-out), filter .8s var(--ease-out), transform .8s var(--ease-out); transition-delay:calc(var(--i) * 45ms); }
[data-words].in .w{ opacity:1; filter:none; transform:none; }
@media (prefers-reduced-motion: reduce){ [data-words] .w{ opacity:1; filter:none; transform:none; transition:none; } }
.ab-bio p + p{ margin-top:14px; }
.ab-bio b{ font-weight:500; color:#f4f6fa; }

/* portrait: placeholder until the real photo arrives; a photo gets the grain and greyscale */
.ab-portrait{ position:relative; margin-top:64px; aspect-ratio:16 / 10; border-radius:10px; overflow:hidden;
  background:#05070d; border:1px solid rgba(var(--c-white),0.1); display:grid; place-items:center; }
.ab-portrait img{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; filter:grayscale(1) contrast(1.05); }
.ab-portrait:has(img)::after{ content:''; position:absolute; inset:0; background:url(/images/grain.webp); opacity:.3; mix-blend-mode:overlay; }
.ab-portrait .ab-lbl{ position:relative; color:rgba(var(--c-white),0.7); background:rgba(3,5,12,.8); padding:7px 12px; border-radius:999px; }
.ab-portrait:has(img) .ab-lbl{ display:none; }

/* registration marks (after gertix.studio): a small + on each outer corner of a block */
.xm{ position:relative; }
.xm::before{ content:''; position:absolute; inset:-6px; pointer-events:none; --x:linear-gradient(rgba(var(--c-white),0.4), rgba(var(--c-white),0.4));
  background:var(--x) left 0 top 6px / 13px 1px, var(--x) left 6px top 0 / 1px 13px, var(--x) right 0 top 6px / 13px 1px, var(--x) right 6px top 0 / 1px 13px,
    var(--x) left 0 bottom 6px / 13px 1px, var(--x) left 6px bottom 0 / 1px 13px, var(--x) right 0 bottom 6px / 13px 1px, var(--x) right 6px bottom 0 / 1px 13px;
  background-repeat:no-repeat; }

/* toolkit after mikewilcockdesign.com/about: two columns of dashed hairline rows, plus logos */
.tk{ list-style:none; display:grid; grid-template-columns:1fr 1fr; column-gap:32px; border-top:1px dashed rgba(var(--c-white),0.16); }
.tk li{ display:flex; align-items:center; gap:14px; padding:16px 0; border-bottom:1px dashed rgba(var(--c-white),0.16);
  font-size:20px; color:rgba(var(--c-white),0.78); transition:padding .5s var(--ease-out), color .3s; }
.tk-logo{ width:22px; height:22px; flex:none; background:currentColor; opacity:.72; transition:opacity .3s;
  -webkit-mask:var(--logo) center / contain no-repeat; mask:var(--logo) center / contain no-repeat; }
.tk-mono{ width:22px; height:22px; flex:none; display:grid; place-items:center; border:1px solid currentColor; border-radius:5px; opacity:.72;
  font-family:'JetBrains Mono', monospace; font-size:9px; font-weight:600; letter-spacing:0; }
.tk li::after{ content:''; width:5px; height:5px; border-radius:50%; background:#9cc0ff; margin-left:auto; opacity:0; transform:scale(0); transition:opacity .3s, transform .4s var(--ease-out); }
@media (hover:hover){
  .tk li:hover{ padding-left:12px; color:#f4f6fa; }
  .tk li:hover .tk-logo, .tk li:hover .tk-mono{ opacity:1; }
  .tk li:hover::after{ opacity:1; transform:none; }
}

/* ── bento ── */
.bento{ display:grid; grid-template-columns:repeat(3, 1fr); grid-template-rows:auto 280px; gap:10px;
  grid-template-areas:"certs certs wire" "team gh wire"; }
.card{ position:relative; background:rgba(0,0,0,.82); border:1px solid rgba(var(--c-white),0.08); border-top-color:rgba(var(--c-white),0.14);
  border-radius:12px; overflow:hidden; display:flex; flex-direction:column; }
/* a faint dot screen inside every card, like a dithered print */
.card::before{ content:""; position:absolute; inset:0; pointer-events:none; background:radial-gradient(rgba(255,255,255,.05) 1px, transparent 1.3px) 0 0 / 7px 7px; }
.card > *{ position:relative; }
/* a soft light that follows the cursor around the card edges (pointer vars set below) */
.card::after{ content:''; position:absolute; inset:0; border-radius:inherit; padding:1px; pointer-events:none; opacity:0; transition:opacity .4s;
  background:radial-gradient(260px circle at var(--mx, -999px) var(--my, -999px), rgba(170,200,255,.55), transparent 70%);
  -webkit-mask:linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite:xor; mask-composite:exclude; }
@media (hover:hover){ .bento:hover .card::after{ opacity:1; } }
.card-hd{ display:flex; align-items:baseline; justify-content:space-between; padding:16px 18px 0; }

.c-certs{ grid-area:certs; padding-bottom:18px; }
.cb-wrap{ flex:1; display:flex; align-items:center; overflow:hidden; padding-top:18px;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent); mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent); }
.cb-track{ display:inline-flex; gap:26px; white-space:nowrap; animation:cbscroll 34s linear infinite; }
.cb-wrap:hover .cb-track{ animation-play-state:paused; }
@keyframes cbscroll{ from{ transform:translateX(0) } to{ transform:translateX(-50%) } }
.cb{ display:inline-flex; flex-direction:column; align-items:center; gap:10px; width:100px; }
/* black and white so they sit quietly in the card; full colour on hover */
.cb img{ width:66px; height:66px; object-fit:contain; border-radius:10px; filter:grayscale(1) brightness(.9); opacity:.8;
  transition:transform .3s var(--ease-out), filter .4s, opacity .4s; }
.cb:hover img{ transform:translateY(-3px) scale(1.06); filter:none; opacity:1; }
/* only CompTIA's badge art has an opaque white square baked in: inverted, that square turns black like the card */
.cb--framed img{ filter:grayscale(1) invert(1) brightness(.9); }
.cb span{ font-size:12px; color:#a4a4aa; white-space:normal; text-align:center; line-height:1.2; }

/* on the wire: the newest actively exploited CVEs, each line typing out in turn (after kvs.services).
   Monospace, so a line's width is its length in ch and steps() can reveal it one character at a time. */
.c-wire{ grid-area:wire; padding-bottom:18px; }
.wr-src{ text-decoration:none; transition:color .3s; }
.wr-src:hover{ color:#f4f6fa; }
.wr-list{ list-style:none; padding:10px 18px 0; display:flex; flex-direction:column; }
.wr-list li{ padding:10px 0; border-bottom:1px dashed rgba(var(--c-white),0.1); font-family:'JetBrains Mono', monospace; }
.wr-t{ display:block; width:calc(var(--n) * 1ch); max-width:100%; overflow:hidden; white-space:nowrap; }
.wr-cve{ font-size:13px; font-weight:500; color:#f4f6fa; }
.wr-what{ margin-top:4px; font-size:12px; color:rgba(var(--c-white),0.55); }
html.motion .c-wire:not(.in) .wr-t{ width:0; }
/* backwards, not both: a finished run can stop a hair short of 1, which steps() rounds down a whole character */
.c-wire.in .wr-t{ animation:wrType calc(var(--n) * 20ms) steps(var(--n), end) var(--d) backwards; }
@keyframes wrType{ from{ width:0; } }
.wr-foot{ margin:auto 18px 0; padding-top:16px; font-size:13px; line-height:1.5; color:rgba(var(--c-white),0.55); }
.wr-foot::after{ content:''; display:inline-block; width:.55em; height:1em; margin-left:4px; vertical-align:-2px; background:#9cc0ff; animation:wrCaret 1s steps(1) infinite; }
@keyframes wrCaret{ 50%{ opacity:0; } }
@media (prefers-reduced-motion: reduce){ .wr-foot::after{ animation:none; } }

/* github: the last 26 weeks as a dot matrix, built from github.com at build time */
.c-gh{ grid-area:gh; color:inherit; text-decoration:none; }
.gh-big{ padding:12px 18px 0; display:flex; align-items:baseline; gap:10px; }
.gh-num{ font-size:44px; font-weight:700; letter-spacing:-.03em; line-height:1; color:#f4f6fa; font-variant-numeric:tabular-nums; }
.gh-cap{ font-size:13px; color:rgba(var(--c-white),0.55); }
.gh-map{ margin:auto 18px 18px; display:grid; grid-template-rows:repeat(7, 1fr); grid-auto-flow:column; grid-auto-columns:1fr; gap:3px; aspect-ratio:26 / 7; }
.gh-map i{ display:block; border-radius:50%; background:#f4f6fa; place-self:center; width:calc(28% + var(--l) * 18%); aspect-ratio:1; opacity:calc(.1 + var(--l) * .22);
  transition:opacity .5s, transform .6s var(--ease-out); transition-delay:calc(var(--c) * 22ms); }
html.motion .c-gh:not(.in) .gh-map i{ opacity:0; transform:scale(.2); }
.c-gh:hover .gh-cap{ color:#f4f6fa; }

.c-team{ grid-area:team; padding-bottom:16px; }
.poke-grid{ flex:1; display:grid; grid-template-columns:repeat(3, 1fr); gap:6px; padding:14px 14px 0; }
.poke-slot{ background:rgba(var(--c-white),0.03); border:1px solid rgba(var(--c-white),0.06); border-radius:8px; padding:8px 4px 7px;
  display:flex; flex-direction:column; align-items:center; justify-content:center; gap:4px; transition:background .3s, border-color .3s; }
.poke-slot img{ width:50px; height:50px; object-fit:contain; image-rendering:pixelated; filter:grayscale(1) brightness(.82) contrast(1.08); transition:filter .4s, transform .4s var(--ease-out); }
.poke-slot:hover{ background:rgba(var(--c-white),0.06); border-color:rgba(var(--c-white),0.14); }
.poke-slot:hover img{ filter:none; transform:translateY(-3px); }
.poke-name{ font-size:12px; color:rgba(var(--c-white),0.55); }

/* ── arcade ── */
/* a band of halftone cloud behind the heading (after detections.ai): square dots sized by the
   brightness of a noise cloud, drawn once into a canvas by the script below */
#arcade{ position:relative; }
.ab-dots{ position:absolute; left:0; top:-190px; width:100%; height:250px; z-index:-1; pointer-events:none;
  -webkit-mask-image:radial-gradient(60% 55% at 30% 60%, #000 15%, transparent 72%); mask-image:radial-gradient(60% 55% at 30% 60%, #000 15%, transparent 72%); }
.ab-arcade-sub{ font-size:19px; line-height:1.6; color:rgba(var(--c-white),0.62); margin:-8px 0 24px; max-width:60ch; }
/* the game sits in an old TV (after poolsuite.net and kvs.services): a plastic shell with a
   window bar on top, a rounded screen with glass and vignette, a channel strip and two knobs below */
.game-panel{ background:linear-gradient(180deg, #17191f, #0b0c10); border:1px solid rgba(var(--c-white),0.1); border-radius:22px; padding:0 16px 14px;
  box-shadow:inset 0 1px 0 rgba(var(--c-white),0.08), 0 40px 90px -40px rgba(0,0,0,.95); display:flex; flex-direction:column; }
.game-hdr{ height:42px; display:grid; grid-template-columns:1fr auto 1fr; align-items:center; }
.tv-btns{ display:flex; gap:7px; }
.tv-btns i{ width:11px; height:11px; border-radius:3px; border:1px solid rgba(var(--c-white),0.22); background:rgba(var(--c-white),0.04); }
.game-hdr-title{ font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:.26em; color:rgba(var(--c-white),0.6); text-transform:uppercase; }
.tv-air{ justify-self:end; display:inline-flex; align-items:center; gap:8px; font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:.22em; color:rgba(255,120,110,.9);
  padding:4px 8px; border:1px solid rgba(255,120,110,.35); border-radius:4px; }
.tv-air-dot{ width:6px; height:6px; border-radius:50%; background:#ff5a4e; box-shadow:0 0 8px #ff5a4e; animation:gdot 2s ease-in-out infinite; }
@keyframes gdot{ 0%,100%{ opacity:1 } 50%{ opacity:.3 } }
.tv-foot{ display:flex; align-items:center; justify-content:space-between; padding:12px 4px 0; font-family:'JetBrains Mono', monospace; font-size:10px; letter-spacing:.2em; color:rgba(var(--c-white),0.4); }
.tv-knobs{ display:flex; gap:12px; }
.tv-knobs i{ width:20px; height:20px; border-radius:50%; background:radial-gradient(circle at 35% 30%, #3a3e48, #121318 70%); box-shadow:0 1px 0 rgba(var(--c-white),0.08), 0 2px 6px rgba(0,0,0,.6); position:relative; }
.tv-knobs i::after{ content:''; position:absolute; left:50%; top:3px; width:2px; height:6px; margin-left:-1px; border-radius:1px; background:rgba(var(--c-white),0.5); }
.tv-knobs i:last-child{ transform:rotate(130deg); }
/* the screen: rounded like a tube, glass glare and a vignette on top (they never take clicks) */
.game-stage::after{ content:''; position:absolute; inset:0; z-index:3; pointer-events:none; border-radius:inherit;
  background:linear-gradient(160deg, rgba(var(--c-white),0.06), transparent 32%), radial-gradient(ellipse at center, transparent 60%, rgba(0,0,0,.5) 100%);
  box-shadow:inset 0 0 60px rgba(0,0,0,.6); }
.game-stage{ position:relative; height:clamp(560px, 78vh, 720px); display:flex; border-radius:18px; overflow:hidden; background:#000; box-shadow:0 0 0 1px #000, 0 0 0 5px #08090c; }
/* power-on, like an old CRT: a bright line, then the picture opens with a flicker (.on added on first sight) */
html.motion .game-stage:not(.on){ transform:scale(.4, .004); filter:brightness(4); }
.game-stage.on{ animation:crtOn 1.1s var(--ease-out) both; }
@keyframes crtOn{
  0%{ transform:scale(.4, .004); filter:brightness(4); }
  30%{ transform:scale(1, .004); filter:brightness(4); }
  60%{ transform:none; filter:brightness(1.8); opacity:1; }
  68%{ opacity:.55; } 76%{ opacity:1; } 84%{ opacity:.8; }
  100%{ transform:none; filter:none; opacity:1; }
}
@media (prefers-reduced-motion: reduce){ .game-stage.on{ animation:none; } }
/* the cover hands the keyboard to the game, so arrow keys stop scrolling the page */
/* button sits low so the game's own title screen stays readable above it */
.game-play{ position:absolute; inset:0; z-index:2; display:grid; place-items:end center; padding-bottom:12%; border:0; cursor:pointer; color:#f4f6fa;
  background:linear-gradient(transparent 45%, rgba(0,0,0,.7)); transition:opacity .4s var(--ease-out); }
.game-play span{ font-family:'Press Start 2P', monospace; font-size:12px; letter-spacing:.12em; padding:14px 20px; border:1px solid rgba(var(--c-white),0.35); border-radius:6px;
  background:rgba(0,0,0,.6); transition:border-color .3s, transform .4s var(--ease-out); }
.game-play:hover span, .game-play:focus-visible span{ border-color:#f4f6fa; transform:scale(1.04); }
.game-play.gone{ opacity:0; pointer-events:none; }

/* footer */
.pg-footer{ grid-column:1 / -1; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px 20px;
  margin-top:clamp(110px, 16vh, 170px); padding:18px 0 32px; border-top:1px solid rgba(var(--c-white),0.1);
  font-family:'JetBrains Mono', monospace; font-size:11px; letter-spacing:.1em; color:rgba(var(--c-white),0.62); }
.pg-footer .f-links{ display:flex; align-items:center; gap:16px; letter-spacing:.16em; text-transform:uppercase; }
.pg-footer .f-links a{ color:rgba(var(--c-white),0.55); text-decoration:none; transition:color .25s; display:inline-flex; align-items:center; gap:5px; }
.pg-footer .f-links a:hover{ color:rgba(var(--c-white),0.92); }
.pg-footer .f-links .fic{ width:12px; height:12px; fill:currentColor; opacity:.9; flex:none; }

@media (prefers-reduced-motion: reduce){
  .cb-track, .tv-air-dot{ animation:none; }
}

@media (--bp-900){
  .ab{ grid-template-columns:1fr; padding-top:112px; }
  .ab-label, .ab-main, .pg-footer{ grid-column:1; }
  .ab-index{ display:none; }
  .ab-label{ margin-bottom:22px; }
  .ab-bio p, .ab-arcade-sub{ font-size:17px; }
  .ab-portrait{ margin-top:44px; aspect-ratio:4 / 5; }
  .tk{ grid-template-columns:1fr; }
  .tk li{ font-size:18px; padding:14px 0; }
  .bento{ grid-template-columns:1fr; grid-template-rows:auto; grid-template-areas:"certs" "wire" "gh" "team"; }
  .c-gh{ min-height:220px; }
  .poke-grid{ grid-template-columns:repeat(3, 1fr); }
  /* the game (and its 70KB script) never boots on phones; see the boot script below */
  #arcade, .ab-index a[data-spy="arcade"]{ display:none; }
}
</style>
