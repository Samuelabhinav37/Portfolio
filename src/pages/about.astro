<script is:inline>
/* sandbox includes allow-same-origin on purpose. Without it the frame has an
   opaque ("null") origin, so its requests for /scripts/about-arcade-game.js
   and /fonts/fonts.css count as cross-origin, and the site-wide
   Cross-Origin-Resource-Policy: same-origin (public/_headers) blocks them:
   in production the game showed its menu and never ran. The frame only ever
   holds this page's own srcdoc, so same-origin grants nothing to anyone else.
   The game lives in data-srcdoc so it never boots on phones (where the
   section is hidden) and only boots on desktop once it is near the screen. */
(function(){
  var ifr = document.getElementById('game-iframe');
  var play = document.querySelector('.game-play');
  if(!ifr) return;
  if(window.SITE && window.SITE.LOW_POWER){ ifr.remove(); if(play) play.remove(); return; }
  var io = new IntersectionObserver(function(es){
    if(!es[0].isIntersecting) return;
    io.disconnect();
    ifr.srcdoc = ifr.getAttribute('data-srcdoc');
    ifr.removeAttribute('data-srcdoc');
  }, { rootMargin:'600px 0px' });
  io.observe(ifr);
  play.addEventListener('click', function(){
    play.classList.add('gone');
    ifr.focus();
    try { ifr.contentWindow.focus(); } catch(e){}
  });
  // clicking back out to the page brings the cover back, so the page scrolls again
  addEventListener('focus', function(){ play.classList.remove('gone'); });
})();

/* [data-words] headings: wrap each word (keeping <b> etc.) so CSS can stagger them in on first sight */
(function(){
  var els = document.querySelectorAll('[data-words]');
  els.forEach(function(el){
    var n = 0;
    el.setAttribute('aria-label', el.textContent.replace(/\s+/g, ' ').trim());
    (function walk(node){
      Array.prototype.slice.call(node.childNodes).forEach(function(c){
        if(c.nodeType === 1){ walk(c); return; }
        if(c.nodeType !== 3) return;
        var frag = document.createDocumentFragment();
        c.textContent.split(/(\s+)/).forEach(function(part){
          if(!part) return;
          if(/^\s+$/.test(part)){ frag.appendChild(document.createTextNode(part)); return; }
          var s = document.createElement('span');
          s.className = 'w'; s.setAttribute('aria-hidden', 'true'); s.style.setProperty('--i', n++); s.textContent = part;
          frag.appendChild(s);
        });
        c.replaceWith(frag);
      });
    })(el);
    el.classList.add('split');
  });
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target); } });
  }, { rootMargin:'0px 0px -12% 0px' });
  els.forEach(function(el){ io.observe(el); });
})();

/* light the index entry for the section in view; the HUD shows its number and, on its ring,
   how far through the page you are (offsets cached on resize, so a scroll frame reads no layout) */
(function(){
  var links = Array.prototype.slice.call(document.querySelectorAll('.ab-index [data-spy]'));
  var hud = document.querySelector('.ab-hud'), num = hud && hud.querySelector('.hud-n'), ring = hud && hud.querySelector('.hud-fill');
  var io = new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(!e.isIntersecting) return;
      links.forEach(function(a, i){
        var on = a.dataset.spy === e.target.id;
        a.classList.toggle('on', on);
        if(on && num) num.textContent = String(i + 1).padStart(2, '0');
      });
    });
  }, { rootMargin:'-35% 0px -60% 0px' });
  links.forEach(function(a){ var s = document.getElementById(a.dataset.spy); if(s) io.observe(s); });
  if(!ring) return;
  var main = document.querySelector('.ab-main'), top = 0, span = 1, raf = 0;
  function measure(){ top = main.getBoundingClientRect().top + scrollY; span = Math.max(1, main.offsetHeight - innerHeight * .6); paint(); }
  function paint(){ raf = 0; ring.style.setProperty('--p', Math.min(1, Math.max(0, (scrollY - top + innerHeight * .4) / span)).toFixed(3)); }
  addEventListener('scroll', function(){ if(!raf) raf = requestAnimationFrame(paint); }, { passive:true });
  addEventListener('resize', measure, { passive:true });
  addEventListener('load', measure, { once:true });
  measure();
})();

/* on the wire: the build-time rows type in on first sight. Shortly before that the page asks
   /api/kev for the live list and swaps in newer rows, so the card is current between deploys. */
(function(){
  var card = document.querySelector('.c-wire');
  if(!card) return;
  var list = card.querySelector('.wr-list'), foot = card.querySelector('.wr-foot');
  function row(v){
    var what = v.product.indexOf(v.vendorProject) === 0 ? v.product : v.vendorProject + ' ' + v.product;
    if(what.length > 28) what = what.slice(0, 27).trim() + '…';
    return { cve: v.cveID, what: what, date: v.dateAdded };
  }
  function render(rows){
    var at = 200;
    list.textContent = '';
    rows.forEach(function(r){
      var li = document.createElement('li');
      [['wr-cve', r.cve], ['wr-what', r.what]].forEach(function(p){
        var s = document.createElement('span');
        s.className = 'wr-t ' + p[0]; s.textContent = p[1];
        s.style.setProperty('--n', p[1].length); s.style.setProperty('--d', at + 'ms');
        at += p[1].length * 20 + 100;
        li.appendChild(s);
      });
      list.appendChild(li);
    });
    var d = new Date(rows[0].date + 'T00:00:00Z').toLocaleDateString('en-US', { month:'short', day:'numeric', timeZone:'UTC' });
    foot.textContent = 'Exploited in the wild. Newest added ' + d + '.';
  }
  var first = list.querySelector('.wr-cve');
  var near = new IntersectionObserver(function(es){
    if(!es[0].isIntersecting) return;
    near.disconnect();
    fetch('/api/kev').then(function(r){ return r.ok ? r.json() : null; }).then(function(d){
      if(!d || !d.items || !d.items.length) return;
      var rows = d.items.slice(0, 5).map(row);
      if(first && first.textContent === rows[0].cve) return;
      var typed = card.classList.contains('in');
      render(rows);
      // already typed out: type the fresh rows again
      if(typed){ card.classList.remove('in'); void card.offsetWidth; card.classList.add('in'); }
    }).catch(function(){});
  }, { rootMargin:'400px 0px' });
  near.observe(card);
  var io = new IntersectionObserver(function(es){ if(es[0].isIntersecting){ card.classList.add('in'); io.disconnect(); } }, { rootMargin:'0px 0px -15% 0px' });
  io.observe(card);
})();

/* github card: the dot matrix sweeps in left to right on first sight */
(function(){
  var gh = document.querySelector('.c-gh');
  if(!gh) return;
  var io = new IntersectionObserver(function(es){ if(es[0].isIntersecting){ gh.classList.add('in'); io.disconnect(); } }, { rootMargin:'0px 0px -15% 0px' });
  io.observe(gh);
})();

/* halftone band behind the Arcade heading: a soft value-noise cloud, sampled on a 7px grid,
   each sample drawn as a square dot whose size follows its brightness. Drawn once when near
   the screen, again on resize; nothing animates. */
(function(){
  var cv = document.querySelector('.ab-dots');
  if(!cv || !cv.getContext) return;
  var seed = [];
  for(var i = 0; i < 512; i++) seed.push(Math.random());
  function n2(x, y){
    var xi = Math.floor(x), yi = Math.floor(y), xf = x - xi, yf = y - yi;
    var h = function(a, b){ return seed[((a * 73856093) ^ (b * 19349663)) & 511]; };
    var u = xf * xf * (3 - 2 * xf), v = yf * yf * (3 - 2 * yf);
    return (h(xi, yi) * (1 - u) + h(xi + 1, yi) * u) * (1 - v) + (h(xi, yi + 1) * (1 - u) + h(xi + 1, yi + 1) * u) * v;
  }
  function cloud(x, y){ return n2(x, y) * .55 + n2(x * 2.1, y * 2.1) * .3 + n2(x * 4.3, y * 4.3) * .15; }
  function draw(){
    var w = cv.clientWidth, h = cv.clientHeight, dpr = Math.min(devicePixelRatio || 1, 2), G = 7;
    cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
    var x = cv.getContext('2d');
    x.setTransform(dpr, 0, 0, dpr, 0, 0);
    x.fillStyle = 'rgba(156,192,255,.42)';
    for(var gy = 0; gy < h; gy += G) for(var gx = 0; gx < w; gx += G){
      var b = Math.max(0, cloud(gx / 120, gy / 90) - .35) / .65;
      var s = Math.min(G - 1.5, b * b * 9);
      if(s > .6) x.fillRect(gx + (G - s) / 2, gy + (G - s) / 2, s, s);
    }
  }
  var io = new IntersectionObserver(function(es){
    if(!es[0].isIntersecting) return;
    io.disconnect(); draw();
    var t; addEventListener('resize', function(){ clearTimeout(t); t = setTimeout(draw, 200); }, { passive:true });
  }, { rootMargin:'400px 0px' });
  io.observe(cv);
})();

/* arcade power-on once the screen is a quarter in view */
(function(){
  var st = document.querySelector('.game-stage');
  if(!st) return;
  var io = new IntersectionObserver(function(es){ if(es[0].isIntersecting){ st.classList.add('on'); io.disconnect(); } }, { threshold:.25 });
  io.observe(st);
})();

/* bento edge light: every card's border tracks the same pointer, so neighbours glow as it nears them */
(function(){
  var bento = document.querySelector('.bento');
  if(!bento || !matchMedia('(hover:hover)').matches) return;
  var cards = bento.querySelectorAll('.card');
  bento.addEventListener('pointermove', function(e){
    // read every rect before writing any vars, so the writes never force a layout
    var rs = Array.prototype.map.call(cards, function(c){ return c.getBoundingClientRect(); });
    cards.forEach(function(c, i){
      c.style.setProperty('--mx', (e.clientX - rs[i].left) + 'px');
      c.style.setProperty('--my', (e.clientY - rs[i].top) + 'px');
    });
  });
})();
</script>

