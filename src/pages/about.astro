<script is:inline>
/* ──────────────────────────────────────────────────────────────────
   PAGE VISIBILITY HARD-PAUSE
   The browser already throttles requestAnimationFrame in hidden tabs
   to ~1Hz, but rAF callbacks still fire and accumulate state (U.uTime,
   freighter/asteroid drift, satellite paths). When the user returns
   they see "the network has been busy" — correct creative read but
   wastes battery. We discard the accumulated threeClock delta on
   show so scene time stands still while the tab is in the background.
   ────────────────────────────────────────────────────────────────── */
(function(){
  'use strict';
  if(typeof threeClock === 'undefined') return;
  document.addEventListener('visibilitychange', function(){
    if(!document.hidden && threeClock && typeof threeClock.getDelta === 'function'){
      threeClock.getDelta(); /* drop the accumulated background dt */
    }
  });
})();
</script>



