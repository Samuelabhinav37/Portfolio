<script is:inline>
/* sandbox includes allow-same-origin on purpose. Without it the frame has an
   opaque ("null") origin, so its requests for /scripts/about-arcade-game.js
   and /fonts/fonts.css count as cross-origin, and the site-wide
   Cross-Origin-Resource-Policy: same-origin (public/_headers) blocks them:
   in production the game showed its menu and never ran. The frame only ever
   holds this page's own srcdoc, so same-origin grants nothing to anyone else.
   The game lives in data-srcdoc so it never boots on phones (where the
   section is hidden) and only boots on desktop once it is near the screen.
   Runs on each visit to this page (Motion.astro onPage). */
onPage(function(signal){
(function(){
  var ifr = document.getElementById('game-iframe');
  var play = document.querySelector('.game-play');
  if(!ifr) return;
  if(window.SITE && window.SITE.LOW_POWER){ ifr.remove(); if(play) play.remove(); return; }
  var stage = document.querySelector('.game-stage');
  // nothing loads or moves until the first click: then the game boots and the screen powers on
  play.addEventListener('click', function(){
    play.classList.add('gone');
    if(ifr.hasAttribute('data-srcdoc')){
      ifr.addEventListener('load', function(){ ifr.focus(); try { ifr.contentWindow.focus(); } catch(e){} }, { once:true });
      ifr.srcdoc = ifr.getAttribute('data-srcdoc');
      ifr.removeAttribute('data-srcdoc');
      stage.classList.add('on');
      return;
    }
    ifr.focus();
    try { ifr.contentWindow.focus(); } catch(e){}
  });
  // clicking back out to the page brings the cover back, so the page scrolls again
  addEventListener('focus', function(){ play.classList.remove('gone'); }, { signal: signal });
})();

/* a cell too long for its column scrolls sideways in a loop, like the reference's client list */
(function(){
  if(!document.querySelector('main.ab')) return; // this setup runs on every page: About's only
  document.querySelectorAll('.work > a > span, .tk').forEach(function(el){
    if(el.scrollWidth <= el.clientWidth + 1) return;
    var h = el.innerHTML;
    el.innerHTML = '<span class="mq"><span>' + h + '</span><span aria-hidden="true">' + h + '</span></span>';
    var w = el.firstChild.firstChild.offsetWidth;
    el.firstChild.style.setProperty('--d', (w / 28).toFixed(1) + 's'); // about 28px a second
  });
})();
});
</script>

