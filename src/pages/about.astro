---
import Motion from '../components/Motion.astro';
import Glitches from '../components/Glitches.astro';
import SiteMenu from '../components/SiteMenu.astro';
import ClarityAnalytics from '../components/ClarityAnalytics.astro';
import ErrorReporter from '../components/ErrorReporter.astro';
import SkyLife from '../components/SkyLife.astro';
import KaiSite from '../components/KaiSite.astro';
import '../styles/tokens.css';
import Fonts from '../components/Fonts.astro';
const sections = [['intro', 'About Samuel'], ['toolkit', 'Toolkit'], ['snapshot', 'Snapshot'], ['arcade', 'Arcade']];
// [name, logo file in public/images/tools, or a monogram where no free logo exists]
const toolkit = [
  ['Splunk', '>'], ['Microsoft Sentinel', 'microsoft-sentinel.svg'],
  ['Wazuh', 'W'], ['Security Onion', 'SO'],
  ['Elastic', 'elastic.svg'], ['MITRE ATT&CK', 'M'],
  ['Python', 'python.svg'], ['PowerShell', 'powershell.svg'],
  ['Ghidra', 'ghidra.svg'], ['Terraform', 'terraform.svg'],
  ['Docker', 'docker.svg'], ['AWS', 'aws.svg'],
];
// [name, badge file in public/images/certs, has a baked-in white square]
const certs = [
  ['Security+', 'security-plus', true], ['Network+', 'network-plus', true], ['ISC2 CC', 'isc2-cc', false],
  ['AWS CCP', 'aws-ccp', false], ['AZ-900', 'az-900', false], ['HTB CJCA', 'htb-cjca', false],
];
// "On the wire": the newest entries in CISA's Known Exploited Vulnerabilities
// catalog, read at build time so the card has real rows without JS; the page
// asks /api/kev (functions/api/kev.js) for anything newer once it is in view.
type Wire = { cve: string; what: string; date: string };
const wireRow = (v: { cveID: string; vendorProject: string; product: string; dateAdded: string }): Wire => {
  const what = v.product.startsWith(v.vendorProject) ? v.product : `${v.vendorProject} ${v.product}`;
  return { cve: v.cveID, what: what.length > 28 ? what.slice(0, 27).trimEnd() + '…' : what, date: v.dateAdded };
};
let wire: Wire[] = [];
try {
  const kev = await (await fetch('https://raw.githubusercontent.com/cisagov/kev-data/main/known_exploited_vulnerabilities.json', { signal: AbortSignal.timeout(15000) })).json();
  wire = kev.vulnerabilities.sort((x: { dateAdded: string }, y: { dateAdded: string }) => y.dateAdded.localeCompare(x.dateAdded)).slice(0, 5).map(wireRow);
} catch { /* offline build: the card shows a link to the catalog until /api/kev answers */ }
// typing schedule: each line types at 20ms a character, 100ms after the one before
let wireAt = 200;
const wireSched = wire.map((w) => {
  const cveAt = wireAt; wireAt += w.cve.length * 20 + 100;
  const whatAt = wireAt; wireAt += w.what.length * 20 + 100;
  return { cveAt, whatAt };
});
const fmtDay = (d: string) => new Date(d + 'T00:00:00Z').toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
// GitHub's public contribution calendar, read at build time (so it refreshes on every deploy).
// Cells carry id="contribution-day-component-<weekday>-<week>" and data-level 0-4.
let ghWeeks: number[][] = [];
let ghActive = 0;
try {
  const html = await (await fetch('https://github.com/users/Samuelabhinav37/contributions', { signal: AbortSignal.timeout(8000) })).text();
  const cols: number[][] = [];
  for (const m of html.matchAll(/data-date="[\d-]+" id="contribution-day-component-(\d)-(\d+)" data-level="(\d)"/g)) {
    (cols[+m[2]] ??= [])[+m[1]] = +m[3];
    if (+m[3] > 0) ghActive++;
  }
  ghWeeks = cols.filter(Boolean).slice(-26).map((w) => w.filter((l) => l !== undefined));
} catch { /* offline build: the card falls back to just the GitHub link */ }
const team: [string, number, number][] = [['Greninja', 82, 90], ['Scizor', 79, 103], ['Ceruledge', 112, 112], ['Lucario', 58, 101], ['Blaziken', 118, 107], ['Sceptile', 74, 97]];
---

<!DOCTYPE html>
<html lang="en">
<head>
<script is:inline>
window.SITE=window.SITE||{};
(function(){
  function computeLowPower(){
    window.SITE.LOW_POWER = matchMedia('(max-width:900px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  computeLowPower();
  var _lpT;
  addEventListener('resize', function(){ clearTimeout(_lpT); _lpT=setTimeout(computeLowPower, 150); }, {passive:true});
})();
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<meta name="darkreader-lock">
<title>Samuel Abhinav — About</title>
<meta name="description" content="I got into security because I liked figuring out how things break. M.S. in Cybersecurity, a handful of certs, and three projects I'm genuinely proud of — currently looking for a team that reads its own logs.">
