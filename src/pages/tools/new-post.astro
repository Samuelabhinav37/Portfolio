---
/**
 * Private post-builder tool. Not linked from anywhere, not in sitemap.xml,
 * marked noindex below, and disallowed in robots.txt — reachable only if
 * you know this exact URL. See src/content/blog/_blueprint.mdx for what
 * every field/block below actually does; this page just assembles them.
 *
 * Uses the File System Access API (Chrome/Edge only) to write the finished
 * .mdx file straight into src/content/blog/ on whatever machine has this
 * page open — it can only ever touch a folder you explicitly grant it via
 * the browser's own native folder picker.
 *
 * Ships in full only in dev — `astro build` (production) emits a minimal
 * stub instead (see NewPostTool import below), so this ~550-line tool never
 * bloats the deployed bundle. Still noindex/robots-disallowed/unlinked
 * regardless, as defense in depth.
 */
import { getCollection } from 'astro:content';
import NewPostTool from '../../components/NewPostTool.astro';
import { PRIMARY_CATS, PRIMARY_CAT_LABELS, SECONDARY_CATS } from '../../data/blog-categories';

const allPosts = await getCollection('blog');
const realPosts = allPosts.filter((p) => !p.id.startsWith('_'));
const relatedOptions = realPosts.map((p) => ({ slug: p.id, title: p.data.title }));
const categories = [...new Set(realPosts.map((p) => p.data.category))];

const isDev = import.meta.env.DEV;
---

<!doctype html>
<html lang="en">
{isDev ? (
  <NewPostTool
    categories={categories}
    relatedOptions={relatedOptions}
    primaryCats={PRIMARY_CATS}
    primaryCatLabels={PRIMARY_CAT_LABELS}
    secondaryCats={SECONDARY_CATS}
  />
) : (
  <Fragment>
    <head>
      <meta charset="UTF-8" />
      <meta name="robots" content="noindex, nofollow" />
      <title>Not available</title>
    </head>
    <body style="margin:0;min-height:100vh;display:flex;align-items:center;justify-content:center;background:#0b0c10;color:#e2e6ee;font:15px/1.5 system-ui,sans-serif;">
      <p>Not available in production — run <code>bun run dev</code> locally.</p>
    </body>
  </Fragment>
)}
</html>
