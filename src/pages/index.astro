---
import Motion from '../components/Motion.astro';
import Glitches from '../components/Glitches.astro';
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import SiteMenu from '../components/SiteMenu.astro';
import ClarityAnalytics from '../components/ClarityAnalytics.astro';
import ErrorReporter from '../components/ErrorReporter.astro';
import SkyBackground from '../components/SkyBackground.astro';
import KaiSite from '../components/KaiSite.astro';
import { SITE } from '../config';
import '../styles/tokens.css';
import Fonts from '../components/Fonts.astro';
import { variant, srcsetWith } from '../image-variant';

// Person schema — the only structured data on the site scoped to Samuel
// himself rather than a specific post; blog posts already carry their own
// Article/BreadcrumbList/FAQPage JSON-LD (see BlogPost.astro) but nothing
// previously told Google these profile links (LinkedIn/GitHub/X/HackerOne)
// and this site describe the same entity. sameAs is what makes that
// connection for knowledge-panel/entity purposes.
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  jobTitle: SITE.role,
  url: SITE.links.portfolio,
  description: SITE.tagline,
  sameAs: [SITE.links.linkedin, SITE.links.github, SITE.links.x, SITE.links.hackerone],
}).replace(/</g, '\\u003c');

const recentPosts = (await getCollection('blog', ({ id, data }) => !data.draft && !id.includes('/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .map((p) => {
    const localCard = `/images/blog/${p.id}-card.jpg`;
    const hasLocalCard = fs.existsSync(`public${localCard}`);
    return {
    href: '/blog/' + p.id + '/',
    img: variant(p.data.cardImage, 480) || p.data.heroImage || (hasLocalCard ? localCard : `https://picsum.photos/seed/${p.id}/600/750?grayscale`),
    srcset: srcsetWith(p.data.cardImage, 480, 800),
    cat: p.data.category,
    date: p.data.pubDate.toLocaleString('en-US', { month: 'short', year: 'numeric' }),
    title: p.data.title,
    desc: p.data.description,
  };
  });
---

<!DOCTYPE html>
<html lang="en">
<head>
<script is:inline>
window.SITE=window.SITE||{};
(function(){
  function computeLowPower(){
    window.SITE.LOW_POWER = matchMedia('(max-width:900px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  computeLowPower();
  var _lpT;
  addEventListener('resize', function(){ clearTimeout(_lpT); _lpT=setTimeout(computeLowPower, 150); }, {passive:true});
})();
</script>
