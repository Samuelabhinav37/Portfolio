<!-- ══ T2 — the globe terminal ═══════════════════════════════════════
     Owns beat 3 and nothing else. Full-viewport with invisible chrome while
     the globe forms, then the chrome glitches in and the box closes around
     it. overflow:hidden is what crops the guest and sells the capture.
     Contains ONLY the globe, its labels and the stills. -->
<!-- #globe-term relocated into the projects sticky-split (right panel) -->

<!-- ═══════════════ PROJECTS — names left · big translucent globe terminal right ═══════════════ -->
<style is:global>
#projects-section{ position:relative; z-index:1; width:100%; min-height:100vh; box-sizing:border-box;
  background:rgba(4,4,10,0.9); display:flex; align-items:center;
  padding:clamp(50px,7vh,100px) 0; }
#projects-section .ps-inner{ width:100%; max-width:1500px; margin:0 auto; padding:0 clamp(24px,5vw,80px); box-sizing:border-box; }
#projects-section .ps-head{ margin:0 0 clamp(20px,3.5vh,38px); }
#projects-section .ps-title{ font-family:'Hanken Grotesk',system-ui,sans-serif; font-weight:300;
  font-size:clamp(1.6rem,2.4vw,2.2rem); letter-spacing:-0.3px; color:#eef3ff; margin:0; }

.psplit{ display:grid; grid-template-columns:minmax(210px,0.5fr) minmax(0,1.5fr); gap:clamp(30px,4.5vw,72px); align-items:center; }
.psplit-left{ display:flex; flex-direction:column; }
.psplit-right{ position:relative; }

.accord{ display:flex; flex-direction:column; border-top:1px solid rgba(226,232,244,0.1); }
.acc{ border-bottom:1px solid rgba(226,232,244,0.1); }
.acc-head{ width:100%; background:none; border:0; cursor:pointer; text-align:left; color:inherit;
  display:flex; align-items:center; gap:16px; padding:clamp(15px,2vh,22px) 4px; transition:opacity .4s ease; }
.acc:not(.is-open) .acc-head{ opacity:0.42; }
.acc:not(.is-open) .acc-head:hover{ opacity:0.8; }
.acc-num{ font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.14em; color:rgba(226,232,244,0.4); width:22px; flex:none; }
.acc-title{ font-family:'Hanken Grotesk',system-ui,sans-serif; font-weight:400; flex:1;
  font-size:clamp(1.2rem,2vw,1.7rem); line-height:1.1; letter-spacing:-0.015em; color:#eef3ff;
  text-shadow:0 0 30px rgba(210,220,240,0.12); }
.acc-mark{ width:11px; height:11px; position:relative; flex:none; opacity:0.55; }
.acc-mark::before,.acc-mark::after{ content:''; position:absolute; background:rgba(226,232,244,0.8); transition:transform .4s ease, opacity .4s ease; }
.acc-mark::before{ left:0; top:5px; width:11px; height:1px; }
.acc-mark::after{ left:5px; top:0; width:1px; height:11px; }
.acc.is-open .acc-mark::after{ transform:scaleY(0); opacity:0; }
.acc-body{ display:grid; grid-template-rows:0fr; transition:grid-template-rows .5s cubic-bezier(.16,1,.3,1); }
.acc.is-open .acc-body{ grid-template-rows:1fr; }
.acc-inner{ overflow:hidden; }
.acc-desc{ font-family:'Hanken Grotesk',system-ui,sans-serif; font-weight:300; font-size:14px;
  line-height:1.55; color:rgba(226,232,244,0.6); margin:0; padding:2px 4px 22px 42px; max-width:46ch; }

/* ── the big translucent globe terminal ── */
.pterm{ position:relative; width:100%; height:min(84vh,900px);
  background:rgba(5,6,12,0.5); border:1px solid rgba(226,232,244,0.12); border-radius:5px;
  overflow:hidden; box-shadow:0 30px 90px -50px rgba(0,0,0,0.9), inset 0 0 0 1px rgba(226,232,244,0.02);
  display:flex; flex-direction:column; }
.pterm .pv-bar{ display:flex; align-items:center; gap:9px; height:34px; padding:0 14px; flex:none;
  background:rgba(12,14,22,0.55); border-bottom:1px solid rgba(226,232,244,0.1);
  font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.2em; text-transform:uppercase; color:rgba(226,232,244,0.72); }
.pterm .pv-led{ width:5px; height:5px; border-radius:50%; background:rgba(120,225,170,0.9); box-shadow:0 0 8px rgba(120,225,170,0.55); flex:none; }
.pterm .pv-bar .pv-sub{ margin-left:auto; color:rgba(226,232,244,0.34); letter-spacing:.14em; }
.pterm .pv-stage{ position:relative; flex:1; min-height:0; }
.pterm #globe-term{ position:absolute; inset:0; width:100%; height:100%; background:transparent; overflow:visible; }
.pterm #globe-gl{ left:50%; top:47%; transform:translate(-50%,-50%); width:min(74vh,40vw,720px); height:min(74vh,40vw,720px); }
.pterm .gt-sweep, .pterm #globe-labels, .pterm #project-cards{ display:none; }
.pterm .pv-stage::after{ content:''; position:absolute; inset:0; pointer-events:none;
  background:radial-gradient(130% 130% at 50% 42%, transparent 58%, rgba(0,0,0,0.4) 100%); }

/* screenshot — floats top-right, updates on project switch */
.pv-shot{ position:absolute; top:16px; right:16px; z-index:6; width:132px; height:90px;
  border:1px solid rgba(226,232,244,0.14); border-radius:3px; overflow:hidden; background:#05060b;
  box-shadow:0 14px 40px -18px rgba(0,0,0,0.8); }
.pv-shot img{ width:100%; height:100%; object-fit:cover; display:block; opacity:0; transition:opacity .6s ease; filter:grayscale(1) brightness(0.55) contrast(0.85); }

/* bottom strip — scrolling stack/pipeline/coverage terms, ticker-style like the CISA KEV feed */
.pv-foot{ position:absolute; left:0; right:0; bottom:0; z-index:6; height:42px;
  display:flex; align-items:center; box-sizing:border-box;
  background:rgba(8,10,17,0.62); border-top:1px solid rgba(226,232,244,0.12);
  backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px); }
.pv-pills-wrap{ flex:1; min-width:0; overflow:hidden;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 92%,transparent);
          mask-image:linear-gradient(90deg,transparent,#000 5%,#000 92%,transparent); }
.pv-pills-track{ display:inline-flex; align-items:baseline; white-space:nowrap; will-change:transform;
  animation:pvpillscroll 20s linear infinite; }
.pv-foot:hover .pv-pills-track{ animation-play-state:paused; }
@keyframes pvpillscroll{ from{transform:translateX(0)} to{transform:translateX(-50%)} }
.pv-pill{ font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.06em;
  color:rgba(226,232,244,0.7); white-space:nowrap; display:inline-block; padding:0 16px; }
.pv-pill-sep{ color:rgba(226,232,244,0.28); }

/* view project — floats bottom-right, between the globe and the ticker strip */
.pv-view{ position:absolute; right:16px; bottom:58px; z-index:7;
  font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.12em; text-transform:uppercase;
  color:rgba(226,232,244,0.92); text-decoration:none; transition:color .3s; }
.pv-view::before{ content:'[ '; color:rgba(226,232,244,0.45); }
.pv-view::after{ content:' → ]'; color:rgba(226,232,244,0.45); transition:color .3s; }
.pv-view:hover, .pv-view:hover::after{ color:#fff; }

#c-labels{ position:absolute; inset:0; z-index:5; pointer-events:none; }
/* Opacity for non-amb .clbl (the active project's tool constellation) is driven
   frame-by-frame from JS (updateConstellation's _clblTarget/cascade), synced to
   the same timer as the node/line glow — no CSS transition here, it would fight
   the per-frame writes. .amb (the always-on ambient skills field) is dimmer and
   static so the clicked project's own labels clearly read as "lit up" above it. */
#c-labels .clbl{ position:absolute; transform:translate(-50%,-50%);
  font-family:'JetBrains Mono',monospace; font-size:9.5px; letter-spacing:.06em; white-space:nowrap;
  color:rgba(226,232,244,0.85); opacity:0; padding:1px 5px; text-shadow:0 0 7px rgba(0,0,0,0.9); }
#c-labels .clbl.anchor{ color:#eef3ff; font-weight:600; }
#c-labels .clbl.back{ opacity:0 !important; }
#c-labels .clbl.amb{ font-size:9px; letter-spacing:.12em; text-transform:uppercase;
  color:rgba(226,232,244,0.6); opacity:0.38; transition:opacity .8s ease; text-shadow:0 0 8px rgba(0,0,0,1); padding-left:9px; }
#c-labels .clbl.amb::before{ content:''; position:absolute; left:0; top:50%; width:4px; height:4px; margin-top:-2px; border-radius:50%; background:rgba(226,232,244,0.5); }
.pv-noise{ position:absolute; inset:0; width:100%; height:100%; z-index:4; pointer-events:none; opacity:0.05; mix-blend-mode:soft-light; }

@media (max-width:900px){
  .psplit{ grid-template-columns:1fr; gap:22px; }
  .psplit-right{ display:none; }
  #projects-section{ min-height:auto; padding-top:12vh; padding-bottom:12vh; }
  .acc-desc{ padding-left:4px; }
}
</style>
<section id="projects-section" aria-label="Selected projects">
  <div class="ps-inner">
    <div class="ps-head">
      <h2 class="ps-title">Projects</h2>
    </div>
    <div class="psplit">
      <div class="psplit-left">
        <div class="accord">
          <article class="acc is-open" data-idx="0" id="sec-sentinel">
            <button class="acc-head" aria-expanded="true">
              <span class="acc-num">01</span>
              <span class="acc-title">SENTINEL</span>
              <span class="acc-mark" aria-hidden="true"></span>
            </button>
            <div class="acc-body"><div class="acc-inner">
              <p class="acc-desc">A multi-SIEM detection architecture that converts raw telemetry into triaged, actionable alerts. Wazuh, Splunk, and Security Onion operate in parallel across the pipeline, Shuffle orchestrates the SOAR playbooks, and a local LLM performs first-pass triage, extending MITRE ATT&amp;CK coverage from nine techniques to fifteen.</p>
            </div></div>
          </article>
          <article class="acc" data-idx="1" id="sec-prism">
            <button class="acc-head" aria-expanded="false">
              <span class="acc-num">02</span>
              <span class="acc-title">PRISM</span>
              <span class="acc-mark" aria-hidden="true"></span>
            </button>
            <div class="acc-body"><div class="acc-inner">
              <p class="acc-desc">A federated anomaly-detection framework evaluated across seven simulated OT and ICS sites. Built on Flower with FedProx and a temporal variational autoencoder trained to model each site's baseline behavior, the system exchanges only masked model weights so that raw telemetry never leaves the plant, and reconstruction error is used to surface anomalies at a false-positive rate below eight percent.</p>
            </div></div>
          </article>
          <article class="acc" data-idx="2" id="sec-axon">
            <button class="acc-head" aria-expanded="false">
              <span class="acc-num">03</span>
              <span class="acc-title">AXON</span>
              <span class="acc-mark" aria-hidden="true"></span>
            </button>
            <div class="acc-body"><div class="acc-inner">
              <p class="acc-desc">A risk-adaptive authentication scheme designed to remain unobtrusive under normal conditions. Each authentication attempt is assigned a continuous risk score derived from device, location, and behavioral signals; low-risk attempts proceed without friction, while high-risk attempts trigger step-up authentication in accordance with the NIST 800-63B assurance model.</p>
            </div></div>
          </article>
        </div>
      </div>
      <div class="psplit-right">
        <div class="pterm">
          <div class="pv-bar"><span class="pv-led"></span><span id="pv-title">SENTINEL</span><span class="pv-sub">globe : live</span></div>
          <div class="pv-stage">
            <div id="globe-term">
              <canvas id="globe-gl" aria-hidden="true"></canvas>
              <div id="globe-labels" aria-hidden="false"></div>
              <div id="project-cards" aria-hidden="false"></div>
              <div id="c-labels" aria-hidden="true"></div>
              <svg class="pv-noise" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><filter id="pvNoise"><feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="2" stitchTiles="stitch"/></filter><rect width="100%" height="100%" filter="url(#pvNoise)"/></svg>
              <div class="gt-chrome">
                <div class="gt-bar"><span class="gt-led"></span><span id="gt-title">globe</span></div>
                <div class="f-grain"></div><div class="crt-scan"></div><div class="crt-flicker"></div><div class="crt-curve"></div>
              </div>
              <div class="gt-sweep"></div>
            </div>
            <div class="pv-shot"><img id="pv-img" alt="" /></div>
            <a id="pv-view" class="pv-view" href="/blog#sentinel">view project</a>
            <div class="pv-foot">
              <div class="pv-pills-wrap"><div class="pv-pills-track" id="pv-pills"></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

