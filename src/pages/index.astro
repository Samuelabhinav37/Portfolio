<style is:global>
/* One rhythm for every section: the same left edge as the project captions,
   the same breath above each heading, the same gap from heading to content. */
:root{ --gut:clamp(16px,3.2vw,48px); --sec-pad:clamp(150px,26vh,300px); --head-gap:clamp(40px,7vh,80px); }

/* Section headings: a smaller sibling of the blog's "Field Notes (N)" title.
   A large serif line with one italic word. */
.sec-head{ position:relative; display:grid; grid-template-columns:1fr auto; align-items:end; column-gap:24px;
  margin:0 0 var(--head-gap); padding:0 var(--gut); }
.sec-title{ margin:0; font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(46px,6.4vw,96px);
  line-height:.92; letter-spacing:-.03em; color:#eef1f8; text-wrap:balance; }
.sec-title em{ font-style:italic; color:#cdd9f7; }
.sec-title sup{ font:500 .17em/1 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; letter-spacing:0;
  vertical-align:top; position:relative; top:.4em; margin-left:.14em; color:#c9d6ff; }
.sec-link{ font:500 11px/1 'JetBrains Mono',monospace; letter-spacing:.16em; text-transform:uppercase; color:#9aa0ae;
  text-decoration:none; transition:color .3s; padding-bottom:.6em; }
.sec-link:hover{ color:#ededee; }
/* Variant B: grotesk headline, the italic word stays serif */
:root[data-heads="b"] .sec-title{ font-family:'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-weight:500;
  font-size:clamp(46px,6.4vw,96px); letter-spacing:-.055em; }
:root[data-heads="b"] .sec-title em{ font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; letter-spacing:-.02em; padding-right:.04em; }
/* Variant C: editorial bar, label in a narrow left column, title in the right */
:root[data-heads="c"] .sec-head{ grid-template-columns:minmax(140px,22%) 1fr auto; border-top:1px solid rgba(201,214,255,.16); padding-top:18px; }
:root[data-heads="c"] .sec-title{ grid-column:2; }


/* Film grain over the whole page, with a soft vignette under it. Held
   still and faint: none of the reference sites animate texture, and the sky
   already supplies the motion. */
.page-grain{ position:fixed; inset:0; z-index:2147483000; pointer-events:none; }
.page-grain::before{ content:""; position:absolute; inset:0;
  background:radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(2,4,12,.55) 100%); }
.page-grain::after{ content:""; position:absolute; inset:0; background:url(/images/grain.webp) repeat; opacity:.045; }

/* Scroll-linked motion (CSS only; browsers without view timelines just show
   everything at rest). Project frames open upward
   and their picture settles from a slight zoom. */
@supports (animation-timeline:view()){
  @media (prefers-reduced-motion:no-preference){
        .pw-img{ animation:frame-open linear both; animation-timeline:view(); animation-range:entry 0% cover 30%; }
    .pw-img > *{ animation:frame-settle linear both; animation-timeline:view(); animation-range:entry 0% cover 45%; }
  }
}
@keyframes frame-open{ from{ clip-path:inset(18% 0 0 0); } to{ clip-path:inset(0 0 0 0); } }
@keyframes frame-settle{ from{ transform:scale(1.12); } to{ transform:scale(1); } }
@media (--bp-760){
  .sec-head{ grid-template-columns:1fr; row-gap:16px; }
  .sec-link{ justify-self:start; }
  :root[data-heads="c"] .sec-head{ grid-template-columns:1fr; }
  :root[data-heads="c"] .sec-title{ grid-column:1; }
}
#projects-section{ position:relative; z-index:301; width:100%; box-sizing:border-box; background:transparent; padding:clamp(40px,6vh,64px) 0 clamp(240px,36vh,360px); }
/* After zainabkabira.com: the work arrives as a painted sheet that slides up
   under the hero. A night watercolour wash with a few brushed swells and
   reef painted into it (sea
   stars scattered, coral on the sea floor below the last row, clouds and
   stars throughout; no fish, mantas or turtle), cut by a dry-brush edge
   top and bottom. All generated once as images (scripts/paint/creatures.py,
   the home-* files), so scrolling costs nothing extra. */
#projects-section::before{ content:""; position:absolute; z-index:-1; left:0; right:0; top:-130px; bottom:-60px; pointer-events:none;
  background:url(/images/paint/home-bottom.webp) center bottom 100px / 1600px auto no-repeat,
    url(/images/paint/home-scatter-tile.webp) 0 300px / 1400px auto,
    url(/images/paint/rays.webp) center top / 1600px auto no-repeat,
    url(/images/paint/clouds-tile.webp) 0 0 / 1024px,
    url(/images/paint/stars-tile.webp) 0 0 / 1024px,
    url(/images/paint/waves-tile.webp) 0 140px / 1024px,
    url(/images/paint/wash-tile.webp) 0 0 / 1024px; opacity:.96;
  -webkit-mask:url(/images/paint/wash-edge.webp) top / 100% 280px no-repeat,
    linear-gradient(#000,#000) 0 278px / 100% calc(100% - 556px) no-repeat,
    url(/images/paint/wash-edge-b.webp) bottom / 100% 280px no-repeat;
          mask:url(/images/paint/wash-edge.webp) top / 100% 280px no-repeat,
    linear-gradient(#000,#000) 0 278px / 100% calc(100% - 556px) no-repeat,
    url(/images/paint/wash-edge-b.webp) bottom / 100% 280px no-repeat; }
@media (--bp-760){
  #projects-section::before{ background-size:1000px auto, 900px auto, 1000px auto, 700px, 1024px, 700px, 1024px; background-position:center bottom 90px, 0 300px, center top, 0 0, 0 0, 0 140px, 0 0; }
}
/* Work tiles, after Bodeyco's journal: two equal columns running edge to
   edge with a 6px gutter, frames in their own shapes so rows go ragged, no
   corners or borders. Under each frame a two-half caption in one small
   grotesk: the name over dim tags on the left, the sentence (dim) on the
   right. Hover fades the picture. */
#projects-section .ps-inner{ width:100%; }
/* Sizes picked in the projects tuner (public/_projects-tune.html); the
   heading lines up with the grid's left edge. */
.pw-grid{ display:grid; width:76%; margin:0 auto; grid-template-columns:repeat(2,minmax(0,1fr)); gap:60px 13px; align-items:start; }
#projects-section .sec-head{ width:76%; margin-inline:auto; padding-inline:0; }
.pw-tile{ display:flex; flex-direction:column; gap:15px; color:inherit; text-decoration:none; }
.pw-img{ margin:0; position:relative; overflow:hidden; background:#0a0c14; aspect-ratio:3/2; }
/* Ratio cycle after Bodeyco's journal (3:2, 5:4, 16:9, 4:3): the taller
   frame switches sides between rows so the grid never settles into a pattern. */
.pw-tile:nth-child(6n+2) .pw-img, .pw-tile:nth-child(6n+5) .pw-img{ aspect-ratio:5/4; }
.pw-tile:nth-child(6n+3) .pw-img, .pw-tile:nth-child(6n) .pw-img{ aspect-ratio:16/9; }
.pw-tile:nth-child(6n+4) .pw-img{ aspect-ratio:4/3; }
/* Hover: the picture fades and drifts in a little (Vantra zooms 1.05). `scale`
   rather than transform, so it adds to the scroll-in settle animation. */
.pw-img > *{ transition:opacity .15s ease, scale .9s var(--ease-out); }
@media (hover:hover){ .pw-tile:hover .pw-img > *, .pw-tile:focus-visible .pw-img > *{ opacity:.35; } }
@media (hover:hover) and (prefers-reduced-motion:no-preference){ .pw-tile:hover .pw-img > *, .pw-tile:focus-visible .pw-img > *{ scale:1.04; } }
/* Screenshots fill their frame; projects without one show a logo or a placeholder. */
.pw-img--shot img{ display:block; width:100%; height:100%; object-fit:cover; }
.pw-img--logo, .pw-img--todo{ display:grid; place-items:center; }
.pw-img--logo img{ width:clamp(56px,11%,120px); height:auto; display:block; }
/* empty frames get the contact page's broken-screen roll (index-wreck-frames.js plays it while on screen) */
.pw-wreck{ position:absolute; inset:0; width:100%; height:100%; object-fit:fill; mix-blend-mode:screen; opacity:.28; pointer-events:none; }
.pw-img--todo span{ position:relative;  font:500 12px/1.2 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; letter-spacing:-.02em; color:rgba(226,232,244,.6); }
.pw-cap{ display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:6px; padding:0 23px;
  font:500 12px/1.2 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; letter-spacing:-.02em; color:#eef1f8;
  /* captions sit on the sky: the blog's dim tone (4.5:1) and dark halo keep them readable over cloud */
  text-shadow:0 1px 2px rgba(3,6,16,.85),0 0 14px rgba(3,6,16,.7); }
.pw-name{ grid-column:1; grid-row:1; padding-right:24px; }
.pw-tags{ grid-column:1; grid-row:2; padding-right:24px; color:rgba(233,236,247,.62); }
.pw-line{ grid-column:2; grid-row:1 / span 2; padding-right:24px; color:rgba(233,236,247,.62); text-wrap:pretty; }
@media (--bp-760){
  .pw-grid{ width:79%; grid-template-columns:1fr; gap:50px 6px; }
  #projects-section .sec-head{ width:79%; }
  .pw-tile{ gap:14px; }
  /* narrow tiles: name, tags and pitch stack instead of sharing a row */
  .pw-cap{ padding:0 16px; grid-template-columns:1fr; }
  .pw-name, .pw-tags, .pw-line{ grid-column:1; grid-row:auto; }
  .pw-line{ margin-top:6px; }
  .pw-name, .pw-tags, .pw-line{ padding-right:0; }
}
@media (prefers-reduced-motion: reduce){ .pw-img > *{ transition:none; } }
</style>
