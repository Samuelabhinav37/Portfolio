      <span class="ctf-strip__lbl">Upcoming CTFs</span>
      <span id="ctf-items" style="display:contents">
        <div class="ctf-item"><span class="ctf-name">picoCTF</span><span class="ctf-meta">loading&hellip;</span></div>
        <div class="ctf-item"><span class="ctf-name">HTB Business CTF</span><span class="ctf-meta">loading&hellip;</span></div>
      </span>
