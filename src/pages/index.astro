     projected ahead of the craft, so it meanders organically instead of hopping
     between points and pausing. Same velocity model as before, so speed/feel
     stay calibrated — only HOW the target is chosen changed. */
  wan.wAng=(wan.wAng===undefined?Math.random()*6.2832:wan.wAng)+(Math.random()-0.5)*0.9*dt;
  var sp=Math.sqrt(wan.vx*wan.vx+wan.vy*wan.vy);
  var hx=sp>0.001?wan.vx/sp:Math.cos(wan.wAng), hy=sp>0.001?wan.vy/sp:Math.sin(wan.wAng);
  wan.tx=wan.x+hx*90+Math.cos(wan.wAng)*70;
