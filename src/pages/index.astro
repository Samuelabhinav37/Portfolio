---
import fs from 'node:fs';
import { getCollection } from 'astro:content';
import SiteMenu from '../components/SiteMenu.astro';
import ClarityAnalytics from '../components/ClarityAnalytics.astro';
import ErrorReporter from '../components/ErrorReporter.astro';
import PortfolioLunaShell from '../components/PortfolioLunaShell.astro';
import NebulaBackground from '../components/NebulaBackground.astro';
import LunaDrawerShell from '../components/LunaDrawerShell.astro';
import { SITE } from '../config';
import '../styles/tokens.css';
// Extracted from this page's own inline <style is:global> blocks (all
// already unscoped, so moving them here changes nothing about what they
// affect) — one file per major section, same granularity as the site's
// existing public/scripts/index-*.js split. Kept in source order so the
// cascade is unchanged.
import '../styles/index-hero.css';
import '../styles/index-footer.css';
import '../styles/index-subliminal.css';
import '../styles/index-editorial.css';
import '../styles/index-projects.css';
import '../styles/index-signal.css';

// Person schema — the only structured data on the site scoped to Samuel
// himself rather than a specific post; blog posts already carry their own
// Article/BreadcrumbList/FAQPage JSON-LD (see BlogPost.astro) but nothing
// previously told Google these profile links (LinkedIn/GitHub/X/HackerOne)
// and this site describe the same entity. sameAs is what makes that
// connection for knowledge-panel/entity purposes.
const personJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  jobTitle: SITE.role,
  url: SITE.links.portfolio,
  description: SITE.tagline,
  sameAs: [SITE.links.linkedin, SITE.links.github, SITE.links.x, SITE.links.hackerone],
}).replace(/</g, '\\u003c');

const recentPosts = (await getCollection('blog', ({ id, data }) => !data.draft && !id.includes('/')))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((p) => {
    const localCard = `/images/blog/${p.id}-card.jpg`;
    const hasLocalCard = fs.existsSync(`public${localCard}`);
    return {
    href: '/blog/' + p.id + '/',
    img: p.data.cardImage || p.data.heroImage || (hasLocalCard ? localCard : `https://picsum.photos/seed/${p.id}/600/750?grayscale`),
    cat: p.data.category,
    date: p.data.pubDate.toLocaleString('en-US', { month: 'short', year: 'numeric' }),
    title: p.data.title,
    desc: p.data.description,
  };
  });
---

