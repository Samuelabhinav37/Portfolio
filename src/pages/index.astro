    <div id="term-screen">
      <div class="tcorner tl"></div><div class="tcorner tr"></div>
      <div class="tcorner bl"></div><div class="tcorner br"></div>
      <div id="term-feed">
        <div id="term-feed-label">CRT&nbsp;FEED</div>
        <div id="term-feed-sub">interior &mdash; pending design</div>
      </div>
    </div>
  </div>
</div>

<!-- Beat 1 scroll distance: scrubs the expand floating &rarr; fullscreen -->
<!-- beat1 removed: CRT is now a normal-flow section that scrolls away -->
<!-- ═══════════════ EDITORIAL FLOW: KEV feed → beliefs → research log ═══════════════
     Normal-flow content inserted between the CRT (beat1) and the globe (beat-arc).
     Sits at z-index 300 over the ambient nebula/network (z0/z1); the CRT releases
     on scroll and the globe stays unformed until its band, so nothing overlaps. -->
<style is:global id="ed-styles">
  #editorial{ position:relative; z-index:300; background:rgba(4,4,10,0.9); color:#ededee;
    font-family:'Hanken Grotesk',-apple-system,sans-serif; font-weight:400; }
  #editorial .ed-lbl{ font-family:'JetBrains Mono',monospace; font-weight:500; font-size:11px;
    letter-spacing:2px; text-transform:uppercase; color:#67676d; }

  /* ── KEV live feed ── */
  #editorial .ed-kev{ padding:clamp(70px,13vh,150px) 0; max-width:1500px; margin:0 auto; }
  #editorial .ed-kev__head{ padding:0 clamp(24px,5vw,80px); margin-bottom:clamp(30px,5vh,48px);
    display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  #editorial .ed-kev__head .ed-lbl{ display:block; margin-bottom:14px; }
  #editorial .ed-kev__head h2{ font-weight:300; font-size:clamp(1.5rem,2.2vw,2rem); letter-spacing:-.3px; }
  #editorial .ed-kev__head h2 em{ font-style:normal; color:#94949a; }
  #editorial .ed-kev__status{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.5px;
    color:#67676d; display:flex; align-items:center; gap:8px; }
  #editorial .ed-kev__status .ed-dot{ width:6px; height:6px; border-radius:50%; background:#67676d; }
  #editorial .ed-kev__status.ed-live .ed-dot{ background:rgba(120,225,170,.9);
    box-shadow:0 0 6px rgba(120,225,170,.7); animation:edpulse 2.2s infinite; }
  @keyframes edpulse{ 0%,100%{opacity:1} 50%{opacity:.35} }
  #editorial .ed-ticker{ position:relative; border-top:1px solid rgba(var(--c-white),.1);
    border-bottom:1px solid rgba(var(--c-white),.1); overflow:hidden;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
            mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent); }
  #editorial .ed-track{ display:inline-flex; white-space:nowrap; will-change:transform;
    animation:edscroll 80s linear infinite; }
  #editorial .ed-ticker:hover .ed-track{ animation-play-state:paused; }
  @keyframes edscroll{ from{transform:translateX(0)} to{transform:translateX(-50%)} }
  #editorial .ed-kv{ display:inline-flex; align-items:baseline; gap:12px; padding:16px 34px;
    font-family:'JetBrains Mono',monospace; font-size:12.5px; letter-spacing:.3px;
    text-decoration:none; cursor:pointer; transition:background .2s; }
  #editorial .ed-kv:hover{ background:rgba(var(--c-white),.05); }
  #editorial .ed-kv .ed-cve{ color:#ededee; font-weight:500; }
  #editorial .ed-kv .ed-vp{ color:#94949a; }
  #editorial .ed-kv .ed-date{ color:#67676d; }
  #editorial .ed-kv .ed-ransom{ color:#e5b8b8; font-size:10px; letter-spacing:1px;
    border:1px solid rgba(229,184,184,.3); border-radius:3px; padding:1px 6px; }
  #editorial .ed-kv .ed-sep{ color:#67676d; opacity:.5; }
  #editorial .ed-kev__foot{ padding:18px clamp(24px,5vw,80px) 0; }
  #editorial .ed-kev__foot span{ font-family:'JetBrains Mono',monospace; font-size:10.5px;
    letter-spacing:.5px; color:#67676d; }

  /* ── Beliefs — Overview spread (ma / fukinsei) ── */
  #editorial .ed-beliefs{ padding:clamp(90px,16vh,190px) clamp(24px,5vw,80px) clamp(70px,12vh,150px);
    max-width:1500px; margin:0 auto; }
  #editorial .ed-beliefs__text{ display:grid; grid-template-columns:1fr 1fr; gap:clamp(30px,6vw,90px);
    align-items:start; margin-bottom:clamp(70px,13vh,160px); }
  #editorial .ed-beliefs__head .ed-lbl{ display:block; margin-bottom:18px; }
  #editorial .ed-beliefs__head h2{ font-weight:300; font-size:clamp(1.6rem,2.2vw,2rem);
    letter-spacing:-.3px; color:#ededee; }
  #editorial .ed-beliefs__copy{ max-width:52ch; padding-top:6px; --reveal:0%; will-change:mask-image;
    -webkit-mask-image:linear-gradient(180deg,#000 0%,#000 var(--reveal),transparent calc(var(--reveal) + 26%));
            mask-image:linear-gradient(180deg,#000 0%,#000 var(--reveal),transparent calc(var(--reveal) + 26%)); }
  #editorial .ed-beliefs__copy p{ font-weight:300; font-size:clamp(1.05rem,1.35vw,1.28rem);
    line-height:1.62; color:#c9c9cc; }
  #editorial .ed-beliefs__copy p em{ font-style:normal; color:#fff; }
  #editorial .ed-beliefs__copy p + p{ margin-top:22px; font-size:clamp(.95rem,1.1vw,1.05rem); color:#94949a; }
  #editorial .ed-beliefs__imgs{ display:grid; grid-template-columns:repeat(12,1fr); align-items:start;
    row-gap:clamp(40px,9vh,120px); }
  #editorial .ed-frame{ position:relative; overflow:hidden; background:#101012; }
  #editorial .ed-frame img{ width:100%; height:100%; object-fit:cover; display:block;
    filter:grayscale(1) brightness(.8);
    transition:filter 1.1s cubic-bezier(.22,1,.36,1), transform 1.3s cubic-bezier(.22,1,.36,1); }
  #editorial .ed-frame:hover img{ filter:grayscale(0) brightness(.95); transform:scale(1.04); }
  #editorial .ed-frame--a{ grid-column:1 / 7; aspect-ratio:16/12.5; margin-top:clamp(40px,9vh,120px); }
  /* No aspect-ratio (unlike ed-frame--a): sizes to the arcade canvas's own
     height instead of being forced to match its neighbor. .ed-beliefs__imgs
     already has align-items:start, so the grid row doesn't stretch it either. */
  #editorial .ed-frame--b{ grid-column:9 / 13; }

  /* ── Beliefs — bento (replaces the landscape frame) ── */
  #editorial .ed-bento{ display:grid; grid-template-columns:1fr 1fr; grid-template-rows:1fr 1fr;
    gap:1px; background:rgba(var(--c-white),.08); }
  #editorial .ed-bento__cell{ background:#101012; padding:clamp(14px,1.6vw,20px); display:flex; flex-direction:column;
    gap:10px; position:relative; overflow:hidden; transition:background .4s ease; }
