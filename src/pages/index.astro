---
import { getCollection } from 'astro:content';
import SiteMenu from '../components/SiteMenu.astro';
import PortfolioLunaShell from '../components/PortfolioLunaShell.astro';
import NebulaBackground from '../components/NebulaBackground.astro';

const recentPosts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3)
  .map((p) => ({
    href: '/blog/' + p.id + '/',
    img: p.data.cardImage || p.data.heroImage || `https://picsum.photos/seed/${p.id}/600/750?grayscale`,
    cat: p.data.category,
    date: p.data.pubDate.toLocaleString('en-US', { month: 'short', year: 'numeric' }),
    title: p.data.title,
    desc: p.data.description,
  }));
---

