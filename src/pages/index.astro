<ClientRouter fallback="swap" />
<Motion />
<style is:global>
/* the ASCII plant up the left edge (/scripts/word-vine.js), behind the page; homepage only */
#word-vine{ display:block; }
/* pixel intro cover (pixel-intro.js); hides itself after 4s if the script never runs */
#px-intro{ display:none; position:fixed; inset:0; width:100%; height:100%; z-index:950; pointer-events:none; image-rendering:pixelated; }
html.px-intro #px-intro{ display:block; background:var(--c-bg); animation:px-intro-safety 0s linear 4s forwards; }
@keyframes px-intro-safety{ to{ visibility:hidden; } }
/* leaves falling off the vine (vine-leaves.js), over the sky, under the hero sentence */
#vine-leaves{ position:absolute; inset:0; width:100%; height:100%; z-index:5; pointer-events:none; }
* { margin:0; padding:0; box-sizing:border-box; }

html, body {
  width:100%;
  background:var(--c-bg);
  overflow-x:clip;   /* clip (not hidden) so it doesn't create a scroll container that breaks position:sticky */
}
html { height:auto; }
body { min-height:100%; }

/* Screen-reader-only: visually hidden but available to assistive tech.
   The focusable variant becomes visible when tabbed to (the skip link). */
.sr-only{
  position:absolute !important; width:1px; height:1px;
  padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0);
  white-space:nowrap; border:0;
}
.sr-only-focusable:focus,
.sr-only-focusable:focus-visible{
  position:fixed !important; top:10px; left:10px;
  width:auto; height:auto; margin:0; padding:8px 14px; clip:auto;
  z-index:100000; background:var(--c-bg); color:#d6e0f4;
  border:1px solid rgba(214,224,244,.4); border-radius:6px;
  font:13px/1 'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; letter-spacing:.04em;
}


/* ── chrome dampening — soft dark pools that keep the UI legible over the
      brightened canvas; sits above the canvas, below the chrome; fades in
      together with the canvas brightness lift on Luna's arrival ── */
#chrome-damp {
  position:fixed; inset:0; z-index:600;
  pointer-events:none; opacity:0;
  transition:opacity 1.3s ease;
  background:
    radial-gradient(ellipse 780px 110px at 50% 18px,
      rgba(6,7,16,0.62) 0%, rgba(6,7,16,0) 72%),
    radial-gradient(ellipse 260px 260px at calc(100% - 64px) calc(9vh + 50px),
      rgba(6,7,16,0.20) 0%, rgba(6,7,16,0) 70%);
}

/* pullback CSS removed — terminal window replaces the window-wall */


/* ════════════════ Terminal window — floating CRT, Beat 1 expands to fullscreen ════════════════ */
#term-stage {
  position:relative; z-index:3;
  width:100%; min-height:100vh; min-height:100svh;
  display:flex; align-items:center; justify-content:center;
  pointer-events:none;
  opacity:0;
  transition:opacity 1.1s cubic-bezier(0.22,1,0.36,1);
}
body.intro-done #term-stage { opacity:1; }
#term-window {
  position:relative; pointer-events:auto;
  width:68vw; height:70vh;
  transform:translateY(0);             /* centered; beat 1 keeps y at 0 while expanding */
  border-radius:10px;
  display:flex; flex-direction:column; overflow:hidden;
  border:none;
  will-change:transform;
}
#term-titlebar {
  position:relative; z-index:201; width:100%; height:34px; flex-shrink:0;
  background:rgba(16,16,16,0.98); border-bottom:1px solid rgba(var(--c-white),0.07);
  display:flex; align-items:center; justify-content:space-between; padding:0 16px; user-select:none;
}
#term-icons { display:flex; align-items:center; gap:11px; }
#term-icons .ticon { font-family:'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:0.82rem; color:rgba(var(--c-white),0.24); line-height:1; }
#term-title {
  position:absolute; left:50%; transform:translateX(-50%);
  font-family:'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:0.65rem; color:rgba(var(--c-white),0.22); text-transform:uppercase;
  letter-spacing:0.10em; white-space:nowrap; pointer-events:none;
}
#term-status { font-family:'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:0.52rem; color:rgba(var(--c-white),0.12); letter-spacing:0.14em; text-transform:uppercase; }
#term-screen { position:relative; flex:1; background:transparent; overflow:hidden; }
/* One centred sentence, after baggy.studio's hero line (measured
   2026-11-08: Bradford LL Book 24px, line-height 1.2, -0.01em, max 796px,
   warm near-black). EB Garamond is the closest serif the site already hosts. */
.hero-line { position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); z-index:11; width:min(796px, calc(100% - 40px)); margin:0;
  font:400 clamp(20px, 1.9vw, 26px)/1.2 'EB Garamond', Georgia, serif; letter-spacing:-0.01em; text-align:center;
  color:rgba(var(--c-white),0.92); }
:root[data-theme="light"] .hero-line { color:#2a160d; }
.tcorner { position:absolute; z-index:10; width:20px; height:20px; border-color:rgba(var(--c-white),0.10); border-style:solid; }
.tcorner.tl { top:20px; left:20px;  border-width:1px 0 0 1px; }
.tcorner.tr { top:20px; right:20px; border-width:1px 1px 0 0; }
.tcorner.bl { bottom:20px; left:20px;  border-width:0 0 1px 1px; }
.tcorner.br { bottom:20px; right:20px; border-width:0 1px 1px 0; }

</style>

<style is:global>

/* ===== FOOTER (scoped, self-contained) ===== */
/* the name across the bottom: fitted to the width by footer-wordmark.js,
   its lower part cut off by the edge of the page; a dim gradient fill, and
   a bright copy revealed by a soft light at the pointer (--mx, --my) */
#site-footer .f-mark{ position:relative; width:100%; height:calc(var(--mfs, 16vw) * .62); overflow:hidden; margin-top:clamp(24px, 4vw, 56px);
  font-family:'Cormorant Garamond', Georgia, serif; font-weight:500; line-height:1; white-space:nowrap; text-align:center;
  font-size:var(--mfs, 16vw); letter-spacing:-.02em; user-select:none; pointer-events:auto; --mx:50%; --my:40%; }
#site-footer .f-mark span{ position:absolute; left:0; right:0; top:-.08em; color:transparent; -webkit-background-clip:text; background-clip:text; }
#site-footer .f-mark-base{ background-image:linear-gradient(180deg, rgba(160,175,210,.3) 0%, rgba(160,175,210,.1) 70%, rgba(150,165,200,0) 100%); }
#site-footer .f-mark-glow{ background-image:radial-gradient(circle at var(--mx) var(--my), rgba(240,244,252,.95) 0, rgba(200,214,245,.55) 10%, rgba(160,180,230,.18) 24%, rgba(160,180,230,0) 36%);
  opacity:var(--mo, 0); transition:opacity .5s ease; }
@media (prefers-reduced-motion: reduce){ #site-footer .f-mark-glow{ transition:none; } }
#site-footer{
  --fbg:#070710; --fink:#eef0f6; --fdim:#717890; --fline:rgba(220,225,235,0.12);
  --faccent:#8fb8ff; --faccent-gray:#52565f;
  --fserif:'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; --fsans:'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --fmono:'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; --fspec:'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --map-line:rgba(200,206,216,.32); --map-node:236,240,248;
}
footer#site-footer{
    position:relative; z-index:3; width:100%; overflow:hidden; background:transparent;
    display:flex; flex-direction:column; align-items:center; justify-content:flex-end; padding:0;
    opacity:1; pointer-events:auto;   /* no panel: the sky shows through; ::before bloom sits on top */
  }
  footer#site-footer.fpin{ pointer-events:auto; opacity:1; }
  /* Footer entrance — mirrors the project-tile reveal (scale + slide + fade), staggered.
     Elements start hidden/shifted; .fenter (added by JS when footer calm crosses in)
     animates them to rest. Same easing language as the tour tiles so it reads continuous. */
  #site-footer .f-copy, #site-footer .f-links{
    opacity:0; transform:translateY(24px) scale(0.965);
    transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1), translate .6s cubic-bezier(.16,1,.3,1);
  }
  /* exit stagger (scroll up): links leave first */
  #site-footer .f-links{transition-delay:0s}
  #site-footer .f-copy{transition-delay:.06s}
  #site-footer.fenter .f-copy{opacity:1; transform:translateY(0) scale(1); transition-delay:.44s}
  #site-footer.fenter .f-links{opacity:1; transform:translateY(0) scale(1); transition-delay:.46s}
  @media (prefers-reduced-motion: reduce){
    #site-footer .f-copy, #site-footer .f-links{opacity:1; transform:none; transition:none}
  }

  /* soft halo behind the footer, seating it in the sky */
  footer#site-footer::before{
    content:''; position:absolute; z-index:0; width:min(1900px,104vw); height:110vh;
    left:50%; bottom:-18vh; transform:translateX(-50%);
    background:radial-gradient(ellipse at 50% 70%, rgba(20,26,48,0.55) 0%, rgba(8,8,20,0.25) 45%, transparent 72%);
    filter:blur(30px); pointer-events:none;
  }
  @media (--bp-980){
    /* the name across the bottom now sits under the footer rows, so Kai's
       corner button covers part of that (decorative) name, not the links */
    .f-bottom{ padding-bottom:8px; }
  }
  /* footer navigation (after micro1): measured on micro1.ai, a ~1290px band;
     group labels 14px light at 40% white, links 16px medium at 80%, 36px apart */
  .f-nav{ position:relative; z-index:1; width:calc(100% - 2 * var(--gut)); margin:var(--sec-pad) auto 0;
    display:grid; grid-template-columns:minmax(0,1.1fr) repeat(3,minmax(0,1fr)); gap:32px; font-family:var(--fsans); }
  .f-brand-name{ font-family:'Cormorant Garamond', Georgia, serif; font-size:28px; font-weight:500; line-height:1; color:#fff; text-decoration:none; letter-spacing:-.01em; }
  .f-social{ display:flex; align-items:center; gap:22px; margin-top:26px; }
  .f-social a{ display:grid; place-items:center; width:18px; height:18px; color:rgba(255,255,255,.7); transition:color .2s; text-decoration:none; }
  .f-social a:hover{ color:#fff; }
  .f-social svg{ width:16px; height:16px; fill:currentColor; }
  .f-h1{ font:700 13px/1 var(--fsans); letter-spacing:-.04em; }
  .f-col{ display:flex; flex-direction:column; align-items:flex-start; }
  .f-group{ margin:0 0 12px; font-size:14px; line-height:21px; font-weight:300; color:rgba(255,255,255,.6); }
  .f-col a + .f-group{ margin-top:40px; }
  .f-col a{ font-size:16px; line-height:24px; font-weight:500; color:rgba(255,255,255,.8); text-decoration:none; padding:6px 0; transition:color .2s; }
  .f-col a:hover{ color:#fff; }
  .f-bottom{
    position:relative; z-index:1; width:calc(100% - 2 * var(--gut)); margin:64px auto 0;
    display:flex; align-items:center; justify-content:space-between; gap:20px; flex-wrap:wrap;
  }
  .f-copy{ font-family:var(--fsans); font-size:14px; color:rgba(255,255,255,.6); }
  .f-links{ display:flex; align-items:center; gap:20px; font-family:var(--fsans); font-size:14px; }
  .f-links a{ color:rgba(255,255,255,.6); text-decoration:none; transition:color .25s; }
  .f-links a:hover{ color:#fff; }
  @media (max-width:900px){
    .f-nav{ grid-template-columns:repeat(2,minmax(0,1fr)); row-gap:44px; }
    .f-brand{ grid-column:1 / -1; }
    /* stacked on the left, clear of Kai's button in the bottom-right corner */
    .f-bottom{ flex-direction:column; align-items:flex-start; gap:12px; }
  }

</style>
<ErrorReporter />
<ClarityAnalytics />
</head>
<body>
<div class="page-grain" aria-hidden="true"></div>

<SiteMenu currentPath="/" />
<h1 class="sr-only">Samuel Abhinav — Security Engineer, Detection &amp; Response</h1>






<SiteSky />
<canvas id="px-intro" aria-hidden="true"></canvas>
<script is:inline defer src="/scripts/word-vine.js"></script>
<script is:inline defer src="/scripts/vine-leaves.js"></script>
<script is:inline defer src="/scripts/pixel-intro.js"></script>




<div id="chrome-damp"></div>

<Glitches />

<!-- ════ Terminal window — floating CRT feed; Beat 1 expands it to fullscreen ════
     Sits at z-index 3: above the sky background (#sky) and its sea
     creatures, below Luna (999) and the chrome (1000+), so the navbar
     and Luna ride on top throughout. Revealed at body.intro-done (Beat 0). -->
<div id="term-stage" data-toc="Home">
  <div id="term-window" style="width:100%;height:100vh;height:100svh;border-radius:0;">
    <div id="term-screen">
      <div class="tcorner tl"></div><div class="tcorner tr"></div>
      <div class="tcorner bl"></div><div class="tcorner br"></div>
      <p class="hero-line">I build detection and response systems, find what hides in complex networks, and help teams work with technology safely.</p>
    </div>
  </div>
</div>

<!-- Shared styles for the Recent writing reel (#writing, after projects). -->
<style is:global id="ed-styles">
  #writing{ position:relative; z-index:300; background:transparent; color:#ededee;
    font-family:'Inter Tight',-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-weight:400; }
  #writing .ed-lbl{ font-family:'JetBrains Mono',monospace; font-weight:500; font-size:11px;
    letter-spacing:.16em; text-transform:uppercase; color:#9aa0ae; }

  /* ── Research log — Work-grammar cards ── */
  #writing .ed-log{ padding:var(--sec-pad) 0 0; }
  /* Edge-to-edge strip that drifts left; index-writing-reel.js moves it.
     overflow:clip, not hidden, so focusing a card can't scroll the box. */
  #writing .wr-reel{ overflow:clip; padding:8px 0 12px; cursor:grab; touch-action:pan-y; user-select:none; }
  #writing .wr-reel.is-drag{ cursor:grabbing; }
  #writing .wr-track{ display:flex; gap:6px; align-items:flex-start; width:max-content; padding-left:calc(var(--gut) - 12px); will-change:transform; }
  #writing .wr-track .fn-tile{ flex:none; width:clamp(280px,30vw,440px); }
  #writing .wr-track img{ -webkit-user-drag:none; }
  @media (--bp-820){
    #writing .wr-track .fn-tile{ width:min(78vw,360px); }
  }
  @media (prefers-reduced-motion:reduce){
    #writing .ed-track{ animation:none; } #writing .ed-ticker{ overflow-x:auto; }
  }
</style>


<!-- ═══════════════ PROJECTS ═══════════════ -->
<style is:global>
/* One rhythm for every section: the same left edge as the project captions,
   the same breath above each heading, the same gap from heading to content. */
:root{ --gut:clamp(16px,3.2vw,48px); --sec-pad:clamp(150px,26vh,300px); --head-gap:clamp(40px,7vh,80px); }

/* Section headings: a smaller sibling of the blog's "Field Notes (N)" title.
   A large serif line. Line-height 1.15, not tighter: the line-reveal mask
   clips at the line box, so a tighter line cut off descenders (the g in Blog). */
.sec-head{ position:relative; display:grid; grid-template-columns:1fr auto; align-items:end; column-gap:24px;
  margin:0 0 var(--head-gap); padding:0 var(--gut); }
.sec-title{ margin:0; font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(23px,3.2vw,48px);
  line-height:1.15; letter-spacing:-.03em; color:#eef1f8; text-wrap:balance; }
.sec-title em{ font-style:italic; color:#cdd9f7; }
.sec-title sup{ font:500 max(12px,.32em)/1 'Cormorant Garamond',Georgia,serif; font-variant-numeric:lining-nums; letter-spacing:0;
  vertical-align:top; position:relative; top:.4em; margin-left:.14em; color:#c9d6ff; }
.sec-link{ font:600 12px/1.2 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; letter-spacing:-.02em; color:#9aa0ae;
  text-decoration:none; transition:color .3s; padding-bottom:.6em; }
.sec-link:hover{ color:#ededee; }
/* Variant B: grotesk headline, the italic word stays serif */
:root[data-heads="b"] .sec-title{ font-family:'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-weight:500;
  font-size:clamp(23px,3.2vw,48px); letter-spacing:-.055em; }
:root[data-heads="b"] .sec-title em{ font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; letter-spacing:-.02em; padding-right:.04em; }
/* Variant C: editorial bar, label in a narrow left column, title in the right */
:root[data-heads="c"] .sec-head{ grid-template-columns:minmax(140px,22%) 1fr auto; border-top:1px solid rgba(201,214,255,.16); padding-top:18px; }
:root[data-heads="c"] .sec-title{ grid-column:2; }


/* Film grain over the whole page, with a soft vignette under it. Held
   still and faint: none of the reference sites animate texture, and the sky
   already supplies the motion. */
.page-grain{ position:fixed; inset:0; z-index:2147483000; pointer-events:none; }
.page-grain::before{ content:""; position:absolute; inset:0;
  background:radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(2,4,12,.55) 100%); }
.page-grain::after{ content:""; position:absolute; inset:0; background:url(/images/grain.webp) repeat; opacity:.045; }

/* Scroll-linked motion (CSS only; browsers without view timelines just show
   everything at rest). Project frames open upward
   and their picture settles from a slight zoom. */
@supports (animation-timeline:view()){
  @media (prefers-reduced-motion:no-preference){
        .pw-img{ animation:frame-open linear both; animation-timeline:view(); animation-range:entry 0% cover 30%; }
    .pw-img > *{ animation:frame-settle linear both; animation-timeline:view(); animation-range:entry 0% cover 45%; }
  }
}
@keyframes frame-open{ from{ clip-path:inset(18% 0 0 0); } to{ clip-path:inset(0 0 0 0); } }
@keyframes frame-settle{ from{ transform:scale(1.12); } to{ transform:scale(1); } }
@media (--bp-760){
  .sec-head{ grid-template-columns:1fr; row-gap:16px; }
  .sec-link{ justify-self:start; }
  :root[data-heads="c"] .sec-head{ grid-template-columns:1fr; }
  :root[data-heads="c"] .sec-title{ grid-column:1; }
}
#projects-section{ position:relative; z-index:301; width:100%; box-sizing:border-box; background:transparent; padding:clamp(40px,6vh,64px) 0 clamp(240px,36vh,360px); }
/* Work tiles laid out like a magazine spread (after hardholy.com): a 12-column field across the page, each
   frame in its own column, size and shape, with wide gaps between them.
   Logo frames stay wide so the logo is never cropped; the empty frames
   take the tall, narrow spots. A one- or two-word caption sits under each, on the right. */
#projects-section .ps-inner{ width:100%; }
.pw-grid{ --col-gap:clamp(12px,1.6vw,24px); display:grid; width:calc(100% - 2 * var(--gut)); max-width:1500px; margin:0 auto;
  grid-template-columns:repeat(12,minmax(0,1fr)); column-gap:var(--col-gap); row-gap:clamp(90px,15vh,170px); align-items:start; }
#projects-section .sec-head{ width:calc(100% - 2 * var(--gut)); max-width:1500px; margin-inline:auto; padding-inline:0; }
.pw-tile{ display:flex; flex-direction:column; gap:12px; color:inherit; text-decoration:none; }
.pw-img{ margin:0; position:relative; overflow:hidden; background:#0a0c14; aspect-ratio:3/2; }
/* the spread: big frame left, a small one dropped low on the right, and so on */
.pw-tile:nth-child(6n+1){ grid-column:1 / span 6; }
.pw-tile:nth-child(6n+2){ grid-column:8 / span 4; margin-top:clamp(120px,24vh,260px); }
.pw-tile:nth-child(6n+2) .pw-img{ aspect-ratio:4/5; }
.pw-tile:nth-child(6n+3){ grid-column:3 / span 5; }
.pw-tile:nth-child(6n+3) .pw-img{ aspect-ratio:16/10; }
.pw-tile:nth-child(6n+4){ grid-column:10 / span 3; margin-top:clamp(80px,16vh,180px); }
.pw-tile:nth-child(6n+4) .pw-img{ aspect-ratio:3/4; }
.pw-tile:nth-child(6n+5){ grid-column:1 / span 7; }
.pw-tile:nth-child(6n+5) .pw-img{ aspect-ratio:16/9; }
.pw-tile:nth-child(6n){ grid-column:9 / span 3; margin-top:clamp(160px,28vh,320px); }
.pw-tile:nth-child(6n) .pw-img{ aspect-ratio:4/5; }
/* Hover: the frame you point at stays lit and drifts in a little; the others
   dim (after krisztianeder.com). Dimming arrives over --dur-change and lifts
   faster. `scale` rather than transform, so it adds to the scroll-in settle. */
/* (dims the tile's children: the scroll reveal writes opacity on the tile itself) */
.pw-tile > *{ transition:opacity var(--dur-change-out) var(--ease-in); }
.pw-img > *{ transition:scale .9s var(--ease-out); }
@media (hover:hover){
  .pw-grid:has(.pw-tile:hover, .pw-tile:focus-visible) .pw-tile:not(:hover, :focus-visible) > *{ opacity:.35; transition:opacity var(--dur-change) var(--ease-out); }
}
@media (hover:hover) and (prefers-reduced-motion:no-preference){ .pw-tile:hover .pw-img > *, .pw-tile:focus-visible .pw-img > *{ scale:1.04; } }
/* Screenshots fill their frame; projects without one show a logo or a placeholder. */
/* "View" rides the cursor over a project (public/scripts/cursor-tip.js, after isablued.com) */
.cursor-tip{ position:fixed; top:0; left:0; z-index:620; padding:5px 9px 4px; border-radius:4px; background:#eef1f8; color:#070710;
  font:600 10px/1 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; letter-spacing:.12em; text-transform:uppercase;
  pointer-events:none; opacity:0; scale:.92; transition:opacity var(--dur-feedback-out) var(--ease-in), scale var(--dur-feedback-out) var(--ease-in); }
.cursor-tip.on{ opacity:1; scale:1; transition-duration:var(--dur-feedback); transition-timing-function:var(--ease-out); }
:root[data-theme="light"] .cursor-tip{ background:#191919; color:#fafaf8; }
@media (prefers-reduced-motion: reduce){ .cursor-tip{ transition:none; } }
.pw-img--shot img{ display:block; width:100%; height:100%; object-fit:cover; }
.pw-img--logo, .pw-img--todo{ display:grid; place-items:center; }
.pw-img--logo img{ width:clamp(56px,11%,120px); height:auto; display:block; }
.pw-img--todo span{ position:relative;  font:500 12px/1.2 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; letter-spacing:-.02em; color:rgba(226,232,244,.6); }
/* Caption: one or two words under the frame, at its right edge.
   The name stays for screen readers; the logo or picture shows it. */
.pw-cap{ align-self:flex-end; font:500 12px/1.3 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; letter-spacing:-.01em; color:#eef1f8;
  /* captions sit on the sky: a dark halo keeps them readable over cloud */
  text-shadow:0 1px 2px rgba(3,6,16,.85),0 0 14px rgba(3,6,16,.7); }
.pw-name{ position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
@media (--bp-760){
  /* phones: one column */
  .pw-grid{ grid-template-columns:1fr; row-gap:64px; }
  .pw-tile:nth-child(n){ grid-column:1; margin-top:0; }
}
@media (prefers-reduced-motion: reduce){ .pw-img > *{ transition:none; } }
</style>
