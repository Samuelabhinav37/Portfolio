<!-- ════ Subliminal marks — brief screen-glitch artifacts that surface at
     random points across the page on a slow, deliberate rhythm. Each hit is
     a small rectangle (chromatic-fringed tear, desynced interlace bars,
     RGB-split sliver, or a real noise-texture patch) and an irregular
     hard-cut opacity/position stutter (3-6 abrupt jumps, no easing) built
     from setTimeout, never CSS @keyframes/transitions/rAF — browsers can
     suspend those mid-flight in a throttled/backgrounded tab, leaving marks
     visually "stuck"; a setTimeout chain always finishes. Static uses an SVG
     feTurbulence noise texture instead of a striped gradient so it reads as
     grain, not pattern. ~1-in-4 hits doubles up as a quick second strike a
     beat later, and ~1-in-5 also flashes a full-page overlay for a single
     frame, selling "the whole screen hiccuped" rather than "a shape
     appeared." Purely atmospheric: no meaning, no interaction, aria-hidden.
     Sits above chrome-damp (600) but below Luna/menu (998+). ════ -->

<div id="subliminal-layer" aria-hidden="true"></div>
<div id="subliminal-flash" aria-hidden="true"></div>
<script is:inline defer src="/scripts/index-subliminal-layer.js"></script>

<!-- ════ Terminal window — floating CRT feed; Beat 1 expands it to fullscreen ════
     Sits in a fixed, centered stage at z-index 500: above the nebula/network
     background (#window), below Luna (999) and the chrome (1000+), so the navbar
     and Luna ride on top throughout. Revealed at body.intro-done (Beat 0). -->
<div id="term-stage">
  <div id="term-window" style="width:100%;height:100vh;height:100svh;border-radius:0;">
    <div id="term-screen">
      <div class="tcorner tl"></div><div class="tcorner tr"></div>
      <div class="tcorner bl"></div><div class="tcorner br"></div>
      <div id="term-feed">
        <video id="term-feed-video" poster="/images/term-feed-poster.webp"
          muted loop playsinline aria-hidden="true"></video>
      </div>
      <div id="hero-tagline">
        <p>Everything is connected.<br>Everything must be <span id="hero-tagline-word" data-text="protected">protected</span><span id="hero-tagline-cursor" aria-hidden="true">|</span></p>
        <p class="hero-tagline-sub">I write detection logic, hunt bugs on HackerOne, and build things like a federated anomaly detector for industrial networks — currently looking for a team that reads its own logs.</p>
      </div>
    </div>
  </div>
</div>
<script is:inline>
(function(){
  var v = document.getElementById('term-feed-video');
  if(!v) return;
  if(matchMedia('(prefers-reduced-motion: reduce)').matches) return; // stays on the poster, as before

  /* Connection-aware loading: on a slow/metered connection, never request
     the 4.9MB video at all — src is only set below, so preload="auto"
     never fires a byte over the wire, and the poster (a real compressed
     still of the video's own first frame) just stays up permanently
     instead of a video that would stall or eat someone's data cap. The
     Network Information API is Chromium-only (no Safari/Firefox support);
     absent that signal, default to loading normally rather than silently
     degrading everyone on unsupported browsers. 3g is treated as slow too
     (not just 2g) since that's the more common "bad mobile" case in the
     real world, plus a downlink-based fallback for congested connections
     that still self-report as 4g. */
  var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  var slow = conn && (
    conn.saveData ||
    /^(slow-2g|2g|3g)$/.test(conn.effectiveType||'') ||
    (typeof conn.downlink === 'number' && conn.downlink < 1.5)
  );
  if(slow) return;

  function loadVideo(){
    v.preload = 'auto';
    v.src = '/videos/term-feed-hero.mp4';
    v.autoplay = true;
    var p = v.play();
    if(p && p.catch) p.catch(function(){});
  }

  /* #term-stage stays opacity:0 until body.intro-done (see CSS above) —
     no reason to spend 4.9MB of bandwidth on a video that isn't even
     visible yet. Watching for the class (rather than assuming a fixed
     delay) keeps this correct whether the instant-settle path or the
     full ~6.4s choreography in index-intro-sequence.js is active. */
  if(document.body.classList.contains('intro-done')){
    loadVideo();
  } else {
    var mo = new MutationObserver(function(){
      if(document.body.classList.contains('intro-done')){
        mo.disconnect();
        loadVideo();
      }
    });
    mo.observe(document.body, {attributes:true, attributeFilter:['class']});
  }
})();
</script>

<!-- Beat 1 scroll distance: scrubs the expand floating &rarr; fullscreen -->
<!-- beat1 removed: CRT is now a normal-flow section that scrolls away -->
<!-- ═══════════════ EDITORIAL FLOW: KEV feed → beliefs → research log ═══════════════
     Normal-flow content inserted between the CRT (beat1) and the globe (beat-arc).
     Sits at z-index 300 over the ambient nebula/network (z0/z1); the CRT releases
     on scroll and the globe stays unformed until its band, so nothing overlaps. -->


<!-- index-signal-eagle.js/index-editorial-flow.js both target elements inside
     #editorial and already gate their own render loops behind an
     IntersectionObserver — but as plain eager deferred script tags they
     still fetched+parsed at t=0 for a section nobody had scrolled to yet.
     This loader defers the fetch/parse itself too, injecting both real
     script elements only once #editorial nears the viewport (same 200px
     rootMargin convention used by every other IO in this codebase).
     NOTE: this comment deliberately avoids writing a literal "<script"
     substring — scripts/obfuscate.mjs's SCRIPT_TAG_RE regex matches HTML
     comments too (it runs before comment-stripping), so a fake opening
     tag in prose with no matching close gets treated as a real one and
     swallows everything up to the next real closing tag, silently
     deleting it. Hit this for real once; don't reintroduce it. -->
<script is:inline>
(function(){
  var target = document.getElementById('editorial-lazy-anchor');
  if(!target || !('IntersectionObserver' in window)){
    // No IO support: load eagerly rather than never loading at all.
    ['/scripts/index-signal-eagle.js','/scripts/index-editorial-flow.js'].forEach(function(src){
      var s=document.createElement('script'); s.src=src; s.defer=true; document.body.appendChild(s);
    });
    return;
  }
  var fired=false;
  function loadNow(){
    if(fired) return; fired=true; io.disconnect();
    ['/scripts/index-signal-eagle.js','/scripts/index-editorial-flow.js'].forEach(function(src){
      var s=document.createElement('script'); s.src=src; s.defer=true; document.body.appendChild(s);
    });
  }
  var io = new IntersectionObserver(function(es){
    if(es[0].isIntersecting) loadNow();
  }, {rootMargin:'200px'});
  io.observe(target);
})();
</script>

<div id="editorial">
<div id="editorial-lazy-anchor" aria-hidden="true"></div>

  <!-- KEV feed -->
  <section class="ed-kev" aria-label="Live threat feed from the CISA KEV catalog">
