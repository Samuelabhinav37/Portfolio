<!-- Beat 1 scroll distance: scrubs the expand floating &rarr; fullscreen -->
<!-- beat1 removed: CRT is now a normal-flow section that scrolls away -->
<!-- ═══════════════ EDITORIAL FLOW: KEV feed → beliefs → research log ═══════════════
     Normal-flow content between the CRT and the projects. Sits at z-index 300
     over the sky background; the CRT releases on scroll, so nothing overlaps. -->
<style is:global id="ed-styles">
  #editorial{ position:relative; z-index:300; background:transparent; color:#ededee;
    font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-weight:400; }
  #editorial .ed-lbl{ font-family:'JetBrains Mono',monospace; font-weight:500; font-size:11px;
    letter-spacing:2px; text-transform:uppercase; color:#87878d; }

  /* ── KEV live feed ── */
  #editorial .ed-kev{ padding:clamp(70px,13vh,150px) 0; max-width:1500px; margin:0 auto; }
  #editorial .ed-kev__head{ padding:0 clamp(24px,5vw,80px); margin-bottom:clamp(30px,5vh,48px);
    display:flex; align-items:flex-end; justify-content:space-between; gap:20px; flex-wrap:wrap; }
  #editorial .ed-kev__head .ed-lbl{ display:block; margin-bottom:14px; }
  #editorial .ed-kev__head h2{ font-weight:300; font-size:clamp(1.5rem,2.2vw,2rem); letter-spacing:-.3px; }
  #editorial .ed-kev__head h2 em{ font-style:normal; color:#94949a; }
  /* One plain-language line so a non-security visitor knows this is a real,
     live feed and what it is, not decoration. */
  #editorial .ed-explain{ margin-top:10px; max-width:68ch; font-weight:300;
    font-size:13px; line-height:1.55; color:#94949a; }
  #editorial .ed-kev__status{ font-family:'JetBrains Mono',monospace; font-size:11px; letter-spacing:.5px;
    color:#87878d; display:flex; align-items:center; gap:8px; }
  #editorial .ed-kev__status .ed-dot{ width:6px; height:6px; border-radius:50%; background:#87878d; }
  #editorial .ed-kev__status.ed-live .ed-dot{ background:rgba(120,225,170,.9);
    box-shadow:0 0 6px rgba(120,225,170,.7); animation:edpulse 2.2s infinite; }
  @keyframes edpulse{ 0%,100%{opacity:1} 50%{opacity:.35} }
  #editorial .ed-ticker{ position:relative; border-top:1px solid rgba(var(--c-white),.1);
    border-bottom:1px solid rgba(var(--c-white),.1); overflow:hidden;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);
            mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent); }
  #editorial .ed-track{ display:inline-flex; white-space:nowrap; will-change:transform;
    animation:edscroll 80s linear infinite; }
  #editorial .ed-ticker:hover .ed-track{ animation-play-state:paused; }
  @keyframes edscroll{ from{transform:translateX(0)} to{transform:translateX(-50%)} }
  #editorial .ed-kv{ display:inline-flex; align-items:baseline; gap:12px; padding:16px 34px;
    font-family:'JetBrains Mono',monospace; font-size:12.5px; letter-spacing:.3px;
    text-decoration:none; cursor:pointer; transition:background .2s; }
  #editorial .ed-kv:hover{ background:rgba(var(--c-white),.05); }
  #editorial .ed-kv .ed-cve{ color:#ededee; font-weight:500; }
  #editorial .ed-kv .ed-vp{ color:#94949a; }
  #editorial .ed-kv .ed-date{ color:#87878d; }
  #editorial .ed-kv .ed-ransom{ color:#e5b8b8; font-size:10px; letter-spacing:1px;
    border:1px solid rgba(229,184,184,.3); border-radius:3px; padding:1px 6px; }
  #editorial .ed-kv .ed-sep{ color:#87878d; opacity:.5; }
  #editorial .ed-kev__foot{ padding:18px clamp(24px,5vw,80px) 0; }
  #editorial .ed-kev__foot span{ font-family:'JetBrains Mono',monospace; font-size:10.5px;
    letter-spacing:.5px; color:#87878d; }

  /* ── KEV feed, mobile: this section had no phone-specific sizing at all —
     desktop's 24-32px heading and 34px-padded ticker pills just ran at full
     size on a narrow screen. Everything below is scaled down and given its
     own explicit spacing (head/ticker/foot were relying on desktop's large
     padding for breathing room, so shrinking that without adding gap back
     is what read as "no spacing" once the paddings came down). */
  @media (--bp-760){
    #editorial .ed-kev{ padding:clamp(40px,8vh,80px) 0; }
    #editorial .ed-kev__head{ padding:0 20px; margin-bottom:22px; gap:10px 16px; }
    #editorial .ed-kev__head .ed-lbl{ margin-bottom:10px; }
    #editorial .ed-kev__head h2{ font-size:1.3rem; }
    #editorial .ed-kev__status{ font-size:9.5px; gap:7px; }
    #editorial .ed-kv{ padding:11px 16px; gap:8px; font-size:10.5px; }
    #editorial .ed-kv .ed-ransom{ font-size:8.5px; padding:1px 5px; }
    #editorial .ed-kev__foot{ padding:14px 20px 0; }
    #editorial .ed-kev__foot span{ font-size:9.5px; }
  }

  /* ── Beliefs: the scroll-lit statement ── */
  #editorial .ed-beliefs{ padding:clamp(90px,16vh,190px) clamp(24px,5vw,80px) clamp(70px,12vh,150px);
    max-width:1500px; margin:0 auto; }
  #editorial .ed-beliefs .ed-lbl{ display:block; margin-bottom:clamp(22px,4vh,40px); }
  #editorial .ed-statement{ --lit-off:#383b47; --lit-on:#f3f5fb;
    font:600 clamp(1.7rem,3.6vw,3rem)/1.16 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    letter-spacing:-.03em; max-width:24ch; color:#e9ecf5; text-wrap:pretty; }
  #editorial .ed-proof{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(18px,3vw,40px);
    margin:clamp(60px,10vh,110px) 0 0; padding-top:28px; border-top:1px solid rgba(var(--c-white),.1); }
  #editorial .ed-proof dt{ font:600 clamp(1.5rem,2.4vw,2.1rem)/1 'Inter Tight',-apple-system,BlinkMacSystemFont,sans-serif;
    letter-spacing:-.03em; color:#f3f5fb; margin-bottom:10px; font-variant-numeric:tabular-nums; }
  #editorial .ed-proof dd{ margin:0; font-weight:300; font-size:13px; line-height:1.5; color:#94949a; max-width:24ch; }
  @media (--bp-820){ #editorial .ed-proof{ grid-template-columns:repeat(2,minmax(0,1fr)); row-gap:28px; } }
  #snapshot .ed-beliefs__imgs{ display:grid; grid-template-columns:repeat(12,1fr); align-items:start;
    row-gap:clamp(40px,9vh,120px); }
  #snapshot .ed-frame{ position:relative; overflow:hidden; background:#101012; }
  #snapshot .ed-frame img{ width:100%; height:100%; object-fit:cover; display:block;
    filter:grayscale(1) brightness(.8);
    transition:filter 1.1s cubic-bezier(.22,1,.36,1), transform 1.3s cubic-bezier(.22,1,.36,1); }
  #snapshot .ed-frame:hover img{ filter:grayscale(0) brightness(.95); transform:scale(1.04); }
  #snapshot .ed-frame--a{ grid-column:1 / 7; aspect-ratio:16/12.5; margin-top:clamp(40px,9vh,120px); }
  /* No aspect-ratio (unlike ed-frame--a): sizes to the arcade canvas's own
     height instead of being forced to match its neighbor. .ed-beliefs__imgs
     already has align-items:start, so the grid row doesn't stretch it either. */
  #snapshot .ed-frame--b{ grid-column:9 / 13; }

  /* ── Beliefs — bento (replaces the landscape frame) ── */
  #snapshot .ed-bento{ display:grid; grid-template-columns:1fr 1fr; grid-template-rows:1fr 1fr;
    gap:1px; background:rgba(var(--c-white),.08); }
  #snapshot .ed-bento__cell{ background:#101012; padding:clamp(14px,1.6vw,20px); display:flex; flex-direction:column;
    gap:10px; position:relative; overflow:hidden; transition:background .4s ease; }
  #snapshot .ed-bento__cell:hover{ background:#151517; }
  #snapshot .ed-bento__lbl{ font-family:'JetBrains Mono',monospace; font-size:10px; font-weight:500;
    letter-spacing:1.3px; text-transform:uppercase; color:#87878d; position:relative; z-index:2; }

  /* Threat intel — terminal/log feel: colored left-rule per source, hairline-divided rows.
     Spans the whole top row (the decorative Signal canvas that shared it is gone), so the
     feed runs as a 2x2 grid of four reports with 2-line titles, rather than three rows
     stretched across a wide empty cell. */
  #snapshot .ed-bento__intel{ grid-column:1 / -1; }
  #snapshot .ed-bento__intel .ed-bento__lbl{ display:flex; align-items:center; gap:7px; }
  #snapshot .ed-intel__dot{ width:5px; height:5px; border-radius:50%; background:rgba(226,232,244,.85);
    box-shadow:0 0 6px rgba(226,232,244,.55); animation:edpulse 2.2s infinite; }
  #snapshot .ed-intel__list{ display:grid; grid-template-columns:1fr 1fr; grid-auto-rows:min-content; align-content:center;
    gap:14px clamp(18px,2.4vw,32px); overflow:hidden; flex:1; min-height:0; font-family:'JetBrains Mono',monospace; }
  #snapshot .ed-intel__row{ display:flex; flex-direction:column; gap:6px; text-decoration:none; color:inherit;
    padding:1px 0 13px 12px; border-left:2px solid transparent; border-bottom:1px solid rgba(var(--c-white),.06);
    transition:border-color .25s, background .25s; }
  #snapshot .ed-intel__row:nth-last-child(-n+2){ border-bottom:none; padding-bottom:0; }
  #snapshot .ed-intel__row.otx{ border-left-color:rgba(226,232,244,.38); }
  #snapshot .ed-intel__row.misp{ border-left-color:rgba(226,232,244,.20); }
  #snapshot .ed-intel__row:hover{ background:rgba(var(--c-white),.04); }
  #snapshot .ed-intel__meta{ display:flex; gap:8px; align-items:center; font-size:9.5px; letter-spacing:.6px; text-transform:uppercase; }
  #snapshot .ed-intel__meta .src{ font-weight:700; padding:2px 6px; border-radius:3px; line-height:1; }
  #snapshot .ed-intel__meta .src.otx{ color:#dcdce0; background:rgba(226,232,244,.10); }
  #snapshot .ed-intel__meta .src.misp{ color:#9c9ca2; background:rgba(226,232,244,.06); }
  #snapshot .ed-intel__meta .org{ color:#8a8a92; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; text-transform:none; letter-spacing:0; }
  #snapshot .ed-intel__title{ font-size:12px; font-weight:400; color:#c9c9cc; line-height:1.4;
    font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical;
    overflow:hidden; }
  #snapshot .ed-intel__row:hover .ed-intel__title{ color:#fff; }

  /* Cert badges marquee — real vendor-issued badge art, not icon chips */
  #snapshot .ed-badges__wrap{ position:relative; flex:1; display:flex; align-items:center; overflow:hidden;
    -webkit-mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent);
            mask-image:linear-gradient(90deg,transparent,#000 8%,#000 92%,transparent); }
  #snapshot .ed-badges__track{ display:inline-flex; gap:22px; white-space:nowrap; will-change:transform;
    animation:edscroll 34s linear infinite; }
  #snapshot .ed-badges__wrap:hover .ed-badges__track{ animation-play-state:paused; }
  #snapshot .ed-badge{ display:inline-flex; flex-direction:column; align-items:center; gap:9px; width:92px; }
  #snapshot .ed-badge img{ width:60px; height:60px; object-fit:contain; box-sizing:content-box;
    transition:transform .3s ease; }
  #snapshot .ed-badge:hover img{ transform:translateY(-2px) scale(1.05); }
  /* Only CompTIA's badge art ships an opaque white square baked into the PNG — everything
     else (ISC2/AWS/Azure/HTB) is already transparent and needs no backing at all. */
  #snapshot .ed-badge--framed img{ background:#f2f1ee; border-radius:11px; padding:6px;
    box-shadow:0 3px 14px rgba(0,0,0,.4); }
  #snapshot .ed-badge span{ font-family:'JetBrains Mono',monospace; font-size:10px; letter-spacing:.3px;
    color:#94949a; white-space:normal; text-align:center; line-height:1.2; }

  /* ATT&CK spotlight — rotating technique card, deliberately distinct from the intel log.
     #ed-attck-mount is the flex container that actually fills the cell; the card content
     sits at the top and the dots are pinned as a footer via justify-content:space-between,
     so extra cell height (from taller viewports) becomes a deliberate gap, not dead space.
     Tactic/ID live inside .ed-attck__text, after the description, so they read as a caption
     under the copy instead of a stray row wedged under the icon. */
  #snapshot .ed-bento__attck{ gap:26px; }
  #snapshot .ed-bento__attck > div{ flex:1; display:flex; flex-direction:column; justify-content:space-between; min-height:0; }
  #snapshot .ed-attck{ display:flex; flex-direction:column; gap:12px; text-decoration:none; color:inherit; }
  #snapshot .ed-attck__top{ display:flex; align-items:flex-start; gap:12px; }
