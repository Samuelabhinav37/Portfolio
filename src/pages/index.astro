    ctx.beginPath();ctx.moveTo(w.ax,w.ay);ctx.lineTo(w.bx,w.by);ctx.strokeStyle='rgba(140,175,220,'+(vis*.06).toFixed(3)+')';ctx.lineWidth=.4;ctx.stroke();
  }
