/* ── Globe interaction: swing-by + depth ───────────────────────────────
   The globe module publishes its screen-space disk as window.__globeScreen
   ({x,y,r} in CSS px, on:true while visible). The 2D layer sits at (OX,OY)
   at 1:1 px scale, so a screen point maps to canvas space by subtracting
   OX/OY.

   Two effects combine to make ships feel like they share 3D space with the
   globe:
   1. Swing-by — near the globe, a craft's heading is bent toward the tangent
      (the way it's already going round) plus a little outward, speed kept
      constant, so it curves past in a graceful slingshot arc instead of a
      straight line. No hard wall, so committed paths can still cross.
   2. Depth — a craft drawn while inside the disk is faded toward the centre
      (and is already behind the globe canvas in z-order), so it reads as
      passing BEHIND the sphere and re-emerging, rather than slicing the
      wireframe. Applied via globalAlpha around each craft's draw. */
var GLOBE_AVOID_PAD   = 10;    // px clearance folded into the swing radius
var GLOBE_SWING_RANGE = 1.75;  // influence radius = (r+pad) * this
var GLOBE_SWING_BEND  = 0.34;  // how hard the path curves near the globe
var GLOBE_BEHIND_MIN  = 0.10;  // craft alpha at the globe's centre (deepest "behind")

function _swingXY(o, XK,YK,VXK,VYK, gx,gy,R){
  var dx=o[XK]-gx, dy=o[YK]-gy, d=Math.sqrt(dx*dx+dy*dy);
  var Rinf=R*GLOBE_SWING_RANGE;
  if(d>=Rinf||d<1e-4) return;
  var nx=dx/d, ny=dy/d;                          // outward radial
  var prox=(Rinf-d)/(Rinf-R); if(prox<0)prox=0; if(prox>1.4)prox=1.4;
  var vx=o[VXK], vy=o[VYK], sp=Math.sqrt(vx*vx+vy*vy);
  if(sp<1e-4) return;
  var tx=-ny, ty=nx;                             // tangent
  if(vx*tx+vy*ty<0){ tx=-tx; ty=-ty; }           // pick the way it's already orbiting
  var bend=prox*prox*GLOBE_SWING_BEND;
  var nvx=vx + (tx*1.15 + nx*0.55)*sp*bend;       // curve toward tangent + slight outward
  var nvy=vy + (ty*1.15 + ny*0.55)*sp*bend;
  var nsp=Math.sqrt(nvx*nvx+nvy*nvy)||1e-4;
  o[VXK]=nvx/nsp*sp;                              // renormalise: a slingshot bends, doesn't speed up
  o[VYK]=nvy/nsp*sp;
}
function steerBodiesAroundGlobe(){
  var g=window.__globeScreen;
  if(!g||!g.on) return;
  var gx=g.x-OX, gy=g.y-OY, R=g.r+GLOBE_AVOID_PAD;
  // Fleets: steer the formation CENTRE (the ships follow it), not each ship.
  if(fleet1) _swingXY(fleet1,'cx','cy','vx','vy',gx,gy,R);
  if(fleet2) _swingXY(fleet2,'cx','cy','vx','vy',gx,gy,R);
  // Chase group + free craft: steer their own velocity.
  _swingXY(robber,'x','y','vx','vy',gx,gy,R);
  _swingXY(cop,'x','y','vx','vy',gx,gy,R);
  _swingXY(esc1,'x','y','vx','vy',gx,gy,R);
  _swingXY(esc2,'x','y','vx','vy',gx,gy,R);
  _swingXY(freighter,'x','y','vx','vy',gx,gy,R);
  _swingXY(freighter2,'x','y','vx','vy',gx,gy,R);
  _swingXY(freighter3,'x','y','vx','vy',gx,gy,R);
  _swingXY(freighterL2,'x','y','vx','vy',gx,gy,R);
  _swingXY(freighterL3,'x','y','vx','vy',gx,gy,R);
  _swingXY(freighterR3,'x','y','vx','vy',gx,gy,R);
  if(probe.active) _swingXY(probe,'x','y','vx','vy',gx,gy,R);
  _swingXY(wan,'x','y','vx','vy',gx,gy,R);
  _swingXY(sct,'x','y','vx','vy',gx,gy,R);
  _swingXY(deadSat,'x','y','vx','vy',gx,gy,R);
  // patrols (parametric line) + orb (own orbit) rely on the depth fade only.
}

/* Depth fade: 1 outside the globe disk, dropping toward GLOBE_BEHIND_MIN at the
   centre, so a craft passing over the globe dims as if going behind it. */
function _depthAlpha(x,y){
  var g=window.__globeScreen; if(!g||!g.on) return 1;
  var gx=g.x-OX, gy=g.y-OY, R=g.r;
  var dx=x-gx, dy=y-gy, d2=dx*dx+dy*dy;
  if(d2>=R*R) return 1;
  var tt=Math.sqrt(d2)/R;                          // 0 centre .. 1 edge
  return GLOBE_BEHIND_MIN + (1-GLOBE_BEHIND_MIN)*tt*tt;
}
var _fxPrevA=1;
function _fxBegin(x,y){ var a=_depthAlpha(x,y); _fxPrevA=ctx.globalAlpha; if(a<0.999) ctx.globalAlpha=_fxPrevA*a; }
function _fxEnd(){ ctx.globalAlpha=_fxPrevA; }

/* Ships + the four moving satellites. Called inside the gate at its original
   z-order for the normal phase, and again after the gate during the globe
