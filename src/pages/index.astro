/* ── MAIN LOOP ── */
var RM = REDUCED_MOTION;
/* The nebula (WebGL shader + 2D glow/starfield) and the interactive hub
   constellation are an intro flourish, not a permanent backdrop — after a
   short window they stop entirely and the WebGL canvas is hidden, leaving
   the plain solid background. Ships and satellites are unaffected and keep
   animating forever. Independent of scroll position/the globe handoff below
   — this is a hard stop regardless of where you are on the page. */
var _bgIntroOver = false;
setTimeout(function(){
  _bgIntroOver = true;
  if(glslCanvas) glslCanvas.style.display = 'none';
}, 6000);
/* Perf: cap the simulation to 30fps and fully pause when the tab is hidden,
   so this page stops competing for GPU/CPU with other tabs (e.g. video). */
var _FRAME_MIN = 1000/30, _frameLast = 0, _loopPaused = false, _frameErrs = 0;
function loop(ts){
  if(document.hidden){ _loopPaused = true; return; }
  requestAnimationFrame(loop);
  if(ts && (ts - _frameLast) < _FRAME_MIN) return;
  _frameLast = ts || 0;
  try{
    var rdt=Math.min(threeClock.getDelta(),0.05);   // real frame delta (seconds)
    var dt = rdt * BG_PACE;                          // scaled: slows ALL background motion
    var t  = U.uTime.value += dt;
    /* Feed the adaptive budget with the REAL frame time (ms), not the scaled
       one — otherwise the scaling would fool the perf tier system. */
    _budget.push(rdt * 1000);
    _budget.step(rdt);
    /* Globe handoff: while the scroll-arc globe owns the screen (its opaque
       canvas fully covers the background) skip the nebula WebGL render and the
       entire 2D scene draw — they're invisible underneath it. Updates still run
       below so nothing freezes or snaps when you scroll back up. clearRect stays
       (cheap on the 1.65x surface) so no stale frame flashes at the handoff. */
    var _globeOwns = (window.__globeOwnsScreen === true);
    /* Scroll choreography removed: the CRT, globe and footer are normal-flow
       sections now. The background stays at constant brightness (no scroll-driven
       dimming), and the footer's reveal + render gate are handled by an
       IntersectionObserver near the footer script rather than by scroll progress. */
    window.__netAlpha = 0.5;
    var _calm = 0, _busy = 1, _netA = 1;
    window.__footerCalm = 0;
    if(renderer && !_bgIntroOver) renderer.render();   // nebula renders in every phase (globe + tour sit over it), until the intro window ends
    ctx.clearRect(0,0,CW,CH);
    ctx.lineCap='round';
    /* Nebula + starfield draw in every phase now (incl. the globe form and the
       project tour) so the globe and cards sit over a live nebula, not black —
       but only within the intro window; after that this whole layer stops.
       The crosshair grid stays gated — it reads as "network", not atmosphere. */
    if(!_bgIntroOver){
    drawNebulae(t);drawStarsParallax(t);
    if(!_globeOwns && _netA>0.01){
      ctx.save(); ctx.globalAlpha=_netA;
      drawCrosshairGrid();
      ctx.restore();
    }
    }
    // Footer calm splits the scene in two:
    //   KEEP (always full opacity, persists into the footer): nebula, stars, ships,
    //         satellites, asteroids, shooting stars, meteors — the calm "space traffic".
    //   FADE (gated by _netA -> 0 at the footer): the network map — crosshair grid,
    //         node labels, constellation/connection lines, traceroutes, scan rings,
    //         wormhole, intrusions, glitch, data storm, backbone, mem-lines.
    // _netA is the network-map alpha; ships never read it, so they stay.
    // _netA (network-map alpha) computed above with _calm; fully faded by calm 0.42.
    updReveal(dt);
    if(!RM) updGlitch(dt);
    updReactiveGlow(dt,t);
    // GLOBAL constellation drift — the whole cluster wanders + gently tumbles as
    // one body about the field centre. Computed here so the node updates below can
    // inverse-map the cursor against it (keeps proximity reveal aligned).
    (function(){
      var gt=U.uTime.value*NET_GLOBAL_SPD;
      // organic 2-octave noise meander — walks a noise line per axis so the cluster
      // wanders in ALL directions and changes heading naturally (no one-way slide).
      // Centred on 0 (noise−0.5) so it drifts out and returns rather than escaping.
      _gDx=((vnoise3(gt*2.0,       0.0, 3.0)-0.5)*1.4 + (vnoise3(gt*4.6,       0.0, 9.0)-0.5)*0.6)*NET_GLOBAL_AMP;
      _gDy=((vnoise3(0.0, gt*2.0+11.0, 5.0)-0.5)*1.4 + (vnoise3(0.0, gt*4.2+3.0, 13.0)-0.5)*0.6)*NET_GLOBAL_AMP;
      _gRot=((vnoise3(gt*1.6, 7.0, 21.0)-0.5)*2.0)*(NET_GLOBAL_ROT*Math.PI/180);
      var dx=canvasMX-(BIO_CX+_gDx), dy=canvasMY-(BIO_CY+_gDy);
      var cr=Math.cos(-_gRot), sr=Math.sin(-_gRot);
      canvasMXt=BIO_CX+dx*cr-dy*sr; canvasMYt=BIO_CY+dx*sr+dy*cr;
    })();
    var nlen=nodes.length;
    if(!_bgIntroOver){ for(var i=0;i<nlen;i++) nodes[i].update(dt); }
    updMemLines(dt);updPulses(dt);updDS(dt);coolHeat(dt);
    updAutoPing(dt);updScanRings(dt);updTraceroutes(dt);
    updWormhole(dt);updIntrusions(dt);
    if(!RM){
      updChase(dt);
      updFleet(fleet1,dt);updFleet(fleet2,dt);
      updPatrol(patrol1,dt);updPatrol(patrol2,dt);
      updFreighter(dt);updFreighterL2(dt);updFreighterL3(dt);updFreighter2(dt);updFreighter3(dt);updFreighterR3(dt);updProbe(dt);
      updAst(dt);updBigAst(dt);
      ssT+=dt;if(ssT>ssNext){spawnSS();ssNext=(12+Math.random()*14)*CALM;ssT=0;}updSS(dt);
      updMeteorShower(dt);
      updBattleDamage(dt);
    }
    updWan(dt);updOrb(dt);updSct(dt);
    updDeadSat(dt);updRelaySat(dt);
    updReticles(dt);
    updDataStorm(dt);
    updBootSeq(dt);
    updPathGlows(dt);
    updAfterGlows(dt);
    updOverloads(dt);
    /* keep ships + the moving satellites clear of the globe's screen disk */
    steerBodiesAroundGlobe();
    if(!_globeOwns){
    // ---- NETWORK MAP (fades out at the footer via _netA) ----
    if(_netA>0.01){
    ctx.save(); ctx.globalAlpha *= _netA;
    // global constellation drift: translate + gently rotate the whole cluster
    // about the field centre. Only wraps the network map — ships, satellites and
    // the nebula are drawn outside this save(), so they stay put and the cluster
    // parallaxes against them.
    ctx.translate(BIO_CX+_gDx, BIO_CY+_gDy); ctx.rotate(_gRot); ctx.translate(-BIO_CX, -BIO_CY);
    /* Beat 2 is space only: nebula, ships, satellites. The node web and the
       traceroutes belong to the intro; the globe's own formation brings the
       dots back for beat 2's second half. */
    /* renamed: v9 already has a _netA in this scope for the footer fade */
    var _netGate=(window.__netAlpha===undefined)?1:window.__netAlpha;
    if(_netGate>0.004 && !_bgIntroOver){
    ctx.save(); ctx.globalAlpha*=_netGate;
    drawGalaxy();
    if(scrollY < (window.innerHeight||800)*1.25) drawConstellationLines();   /* constellations: intro only */
    if(_budget.tier < 3) drawCorona(t);
    if(_budget.tier < 2) drawNebulaTrails();
    drawMemLines();drawBackbone();
    for(var i=0;i<nlen;i++) nodes[i].drawTrail();
    drawPathGlows();
    drawConns();drawPulses();drawDS();drawTraceroutes();drawScanRings();
    for(var i=0;i<nlen;i++) nodes[i].drawRings();
    for(var i=0;i<nlen;i++) nodes[i].drawHB(t);
    for(var i=0;i<nlen;i++) nodes[i].draw(t);
    drawIntrusions();drawReticles();
    ctx.restore();
    }
    drawWormhole();
    ctx.restore();
    }
    // ---- SPACE TRAFFIC (always full opacity, stays in the footer) ----
    drawShipsAndMovingSats();
    drawRelaySat();drawGeoSat();
    if(!RM){
      drawAst();drawBigAst();drawSS();
      drawMeteorShower();
    }
    drawAfterGlows();
    // grain + glitch are network-map texture -> fade them with _netA too
    if(!RM && _netA>0.01){
      ctx.save(); ctx.globalAlpha *= _netA;
      drawGrain(t);
      if(_budget.tier < 1) drawGlitch();
      ctx.restore();
    }
    } /* end !_globeOwns draw gate */

    /* Globe / project-tour phase: the dense network is gated off above, but the
       ships + moving satellites keep flying over the globe — steered clear of it
       by steerBodiesAroundGlobe(). Drawn here (not inside the gate) so they ride
       on top of the live nebula during the globe phase. */
    if(_globeOwns) drawShipsAndMovingSats();

    // The red ship (the chase) stays present through the whole experience — drawn even
    // over the globe/project area — but NOT during the boot intro or the CRT hero at the
    // top. __arcProgress > ~0.06 means we've scrolled off the CRT screen.
