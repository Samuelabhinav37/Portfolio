  #snapshot .ed-attck:hover .ed-attck__icon{ background:rgba(226,232,244,.14); }
  #snapshot .ed-attck__icon svg{ width:16px; height:16px; }
  #snapshot .ed-attck__text{ display:flex; flex-direction:column; gap:7px; min-width:0; }
  #snapshot .ed-attck__name{ font-weight:400; font-size:clamp(.86rem,1.05vw,.96rem); color:#ededee;
    line-height:1.3; letter-spacing:-.1px; transition:color .25s; }
  #snapshot .ed-attck:hover .ed-attck__name{ color:#fff; }
  #snapshot .ed-attck__desc{ font-weight:300; font-size:11.5px; color:#94949a; line-height:1.55; max-width:42ch;
    display:-webkit-box; -webkit-line-clamp:6; -webkit-box-orient:vertical; overflow:hidden; }
  #snapshot .ed-attck__meta{ display:flex; align-items:center; gap:9px; margin-top:2px; }
  #snapshot .ed-attck__tactic{ font-family:'JetBrains Mono',monospace; font-size:9.5px;
    font-weight:600; letter-spacing:.8px; text-transform:uppercase; color:#dcdce0;
    background:rgba(226,232,244,.10); border-radius:2px; padding:3px 7px; }
  #snapshot .ed-attck__id{ font-family:'JetBrains Mono',monospace; font-size:11px; color:#87878d; letter-spacing:.5px; }
  #snapshot .ed-attck__dots{ display:flex; align-items:center; gap:0; padding-top:4px; margin-left:-10px;
    border-top:1px solid rgba(var(--c-white),.07); }
  /* Each button is a real 24x24 target (WCAG 2.5.8) with the 4px dot drawn
     in its center. The old version kept 4px buttons with a 24px ::before
     hit area, but dots 9px apart meant neighbouring hit areas overlapped.
     margin-left:-10px keeps the first dot aligned with the text above. */
  #snapshot .ed-attck__dots button{ position:relative; width:24px; height:24px; background:none;
    cursor:pointer; border:0; padding:0; appearance:none; }
  #snapshot .ed-attck__dots button::after{ content:''; position:absolute; left:10px; top:10px; width:4px; height:4px;
    border-radius:50%; background:rgba(var(--c-white),.18); transition:background .3s; }
  #snapshot .ed-attck__dots button:focus-visible{ outline:1px solid #ededee; outline-offset:-6px; border-radius:50%; }
  #snapshot .ed-attck__dots button.active::after{ background:#ededee; }

  /* DDoS targets: ranked share bars. Same dark/mono bento language as the
     cells above; bar fill is the one accent, no per-industry colors. */
  #snapshot .ed-ddos{ padding:clamp(16px,1.8vw,22px); box-sizing:border-box;
    display:flex; flex-direction:column; gap:14px; justify-content:space-between; }
