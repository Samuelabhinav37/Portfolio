<style is:global>
/* One rhythm for every section: the same left edge as the project captions,
   the same breath above each heading, the same gap from heading to content. */
:root{ --gut:clamp(16px,3.2vw,48px); --sec-pad:clamp(150px,26vh,300px); --head-gap:clamp(40px,7vh,80px); }

/* Section headings: a smaller sibling of the blog's "Field Notes (N)" title.
   A large serif line with one italic word. */
.sec-head{ position:relative; display:grid; grid-template-columns:1fr auto; align-items:end; column-gap:24px;
  margin:0 0 var(--head-gap); padding:0 var(--gut); }
#signal .sec-head{ padding:0; }
.sec-title{ margin:0; font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; font-size:clamp(46px,6.4vw,96px);
  line-height:.92; letter-spacing:-.03em; color:#eef1f8; text-wrap:balance; }
.sec-title em{ font-style:italic; color:#cdd9f7; }
.sec-title sup{ font:500 .17em/1 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; letter-spacing:0;
  vertical-align:top; position:relative; top:.4em; margin-left:.14em; color:#c9d6ff; }
.sec-link{ font:500 11px/1 'JetBrains Mono',monospace; letter-spacing:.16em; text-transform:uppercase; color:#9aa0ae;
  text-decoration:none; transition:color .3s; padding-bottom:.6em; }
.sec-link:hover{ color:#ededee; }
/* Variant B: grotesk headline, the italic word stays serif */
:root[data-heads="b"] .sec-title{ font-family:'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; font-weight:500;
  font-size:clamp(46px,6.4vw,96px); letter-spacing:-.055em; }
:root[data-heads="b"] .sec-title em{ font-family:'Cormorant Garamond',Georgia,serif; font-weight:400; letter-spacing:-.02em; padding-right:.04em; }
/* Variant C: editorial bar, label in a narrow left column, title in the right */
:root[data-heads="c"] .sec-head{ grid-template-columns:minmax(140px,22%) 1fr auto; border-top:1px solid rgba(201,214,255,.16); padding-top:18px; }
:root[data-heads="c"] #signal .sec-head{ padding-top:18px; }
:root[data-heads="c"] .sec-title{ grid-column:2; }

/* Page rail (same shape as the blog post's .etoc strip) */
.hrail{ position:fixed; right:22px; top:50%; transform:translateY(-50%); z-index:140; }
.hrail-dashes{ list-style:none; margin:0; padding:12px 6px 12px 28px; display:grid; gap:12px; justify-items:end; }
.hrail-dashes span{ display:block; width:22px; height:2px; border-radius:2px; background:rgba(226,232,244,.22); transition:width .25s, background .25s; }
.hrail-dashes span.is-past{ background:rgba(226,232,244,.62); }
.hrail-dashes span.is-active{ width:32px; background:rgba(238,241,248,.95); }
.hrail-card{ position:absolute; right:calc(100% - 20px); top:50%; width:220px; padding:10px; border:1px solid rgba(226,232,244,.14); border-radius:10px;
  background:rgba(12,13,19,.97); box-shadow:0 18px 50px rgba(0,0,0,.6);
  opacity:0; pointer-events:none; transform:translate(8px,-50%); transition:opacity .18s ease, transform .18s ease; }
.hrail.is-open .hrail-card, .hrail:focus-within .hrail-card{ opacity:1; pointer-events:auto; transform:translate(0,-50%); }
.hrail-card ol{ list-style:none; margin:0; padding:0; display:grid; gap:1px; }
.hrail-card a{ display:block; padding:7px 10px; border-radius:6px; font:400 14px/1.35 'Inter Tight',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif; color:rgba(226,232,244,.7); text-decoration:none; }
.hrail-card a:hover{ background:rgba(255,255,255,.05); color:#fff; }
.hrail-card a.is-active{ color:#fff; background:rgba(200,206,218,.08); box-shadow:inset 2px 0 0 #c8ceda; }
@media (max-width:1099px){ .hrail{ display:none; } }
@media (prefers-reduced-motion:reduce){ .hrail-dashes span, .hrail-card{ transition:none; } }

/* Film grain over the whole page, with a soft vignette under it. Held
   still and faint: none of the reference sites animate texture, and the sky
   already supplies the motion. */
.page-grain{ position:fixed; inset:0; z-index:2147483000; pointer-events:none; }
.page-grain::before{ content:""; position:absolute; inset:0;
  background:radial-gradient(120% 90% at 50% 45%, transparent 55%, rgba(2,4,12,.55) 100%); }
.page-grain::after{ content:""; position:absolute; inset:0; background:url(/images/grain.webp) repeat; opacity:.045; }

/* Scroll-linked motion (CSS only; browsers without view timelines just show
   everything at rest). Project frames open upward
   and their picture settles from a slight zoom. */
@supports (animation-timeline:view()){
  @media (prefers-reduced-motion:no-preference){
        .pw-img{ animation:frame-open linear both; animation-timeline:view(); animation-range:entry 0% cover 30%; }
    .pw-img > *{ animation:frame-settle linear both; animation-timeline:view(); animation-range:entry 0% cover 45%; }
  }
}
@keyframes frame-open{ from{ clip-path:inset(18% 0 0 0); } to{ clip-path:inset(0 0 0 0); } }
@keyframes frame-settle{ from{ transform:scale(1.12); } to{ transform:scale(1); } }
@media (--bp-760){
  .sec-head{ grid-template-columns:1fr; row-gap:16px; }
  .sec-link{ justify-self:start; }
  :root[data-heads="c"] .sec-head{ grid-template-columns:1fr; }
  :root[data-heads="c"] .sec-title{ grid-column:1; }
}
#projects-section{ position:relative; z-index:301; width:100%; box-sizing:border-box; background:transparent; padding:clamp(40px,6vh,64px) 0 clamp(240px,36vh,360px); }
/* After zainabkabira.com: the work arrives as a painted sheet that slides up
   over the beliefs. A night watercolour wash with a few brushed swells and
   the sky cast painted into it (mantas and a fish by the heading, coral
   trees on rock shelves down both sides, sea stars and fish scattered, a
   turtle and coral on the sea floor below the last row, clouds and stars
   throughout), cut by a dry-brush edge
   top and bottom. All generated once as images from the creatures' own
   shapes in sky-cast.js, so scrolling costs nothing extra. */
#projects-section::before{ content:""; position:absolute; z-index:-1; left:0; right:0; top:-130px; bottom:-60px; pointer-events:none;
  background:url(/images/paint/creatures-top.webp) center -60px / 1600px auto no-repeat,
    url(/images/paint/creatures-bottom.webp) center bottom 100px / 1600px auto no-repeat,
    url(/images/paint/side-l.webp) left 0 top 160px / 300px auto repeat-y,
    url(/images/paint/side-r.webp) right 0 top 460px / 300px auto repeat-y,
    url(/images/paint/scatter-tile.webp) 0 300px / 1400px auto,
    url(/images/paint/rays.webp) center top / 1600px auto no-repeat,
    url(/images/paint/clouds-tile.webp) 0 0 / 1024px,
    url(/images/paint/stars-tile.webp) 0 0 / 1024px,
    url(/images/paint/waves-tile.webp) 0 140px / 1024px,
    url(/images/paint/wash-tile.webp) 0 0 / 1024px; opacity:.96;
  -webkit-mask:url(/images/paint/wash-edge.webp) top / 100% 280px no-repeat,
    linear-gradient(#000,#000) 0 278px / 100% calc(100% - 556px) no-repeat,
    url(/images/paint/wash-edge-b.webp) bottom / 100% 280px no-repeat;
          mask:url(/images/paint/wash-edge.webp) top / 100% 280px no-repeat,
    linear-gradient(#000,#000) 0 278px / 100% calc(100% - 556px) no-repeat,
    url(/images/paint/wash-edge-b.webp) bottom / 100% 280px no-repeat; }
/* ...and the beliefs sink back under it: they drift down with the page
   (so they seem to stay put), shrink a little and dim, like her hero. */
@supports (animation-timeline:view()){
  @media (prefers-reduced-motion:no-preference){
    #beliefs{ view-timeline:--beliefs; }
    #beliefs > *{ animation:beliefs-sink linear both; animation-timeline:--beliefs; animation-range:exit 0% exit 100%; transform-origin:50% 30%; }
  }
}
@media (--bp-760){
  #projects-section::before{ background-size:1000px auto, 1000px auto, 110px auto, 110px auto, 900px auto, 1000px auto, 700px, 1024px, 700px, 1024px; background-position:center -30px, center bottom 90px, left 0 top 160px, right 0 top 460px, 0 300px, center top, 0 0, 0 0, 0 140px, 0 0; }
