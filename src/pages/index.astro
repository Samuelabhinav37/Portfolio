<style is:global>
* { margin:0; padding:0; box-sizing:border-box; }

html, body {
  width:100%;
  background:var(--c-bg);
  overflow-x:clip;   /* clip (not hidden) so it doesn't create a scroll container that breaks position:sticky */
}
html { height:auto; }
body { min-height:100%; }

/* Screen-reader-only: visually hidden but available to assistive tech.
   The focusable variant becomes visible when tabbed to (the skip link). */
.sr-only{
  position:absolute !important; width:1px; height:1px;
  padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0);
  white-space:nowrap; border:0;
}
.sr-only-focusable:focus,
.sr-only-focusable:focus-visible{
  position:fixed !important; top:10px; left:10px;
  width:auto; height:auto; margin:0; padding:8px 14px; clip:auto;
  z-index:100000; background:var(--c-bg); color:#d6e0f4;
  border:1px solid rgba(214,224,244,.4); border-radius:6px;
  font:13px/1 -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; letter-spacing:.04em;
}

/* ── Intro ── */
/* (intro-vignette removed — wordmark sits over the live boot, no dark veil) */

#intro-logo {
  position: fixed; top: 50%; left: 50%;
  transform: translate(-50%, -50%) translateY(10px);
  z-index: 9001; pointer-events: none;
  display: flex; align-items: baseline; gap: 0.55rem;
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1),
              transform 0.6s cubic-bezier(0.22,1,0.36,1);
}
#intro-logo.in { opacity: 1; transform: translate(-50%, -50%) translateY(0px); }
#intro-logo h1 {
  font-family: 'Cormorant Garamond', serif;
  /* fixed 2.80rem (44.8px) had no mobile fallback — "Samuel " + italic
     "Abhinav" side by side at that size runs close to or past the edges of
     a ~320-360px phone viewport and silently clips (page uses overflow-x:clip,
     so no scrollbar to reveal it, just a cut-off wordmark). */
  font-size: clamp(1.9rem, 9vw, 2.80rem); font-weight: 400;
  color: rgba(var(--c-white),0.92); letter-spacing: 0.01em;
}
#intro-logo .port {
  font-family: 'Cormorant Garamond', serif;
  font-size: clamp(1.9rem, 9vw, 2.80rem); font-weight: 400;
  font-style: italic; color: rgba(var(--c-white),0.6);
}

/* ── intro idle glitch: monochrome char-scramble + split (HELLO DRIBBBLE style) ── */
#intro-logo .gtxt { position:relative; }
#intro-logo .gtxt::before, #intro-logo .gtxt::after {
  content:attr(data-text); position:absolute; top:0; left:0; width:100%;
  overflow:hidden; opacity:0; pointer-events:none;
}
#intro-logo .gtxt::before { color:rgba(var(--c-white),0.95); }   /* white ghost, shifts left */
#intro-logo .gtxt::after  { color:rgba(150,150,150,0.9); }    /* gray ghost, shifts right */
#intro-logo .port .gtxt::before { color:rgba(var(--c-white),0.55); }
#intro-logo .port .gtxt::after  { color:rgba(150,150,150,0.5); }
#intro-logo.glitch-flick .gtxt::before { opacity:.55; transform:translate(-1.5px,0); }
#intro-logo.glitch-flick .gtxt::after  { opacity:.5;  transform:translate(1.5px,0); }
@media (prefers-reduced-motion: reduce){
  #intro-logo.glitch-flick .gtxt::before, #intro-logo.glitch-flick .gtxt::after { opacity:0 !important; transform:none !important; }
}

/* ── chrome dampening — soft dark pools that keep the UI legible over the
      brightened canvas; sits above the canvas, below the chrome; fades in
      together with the canvas brightness lift on Luna's arrival ── */
#chrome-damp {
  position:fixed; inset:0; z-index:600;
  pointer-events:none; opacity:0;
  transition:opacity 1.3s ease;
  background:
    radial-gradient(ellipse 780px 110px at 50% 18px,
      rgba(6,7,16,0.62) 0%, rgba(6,7,16,0) 72%),
    radial-gradient(ellipse 260px 260px at calc(100% - 64px) calc(9vh + 50px),
      rgba(6,7,16,0.20) 0%, rgba(6,7,16,0) 70%);
}

/* pullback CSS removed — terminal window replaces the window-wall */


/* ════════════════ Terminal window — floating CRT, Beat 1 expands to fullscreen ════════════════ */
#term-stage {
  position:relative; z-index:1;
  width:100%; min-height:100vh; min-height:100svh;
  display:flex; align-items:center; justify-content:center;
  pointer-events:none;
  opacity:0;
  transition:opacity 1.1s cubic-bezier(0.22,1,0.36,1);
}
body.intro-done #term-stage { opacity:1; }
#term-window {
  position:relative; pointer-events:auto;
  width:68vw; height:70vh;
  transform:translateY(0);             /* centered; beat 1 keeps y at 0 while expanding */
  border-radius:10px;
  display:flex; flex-direction:column; overflow:hidden;
  border:none;
  box-shadow:
    0 0 60px 10px rgba(var(--c-white),0.04),
    0 0 170px 36px rgba(90,120,185,0.12),
    0 40px 90px rgba(0,0,0,0.80);
  will-change:transform;
}
#term-window::before {
  content:''; position:absolute; inset:0; z-index:200; pointer-events:none; border-radius:inherit;
  background:repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.05) 3px, rgba(0,0,0,0.05) 4px);
}
#term-titlebar {
  position:relative; z-index:201; width:100%; height:34px; flex-shrink:0;
  background:rgba(16,16,16,0.98); border-bottom:1px solid rgba(var(--c-white),0.07);
  display:flex; align-items:center; justify-content:space-between; padding:0 16px; user-select:none;
}
#term-icons { display:flex; align-items:center; gap:11px; }
#term-icons .ticon { font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:0.82rem; color:rgba(var(--c-white),0.24); line-height:1; }
#term-title {
  position:absolute; left:50%; transform:translateX(-50%);
  font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:0.65rem; color:rgba(var(--c-white),0.22); text-transform:uppercase;
  letter-spacing:0.10em; white-space:nowrap; pointer-events:none;
}
#term-status { font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-size:0.52rem; color:rgba(var(--c-white),0.12); letter-spacing:0.14em; text-transform:uppercase; }
#term-screen { position:relative; flex:1; background:transparent; overflow:hidden; }
.tcorner { position:absolute; z-index:10; width:20px; height:20px; border-color:rgba(var(--c-white),0.10); border-style:solid; }
.tcorner.tl { top:20px; left:20px;  border-width:1px 0 0 1px; }
.tcorner.tr { top:20px; right:20px; border-width:1px 1px 0 0; }
.tcorner.bl { bottom:20px; left:20px;  border-width:0 0 1px 1px; }
.tcorner.br { bottom:20px; right:20px; border-width:0 1px 1px 0; }
/* Pinned hero tagline — inset from the .tcorner brackets, bottom-left of the
   CRT feed. Fades in with the rest of the hero chrome on body.intro-done, a
   beat after the stage itself so it reads as a second, deliberate reveal.
   It sits straight on the sky; the text-shadow keeps it readable over cloud. */
#hero-tagline { position:absolute; z-index:11; left:52px; right:52px; bottom:48px; max-width:760px;
  pointer-events:none; opacity:0; transition:opacity 1.1s cubic-bezier(0.22,1,0.36,1); transition-delay:.4s; }
body.intro-done #hero-tagline { opacity:1; }
#hero-tagline p { margin:0; font-family:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; font-weight:500;
  font-size:clamp(28px,3.4vw,44px); line-height:1.15; letter-spacing:-0.005em;
  color:rgba(var(--c-white),0.92); text-shadow:0 4px 20px rgba(0,0,0,0.65); }
#hero-tagline-cursor { display:inline-block; margin-left:1px; color:rgba(var(--c-white),0.65);
  animation:heroCursorBlink .95s step-start infinite; }
@keyframes heroCursorBlink { 50%{ opacity:0; } }
@media (--bp-820) { #hero-tagline { left:28px; right:28px; bottom:34px; } }
@media (prefers-reduced-motion: reduce) { #hero-tagline-cursor { animation:none; } }

</style>

<style is:global>

/* ===== v9 CRT VIDEO FOOTER (scoped, self-contained) ===== */
#site-footer{
  --fbg:#070710; --fink:#eef0f6; --fdim:#717890; --fline:rgba(220,225,235,0.12);
  --faccent:#8fb8ff; --faccent-gray:#52565f;
  --fserif:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; --fsans:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --fmono:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; --fspec:-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  --map-line:rgba(200,206,216,.32); --map-node:236,240,248;
}
footer#site-footer{
    position:relative; z-index:1; width:100%; min-height:100vh; min-height:100svh; overflow:hidden; background:transparent;
    display:flex; flex-direction:column; align-items:center; justify-content:flex-end; padding:0;
    opacity:1; pointer-events:auto;   /* no panel: the sky shows through; ::before bloom sits on top */
  }
  footer#site-footer.fpin{ pointer-events:auto; opacity:1; }
  /* Footer entrance — mirrors the project-tile reveal (scale + slide + fade), staggered.
     Elements start hidden/shifted; .fenter (added by JS when footer calm crosses in)
     animates them to rest. Same easing language as the tour tiles so it reads continuous. */
  #site-footer .crt, #site-footer .f-eyebrow, #site-footer .f-tagline,
  #site-footer .f-cta, #site-footer .f-copy, #site-footer .f-links{
    opacity:0; transform:translateY(24px) scale(0.965);
    transition:opacity .7s cubic-bezier(.16,1,.3,1), transform .7s cubic-bezier(.16,1,.3,1);
  }
  /* exit stagger (scroll up): reverse order — links leave first, CRT last */
  #site-footer .f-links{transition-delay:0s}
  #site-footer .f-copy{transition-delay:.06s}
  #site-footer .f-cta{transition-delay:.12s}
  #site-footer .f-tagline{transition-delay:.18s}
  #site-footer .f-eyebrow{transition-delay:.24s}
  #site-footer .crt{transition-delay:.30s}
  #site-footer.fenter .crt{opacity:1; transform:translateY(0) scale(1); transition-delay:0s}
  #site-footer.fenter .f-eyebrow{opacity:1; transform:translateY(0) scale(1); transition-delay:.12s}
  #site-footer.fenter .f-tagline{opacity:1; transform:translateY(0) scale(1); transition-delay:.20s}
  #site-footer.fenter .f-cta{opacity:1; transform:translateY(0) scale(1); transition-delay:.30s}
  #site-footer.fenter .f-copy{opacity:1; transform:translateY(0) scale(1); transition-delay:.44s}
  #site-footer.fenter .f-links{opacity:1; transform:translateY(0) scale(1); transition-delay:.46s}
  @media (prefers-reduced-motion: reduce){
    #site-footer .crt, #site-footer .f-eyebrow, #site-footer .f-tagline,
    #site-footer .f-cta, #site-footer .f-copy, #site-footer .f-links{opacity:1; transform:none; transition:none}
  }

  /* soft halo behind the CRT — seats it in the space scene with a glow, the way the globe
     has its own bloom, rather than a hard-edged panel pasted over the background */
  footer#site-footer::before{
    content:''; position:absolute; z-index:0; width:min(1900px,104vw); height:110vh;
    left:50%; bottom:-18vh; transform:translateX(-50%);
    background:radial-gradient(ellipse at 50% 70%, rgba(20,26,48,0.55) 0%, rgba(8,8,20,0.25) 45%, transparent 72%);
    filter:blur(30px); pointer-events:none;
  }
  /* the CRT — a full terminal window, same grammar as the hero frame: 34px
     titlebar (icons / mono title / status), screen below with the video as a
     faint feed, corner brackets inside. 10px radius + the hero's triple glow
     shadow so it reads as the same physical object returning at page end. */
  /* Sized to match #signal's "Security news" + "On rotation" cards combined —
     same width formula as .sig-inner (max 1500px minus its clamp(24-80px)
     side padding, twice) and the same measured rendered height of that grid. */
  .f-card{
    position:relative; z-index:1; width:min(1340px, calc(100vw - clamp(48px,10vw,160px))); min-height:560px; margin:158px auto 0;
    display:flex; align-items:center; justify-content:space-between; gap:56px;
    padding:96px 64px; border-radius:20px; overflow:visible;
    background:linear-gradient(155deg, rgba(15,17,27,0.94) 0%, rgba(7,7,14,0.90) 55%, rgba(3,3,8,0.94) 100%);
    border:1px solid rgba(var(--c-white),0.07);
    box-shadow:0 60px 130px -35px rgba(0,0,0,0.7), inset 0 1px 0 rgba(var(--c-white),0.04);
  }
  /* dot-grid + bottom bloom — same device as the reference hero mock, tinted
     into the site's own blue (the exact tone already used in #term-window's
     box-shadow) rather than the reference's amber. Dot-grid favors the left
     column where the copy lives; the bloom rises from the bottom edge. */
  .f-card::before{
    content:''; position:absolute; inset:0; z-index:0; opacity:.4; pointer-events:none; border-radius:inherit;
    background-image:radial-gradient(rgba(var(--c-ice),0.6) 1px, transparent 1.5px);
    background-size:22px 22px;
    -webkit-mask-image:radial-gradient(ellipse 70% 65% at 28% 50%, #000 0%, transparent 75%);
            mask-image:radial-gradient(ellipse 70% 65% at 28% 50%, #000 0%, transparent 75%);
  }
  .f-card::after{
    content:''; position:absolute; inset:0; z-index:0; pointer-events:none; border-radius:inherit;
    background:radial-gradient(ellipse 60% 50% at 38% 112%, rgba(96,132,196,0.42), transparent 68%);
  }
  /* faint grain + a fine diagonal grid sheen so the card reads as a textured
     surface rather than a flat gradient fill; sits behind the text/crt layers. */
  .f-card-tex{ position:absolute; inset:0; z-index:0; border-radius:inherit; overflow:hidden; pointer-events:none; }
  .f-card-tex::before{
    content:''; position:absolute; inset:-20%; opacity:.05; mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
  }
  .f-card-tex::after{
    content:''; position:absolute; inset:0; opacity:.55;
    background:
      linear-gradient(122deg, rgba(var(--c-white),0.06) 0%, transparent 32%),
      linear-gradient(rgba(var(--c-white),.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(var(--c-white),.035) 1px, transparent 1px);
    background-size:auto, 42px 42px, 42px 42px;
    -webkit-mask-image:radial-gradient(120% 100% at 26% 18%, #000 42%, transparent 100%);
    mask-image:radial-gradient(120% 100% at 26% 18%, #000 42%, transparent 100%);
  }
  .f-left{
    position:relative; z-index:2; display:flex; flex-direction:column; justify-content:center;
    gap:18px; flex:1 1 300px; max-width:540px;
  }
  /* the terminal/recon-map panel is now the card's visual hook — same object as
     before, just reframed to pop out of the card's top-right edge like a photo,
     floating along the same top-right diagonal the reference image sits on. A
     slight rotation gives it an intentionally "placed" artistic tilt rather than
     sitting flush/aligned with the card. Fixed aspect ratio (not vh) so it stays
     a wide landscape rectangle instead of squashing into a taller/squarer crop. */
  .crt{
    position:relative; z-index:3; align-self:flex-start;
    width:min(320px,26%); aspect-ratio:240/427; height:auto; flex:0 0 auto;
    border-radius:12px; overflow:hidden; background:#000;
    margin:-190px -30px 0 0;
    box-shadow:0 60px 130px -18px rgba(0,0,0,0.82),
               0 0 0 1px rgba(var(--c-white),0.06),
               0 0 140px 24px rgba(90,120,185,0.10);
    display:flex; flex-direction:column;
    transform:translateZ(0) rotate(-1.6deg); will-change:transform; contain:layout paint;
  }
  .crt-inner{
    position:relative; flex:1; min-height:0; width:100%;
    display:flex; flex-direction:column;
  }
  @media (--bp-980){
    /* The CRT (live ascii.cam video render) is the heaviest thing in the
       footer — dropped entirely on phone/tablet rather than shrunk, same
       call as the globe. index-ascii-footer.js skips booting it under
       LOW_POWER so the video/canvas loop never runs either.
       footer#site-footer itself is min-height:100vh so the CRT panel (the
       thing that actually fills that height on desktop) has room — with
       the CRT gone here, that same 100vh became mostly empty black space
       above a small text card pinned to the bottom (justify-content:
       flex-end), which on a real phone reads as an endless black screen
       while scrolling through it. Let the footer size to its actual
       content instead of forcing a full viewport of empty space. */
    footer#site-footer{ min-height:0; }
    .f-card{ flex-direction:column; align-items:stretch; min-height:0; padding:36px 26px 30px; gap:28px; margin-top:56px; }
    .f-left{ max-width:none; }
    .crt{ display:none; }
    /* .f-links wraps below .f-copy at this width and was landing directly
       under Luna's fixed 120px corner widget (she docks to bottom:16px on
       mobile) — real, confirmed overlap, not just visually close. Extra
       bottom padding pushes the whole row up clear of her footprint. */
    .f-bottom{ padding-bottom:170px; }
  }
  /* ascii.cam widget — ported from the About page's skills card, same spot
     the CRT recon map used to occupy. Renders a baked-in default clip (or a
     dropped/picked video or photo) as a live luminance-ramp ASCII render. */
  .ascii-card{ position:relative; flex:1; min-height:0; display:flex; flex-direction:column; }
  .ascii-stage{ flex:1; min-height:0; position:relative; display:flex; align-items:center; justify-content:center;
    overflow:hidden; background:#050506; }
  .ascii-out{ margin:0; white-space:pre; font-family:'JetBrains Mono','DejaVu Sans Mono',monospace;
    color:rgba(var(--c-white),0.84); font-size:2px; line-height:2px; letter-spacing:0; }
  /* subtle screen-curve via inset shadow + a faint vignette so edges fall into the bezel */
  .crt-curve{
    position:absolute; inset:0; z-index:2; pointer-events:none;
    background:radial-gradient(140% 42% at 50% -8%, rgba(var(--c-white),0.05), transparent 60%),
               radial-gradient(ellipse at center, transparent 48%, rgba(0,0,0,0.48) 100%);
    box-shadow:inset 0 0 90px 16px rgba(0,0,0,0.5), inset 0 0 220px 40px rgba(0,0,0,0.26);
  }
  /* scanlines — thin horizontal dark lines, classic CRT phosphor rows */
  .crt-scan{
    position:absolute; inset:0; z-index:2; pointer-events:none; opacity:.6;
    background:repeating-linear-gradient(0deg, rgba(0,0,0,0) 0px, rgba(0,0,0,0) 2px, rgba(0,0,0,0.28) 3px, rgba(0,0,0,0) 4px);
  }
  /* faint flicker — very subtle brightness pulse, the CRT "alive" cue */
  .crt-flicker{position:absolute; inset:0; z-index:2; pointer-events:none; background:rgba(var(--c-white),0.015); animation:flicker 5s steps(60) infinite}
  @keyframes flicker{0%,100%{opacity:.3}50%{opacity:.7}92%{opacity:.4}94%{opacity:.9}96%{opacity:.5}}
  @media (prefers-reduced-motion: reduce){ .crt-flicker{animation:none} }
  /* grain, kept from the styled version */
  .f-grain{position:absolute; inset:-20%; z-index:2; pointer-events:none; opacity:.06; mix-blend-mode:overlay;
    background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23n)'/></svg>");
    animation:grainShift 2.4s steps(3) infinite; will-change:transform; transform:translateZ(0)}
  @keyframes grainShift{0%{transform:translate(0,0)}25%{transform:translate(-1%,1%)}50%{transform:translate(1%,-1%)}75%{transform:translate(-1%,-1%)}100%{transform:translate(0,0)}}

  .f-eyebrow{
    font-family:var(--fsans); font-weight:600; font-size:11px; letter-spacing:.18em; text-transform:uppercase;
    color:#a6abba; margin:0 0 8px; display:flex; align-items:center; gap:6px;
  }
  .f-eyebrow::before{
    content:''; width:5px; height:5px; border-radius:50%; background:rgba(120,225,170,0.95);
    box-shadow:0 0 6px 1px rgba(120,225,170,0.55), 0 0 14px 3px rgba(120,225,170,0.35);
    animation:dotGlow 2.6s ease-in-out infinite;
  }
  @keyframes dotGlow{
    0%,100%{box-shadow:0 0 6px 1px rgba(120,225,170,0.55), 0 0 14px 3px rgba(120,225,170,0.35)}
    50%{box-shadow:0 0 10px 3px rgba(120,225,170,0.7), 0 0 22px 7px rgba(120,225,170,0.5)}
  }
  @media (prefers-reduced-motion: reduce){ .f-eyebrow::before{animation:none} }
  .f-tagline{font-family:var(--fsans); font-style:normal; font-weight:400; color:var(--fink);
    font-size:clamp(27px,2.6vw,34px); line-height:1.34; letter-spacing:-0.01em; white-space:nowrap; margin:0; text-shadow:0 4px 24px rgba(0,0,0,.55)}
  @media (--bp-820){ .f-tagline{ white-space:normal; } }
  /* rotating word — four words cross-fade in an 8s loop, one every 2s. All
     words share one grid cell (instead of being absolutely positioned) so the
     box sizes to natural line height and sits on the same baseline as the
     rest of the sentence — no manual height/vertical-align guessing needed. */
  .rotator{ position:relative; display:inline-grid; min-width:185px; overflow:hidden; vertical-align:baseline; }
  .rotating-word{ grid-row:1; grid-column:1; white-space:nowrap; opacity:0; transform:translateY(55%);
    animation:wordRotate 8s ease-in-out infinite; }
  .rotating-word:nth-child(2){ animation-delay:2s; }
  .rotating-word:nth-child(3){ animation-delay:4s; }
  .rotating-word:nth-child(4){ animation-delay:6s; }
  @keyframes wordRotate{
    0%,3%{ opacity:0; transform:translateY(55%); }
    8%,17%{ opacity:1; transform:translateY(0); }
    22%,100%{ opacity:0; transform:translateY(-55%); }
  }
  @media (prefers-reduced-motion: reduce){
    .rotator{ overflow:visible; }
    .rotating-word{ animation:none; opacity:0; }
    .rotating-word:first-child{ opacity:1; }
  }
  .f-cta{
    font-family:var(--fsans); font-weight:500; font-size:14px; letter-spacing:0; text-transform:none;
    color:rgba(238,241,247,0.94); text-decoration:none; background:rgba(var(--c-white),0.06); border-radius:6px;
