/* ── Luna's speech: a small quip card above her head — used to sit to her
   left, but that ate horizontal space and clashed with nearby content, so
   it now docks directly over #luna-wrap instead (same right:18px anchor,
   positioned by "bottom" so it always clears her regardless of viewport). ── */
#luna-quip{
  position:fixed; right:18px; top:auto; bottom:calc(34vh - 70px);
  z-index:999; max-width:min(180px,60vw); text-align:right; pointer-events:none;
  font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif;
  font-size:12.5px; line-height:1.45; letter-spacing:0.01em;
  color:rgba(226,232,240,0.92);
  background:rgba(10,11,16,0.82); border:1px solid rgba(205,214,226,0.14);
  border-radius:12px; padding:9px 13px;
  box-shadow:0 10px 30px rgba(0,0,0,0.45); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);
  opacity:0; transform:translateY(6px) scale(0.98);
  transition:opacity .5s cubic-bezier(0.22,1,0.36,1), transform .5s cubic-bezier(0.22,1,0.36,1);
}
#luna-quip.show{ opacity:1; transform:translateY(0) scale(1); }
#luna-quip .lq-cursor{ color:rgba(202,210,226,0.6); }
#luna-quip.lq-clickable{ pointer-events:auto; cursor:pointer; transition:opacity .5s cubic-bezier(0.22,1,0.36,1), transform .5s cubic-bezier(0.22,1,0.36,1), border-color .2s ease, background .2s ease; }
#luna-quip.lq-clickable:hover{ border-color:rgba(205,214,226,0.30); background:rgba(14,16,22,0.92); }
#luna-quip .lq-hint{ display:block; margin-top:5px; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:rgba(202,210,226,0.5); }
@media (prefers-reduced-motion:reduce){ #luna-quip{ transition:opacity .3s ease; transform:none; } }

/* ── Intro ── */
/* (intro-vignette removed — wordmark sits over the live boot, no dark veil) */

#intro-logo {
  position: fixed; top: 50%; left: 50%;
  transform: translate(-50%, -50%) translateY(10px);
  z-index: 9001; pointer-events: none;
  display: flex; align-items: baseline; gap: 0.55rem;
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1),
              transform 0.6s cubic-bezier(0.22,1,0.36,1);
}
#intro-logo.in { opacity: 1; transform: translate(-50%, -50%) translateY(0px); }
#intro-logo h1 {
  font-family: 'EB Garamond', serif;
  font-size: 2.80rem; font-weight: 400;
  color: rgba(255,255,255,0.92); letter-spacing: 0.01em;
}
#intro-logo .port {
  font-family: 'EB Garamond', serif;
  font-size: 2.80rem; font-weight: 400;
  font-style: italic; color: rgba(255,255,255,0.6);
}

/* ── intro idle glitch: monochrome char-scramble + split (HELLO DRIBBBLE style) ── */
#intro-logo .gtxt { position:relative; }
#intro-logo .gtxt::before, #intro-logo .gtxt::after {
  content:attr(data-text); position:absolute; top:0; left:0; width:100%;
  overflow:hidden; opacity:0; pointer-events:none;
}
#intro-logo .gtxt::before { color:rgba(255,255,255,0.95); }   /* white ghost, shifts left */
#intro-logo .gtxt::after  { color:rgba(150,150,150,0.9); }    /* gray ghost, shifts right */
#intro-logo .port .gtxt::before { color:rgba(255,255,255,0.55); }
#intro-logo .port .gtxt::after  { color:rgba(150,150,150,0.5); }
#intro-logo.glitch-flick .gtxt::before { opacity:.55; transform:translate(-1.5px,0); }
#intro-logo.glitch-flick .gtxt::after  { opacity:.5;  transform:translate(1.5px,0); }
@media (prefers-reduced-motion: reduce){
  #intro-logo.glitch-flick .gtxt::before, #intro-logo.glitch-flick .gtxt::after { opacity:0 !important; transform:none !important; }
}

/* system-sans direction: keep live numeric readouts on tabular figures so
   ticking digits (scroll counter, GMT clock) don't shift width each update */
#menu-clock,
.ptile--spec .v, .ptile--metric .mv,
#cr-detail .cd-v, #cr-detail .cd-mv { font-variant-numeric: tabular-nums; }


/* ── Luna portal arrival ── */
#luna-portal {
  position:fixed;
  right:18px; top:calc(66vh + 80px);  /* concentric with Luna's new box */
  width:120px; height:120px;
  border-radius:50%;
  z-index:998;
  pointer-events:none; opacity:0;
  background:radial-gradient(circle,
    rgba(160,195,255,0.22) 0%,
    rgba(130,170,245,0.10) 38%,
    rgba(120,160,240,0.03) 58%,
    transparent 72%);                  /* soft bloom, no hard ring — she coalesces from light */
  box-shadow:0 0 18px 2px rgba(120,170,255,0.10);
}
#luna-portal.opening {
  animation:lunaPortal 1.3s cubic-bezier(0.22,1,0.36,1) forwards;
}
@keyframes lunaPortal {
  0%   { opacity:0;    transform:scale(1.12); }   /* a faint wide gather */
  38%  { opacity:0.55; transform:scale(1.00); }   /* light draws onto her — she arrives */
  100% { opacity:0;    transform:scale(0.97); }   /* quietly fades */
}

/* ── chrome dampening — soft dark pools that keep the UI legible over the
      brightened canvas; sits above the canvas, below the chrome; fades in
      together with the canvas brightness lift on Luna's arrival ── */
#chrome-damp {
  position:fixed; inset:0; z-index:600;
  pointer-events:none; opacity:0;
  transition:opacity 1.3s ease;
  background:
    radial-gradient(ellipse 780px 110px at 50% 18px,
      rgba(6,7,16,0.62) 0%, rgba(6,7,16,0) 72%),
    radial-gradient(ellipse 260px 260px at calc(100% - 64px) calc(9vh + 50px),
      rgba(6,7,16,0.20) 0%, rgba(6,7,16,0) 70%);
}

/* pullback CSS removed — terminal window replaces the window-wall */


/* ════════════════ Terminal window — floating CRT, Beat 1 expands to fullscreen ════════════════ */
#term-stage {
  position:relative; z-index:1;
  width:100%; min-height:100vh;
  display:flex; align-items:center; justify-content:center;
  pointer-events:none;
  opacity:0;
  transition:opacity 1.1s cubic-bezier(0.22,1,0.36,1);
}
body.intro-done #term-stage { opacity:1; }
#term-window {
  position:relative; pointer-events:auto;
  width:68vw; height:70vh;
  transform:translateY(0);             /* centered; beat 1 keeps y at 0 while expanding */
  border-radius:10px;
  display:flex; flex-direction:column; overflow:hidden;
  border:none;
  box-shadow:
    0 0 60px 10px rgba(255,255,255,0.04),
    0 0 170px 36px rgba(90,120,185,0.12),
    0 40px 90px rgba(0,0,0,0.80);
  will-change:transform;
}
#term-window::before {
  content:''; position:absolute; inset:0; z-index:200; pointer-events:none; border-radius:inherit;
  background:repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.05) 3px, rgba(0,0,0,0.05) 4px);
}
#term-window::after {
  content:''; position:absolute; inset:0; z-index:199; pointer-events:none; border-radius:inherit;
  background:radial-gradient(ellipse at center, transparent 52%, rgba(0,0,0,0.34) 100%);
}
#term-titlebar {
  position:relative; z-index:201; width:100%; height:34px; flex-shrink:0;
  background:rgba(16,16,16,0.98); border-bottom:1px solid rgba(255,255,255,0.07);
  display:flex; align-items:center; justify-content:space-between; padding:0 16px; user-select:none;
}
#term-icons { display:flex; align-items:center; gap:11px; }
#term-icons .ticon { font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:0.82rem; color:rgba(255,255,255,0.24); line-height:1; }
#term-title {
  position:absolute; left:50%; transform:translateX(-50%);
  font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:0.65rem; color:rgba(255,255,255,0.22); text-transform:uppercase;
  letter-spacing:0.10em; white-space:nowrap; pointer-events:none;
}
#term-status { font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:0.52rem; color:rgba(255,255,255,0.12); letter-spacing:0.14em; text-transform:uppercase; }
#term-screen { position:relative; flex:1; background:#030307; overflow:hidden; }
.tcorner { position:absolute; z-index:10; width:20px; height:20px; border-color:rgba(255,255,255,0.10); border-style:solid; }
.tcorner.tl { top:20px; left:20px;  border-width:1px 0 0 1px; }
.tcorner.tr { top:20px; right:20px; border-width:1px 1px 0 0; }
.tcorner.bl { bottom:20px; left:20px;  border-width:0 0 1px 1px; }
.tcorner.br { bottom:20px; right:20px; border-width:0 1px 1px 0; }
#term-feed { position:absolute; top:50%; left:50%; transform:translate(-50%,-50%); text-align:center; pointer-events:none; }
#term-feed-label { font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:300; font-size:1.2rem; letter-spacing:0.32em; color:rgba(180,205,245,0.5); text-transform:uppercase; }
#term-feed-sub { font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-style:italic; font-size:1.0rem; color:rgba(255,255,255,0.28); margin-top:10px; }

/* ════ Globe arc overlays ════ */
/* GUEST of T2, so window-relative. Edited in place rather than overridden
   earlier in the sheet, because this rule is the one that wins. */
#globe-labels { position:absolute; inset:0; z-index:2; pointer-events:none; }
.glbl { position:absolute; transform:translateY(-50%); padding-left:16px; font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif;
  font-size:11px; letter-spacing:0.22em; color:rgba(214,226,250,0.95); white-space:nowrap;
  pointer-events:auto; cursor:pointer; opacity:0; transition:opacity .25s ease;
  text-shadow:0 0 12px rgba(20,30,60,0.9); }
/* the dot IS the node marker: anchor its CENTRE exactly on the projected node
   point (the JS sets the element's left/top to that point), text offset to the
   right. Was translate(-50%,-50%) which centred the TEXT on the node and left
   the dot ~half-the-text-width to the left — hence the "labels off the globe". */
.glbl::before { content:''; position:absolute; left:0; top:50%; width:6px; height:6px;
  margin-left:-3px; margin-top:-3px; border-radius:50%; background:rgba(150,185,255,0.9); box-shadow:0 0 10px rgba(150,200,255,0.9); }
.glbl:hover { color:#fff; }
/* signal tier — the knowledge-field / neighbor labels: whisper-size telemetry text.
   Non-interactive atmosphere; opacity driven per-frame (facing + phase). */
.gsig { position:absolute; transform:translateY(-50%); padding-left:11px;
  font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:8.5px; letter-spacing:0.16em;
  color:rgba(190,208,240,0.85); white-space:nowrap; pointer-events:none; opacity:0; z-index:640; }
.gsig::before { content:''; position:absolute; left:0; top:50%; width:3px; height:3px;
  transform:translateY(-50%); border-radius:50%; background:rgba(170,195,240,0.8); }
.gsig.sig-n { color:rgba(210,224,250,0.95); font-size:9px; }   /* neighbor tier: a step brighter */

/* ════════════════ Project tour — blueprint window clusters ════════════════
   Each project shows an asymmetric stack of windows (one large blueprint image +
   offset title / spec / metric tiles) that stagger in as the globe lands. A focus
   scrim darkens the background during each hold so the windows read clearly. Swap
   real photos via the <img> src; the blueprint duotone stays in CSS. */
#tour-scrim { position:fixed; inset:0; z-index:2; pointer-events:none; opacity:0;
  background:radial-gradient(150% 120% at 50% 46%, rgba(3,4,10,0.90) 0%, rgba(1,2,6,0.985) 68%); }
#project-cards { position:absolute; inset:var(--gt-bar) 0 0 0; z-index:3; pointer-events:none; display:none; }
.pcluster { position:absolute; top:50%; right:4%; width:min(440px,34%); height:540px; transform:translateY(-50%); }
.ptile { position:absolute; opacity:0; pointer-events:none; }
/* will-change is applied per-tile in JS only while the tile's cluster is
   focused, then cleared — permanent promotion on all 21 tiles wastes GPU memory. */
.ptile.live { pointer-events:auto; }
/* v9's composition, restored inside T2. The element count was never the real
   problem: the terminal RESIZING under them was. Now that it is born at final
   size and only translates, the original layout holds. */
.ptile--title { top:0; right:8px; text-align:right; }
.ptile--title .pk { font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:10px; letter-spacing:0.34em;
  text-transform:uppercase; color:rgba(226,232,244,0.74); margin-bottom:5px; }
.ptile--title .pt { font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:600; font-size:3.6rem; line-height:0.9;
  color:#eef3ff; letter-spacing:-0.005em; text-shadow:0 0 24px rgba(210,220,240,0.14); }
.ptile--img { top:72px; left:0; width:min(300px,96%); }
.pblue { position:relative; width:100%; aspect-ratio:4/3; overflow:hidden;
  border:1px solid rgba(226,232,244,0.30); background:#0a0a0b; }
/* fine blueprint grid + soft core glow — shown only when no real image is loaded,
   so the empty state reads as a schematic viewport rather than a blank void */
.pblue--empty { background-image:
    repeating-linear-gradient(0deg, rgba(226,232,244,0.06) 0 1px, transparent 1px 13px),
    repeating-linear-gradient(90deg, rgba(226,232,244,0.06) 0 1px, transparent 1px 13px),
    repeating-linear-gradient(0deg, rgba(226,232,244,0.12) 0 1px, transparent 1px 52px),
    repeating-linear-gradient(90deg, rgba(226,232,244,0.12) 0 1px, transparent 1px 52px),
    radial-gradient(130% 110% at 50% 50%, rgba(120,134,160,0.16), transparent 68%); }
.pblue img { width:100%; height:100%; object-fit:cover; display:block; mix-blend-mode:screen; opacity:0.92;
  filter:grayscale(1) contrast(0.92) brightness(0.82) blur(0.4px); }
/* light-background source images (white-paper diagrams) invert first so the sheet
   drops into the dark tile and the line-art glows, matching the dark screenshots */
.pblue--invert img { filter:invert(1) grayscale(1) contrast(0.96) brightness(0.85) blur(0.4px); }
/* ── scene integration: dissolve the loaded screenshots into the starfield.
   feather every edge so the rectangle melts into the dark, drop the hard frame,
   and lay film grain over the content so tile and scene share one surface. */
.pblue:not(.pblue--empty){ background:transparent; border-color:transparent; }
.pblue:not(.pblue--empty) img{
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent),linear-gradient(0deg,transparent,#000 13%,#000 87%,transparent); -webkit-mask-composite:source-in;
  mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent),linear-gradient(0deg,transparent,#000 13%,#000 87%,transparent); mask-composite:intersect; }
.pblue:not(.pblue--empty)::before{ display:none; }
.pblue:not(.pblue--empty)::after{ background:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='400' height='300' preserveAspectRatio='none'><g stroke='rgb(216,216,220)' stroke-width='1' opacity='0.32'><path d='M27 30h14M34 23v14'/><path d='M359 30h14M366 23v14'/><path d='M27 270h14M34 263v14'/><path d='M359 270h14M366 263v14'/></g><g stroke='white' stroke-width='0.7' fill='none'><line x1='88' y1='20' x2='86' y2='280' opacity='0.15'/><line x1='210' y1='42' x2='212' y2='300' opacity='0.1'/><line x1='322' y1='0' x2='321' y2='214' opacity='0.16'/></g><g fill='white'><circle cx='120' cy='70' r='1.1' opacity='0.28'/><circle cx='262' cy='108' r='0.8' opacity='0.22'/><circle cx='182' cy='200' r='1.3' opacity='0.26'/><circle cx='340' cy='240' r='0.9' opacity='0.2'/><circle cx='60' cy='152' r='0.7' opacity='0.22'/><circle cx='300' cy='58' r='1.0' opacity='0.24'/><circle cx='150' cy='122' r='0.6' opacity='0.18'/><circle cx='232' cy='252' r='0.8' opacity='0.22'/></g></svg>") 0 0/100% 100% no-repeat, url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='160' height='160'><filter id='tg'><feTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='2' stitchTiles='stitch'/></filter><rect width='100%25' height='100%25' filter='url(%23tg)' opacity='0.6'/></svg>") 0 0/160px 160px, repeating-linear-gradient(0deg, rgba(0,0,0,0.16) 0 1px, transparent 1px 4px), radial-gradient(120% 120% at 50% 45%, transparent 44%, rgba(0,0,0,0.66) 100%); mix-blend-mode:overlay; opacity:.66;
  box-shadow:none;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent),linear-gradient(0deg,transparent,#000 13%,#000 87%,transparent); -webkit-mask-composite:source-in;
  mask-image:linear-gradient(90deg,transparent,#000 12%,#000 88%,transparent),linear-gradient(0deg,transparent,#000 13%,#000 87%,transparent); mask-composite:intersect; }
/* depth: push the two flanking frames back so the hero reads first (opacity only,
   so PRISM's invert filter is preserved) */
.ptile--limg .pblue:not(.pblue--empty) img{ opacity:.58; }
.ptile--img  .pblue:not(.pblue--empty) img{ opacity:.78; }

/* engineering corner brackets — always frame the viewport (over image too) */
.pblue::before { content:''; position:absolute; inset:0; pointer-events:none; z-index:3;
  background:
    linear-gradient(rgba(226,232,244,0.34) 0 0) 0 0/15px 1px no-repeat,
    linear-gradient(rgba(226,232,244,0.34) 0 0) 0 0/1px 15px no-repeat,
    linear-gradient(rgba(226,232,244,0.34) 0 0) 100% 0/15px 1px no-repeat,
