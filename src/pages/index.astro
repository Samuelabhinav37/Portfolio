<script is:inline>
/* Signal loaders — all defensive (public CORS proxy), each with a fallback so the
   section never shows empty. News merges several security sources (newest first);
   CTFs come live from CTFtime (soonest two); podcast art + names from the iTunes API. */
(function(){
  /* Free public CORS proxies have no uptime guarantee and go down/rate-limit
     independently of each other, so a single one is a single point of
     failure. Try a short list in order, a few seconds each; first one that
     returns something wins. If they all fail, callers fall back gracefully
     rather than hang forever. */
  var PROXIES=[
    function(u){ return 'https://api.allorigins.win/raw?url='+encodeURIComponent(u); },
    function(u){ return 'https://corsproxy.io/?url='+encodeURIComponent(u); }
  ];
  function fetchViaProxy(url, attempt){
    attempt=attempt||0;
    if(attempt>=PROXIES.length) return Promise.reject(new Error('all proxies failed'));
    var ctrl=('AbortController' in window)?new AbortController():null;
    var to=ctrl?setTimeout(function(){ ctrl.abort(); },4500):null;
    return fetch(PROXIES[attempt](url), ctrl?{signal:ctrl.signal}:{}).then(function(r){
      if(to) clearTimeout(to);
      if(!r.ok) throw new Error('bad status');
      return r.text();
    }).catch(function(){
      if(to) clearTimeout(to);
      return fetchViaProxy(url, attempt+1);
    });
  }

  (function(){ // security news: merge feeds, newest first
    var host=document.getElementById('news-list'); if(!host) return;
    var FEEDS=[{n:'The Hacker News',u:'https://feeds.feedburner.com/TheHackersNews',site:'https://thehackernews.com'},
               {n:'BleepingComputer',u:'https://www.bleepingcomputer.com/feed/',site:'https://www.bleepingcomputer.com'},
               {n:'Krebs on Security',u:'https://krebsonsecurity.com/feed/',site:'https://krebsonsecurity.com'}];
    function row(title,meta,link,img){
      var a=document.createElement('a'); a.className='news-row'; a.href=link||'#'; a.target='_blank'; a.rel='noopener';
      var b=document.createElement('span'); b.className='news-badge'; if(img){ b.style.backgroundImage='url("'+img+'")'; b.classList.add('has-img'); }
      var body=document.createElement('span'); body.className='news-body';
      var t=document.createElement('span'); t.className='news-title'; t.textContent=title;
      var m=document.createElement('span'); m.className='news-meta'; m.textContent=meta;
      body.appendChild(t); body.appendChild(m); a.appendChild(b); a.appendChild(body); return a;
    }
    function fallback(){ host.innerHTML=''; FEEDS.forEach(function(f){ host.appendChild(row(f.n, f.site.replace(/^https?:\/\//,''), f.site, '')); }); }
    function parse(xml,src){ var out=[]; try{
      var doc=new DOMParser().parseFromString(xml,'text/xml');
      [].slice.call(doc.querySelectorAll('item')).slice(0,5).forEach(function(it){
        var g=function(sel){ var e=it.querySelector(sel); return e?e.textContent:''; };
        var desc=g('description')||g('encoded')||''; var img='';
        var mm=desc.match(/<img[^>]+src=["']([^"']+)["']/i); if(mm) img=mm[1];
        if(!img){ var en=it.querySelector('enclosure'); if(en&&en.getAttribute('url')&&/\.(jpg|jpeg|png|webp)/i.test(en.getAttribute('url'))) img=en.getAttribute('url'); }
        out.push({title:g('title'),link:g('link'),date:new Date(g('pubDate')||g('date')||0),source:src,img:img});
      });
    }catch(e){} return out; }
    var all=[], pending=FEEDS.length, done=false, to=setTimeout(finish,7000);
    function finish(){ if(done) return; done=true; clearTimeout(to);
      if(!all.length){ fallback(); return; }
      all.sort(function(a,b){ return b.date-a.date; });
      host.innerHTML='';
      all.slice(0,5).forEach(function(it){ var d=it.date, ds=(d&&!isNaN(d.getTime())&&d.getTime()>0)?' \u00b7 '+d.toLocaleDateString(undefined,{month:'short',day:'numeric'}):'';
        host.appendChild(row(it.title, it.source+ds, it.link, it.img)); });
    }
    FEEDS.forEach(function(f){ fetchViaProxy(f.u)
      .then(function(xml){ all=all.concat(parse(xml,f.n)); }).catch(function(){})
      .then(function(){ if(--pending<=0) finish(); }); });
  })();

  (function(){ // CTFs: soonest two upcoming from CTFtime
    var host=document.getElementById('ctf-items'); if(!host) return;
    var done=false;
    /* The free CORS proxy -> CTFtime chain times out often enough that this
       needs an honest fallback, same as the news loader below \u2014 otherwise the
       two placeholder items sit there saying "loading..." forever, which
       reads as broken rather than just offline right now. */
    function fallback(){
      if(done) return; done=true;
      host.innerHTML='';
      var it=document.createElement('div'); it.className='ctf-item';
      var a=document.createElement('a'); a.href='https://ctftime.org/event/list/upcoming'; a.target='_blank'; a.rel='noopener'; a.style.textDecoration='none';
      var nm=document.createElement('span'); nm.className='ctf-name'; nm.textContent='CTFtime';
      var mt=document.createElement('span'); mt.className='ctf-meta'; mt.textContent='live schedule \u2192';
      a.appendChild(nm); a.appendChild(mt); it.appendChild(a); host.appendChild(it);
    }
    var to=setTimeout(fallback, 10000);
    var now=Math.floor(Date.now()/1000), fin=now+150*86400;
    var API='https://ctftime.org/api/v1/events/?limit=40&start='+now+'&finish='+fin;
    fetchViaProxy(API).then(function(txt){
      var data=JSON.parse(txt); if(!Array.isArray(data)||!data.length) return fallback();
      var ev=data.filter(function(e){ return new Date(e.start).getTime()>Date.now(); })
                 .sort(function(a,b){ return new Date(a.start)-new Date(b.start); }).slice(0,5);
      if(!ev.length) return fallback();
      if(done) return; done=true; clearTimeout(to);
      host.innerHTML='';
      ev.forEach(function(e){ var d=new Date(e.start);
        var it=document.createElement('div'); it.className='ctf-item';
        var a=document.createElement('a'); a.href=e.ctftime_url||e.url||'#'; a.target='_blank'; a.rel='noopener'; a.style.textDecoration='none';
        var nm=document.createElement('span'); nm.className='ctf-name'; nm.textContent=e.title;
        var mt=document.createElement('span'); mt.className='ctf-meta'; mt.textContent=(e.format||'CTF')+' \u00b7 '+d.toLocaleDateString(undefined,{month:'short',day:'numeric'});
        a.appendChild(nm); it.appendChild(a); it.appendChild(mt); host.appendChild(it);
      });
    }).catch(fallback);
  })();

  (function(){ // podcast art + canonical names via the iTunes API (CORS-friendly)
    [].slice.call(document.querySelectorAll('#signal .pod-row')).forEach(function(rw){
      var link=rw.querySelector('.pod-name a'), art=rw.querySelector('.pod-art'); if(!link) return;
      fetch('https://itunes.apple.com/search?media=podcast&limit=1&term='+encodeURIComponent(link.textContent))
        .then(function(r){ return r.json(); }).then(function(d){
          var it=d&&d.results&&d.results[0]; if(!it) return;
          if(it.artworkUrl100&&art){ art.textContent=''; art.style.backgroundImage='url("'+it.artworkUrl100.replace('100x100bb','300x300bb')+'")'; art.style.backgroundSize='cover'; art.style.backgroundPosition='center'; }
          if(it.collectionViewUrl) link.href=it.collectionViewUrl;
        }).catch(function(){});
    });
  })();
})();
</script>
<script is:inline>
/* "See more" dialog for the Signal section — when the on-page list (capped
   at 5) isn't enough, this points people at the real, primary sources
   instead of trying to cram more into an already-tight card. */
(function(){
  var dlg=document.getElementById('signal-dialog'); if(!dlg) return;
  var panel=dlg.querySelector('.sig-dialog__panel');
  var titleEl=document.getElementById('sig-dialog-title');
  var eyebrowEl=document.getElementById('sig-dialog-eyebrow');
  var listEl=document.getElementById('sig-dialog-list');
  var lastFocused=null;

  function favicon(host){ return 'https://www.google.com/s2/favicons?sz=64&domain='+host; }

  var DATA={
