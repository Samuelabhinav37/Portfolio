}
var fleet1,fleet2;
/* Central no-park zone: roughly the globe's on-screen footprint in canvas
   space. Ship and fleet targets avoid it so nothing parks where the globe
   forms and then gets shoved outward when the globe inflates on scroll.
   Computed from live CW so it stays correct across resizes. */
function _awayFromCentre(x,y){ var dx=x-CW/2, dy=y-CH/2, r=CW*0.17; return dx*dx+dy*dy > r*r; }
function pickFleetTarget(fl){var all=nodes.filter(function(n){return n.tier==='hub'&&!n.dead;});if(!all.length)return;var h=all.filter(function(n){return _awayFromCentre(n.x,n.y);});if(!h.length)h=all;var t=h[Math.random()*h.length|0];fl._target=t;fl.tx=t.x;fl.ty=t.y;fl.state='moving';}
