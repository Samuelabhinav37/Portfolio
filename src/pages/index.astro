<style is:global>
* { margin:0; padding:0; box-sizing:border-box; }

html, body {
  width:100%;
  background:var(--c-bg);
  overflow-x:clip;   /* clip (not hidden) so it doesn't create a scroll container that breaks position:sticky */
}
html { height:auto; }
body { min-height:100%; }

/* Screen-reader-only: visually hidden but available to assistive tech.
   The focusable variant becomes visible when tabbed to (the skip link). */
.sr-only{
  position:absolute !important; width:1px; height:1px;
  padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0);
  white-space:nowrap; border:0;
}
.sr-only-focusable:focus,
.sr-only-focusable:focus-visible{
  position:fixed !important; top:10px; left:10px;
  width:auto; height:auto; margin:0; padding:8px 14px; clip:auto;
  z-index:100000; background:var(--c-bg); color:#d6e0f4;
  border:1px solid rgba(214,224,244,.4); border-radius:6px;
  font:13px/1 'Hanken Grotesk', system-ui, -apple-system, sans-serif; letter-spacing:.04em;
}

/* ── T2 geometry: written by JS each frame, never authored by hand ───── */
:root{
  --gt-x:0px; --gt-y:0px; --gt-w:100vw; --gt-h:100vh; --gt-r:0px;
  --gt-chrome:0; --gt-o:1; --gt-bar:34px;
  --gl-x:0px; --gl-y:0px; --gl-s:100vh;
  --rail-o:0;
}
#globe-term{
  position:relative; z-index:1;
  width:100%; height:100vh;
  overflow:hidden;                 /* keeps the globe + chrome inside the section */
  pointer-events:none; opacity:1;
  background:rgba(4,4,10,0.9);     /* same calm panel as #editorial for a continuous field */
}
/* box-shadow copied verbatim from T3's .crt so the two frames read as the same
   object. Background stays translucent rather than T3's #000: the nebula and
   ships have to remain visible behind this one. */
#globe-term::before{
  content:''; position:absolute; inset:0; z-index:6; pointer-events:none;
  border-radius:inherit; opacity:var(--gt-chrome);
  background:rgba(3,4,10,0.16);
  box-shadow:0 0 60px 10px rgba(var(--c-white),0.04),
             0 0 170px 36px rgba(90,120,185,0.12);
}
#globe-term .gt-chrome{ position:absolute; inset:0; z-index:5;
  pointer-events:none; opacity:var(--gt-chrome); border-radius:inherit; overflow:hidden; }
#globe-gl{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%);
  width:min(86vh,86vw); height:min(86vh,86vw); display:block; z-index:1;
  pointer-events:none; opacity:0; transition:opacity .8s ease; }
body.globe-active #globe-gl{ opacity:1; }
#globe-term .gt-bar{
  position:absolute; top:0; left:0; right:0; height:34px; z-index:7;   /* 34px = T3's .fterm-bar */
  display:flex; align-items:center; gap:9px; padding:0 13px;
  background:rgba(16,16,16,0.98); border-bottom:1px solid rgba(188,217,255,0.13);
  font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:500; font-size:9.5px;
  letter-spacing:0.16em; text-transform:uppercase; color:rgba(238,241,247,0.42); }
#globe-term .gt-led{ width:5px; height:5px; border-radius:50%; background:#bcd9ff; opacity:.55; }
#globe-term .gt-sweep{ position:absolute; left:0; right:0; height:38%; z-index:8; opacity:0; top:-40%;
  pointer-events:none;
  background:linear-gradient(to bottom, transparent, rgba(188,217,255,0.16) 46%, rgba(var(--c-white),0.30) 52%, transparent); }
#globe-term.sweep .gt-sweep{ animation:gtSweep .52s cubic-bezier(.5,0,.4,1); }
@keyframes gtSweep{ 0%{opacity:1; top:-40%} 100%{opacity:1; top:110%} }
#globe-term.capture .crt-scan{ animation:gtGlitch .42s steps(8); }
@keyframes gtGlitch{ 0%,100%{opacity:.40} 20%{opacity:.95} 40%{opacity:.10} 60%{opacity:.85} 80%{opacity:.28} }

/* ── host chrome: rail + the metadata evicted from inside T2 ─────────── */
#case-rail{ position:fixed; left:clamp(16px,3vw,48px); top:14vh;
  width:clamp(160px,17vw,240px); z-index:1100; opacity:var(--rail-o);   /* was 471, under the drawer at 1200 */
  transform:translateX(calc((1 - var(--rail-o)) * -12px)); pointer-events:none; }
/* Parent stays none so it never blocks the canvas; the BUTTONS carry their
   own auto, which works through a pointer-events:none ancestor. Visibility
   is what gates them, so an invisible rail cannot be clicked. */
#case-rail button, #case-rail a{ pointer-events:auto; }
#case-rail .cr-head{ display:flex; justify-content:space-between; padding:0 0 10px;
  border-bottom:1px solid rgba(188,217,255,0.30); }
#case-rail .cr-lbl{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:500; font-size:9.5px;
  letter-spacing:0.16em; text-transform:uppercase; color:rgba(238,241,247,0.40); }
#case-rail ul{ list-style:none; margin:0; padding:0; }
#case-rail button{ position:relative; display:grid; grid-template-columns:auto 1fr;
  align-items:baseline; gap:10px; width:100%; background:none; border:0;
  border-bottom:1px solid rgba(188,217,255,0.13); padding:12px 4px 12px 0;
  text-align:left; cursor:pointer; color:rgba(238,241,247,0.40); font:inherit;
  transition:color .3s, background .3s, padding-left .3s; }
#case-rail button:hover{ color:#eef1f7; background:rgba(188,217,255,0.035); padding-left:9px; }
#case-rail .cr-id{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:500; font-size:10px;
  letter-spacing:0.06em; color:rgba(238,241,247,0.22); transition:color .3s; }
#case-rail .cr-nm{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:300; font-size:18px;
  line-height:1.15; color:currentColor; }
#case-rail button[aria-selected="true"]{ color:#eef1f7; padding-left:9px; }
#case-rail button[aria-selected="true"] .cr-id{ color:#bcd9ff; }
#case-rail button[aria-selected="true"] .cr-nm{ font-style:italic; }
#case-rail button[aria-selected="true"]::before{ content:''; position:absolute; left:0; top:50%;
  width:2px; height:19px; margin-top:-9px; background:#bcd9ff; }
/* the case detail: title, metric and spec, all of which used to be inside T2 */
#cr-detail{ display:none; }   /* names only; the case detail lives in T2 */
#cr-detail .cd-kick{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:500; font-size:9px;
  letter-spacing:0.24em; text-transform:uppercase; color:rgba(150,190,255,0.55); }
#cr-detail .cd-title{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:600; font-size:2.5rem;
  line-height:1; margin:5px 0 3px; color:#eef1f7; }
#cr-detail .cd-cap{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-style:italic; font-size:14px;
  line-height:1.35; color:rgba(238,241,247,0.50); margin:0 0 16px; }
#cr-detail .cd-metric{ display:flex; align-items:baseline; gap:8px; padding:0 0 14px;
  border-bottom:1px solid rgba(188,217,255,0.13); }
#cr-detail .cd-mv{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:1.5rem; color:#bcd9ff; }
#cr-detail .cd-ml{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:8.5px; letter-spacing:0.18em;
  text-transform:uppercase; color:rgba(238,241,247,0.38); }
#cr-detail ul.cd-spec{ list-style:none; margin:0; padding:0; }
#cr-detail .cd-spec li{ padding:9px 0; border-bottom:1px solid rgba(188,217,255,0.09); }
#cr-detail .cd-k{ display:block; font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:8px;
  letter-spacing:0.24em; text-transform:uppercase; color:rgba(238,241,247,0.32); margin-bottom:3px; }
#cr-detail .cd-v{ font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-size:11.5px; line-height:1.45;
  color:rgba(238,241,247,0.82); }
#cr-detail .cd-more{ display:inline-flex; gap:7px; margin-top:16px; text-decoration:none;
  font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif; font-weight:500; font-size:9.5px; letter-spacing:0.16em;
  text-transform:uppercase; color:rgba(238,241,247,0.55);
  border-bottom:1px solid rgba(188,217,255,0.22); padding-bottom:3px; transition:.25s; }
#cr-detail .cd-more:hover{ color:#bcd9ff; border-color:rgba(188,217,255,0.55); }
@media (max-width:980px){
  #case-rail{ left:4vw; right:4vw; width:auto; top:9vh; }
  #case-rail ul{ display:flex; gap:6px; }
  #case-rail li{ flex:1; }
  #case-rail button{ grid-template-columns:1fr; gap:2px; padding:8px; }
  #case-rail button[aria-selected="true"]::before{ top:auto; bottom:-1px; left:0; right:0;
    width:auto; height:2px; margin:0; }
  #cr-detail{ display:none; }
}

/* ── Luna's speech: a small quip card above her head — used to sit to her
   left, but that ate horizontal space and clashed with nearby content, so
   it now docks directly over #luna-wrap instead (same right:18px anchor,
   positioned by "bottom" so it always clears her regardless of viewport). ── */
#luna-quip{
  position:fixed; right:18px; top:auto; bottom:calc(34vh - 70px);
  z-index:999; max-width:min(180px,60vw); text-align:right; pointer-events:none;
  font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif;
  font-size:12.5px; line-height:1.45; letter-spacing:0.01em;
  color:rgba(226,232,240,0.92);
  background:rgba(10,11,16,0.82); border:1px solid rgba(205,214,226,0.14);
  border-radius:12px; padding:9px 13px;
  box-shadow:0 10px 30px rgba(0,0,0,0.45); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);
  opacity:0; transform:translateY(6px) scale(0.98);
  transition:opacity .5s cubic-bezier(0.22,1,0.36,1), transform .5s cubic-bezier(0.22,1,0.36,1);
}
#luna-quip.show{ opacity:1; transform:translateY(0) scale(1); }
#luna-quip .lq-cursor{ color:rgba(202,210,226,0.6); }
#luna-quip.lq-clickable{ pointer-events:auto; cursor:pointer; transition:opacity .5s cubic-bezier(0.22,1,0.36,1), transform .5s cubic-bezier(0.22,1,0.36,1), border-color .2s ease, background .2s ease; }
#luna-quip.lq-clickable:hover{ border-color:rgba(205,214,226,0.30); background:rgba(14,16,22,0.92); }
#luna-quip .lq-hint{ display:block; margin-top:5px; font-size:10px; letter-spacing:0.16em; text-transform:uppercase; color:rgba(202,210,226,0.5); }
@media (prefers-reduced-motion:reduce){ #luna-quip{ transition:opacity .3s ease; transform:none; } }

/* ── Intro ── */
/* (intro-vignette removed — wordmark sits over the live boot, no dark veil) */

#intro-logo {
  position: fixed; top: 50%; left: 50%;
  transform: translate(-50%, -50%) translateY(10px);
  z-index: 9001; pointer-events: none;
  display: flex; align-items: baseline; gap: 0.55rem;
  opacity: 0;
  transition: opacity 0.6s cubic-bezier(0.22,1,0.36,1),
              transform 0.6s cubic-bezier(0.22,1,0.36,1);
}
#intro-logo.in { opacity: 1; transform: translate(-50%, -50%) translateY(0px); }
#intro-logo h1 {
  font-family: 'EB Garamond', serif;
  font-size: 2.80rem; font-weight: 400;
  color: rgba(var(--c-white),0.92); letter-spacing: 0.01em;
}
#intro-logo .port {
  font-family: 'EB Garamond', serif;
  font-size: 2.80rem; font-weight: 400;
  font-style: italic; color: rgba(var(--c-white),0.6);
}

/* ── intro idle glitch: monochrome char-scramble + split (HELLO DRIBBBLE style) ── */
#intro-logo .gtxt { position:relative; }
#intro-logo .gtxt::before, #intro-logo .gtxt::after {
  content:attr(data-text); position:absolute; top:0; left:0; width:100%;
  overflow:hidden; opacity:0; pointer-events:none;
}
#intro-logo .gtxt::before { color:rgba(var(--c-white),0.95); }   /* white ghost, shifts left */
#intro-logo .gtxt::after  { color:rgba(150,150,150,0.9); }    /* gray ghost, shifts right */
#intro-logo .port .gtxt::before { color:rgba(var(--c-white),0.55); }
#intro-logo .port .gtxt::after  { color:rgba(150,150,150,0.5); }
#intro-logo.glitch-flick .gtxt::before { opacity:.55; transform:translate(-1.5px,0); }
#intro-logo.glitch-flick .gtxt::after  { opacity:.5;  transform:translate(1.5px,0); }
@media (prefers-reduced-motion: reduce){
  #intro-logo.glitch-flick .gtxt::before, #intro-logo.glitch-flick .gtxt::after { opacity:0 !important; transform:none !important; }
}

/* system-sans direction: keep live numeric readouts on tabular figures so
   ticking digits (scroll counter, GMT clock) don't shift width each update */
#menu-clock,
.ptile--spec .v, .ptile--metric .mv,
#cr-detail .cd-v, #cr-detail .cd-mv { font-variant-numeric: tabular-nums; }


/* ── Luna portal arrival ── */
#luna-portal {
  position:fixed;
  right:18px; top:calc(66vh + 80px);  /* concentric with Luna's new box */
  width:120px; height:120px;
  border-radius:50%;
  z-index:998;
  pointer-events:none; opacity:0;
  background:radial-gradient(circle,
    rgba(160,195,255,0.22) 0%,
    rgba(130,170,245,0.10) 38%,
    rgba(120,160,240,0.03) 58%,
    transparent 72%);                  /* soft bloom, no hard ring — she coalesces from light */
  box-shadow:0 0 18px 2px rgba(120,170,255,0.10);
}
#luna-portal.opening {
  animation:lunaPortal 1.3s cubic-bezier(0.22,1,0.36,1) forwards;
}
@keyframes lunaPortal {
  0%   { opacity:0;    transform:scale(1.12); }   /* a faint wide gather */
  38%  { opacity:0.55; transform:scale(1.00); }   /* light draws onto her — she arrives */
  100% { opacity:0;    transform:scale(0.97); }   /* quietly fades */
}

/* ── chrome dampening — soft dark pools that keep the UI legible over the
      brightened canvas; sits above the canvas, below the chrome; fades in
      together with the canvas brightness lift on Luna's arrival ── */
#chrome-damp {
  position:fixed; inset:0; z-index:600;
  pointer-events:none; opacity:0;
  transition:opacity 1.3s ease;
  background:
    radial-gradient(ellipse 780px 110px at 50% 18px,
      rgba(6,7,16,0.62) 0%, rgba(6,7,16,0) 72%),
    radial-gradient(ellipse 260px 260px at calc(100% - 64px) calc(9vh + 50px),
      rgba(6,7,16,0.20) 0%, rgba(6,7,16,0) 70%);
}

/* pullback CSS removed — terminal window replaces the window-wall */


/* ════════════════ Terminal window — floating CRT, Beat 1 expands to fullscreen ════════════════ */
#term-stage {
  position:relative; z-index:1;
  width:100%; min-height:100vh;
  display:flex; align-items:center; justify-content:center;
  pointer-events:none;
  opacity:0;
  transition:opacity 1.1s cubic-bezier(0.22,1,0.36,1);
}
body.intro-done #term-stage { opacity:1; }
#term-window {
  position:relative; pointer-events:auto;
  width:68vw; height:70vh;
  transform:translateY(0);             /* centered; beat 1 keeps y at 0 while expanding */
  border-radius:10px;
  display:flex; flex-direction:column; overflow:hidden;
  border:none;
  box-shadow:
    0 0 60px 10px rgba(var(--c-white),0.04),
    0 0 170px 36px rgba(90,120,185,0.12),
    0 40px 90px rgba(0,0,0,0.80);
  will-change:transform;
}
#term-window::before {
  content:''; position:absolute; inset:0; z-index:200; pointer-events:none; border-radius:inherit;
  background:repeating-linear-gradient(0deg, transparent, transparent 3px, rgba(0,0,0,0.05) 3px, rgba(0,0,0,0.05) 4px);
}
#term-window::after {
  content:''; position:absolute; inset:0; z-index:199; pointer-events:none; border-radius:inherit;
  background:radial-gradient(ellipse at center, transparent 52%, rgba(0,0,0,0.34) 100%);
}
#term-titlebar {
  position:relative; z-index:201; width:100%; height:34px; flex-shrink:0;
  background:rgba(16,16,16,0.98); border-bottom:1px solid rgba(var(--c-white),0.07);
  display:flex; align-items:center; justify-content:space-between; padding:0 16px; user-select:none;
}
#term-icons { display:flex; align-items:center; gap:11px; }
