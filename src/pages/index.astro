<!-- serif restored for the NAME only (corner identity + intro wordmark); rest of the site stays system-sans -->
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&family=EB+Garamond:ital,wght@0,400;1,400&display=swap" rel="stylesheet">
