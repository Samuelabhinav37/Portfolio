  if(wan.tx<CW*0.15)wan.tx=CW*0.15; else if(wan.tx>CW*0.85)wan.tx=CW*0.85;
  if(wan.ty<CH*0.13)wan.ty=CH*0.13; else if(wan.ty>CH*0.87)wan.ty=CH*0.87;
