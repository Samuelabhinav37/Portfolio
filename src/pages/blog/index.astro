<script is:inline>
/* Luna arrival + chrome flags — this page has no intro choreography, so the
   flags Luna's embed gates on are set immediately, and the portal bloom fires
   on a short fixed delay after load. Also boots the ambient nebula network
   (same shared background as index/about/contact) straight to its settled
   lit state, mirroring the homepage intro's returning-visitor fast-path. */
(function(){
  window.SITE._introRevealReady = true;
  window.SITE._introFullyDone   = true;
  window.SITE._bgBoost = 0.95;
  try { if (window.U && U.uBright) U.uBright.value = 0.6; } catch(e){}
  try { startBootSeq(); }
  catch(e){ try { window.NS && window.NS.startBootSeq && window.NS.startBootSeq(); } catch(_){} }
  var portal = document.getElementById('luna-portal');
  if(portal) setTimeout(function(){ portal.classList.add('opening'); }, 1400);
})();
</script>
<script is:inline>
/* ──────────────────────────────────────────────────────────────────
   PAGE VISIBILITY HARD-PAUSE
   The browser already throttles requestAnimationFrame in hidden tabs
   to ~1Hz, but rAF callbacks still fire and accumulate state (U.uTime,
   freighter/asteroid drift, satellite paths). When the user returns
   they see "the network has been busy" — correct creative read but
   wastes battery. We discard the accumulated threeClock delta on
   show so scene time stands still while the tab is in the background.
   ────────────────────────────────────────────────────────────────── */
(function(){
  'use strict';
  if(typeof threeClock === 'undefined') return;
  document.addEventListener('visibilitychange', function(){
    if(!document.hidden && threeClock && typeof threeClock.getDelta === 'function'){
      threeClock.getDelta(); /* drop the accumulated background dt */
    }
  });
})();
</script>

