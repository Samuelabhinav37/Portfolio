---
import { getCollection } from 'astro:content';
import SiteMenu from '../../components/SiteMenu.astro';
import ClarityAnalytics from '../../components/ClarityAnalytics.astro';
import ErrorReporter from '../../components/ErrorReporter.astro';
import PortfolioLunaShell from '../../components/PortfolioLunaShell.astro';
import NebulaBackground from '../../components/NebulaBackground.astro';
import LunaDrawerShell from '../../components/LunaDrawerShell.astro';
import { FAKE_PROJECTS } from '../../data/projects.ts';
import '../../styles/tokens.css';

// Translations (e.g. es/anatomy-of-a-supply-chain-attack) live under a
// locale subfolder and get their own index-free route — the grid here
// stays English-only; a translated post is reached via the language
// switcher on its English original, not by appearing twice in this list.
const posts = (await getCollection('blog', ({ id, data }) => !data.draft && !id.includes('/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const year = new Date().getFullYear();
const postCards = posts.map((p) => ({
  id: p.id,
  name: p.data.title,
  cats: p.data.cats,
  kick: p.data.category + ' · ' + p.data.pubDate.getFullYear(),
  year: p.data.pubDate.getFullYear(),
  seed: p.id,
  // Horizontal rows want a wide image, so heroImage (already ~1.9:1) is the
  // primary source now — cardImage is kept only as a fallback for any post
  // that happens to have one set without a heroImage, not something new
  // posts need to supply.
  img: p.data.heroImage || p.data.cardImage || null,
  lead: p.data.description,
  href: '/blog/' + p.id + '/',
}));
// Featured hero card — an illustrative case study if any exist (FAKE_PROJECTS
// is currently empty on purpose, see src/data/projects.ts), else the latest
// real post. Matches what the client-side rotator in the script below would
// pick as its first frame, so there's no server/client mismatch on load.
const heroItem = FAKE_PROJECTS[0] ?? postCards[0] ?? null;
// FakeProject has no `href` field (it opens the case-study slide-over
// instead) — narrow explicitly rather than accessing heroItem.href, which
// TS rejects on the FakeProject branch of the union.
const heroHref = heroItem && 'href' in heroItem ? heroItem.href : null;
// Anthropic-style static hero: one big featured item plus a short text list
// of the next few recent posts beside it — skip postCards[0] only when it's
// actually the one occupying the featured slot (FAKE_PROJECTS is currently
// empty on purpose, so today heroItem always comes from postCards[0]).
const sideItems = (FAKE_PROJECTS.length ? postCards : postCards.slice(1)).slice(0, 5);
// The grid/table below needs to exclude whatever's already shown up here —
// otherwise the same 3-4 posts appear twice on first load, back to back.
const featuredSeeds = [heroItem, ...sideItems].filter(Boolean).map((p) => p.seed);
---

