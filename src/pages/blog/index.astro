---
import { getCollection } from 'astro:content';
import SiteMenu from '../../components/SiteMenu.astro';
import PortfolioLunaShell from '../../components/PortfolioLunaShell.astro';
import LunaDrawerShell from '../../components/LunaDrawerShell.astro';
import '../../styles/tokens.css';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const year = new Date().getFullYear();
const postCards = posts.map((p) => ({
  id: p.id,
  name: p.data.title,
  cats: p.data.cats,
  kick: p.data.category + ' · ' + p.data.pubDate.getFullYear(),
  year: p.data.pubDate.getFullYear(),
  seed: p.id,
  img: p.data.cardImage || p.data.heroImage || null,
  lead: p.data.description,
  href: '/blog/' + p.id + '/',
}));
---

