/* case study */
.flyer{position:fixed;z-index:450;object-fit:cover;filter:grayscale(1) brightness(.9);
  will-change:transform;pointer-events:none}
.cs{position:fixed;inset:0;z-index:400;background:var(--bg);overflow-y:auto;
  opacity:0;visibility:hidden;transition:opacity .35s ease}
.cs.open{opacity:1;visibility:visible}
.cs-back{position:fixed;top:22px;left:38px;z-index:460;background:none;border:none;color:#fff;
  font-family:var(--sans);font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase;
  cursor:pointer;mix-blend-mode:difference}
.cs-herowrap{position:relative;width:100%;height:64vh;min-height:380px;overflow:hidden;background:#101012}
.cs-hero{width:100%;height:100%;object-fit:cover;filter:grayscale(1) brightness(.7);opacity:0;position:relative;z-index:2;transition:opacity .5s ease}
.cs-herowrap::before{content:"";position:absolute;inset:0;z-index:1;
  background:linear-gradient(100deg,#161618 28%,#27272b 50%,#161618 72%);background-size:200% 100%;
  animation:shim 1.6s linear infinite;transition:opacity .7s ease;opacity:1}
.cs-herowrap.loaded::before{opacity:0}
@keyframes shim{0%{background-position:200% 0}100%{background-position:-200% 0}}
.cs-herowrap::after{content:"";position:absolute;inset:0;z-index:3;background:linear-gradient(180deg,rgba(27,27,30,.4),rgba(27,27,30,.85))}
.cs-body{max-width:1100px;margin:0 auto;padding:0 38px 120px}
.cs-rev{opacity:0;transform:translateY(20px);transition:opacity .8s var(--e),transform .8s var(--e)}
