---
import Motion from '../../components/Motion.astro';
import Glitches from '../../components/Glitches.astro';
import { getCollection } from 'astro:content';
import SiteMenu from '../../components/SiteMenu.astro';
import ClarityAnalytics from '../../components/ClarityAnalytics.astro';
import ErrorReporter from '../../components/ErrorReporter.astro';
import SkyBackground from '../../components/SkyBackground.astro';
import KaiSite from '../../components/KaiSite.astro';
import '../../styles/tokens.css';
import Fonts from '../../components/Fonts.astro';
import { variant, webpDims } from '../../image-variant';

// Translations (e.g. es/anatomy-of-a-supply-chain-attack) live under a
// locale subfolder and get their own index-free route — the grid here
// stays English-only; a translated post is reached via the language
// switcher on its English original, not by appearing twice in this list.
const posts = (await getCollection('blog', ({ id, data }) => !data.draft && !id.includes('/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const year = new Date().getFullYear();

/* Field Notes: every post as a tile in an edge-to-edge grid. Tile art is the
   wide heroImage (about 1.9:1) cropped to the tile's ratio; the 800w variant
   serves 1x, the original backs it up for 2x. */
const WPM = 230;
/* Tiles share a width but not a height: each takes the next ratio in this
   cycle, so a row's pictures end at slightly different lines. Same cycle in
   blog-fieldnotes.js. */
const RATIOS = ['16/9', '3/2', '13/9', '3/2', '29/20', '16/9', '9/7', '16/9', '3/2'];
function ordinal(n: number) {
  const s = ['th', 'st', 'nd', 'rd'], v = n % 100;
  return n + (s[(v - 20) % 10] || s[v] || s[0]);
}
function dateLabel(d: Date) {
  return d.toLocaleDateString('en-US', { month: 'long', timeZone: 'UTC' }) + ' ' + ordinal(d.getUTCDate()) + ', ' + d.getUTCFullYear();
}
const cards = posts.map((p) => {
  const img = p.data.heroImage || p.data.cardImage || null;
  const small = variant(img, 800);
  const dims = img ? webpDims(img) : null;
  const words = (p.body || '').split(/\s+/).filter(Boolean).length;
  return {
    id: p.id,
    title: p.data.title,
    topic: p.data.category,
    date: p.data.pubDate.toISOString().slice(0, 10),
    dateLabel: dateLabel(p.data.pubDate),
    month: p.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }),
    mins: Math.max(1, Math.round(words / WPM)),
    desc: p.data.description,
    href: '/blog/' + p.id + '/',
    img,
    srcset: img && small && small !== img && dims ? `${small} 800w, ${img} ${dims.width}w` : null,
  };
});
const topics = [...new Set(cards.map((c) => c.topic))];
const TILE_SIZES = '(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw';
---

<!DOCTYPE html>
<html lang="en">
<head>
<script is:inline>
window.SITE=window.SITE||{};
(function(){
  function computeLowPower(){
    window.SITE.LOW_POWER = matchMedia('(max-width:900px)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches;
  }
  computeLowPower();
  var _lpT;
  addEventListener('resize', function(){ clearTimeout(_lpT); _lpT=setTimeout(computeLowPower, 150); }, {passive:true});
})();
</script>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="color-scheme" content="dark">
<title>Field Notes — Samuel Abhinav</title>
<meta name="description" content="Field Notes by Samuel Abhinav: how passwords, hashing, encryption and firewalls came to be, told from first principles, plus threat-intel writeups.">
<link rel="canonical" href="https://samuelabhinav.com/blog/">
<meta property="og:type" content="website">
<meta property="og:title" content="Field Notes — Samuel Abhinav">
<meta property="og:description" content="Field Notes by Samuel Abhinav: how passwords, hashing, encryption and firewalls came to be, told from first principles, plus threat-intel writeups.">
<meta property="og:site_name" content="Samuel · Security Engineer">
<meta property="og:url" content="https://samuelabhinav.com/blog/">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Field Notes — Samuel Abhinav">
<meta name="twitter:description" content="Field Notes by Samuel Abhinav: how passwords, hashing, encryption and firewalls came to be, told from first principles, plus threat-intel writeups.">
<link rel="icon" href="/favicon.ico" sizes="32x32">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<script is:inline src="/scripts/title-manager.js"></script>
<Fonts />
<Motion />
<style is:global>
/* ══════════════ FIELD NOTES ══════════════
   A serif title floating on the sky with search under it, then every post
   as a tile in an edge-to-edge, three-column grid: square-cornered art in
   slightly different heights, two short lines of caption under each, and
   numbered pages at the bottom. Everything under the title is set in one
   small, tight grotesk. */
:root{
  --bg:var(--c-bg);
  --ink:#e9ecf7; --muted:rgba(200,210,232,.66); --faint:rgba(200,210,232,.42);
  /* the search fields float over the sky: an opaque fill, a hairline
     top highlight and a long soft shadow underneath */
  --card-line:rgba(190,205,240,.11);
  --float:0 1px 0 rgba(255,255,255,.04) inset,0 22px 50px -26px rgba(0,0,0,.85),0 6px 16px -8px rgba(0,0,0,.5);
  --accent:#8fb3ff;
  --field:#0b1020;
  --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  --grot:'Inter Tight',var(--sans);
  --dim:rgba(233,236,247,.42);
  --serif:'Cormorant Garamond',Georgia,serif;
  --e:cubic-bezier(.2,.8,.2,1);
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);min-height:100vh;min-height:100svh;
  overflow-x:hidden;-webkit-font-smoothing:antialiased}
a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:4px;border-radius:6px}

/* every content block is positioned so it paints above the fixed #sky
   (a positioned element with z-index:auto) */
.fn{position:relative;z-index:1;padding-bottom:96px;display:flex;flex-direction:column;gap:clamp(56px,7vw,92px)}

/* ── title + search ── */
.fn-hero{display:flex;flex-direction:column;align-items:center;gap:34px;width:100%;max-width:1240px;margin:0 auto;
  padding:clamp(120px,15vw,170px) max(20px, env(safe-area-inset-right, 0px)) 4px max(20px, env(safe-area-inset-left, 0px))}
.fn-title{font-family:var(--serif);font-weight:400;font-size:clamp(64px,11vw,132px);line-height:.95;letter-spacing:-.01em;
  color:#eef2fb;text-align:center;text-wrap:balance;
  text-shadow:0 0 24px rgba(143,179,255,.28),0 0 70px rgba(110,150,240,.22);
  animation:fnDrift 9s ease-in-out infinite}
.fn-title em{font-style:italic;color:#cdd9f7}
@keyframes fnDrift{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.fn-search{width:min(900px,100%);display:grid;grid-template-columns:minmax(0,1fr) 210px;gap:14px}
.fn-field{display:flex;align-items:center;gap:10px;height:52px;padding:0 16px;background:var(--field);
  border:1px solid var(--card-line);border-radius:8px;box-shadow:var(--float);
  transition:border-color .2s,box-shadow .2s}
.fn-field:focus-within{border-color:var(--accent);box-shadow:0 0 0 4px rgba(143,179,255,.16)}
.fn-field svg{width:17px;height:17px;flex:none;stroke:var(--muted);fill:none;stroke-width:2}
.fn-field input,.fn-field select{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);
  font:500 14px var(--grot);letter-spacing:-.02em}
.fn-field input:focus-visible,.fn-field select:focus-visible{outline:0}
.fn-field input::placeholder{color:var(--faint)}
.fn-field input::-webkit-search-cancel-button{filter:invert(.8)}
.fn-field select{appearance:none;-webkit-appearance:none;cursor:pointer}
.fn-field select option{background:#0c1330;color:var(--ink)}
@media (max-width:640px){.fn-search{grid-template-columns:1fr}.fn-field input,.fn-field select{font-size:16px}}

/* ── the grid ──
   One type style for every line under the title: 12px, tight tracking, the
   second line at lower contrast. Tiles run edge to edge with hairline gaps. */
.fn-list,.fn-pg,footer{font:600 12px/1.2 var(--grot);letter-spacing:-.02em}
.fn-list{display:flex;flex-direction:column;gap:14px}
.fn-head{display:flex;align-items:baseline;gap:14px;padding:0 12px}
.fn-head h2{font:inherit;color:var(--ink)}
.fn-count{color:var(--dim)}
.fn-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:6px;row-gap:clamp(36px,4vw,60px);align-items:start}
@media (max-width:900px){.fn-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.fn-grid{grid-template-columns:minmax(0,1fr);row-gap:32px}}
.fn-tile{display:block;min-width:0;color:inherit;text-decoration:none}
.fn-tile:focus-visible{outline-offset:2px;border-radius:0}
.fn-pic{position:relative;overflow:hidden;aspect-ratio:var(--r,16/9);background:#060a18}
.fn-pic img{position:absolute;inset:0;width:100%;height:100%;display:block;object-fit:cover;object-position:50% 50%;
  transition:transform 1.2s var(--e),filter .5s}
.fn-tile:hover .fn-pic img{transform:scale(1.025);filter:brightness(1.08)}
.fn-cap{display:flex;flex-direction:column;padding:12px 12px 0}
.fn-cap h3{font:inherit;color:var(--ink)}
.fn-cap span{color:var(--dim)}
/* after a search or page change the new tiles settle in one after another */
.fn-tile.fn-in{animation:fnIn .55s var(--ease-out,cubic-bezier(.16,1,.3,1)) both;animation-delay:calc(var(--i,0)*50ms)}
@keyframes fnIn{from{opacity:0;transform:translateY(12px)}}
.fn-empty{grid-column:1/-1;padding:60px 12px;color:var(--dim)}

/* ── numbered pages ── */
.fn-pg{display:flex;gap:14px;flex-wrap:wrap;padding:0 12px}
.fn-pg[hidden]{display:none}
.fn-pg button{font:inherit;letter-spacing:inherit;color:var(--dim);background:none;border:0;padding:4px 0;cursor:pointer;transition:color .2s}
.fn-pg button:hover:not([disabled]),.fn-pg button[aria-current="page"]{color:var(--ink)}
.fn-pg button[disabled]{opacity:.4;cursor:default}

/* ── footer ── */
footer{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:30px 12px 50px;color:var(--dim)}
footer .f-links{display:flex;align-items:center;gap:14px}
footer .f-links a{color:var(--dim);text-decoration:none;transition:color .25s;display:inline-flex;align-items:center;gap:6px}
footer .f-links a:hover{color:var(--ink)}
footer .f-links .fic{width:12px;height:12px;fill:currentColor;flex:none}

@media (prefers-reduced-motion: reduce){
  .fn-title{animation:none}
  .fn-pic img{transition:none}
  .fn-tile.fn-in{animation:none}
}
</style>
<style is:global>
</style>
<ErrorReporter />
<ClarityAnalytics />
</head>
<body>

<SkyBackground calm />
<!-- This page is dense, text-heavy tables/cards that need to read clearly
     over whatever's moving behind them, so it puts a page-local blur layer ABOVE
     the shared sky (not touching the component, so index/about/contact are
     unaffected) — plain fixed div, no explicit z-index needed: it paints
     above #sky (position:fixed, z-index:auto)
     purely by coming later in the DOM at the same stacking tier, and stays
     below real content since every content section already carries an
     explicit z-index that beats z-index:auto regardless of DOM order.
     backdrop-filter:blur here softens the stars themselves too, same
     "frosted glass" trick the featured hero's own .hero::after already
     uses over its title card — just extended across the whole page instead
     of one small area, since backdrop-filter only blurs what's behind an
     element, never the real content stacked above it. -->
<div id="content-scrim" aria-hidden="true"></div>
<style>
  #content-scrim{position:fixed;inset:0;pointer-events:none;
    backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
  /* backdrop-filter recomputes every frame the animated starfield behind it
     changes — one of the pricier CSS effects, worth skipping on phones and
     reduced-motion, matching the threshold where the sky drops to its
     lighter tier on these devices. */
  @media (--bp-900), (prefers-reduced-motion:reduce){
    #content-scrim{backdrop-filter:none;-webkit-backdrop-filter:none}
  }
</style>

<SiteMenu currentPath="/blog" />

<Glitches />


<main class="fn" id="main">
  <section class="fn-hero" aria-labelledby="fn-title">
    <h1 class="fn-title" id="fn-title" data-reveal="lines">Field <em>Notes</em></h1>
    <div class="fn-search" role="search" data-reveal>
      <label class="fn-field" for="fn-q">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/></svg>
        <input id="fn-q" type="search" placeholder="Search" autocomplete="off" aria-label="Search posts">
      </label>
      <label class="fn-field" for="fn-topic">
        <select id="fn-topic" aria-label="Topic">
          <option value="">Topic</option>
          {topics.map((t) => <option value={t}>{t}</option>)}
        </select>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6"/></svg>
      </label>
    </div>
  </section>

  <section class="fn-list" aria-labelledby="fn-latest">
    <div class="fn-head"><h2 id="fn-latest">Latest</h2><span class="fn-count" id="fn-count">{cards.length} posts</span></div>
    <!-- Rendered in full here, so every post is in the HTML without
         JavaScript; blog-fieldnotes.js then pages it and runs search. -->
    <div class="fn-grid" id="fn-grid" data-reveal-group>
      {cards.map((c, i) => (
        <a class="fn-tile" href={c.href} style={`--r:${RATIOS[i % RATIOS.length]}`}>
          <div class="fn-pic">
            {c.img && <img src={c.img} srcset={c.srcset || undefined} sizes={TILE_SIZES} alt="" loading={i < 3 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} decoding="async" />}
          </div>
          <div class="fn-cap">
            <h3>{c.title}</h3>
            <span>{c.topic}, {c.month}</span>
          </div>
        </a>
      ))}
    </div>
    <nav class="fn-pg" id="fn-pg" aria-label="Pages" hidden></nav>
  </section>
</main>

<footer>
  <span>© {year} Samuel Abhinav</span>
  <div class="f-links">
    <a href="https://www.linkedin.com/in/samuelabhinav/" target="_blank" rel="me noopener"><svg class="fic" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>LinkedIn</a>
    <a href="https://github.com/Samuelabhinav37" target="_blank" rel="me noopener"><svg class="fic" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>GitHub</a>
    <a href="https://x.com/SamuelAbhinav37" target="_blank" rel="me noopener" aria-label="X"><svg class="fic" viewBox="0 0 24 24" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg></a>
    <a href="https://hackerone.com/sam142437?type=user" target="_blank" rel="me noopener">HackerOne</a>
  </div>
</footer>

<script is:inline define:vars={{ cards }}>window.__FIELD_NOTES__ = cards;</script>
<script src="../../scripts/blog-fieldnotes.js"></script>



<script is:inline>
/* Luna arrival + chrome flags — this page has no intro choreography, so the
   flags Luna's embed gates on are set immediately, and the portal bloom fires
   on a short fixed delay after load. */
(function(){
  window.SITE._introRevealReady = true;
  window.SITE._introFullyDone   = true;
  var portal = document.getElementById('luna-portal');
  if(portal) setTimeout(function(){ portal.classList.add('opening'); }, 1400);
})();
</script>

<KaiSite />
<script src="../../scripts/blog-luna-kb.js"></script>


</body>
</html>
