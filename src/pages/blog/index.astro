  <button class="cs-back" id="csBack">← Index</button>
  <div class="cs-herowrap"><img class="cs-hero" id="csHero" alt=""></div>
  <div class="cs-body">
    <div class="cs-kick meta cs-rev" id="csKick"></div>
    <h1 class="cs-name cs-rev" id="csName"></h1>
    <p class="cs-lead cs-rev" id="csLead"></p>
    <div class="cs-metrics cs-rev" id="csMetrics"></div>
