<!-- Cormorant Garamond + JetBrains Mono are only used by Luna's chat drawer,
     which most visitors never open — loaded non-render-blocking (classic
     "print" media-swap trick) instead of holding up first paint for every
     visitor whether or not they ever click her. -->
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,500;0,600;1,300;1,600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<style is:global>
:root{
  --bg:var(--c-bg);--ink:#ededee;--ink-soft:#c9c9cc;--muted:#94949a;--faint:#67676d;
  --line:rgba(var(--c-white),.26);--line-soft:rgba(var(--c-white),.1);
  --sans:'Hanken Grotesk',-apple-system,sans-serif;--e:cubic-bezier(.22,1,.36,1);
}
*{box-sizing:border-box;margin:0;padding:0}
.lenis.lenis-smooth{scroll-behavior:auto!important}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:400;
  min-height:100vh;overflow-x:hidden;-webkit-font-smoothing:antialiased}
.meta{font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase}
a:focus-visible,button:focus-visible,select:focus-visible,.card:focus-visible{
  outline:1px solid #fff;outline-offset:4px}

#luna-portal{position:fixed;right:18px;top:calc(66vh + 80px);width:120px;height:120px;border-radius:50%;
  z-index:998;pointer-events:none;opacity:0;
  background:radial-gradient(circle,rgba(160,195,255,0.22) 0%,rgba(130,170,245,0.10) 38%,rgba(120,160,240,0.03) 58%,transparent 72%);
  box-shadow:0 0 18px 2px rgba(120,170,255,0.10)}
#luna-portal.opening{animation:lunaPortal 1.3s cubic-bezier(0.22,1,0.36,1) forwards}
@keyframes lunaPortal{0%{opacity:0;transform:scale(1.12)}38%{opacity:0.55;transform:scale(1.00)}100%{opacity:0;transform:scale(0.97)}}

.hero{position:relative;height:100vh;min-height:640px;overflow:hidden}
.hero .bg{position:absolute;inset:-8% -2%;will-change:transform}
/* Gemini-glow style ambient hero: a soft blurred rounded-rect light source
   instead of a project screenshot. .halo is a larger, softer wash behind the
   brighter inner blob, same trick as the reference demo. */
.hero-glow{position:absolute;left:50%;top:52%;width:46%;height:42%;transform:translate(-50%,-50%);
  border-radius:40px;filter:blur(90px);z-index:1;
  background:radial-gradient(ellipse 70% 70% at 50% 50%,
    hsla(226,8%,28%,0.5) 0%, hsla(226,8%,20%,0.28) 60%, hsla(226,6%,14%,0.12) 100%)}
.hero-glow.halo{width:69%;height:63%;filter:blur(126px);opacity:0.55}
/* Frosted-glass layer: sits between the glow and the title card, darkening
   and blurring what's behind it for an opaque "glass panel" read rather than
   a flat gradient wash. */
.hero::after{content:"";position:absolute;inset:0;z-index:2;
  background:linear-gradient(180deg,rgba(10,10,13,.09),rgba(10,10,13,.03) 38%,rgba(8,8,10,.18));
  backdrop-filter:blur(3px); -webkit-backdrop-filter:blur(3px);}
.frame{position:absolute;z-index:3;top:50%;left:50%;transform:translate(-50%,-46%);
  width:min(540px,80vw);height:min(420px,56vh);border:1px solid var(--line);padding:26px 28px;
  display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;
  opacity:0;transition:opacity 1s var(--e),border-color .5s,background .5s}
.is-loaded .frame{opacity:1;transition-delay:.75s}
.frame:hover{border-color:#fff;background:rgba(var(--c-white),.03)}
.frame .top{display:flex;justify-content:space-between;align-items:flex-start}
.frame .top .meta{color:#dcdce0}
.frame .ar{font-size:17px;color:#dcdce0;transition:transform .4s var(--e)}
.frame:hover .ar{transform:translate(3px,-3px)}
.frame h1{font-weight:300;font-size:clamp(32px,4.5vw,52px);line-height:1.02;letter-spacing:-1px;color:#fff}
.cue{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);z-index:3;display:flex;
  flex-direction:column;align-items:center;gap:8px;color:#bdbdc2;opacity:.65}
.cue .ln{width:1px;height:34px;background:#bdbdc2;animation:drop 2s var(--e) infinite}
@keyframes drop{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}
  55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

/* ── THREAT WIRE — live ticker (NVD → CIRCL → static pills fallback).
   Awwwards-pattern mechanics: measured track duplication for a seamless
   loop, constant px/s velocity (duration computed from content width),
   pause on hover, edge fade masks, reduced-motion = static scrollable row. */
.wire{position:relative;z-index:1;display:flex;align-items:stretch;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
.wire-label{flex:0 0 auto;display:flex;align-items:center;gap:9px;padding:14px 22px;
  border-right:1px solid var(--line-soft);color:var(--muted);white-space:nowrap;user-select:none}
.wire-label .dot{width:6px;height:6px;border-radius:50%;background:#fff;animation:wpulse 2.2s ease-in-out infinite}
@keyframes wpulse{0%,100%{opacity:.9}50%{opacity:.25}}
.wire-view{flex:1;overflow:hidden;position:relative;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);
          mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.wire-track{display:flex;align-items:center;width:max-content;padding:9px 0;
  animation:wscroll var(--wire-dur,40s) linear infinite;will-change:transform}
.wire-view:hover .wire-track{animation-play-state:paused}
@keyframes wscroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.wire-item{display:inline-flex;align-items:center;gap:10px;margin:0 9px;padding:7px 14px;
  border:1px solid var(--line-soft);border-radius:999px;text-decoration:none;white-space:nowrap;
  color:var(--muted);transition:border-color .3s,color .3s,background .3s}
/* these link out to real external URLs (NVD, etc.) — force the intended
   color regardless of the visitor's browser history, since the default
   a:visited color can otherwise outrank a plain class selector. */
a.wire-item:visited{color:var(--muted)}
a.wire-item:hover{border-color:var(--line);color:var(--ink);background:rgba(var(--c-white),.03)}
.wire-item .sev{font-size:11px;font-weight:600;letter-spacing:2px;color:#fff}
.wire-item .wid{font-size:11px;font-weight:500;letter-spacing:2px;color:var(--ink-soft);text-transform:uppercase}
.wire-item .wtx{font-size:11px;font-weight:400;letter-spacing:.6px;color:var(--faint)}
.wire-item.skel{min-width:220px;height:31px;position:relative;overflow:hidden;border-color:var(--line-soft)}
.wire-item.skel::before{content:"";position:absolute;inset:0;
  background:linear-gradient(100deg,#161618 28%,#27272b 50%,#161618 72%);background-size:200% 100%;
  animation:shim 1.6s linear infinite;opacity:.5}
@media(max-width:760px){.wire-label{padding:12px 14px}}
@media (prefers-reduced-motion:reduce){
  .wire-track{animation:none;width:auto}
  .wire-view{overflow-x:auto;mask-image:none;-webkit-mask-image:none}
}

.intro{position:relative;z-index:1;padding:104px 38px 70px;max-width:1100px}
.intro p{font-weight:200;font-size:clamp(24px,3.4vw,46px);line-height:1.18;letter-spacing:-.5px;color:var(--ink-soft)}
.intro p em{font-style:normal;color:#fff}

section.block{position:relative;z-index:1;padding:40px 38px 96px}
.lbl{color:var(--faint);margin-bottom:20px}
.shead{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;margin-bottom:46px}
.shead h2{font-weight:200;font-size:clamp(44px,8vw,104px);line-height:.86;letter-spacing:-2px;color:#fff}
.shead .meta{color:var(--faint);text-align:right;padding-bottom:10px;line-height:2}

.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:30px 24px}
.card{display:block;text-decoration:none;color:inherit;cursor:pointer;opacity:0;transform:translateY(26px);
  transition:opacity .9s var(--e),transform .9s var(--e)}
.card:visited{color:inherit}
.card.in{opacity:1;transform:none}
.card .ph{position:relative;aspect-ratio:4/5;overflow:hidden;background:#101012}
/* Static stand-in for cards with no real photo (no cardImage/heroImage set) —
   same gradient BlogPost.astro uses for its hero-art placeholder, so a
   missing image reads as an intentional treatment, not a broken load. */
.card .ph.noimg{background:
  radial-gradient(at 50% 32%,rgba(132,132,146,.30) 0%,rgba(70,70,80,.18) 38%,transparent 70%),
  linear-gradient(165deg,rgba(36,36,42,.95) 0%,rgba(10,10,12,.98) 100%)}
.card .ph::before,.cs-herowrap::before{content:"";position:absolute;inset:0;z-index:1;
  background:linear-gradient(100deg,#161618 28%,#27272b 50%,#161618 72%);background-size:200% 100%;
  animation:shim 1.6s linear infinite;transition:opacity .7s ease;opacity:1}
.card .ph.loaded::before,.cs-herowrap.loaded::before{opacity:0}
@keyframes shim{0%{background-position:200% 0}100%{background-position:-200% 0}}
.card .ph img{width:100%;height:100%;object-fit:cover;display:block;position:relative;z-index:2;
  filter:grayscale(1) brightness(.78);opacity:0;
  transform:scale(1.03);transition:filter .7s var(--e),transform .9s var(--e),opacity .6s ease}
.card .ph.loaded img{opacity:1}
.card .ph::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,15,17,.05),rgba(15,15,17,.5))}
.card:hover .ph img{filter:grayscale(0) brightness(.94);transform:scale(1.09)}
.card .num{position:absolute;top:13px;left:15px;z-index:2;color:#fff;opacity:.55;font-size:11px;
  font-weight:500;letter-spacing:2px;transition:opacity .4s}
.card:hover .num{opacity:1}
.card .cmeta{display:flex;justify-content:space-between;color:var(--faint);margin:15px 0 8px}
.card h3{font-weight:400;font-size:clamp(19px,1.6vw,23px);line-height:1.18;letter-spacing:-.2px;
  color:var(--ink);max-width:24ch;position:relative;display:inline-block}
.card h3::after{content:"";position:absolute;left:0;bottom:-3px;width:0;height:1px;background:#fff;transition:width .5s var(--e)}
.card:hover h3{color:#fff}.card:hover h3::after{width:100%}

.filter{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;
  border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);padding:16px 0;margin-bottom:24px}
.tabs{display:flex;flex-wrap:wrap;gap:26px}
.tab{background:none;border:none;display:inline-flex;align-items:center;gap:9px;color:var(--muted);
  font-family:var(--sans);cursor:pointer;transition:color .3s}
.tab .ring{width:11px;height:11px;border-radius:50%;border:1px solid var(--faint);transition:all .3s}
.tab.on{color:#fff}.tab.on .ring{border-color:#fff;background:radial-gradient(circle,#fff 42%,transparent 46%)}
.tab:hover{color:var(--ink)}
.sortwrap{color:var(--faint)}
.sortwrap select{background:none;border:none;color:var(--ink);font-family:var(--sans);font-size:11px;
  font-weight:500;letter-spacing:2px;text-transform:uppercase;cursor:pointer}
.sortwrap select option{background:#222;text-transform:none}
.count{color:var(--faint);margin-bottom:30px}.count b{color:var(--muted);font-weight:500}
.tab-more{color:var(--muted)}.tab-more.on{color:#fff}

/* ── Filter dialog — "See more" panel for the secondary category set,
   same modal pattern as the homepage Signal "See more" dialog. ── */
.flt-dialog{position:fixed;inset:0;z-index:900;display:grid;place-items:center;padding:24px;
  opacity:0;visibility:hidden;transition:opacity .3s ease}
.flt-dialog[aria-hidden="false"]{opacity:1;visibility:visible}
.flt-dialog__backdrop{position:absolute;inset:0;background:rgba(4,4,8,.72);
  -webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px)}
.flt-dialog__panel{position:relative;z-index:1;width:min(560px,92vw);max-height:80vh;overflow-y:auto;
  background:#0a0a0f;border:1px solid var(--line-soft);border-radius:14px;padding:28px 28px 24px;
  transform:translateY(10px);transition:transform .35s var(--e)}
.flt-dialog[aria-hidden="false"] .flt-dialog__panel{transform:none}
.flt-dialog__close{position:absolute;top:14px;right:14px;width:28px;height:28px;display:grid;place-items:center;
  background:rgba(var(--c-white),.06);border:1px solid rgba(var(--c-white),.12);border-radius:50%;
  color:#dfe4f0;font-size:16px;line-height:1;cursor:pointer;transition:background .2s}
.flt-dialog__close:hover{background:rgba(var(--c-white),.12)}
.flt-dialog__title{font-weight:300;font-size:24px;color:#fff;margin-bottom:6px}
.flt-dialog__sub{color:var(--faint);margin-bottom:22px}
.flt-pill-grid{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:26px}
.flt-pill{font-family:var(--sans);font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;
  color:var(--muted);background:none;border:1px solid var(--line-soft);border-radius:999px;
  padding:10px 16px;cursor:pointer;transition:color .2s,border-color .2s,background .2s}
.flt-pill:hover{color:var(--ink);border-color:var(--line)}
.flt-pill.on{color:#0a0a0f;background:#fff;border-color:#fff}
.flt-dialog__apply{display:block;margin-left:auto;background:#fff;color:#0a0a0f;border:none;border-radius:999px;
  padding:11px 24px;font-family:var(--sans);font-size:11px;font-weight:600;letter-spacing:1.5px;
  text-transform:uppercase;cursor:pointer;transition:transform .2s}
.flt-dialog__apply:hover{transform:translateY(-1px)}
@media (prefers-reduced-motion:reduce){.flt-dialog,.flt-dialog__panel{transition:none}}

footer{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:30px 38px 50px;color:var(--faint)}
footer .f-links{display:flex;align-items:center;gap:14px;font-family:var(--sans);font-weight:500;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase}
footer .f-links a{color:var(--faint);text-decoration:none;transition:color .25s;display:inline-flex;align-items:center;gap:6px}
footer .f-links a:hover{color:#fff}
footer .f-links .fic{width:12.5px;height:12.5px;fill:currentColor;opacity:0.9;flex:none}
footer .f-links .fic.line{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}

/* case study */
.flyer{position:fixed;z-index:450;object-fit:cover;filter:grayscale(1) brightness(.9);
  will-change:transform;pointer-events:none}
.cs{position:fixed;inset:0;z-index:400;background:var(--bg);overflow-y:auto;
  opacity:0;visibility:hidden;transition:opacity .35s ease}
.cs.open{opacity:1;visibility:visible}
.cs-back{position:fixed;top:22px;left:38px;z-index:460;background:none;border:none;color:#fff;
  font-family:var(--sans);font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase;
  cursor:pointer;mix-blend-mode:difference}
.cs-herowrap{position:relative;width:100%;height:64vh;min-height:380px;overflow:hidden;background:#101012}
.cs-hero{width:100%;height:100%;object-fit:cover;filter:grayscale(1) brightness(.7);opacity:0;position:relative;z-index:2;transition:opacity .5s ease}
.cs-herowrap::after{content:"";position:absolute;inset:0;z-index:3;background:linear-gradient(180deg,rgba(27,27,30,.4),rgba(27,27,30,.85))}
.cs-body{max-width:1100px;margin:0 auto;padding:0 38px 120px}
.cs-rev{opacity:0;transform:translateY(20px);transition:opacity .8s var(--e),transform .8s var(--e)}
.cs.shown .cs-rev{opacity:1;transform:none}
.cs-kick{color:var(--muted);margin-top:-60px;position:relative;z-index:2}
.cs-name{font-weight:200;font-size:clamp(48px,9vw,120px);line-height:.9;letter-spacing:-3px;
  color:#fff;margin:14px 0 26px;position:relative;z-index:2}
.cs-lead{font-weight:200;font-size:clamp(22px,3vw,38px);line-height:1.25;color:var(--ink-soft);max-width:22ch;margin-bottom:50px}
.cs-metrics{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;
  background:var(--line-soft);border:1px solid var(--line-soft);margin-bottom:60px}
.cs-metrics .m{background:var(--bg);padding:26px 22px}
.cs-metrics .m .v{font-weight:200;font-size:clamp(30px,4vw,52px);color:#fff;letter-spacing:-1px}
.cs-metrics .m .k{color:var(--faint);margin-top:8px}
.cs-grid2{display:grid;grid-template-columns:1.6fr 1fr;gap:60px}
.cs-overview p{font-weight:300;font-size:18px;line-height:1.7;color:var(--ink-soft);margin-bottom:22px}
.cs-side h4{color:var(--faint);font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase;
  margin:0 0 14px;padding-bottom:12px;border-bottom:1px solid var(--line-soft)}
.cs-side .blk{margin-bottom:34px}
.cs-chips{display:flex;flex-wrap:wrap;gap:8px}
.cs-chips span{border:1px solid var(--line-soft);padding:6px 11px;font-size:11px;letter-spacing:1px;
  color:var(--muted);font-weight:500}
.cs-side .lk{display:block;color:var(--ink);text-decoration:none;padding:10px 0;border-bottom:1px solid var(--line-soft);transition:color .3s}
.cs-side .lk:hover{color:#fff}.cs-side .lk .ar{float:right;color:var(--faint)}

@media(max-width:760px){
  .hero{height:90vh}
  .frame{top:auto;bottom:8vh;transform:translate(-50%,0)}
  .intro{padding:72px 20px 50px}section.block{padding:30px 20px 64px}
  .shead{flex-direction:column;align-items:flex-start}.shead .meta{text-align:left}
  .cs-back{left:20px}.cs-body{padding:0 20px 80px}
  .cs-grid2{grid-template-columns:1fr;gap:40px}
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
  .hero .bg{transform:none!important}
}
</style>
<style is:global>
  /* ── Luna's speech: a small quip card that docks directly over #luna-wrap
     (same right:18px anchor, positioned by "bottom" so it always clears her
     regardless of viewport). ── */
  #luna-quip{
    position:fixed; right:18px; top:auto; bottom:calc(34vh - 70px);
    z-index:999; max-width:min(180px,60vw); text-align:right; pointer-events:none;
    font-family:'Hanken Grotesk', system-ui, -apple-system, sans-serif;
    font-size:12.5px; line-height:1.45; letter-spacing:0.01em;
    color:rgba(226,232,240,0.92);
    background:rgba(10,11,16,0.82); border:1px solid rgba(205,214,226,0.14);
    border-radius:12px; padding:9px 13px;
    box-shadow:0 10px 30px rgba(0,0,0,0.45); -webkit-backdrop-filter:blur(6px); backdrop-filter:blur(6px);
    opacity:0; transform:translateY(6px) scale(0.98);
    transition:opacity .5s cubic-bezier(0.22,1,0.36,1), transform .5s cubic-bezier(0.22,1,0.36,1);
  }
  #luna-quip.show{ opacity:1; transform:translateY(0) scale(1); }
  #luna-quip.lq-clickable{ pointer-events:auto; cursor:pointer; transition:opacity .5s cubic-bezier(0.22,1,0.36,1), transform .5s cubic-bezier(0.22,1,0.36,1), border-color .2s ease, background .2s ease; }
  #luna-quip.lq-clickable:hover{ border-color:rgba(205,214,226,0.30); background:rgba(14,16,22,0.92); }
  #luna-quip .lq-hint{ display:block; margin-top:6px; font-size:11px; font-style:italic; font-weight:400; color:rgba(202,210,226,0.55); }
  @media (prefers-reduced-motion:reduce){ #luna-quip{ transition:opacity .3s ease; transform:none; } }
</style>
</head>
<body>

<SiteMenu currentPath="/blog" />

<PortfolioLunaShell />
<div id="luna-portal"></div>
<div id="luna-quip" aria-hidden="true"></div>

<div class="hero">
  <div class="bg" id="herobg"><div class="hero-glow halo"></div><div class="hero-glow"></div></div>
  <article class="frame" id="heroFrame" tabindex="0" role="link" aria-label="Open Sentinel case study">
    <div class="top"><span class="meta">Security Operations · 2025</span><span class="ar">↗</span></div>
    <h1>Sentinel</h1>
  </article>
  <div class="cue"><span class="ln"></span><span class="meta">Scroll</span></div>
</div>

<div class="wire" aria-label="Live security threat wire">
  <div class="wire-label meta"><span class="dot"></span>Threat wire</div>
  <div class="wire-view"><div class="wire-track" id="wireTrack"></div></div>
</div>

<section class="block">
  <div class="shead"><h2>Index</h2><span class="meta">Security field notes. <em>Built, broken, and documented.</em></span></div>
  <div class="filter">
    <div class="tabs" id="tabs">
      <button class="tab on meta" data-cat="all"><span class="ring"></span>All</button>
      <button class="tab meta" data-cat="detect"><span class="ring"></span>Detection</button>
      <button class="tab meta" data-cat="otics"><span class="ring"></span>OT/ICS</button>
      <button class="tab meta" data-cat="auth"><span class="ring"></span>Auth</button>
      <button class="tab meta" data-cat="bb"><span class="ring"></span>Bug Bounty</button>
      <button class="tab tab-more meta" id="moreTab" type="button">See more →</button>
    </div>
    <div class="sortwrap meta">Sort by:
      <select id="sort" aria-label="Sort"><option value="latest">Latest</option><option value="oldest">Oldest</option><option value="az">A — Z</option></select>
    </div>
  </div>
  <div class="count meta" id="count">Showing <b>09</b> of <b>09</b> results</div>
  <div class="grid" id="grid"></div>
</section>

<div id="filterDialog" class="flt-dialog" aria-hidden="true">
  <div class="flt-dialog__backdrop" data-flt-close></div>
  <div class="flt-dialog__panel" role="dialog" aria-modal="true" aria-labelledby="fltTitle">
    <button type="button" class="flt-dialog__close" data-flt-close aria-label="Close">&times;</button>
    <h3 class="flt-dialog__title" id="fltTitle">More categories</h3>
    <p class="flt-dialog__sub meta">Select one or more to narrow the index</p>
    <div class="flt-pill-grid" id="fltPills"></div>
    <button type="button" class="flt-dialog__apply" id="fltApply">Apply →</button>
  </div>
</div>

