@media (--bp-760){
  /* padding-top used to clear the fixed header because .hero2 was the
     first thing on the page — now the wire ticker is (see order:-1 below),
     so that clearance moves there instead and this only needs normal
     breathing room under it. */
  .hero2{gap:36px;padding:24px 20px 40px}
  .hero2-feat,.hero2-side{flex-basis:100%}
  .intro{padding:72px 20px 50px}section.block{padding:8px 20px 64px}

  /* Threat wire above everything, filter/sort right above the archive
     grid it controls, grid last — .hero-wire-wrap only becomes a flex
     container at this width. Desktop DOM order is hero, wire, filter, grid;
     mobile wants wire first instead, so these four explicit order values
     override it rather than reordering the markup itself. section.block was
     moved inside .hero-wire-wrap (from being a separate sibling)
     specifically so it can share this flex/order context — CSS order can't
     reorder across two different parents. */
  .hero-wire-wrap{display:flex;flex-direction:column}
  .wire{order:-1;padding-top:84px}
  .hero2{order:0}
  /* Gap above is deliberately bigger than the gap below: with the two
     roughly equal (~60px vs ~48px) the filter row read as floating
     equidistant between the hero's recent-post list and the archive
     grid — neither one visually claimed it. Widening the gap from the
     hero and tightening section.block's lead-in (below) groups it
     with the grid it actually controls instead. */
  .filter-count-wrap{order:1;padding:40px 20px 0}
  section.block{order:2}
  .cs-back{left:20px}.cs-body{padding:0 20px 80px}
  .cs-grid2{grid-template-columns:1fr;gap:40px}

  /* Wire + filters route their labels through .meta (11px/2px tracking) —
     that tracking is what makes small badges/tabs read as oversized on a
     phone, so both size and letter-spacing come down here. */
  .meta{font-size:9px;letter-spacing:1px}

  /* ── Threat wire: smaller pills, tighter padding on every side, so the
     ticker reads as a thin compact strip instead of a row of desktop-sized
     badges squeezed onto a phone ── */
  .wire-label{padding:8px 10px;gap:6px}
  .wire-label .dot{width:5px;height:5px}
  .wire-track{padding:6px 0}
  .wire-item{padding:4px 8px;margin:0 5px;gap:5px}
  .wire-item .sev,.wire-item .wid,.wire-item .wtx{font-size:9px;letter-spacing:1px}
  .wire-item.skel{min-width:130px;height:22px}

  /* ── Filter/sort row AND the "Showing X of X results" count are both
     hidden on mobile — narrow-screen visitors just get the plain archive
     list, nothing to filter/sort and no count to read. Hiding the whole
     wrap (not just its children) avoids leaving its top padding behind as
     empty space. Underlying JS still runs and updates .count's text (still
     needed for desktop), it's just not shown at this width. ── */
  .filter-count-wrap{display:none}

  /* The fixed corner nav (#site-identity's "Samuel Abhinav" wordmark,
     #menu-trigger's "Menu" button — both rendered by SiteMenu.astro, a
     child component; reachable here because this stylesheet is
     is:global) had no backdrop behind it. On this page specifically,
     scrolled post titles pass directly underneath and the thin serif
     wordmark visibly collided with whatever title happened to be at that
     exact scroll position. Hiding both on mobile "fixed" the overlap but
     also removed the only way to navigate off this page on mobile — give
     them a small blurred backdrop instead so they stay visible/clickable
     without colliding with scrolled content underneath. Scoped to this
     page only (blog index), not the whole site. */
  #site-identity, #menu-trigger { background: rgba(5,5,9,0.55); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); border-radius: 8px; }
  #site-identity { padding: 5px 10px; margin: -5px -10px; }
  #menu-trigger { padding: 6px 10px; margin: -6px -10px; }
}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important}
}
