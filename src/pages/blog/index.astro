<!-- Body/UI text now uses the native -apple-system OS font stack (see --sans
     above) instead of a hosted Hanken Grotesk webfont — one less render-
     blocking request, and it's genuinely faster since there's nothing to
     download at all. Cormorant Garamond is the one exception: it's the
     "Samuel Abhinav" corner identity (#site-identity in SiteMenu.astro),
     visible above the fold on every page, so it loads render-blocking here
     same as the other pages. -->
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@500&display=swap" rel="stylesheet">
<!-- JetBrains Mono is only used by Luna's chat drawer's mono accents, which
     most visitors never open — loaded non-render-blocking (classic "print"
     media-swap trick) instead of holding up first paint for every visitor
     whether or not they ever click her. -->
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
<style is:global>
:root{
  --bg:var(--c-bg);--ink:#ededee;--ink-soft:#c9c9cc;--muted:#94949a;--faint:#87878d;
  --line:rgba(var(--c-white),.26);--line-soft:rgba(var(--c-white),.1);
  --e:cubic-bezier(.22,1,.36,1);
  /* Native OS font stack — same trick Apple's own site uses instead of
     embedding the licensed SF Pro font: -apple-system pulls the real San
     Francisco font on Mac/iPhone/iPad directly from the OS (zero download,
     genuinely free/legal), falling back to each other OS's own native UI
     font. Now the site-wide default for everything on the blog, not just
     titles/descriptions — Hanken Grotesk dropped entirely. */
  --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  --apple-sans:var(--sans);
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:400;
  min-height:100vh;min-height:100svh;overflow-x:hidden;-webkit-font-smoothing:antialiased}
.meta{font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase}
a:focus-visible,button:focus-visible,select:focus-visible,.card:focus-visible{
  outline:1px solid #fff;outline-offset:4px}

#luna-portal{position:fixed;right:18px;top:calc(66vh + 80px);width:120px;height:120px;border-radius:50%;
  z-index:998;pointer-events:none;opacity:0;
  background:radial-gradient(circle,rgba(160,195,255,0.22) 0%,rgba(130,170,245,0.10) 38%,rgba(120,160,240,0.03) 58%,transparent 72%);
  box-shadow:0 0 18px 2px rgba(120,170,255,0.10)}
#luna-portal.opening{animation:lunaPortal 1.3s cubic-bezier(0.22,1,0.36,1) forwards}
@keyframes lunaPortal{0%{opacity:0;transform:scale(1.12)}38%{opacity:0.55;transform:scale(1.00)}100%{opacity:0;transform:scale(0.97)}}
/* Below 900px #luna-wrap docks to the bottom-right corner instead of its
   vh-based spot (see PortfolioLunaShell.astro's .luna-hidden rule) — keep
   the arrival bloom anchored to that same corner. */
@media (--bp-900){ #luna-portal{ top:auto; bottom:16px; right:14px; } }

/* Anthropic-style static hero: one big featured post (image, kicker, title,
   excerpt) beside a short text list of a few more recent ones — replaces
   the old full-viewport rotating flip-card. The page-wide #content-scrim
   (blur + dark overlay, added separately) already handles darkening the
   starfield behind this section, so no dedicated hero glow/frosted-glass
   layer is needed here anymore either. */
/* Flex, not grid — a proportional 1.6fr/1fr grid split stretched the
   featured card's column across most of the page while its actual content
   (a capped-width image + text) stayed narrow, leaving a big dead gap
   before the side list started. Flex with a content-sized basis on each
   side + justify-content:center means both blocks size to what they
   actually need and sit snug next to each other, centered as one group. */
.hero2{position:relative;z-index:1;display:flex;flex-wrap:wrap;justify-content:center;
  gap:56px;padding:96px 38px 64px;max-width:1400px;margin:0 auto}
.hero2-feat{position:relative;display:block;flex:0 1 540px;text-decoration:none;color:inherit;cursor:pointer;
  opacity:0;transform:translateY(24px);transition:opacity 1s var(--e),transform 1s var(--e)}
.is-loaded .hero2-feat{opacity:1;transform:none;transition-delay:.3s}
.hero2-imgwrap{position:relative;aspect-ratio:16/10;overflow:hidden;border-radius:6px;background:#101012;margin-bottom:22px}
.hero2-imgwrap img{width:100%;height:100%;object-fit:cover;display:block;
  filter:grayscale(.35) brightness(.75);transition:filter .5s var(--e),transform .7s var(--e)}
.hero2-feat:hover .hero2-imgwrap img{filter:grayscale(0) brightness(.9);transform:scale(1.03)}
/* Only the image reacted to hover before — the title is already pure
   white (no headroom for a color brighten), so it gets a growing
   underline instead; the category/excerpt get a real color shift so
   nothing below the photo just sits there unchanged. */
.hero2-feat .meta{display:block;color:var(--faint);transition:color .3s}
.hero2-feat:hover .meta{color:var(--ink-soft)}
.hero2-feat h1{margin-top:10px;font-family:var(--apple-sans);font-weight:300;font-size:clamp(26px,2.6vw,36px);line-height:1.12;
  letter-spacing:-1px;color:#fff;position:relative;display:inline-block}
.hero2-feat h1::after{content:"";position:absolute;left:0;bottom:-4px;width:0;height:1px;background:#fff;transition:width .5s var(--e)}
.hero2-feat:hover h1::after{width:100%}
.hero2-feat p{margin-top:14px;font-family:var(--apple-sans);color:var(--faint);font-size:15px;line-height:1.6;transition:color .3s;
  display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}
.hero2-feat:hover p{color:var(--muted)}

.hero2-side{display:flex;flex-direction:column;flex:0 1 360px;padding-top:6px;
  opacity:0;transform:translateY(24px);transition:opacity 1s var(--e),transform 1s var(--e)}
.is-loaded .hero2-side{opacity:1;transform:none;transition-delay:.5s}
.hero2-item{display:block;text-decoration:none;color:inherit;padding:20px 14px;margin:0 -14px;
  border-top:1px solid var(--line-soft);border-radius:5px;transition:background-color .25s}
.hero2-item:hover{background:rgba(var(--c-white),.07)}
.hero2-side .hero2-item:last-child{border-bottom:1px solid var(--line-soft)}
.hero2-item .meta{color:var(--faint);transition:color .3s}
.hero2-item:hover .meta{color:var(--ink-soft)}
.hero2-item h2{margin-top:8px;font-family:var(--apple-sans);font-weight:400;font-size:17px;line-height:1.3;color:var(--ink);transition:color .3s}
.hero2-item:hover h2{color:#fff}

/* ── THREAT WIRE — live ticker (NVD → CIRCL → static pills fallback).
   Awwwards-pattern mechanics: measured track duplication for a seamless
   loop, constant px/s velocity (duration computed from content width),
   pause on hover, edge fade masks, reduced-motion = static scrollable row. */
.wire{position:relative;z-index:1;display:flex;align-items:stretch;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
.wire-label{flex:0 0 auto;display:flex;align-items:center;gap:9px;padding:14px 22px;
  border-right:1px solid var(--line-soft);color:var(--muted);white-space:nowrap;user-select:none}
.wire-label .dot{width:6px;height:6px;border-radius:50%;background:#fff;animation:wpulse 2.2s ease-in-out infinite}
@keyframes wpulse{0%,100%{opacity:.9}50%{opacity:.25}}
.wire-view{flex:1;overflow:hidden;position:relative;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent);
          mask-image:linear-gradient(90deg,transparent,#000 5%,#000 95%,transparent)}
.wire-track{display:flex;align-items:center;width:max-content;padding:9px 0;
  animation:wscroll var(--wire-dur,40s) linear infinite;will-change:transform}
.wire-view:hover .wire-track{animation-play-state:paused}
@keyframes wscroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.wire-item{display:inline-flex;align-items:center;gap:10px;margin:0 9px;padding:7px 14px;
  border:1px solid var(--line-soft);border-radius:999px;text-decoration:none;white-space:nowrap;
  color:var(--muted);transition:border-color .3s,color .3s,background .3s}
/* these link out to real external URLs (NVD, etc.) — force the intended
   color regardless of the visitor's browser history, since the default
   a:visited color can otherwise outrank a plain class selector. */
a.wire-item:visited{color:var(--muted)}
a.wire-item:hover{border-color:var(--line);color:var(--ink);background:rgba(var(--c-white),.03)}
.wire-item .sev{font-size:11px;font-weight:600;letter-spacing:2px;color:#fff}
.wire-item .wid{font-size:11px;font-weight:500;letter-spacing:2px;color:var(--ink-soft);text-transform:uppercase}
.wire-item .wtx{font-size:11px;font-weight:400;letter-spacing:.6px;color:var(--faint)}
.wire-item.skel{min-width:220px;height:31px;position:relative;overflow:hidden;border-color:var(--line-soft)}
.wire-item.skel::before{content:"";position:absolute;inset:0;
  background:linear-gradient(100deg,#161618 28%,#27272b 50%,#161618 72%);background-size:200% 100%;
  animation:shim 1.6s linear infinite;opacity:.5}
@media (--bp-760){.wire-label{padding:12px 14px}}
@media (prefers-reduced-motion:reduce){
  .wire-track{animation:none;width:auto}
  .wire-view{overflow-x:auto;mask-image:none;-webkit-mask-image:none}
}
/* One plain line under the ticker so a non-security reader knows what the
   scrolling entries and the severity number mean. position+z-index for the
   same reason .wire/.hero2/.filter-count-wrap carry them: the #gc nebula
   canvas (position:absolute;z-index:0) paints over any static sibling
   regardless of DOM order, which left this <p> invisible. */
.wire-explain{position:relative;z-index:1;margin:10px 22px 0;max-width:60ch;font-size:12.5px;line-height:1.5;color:var(--muted)}
/* On mobile .hero-wire-wrap is a flex column with explicit order values that
   pull the wire to the top (order:-1). Match it so the explainer stays
   directly under the wire instead of drifting down next to the hero card. */
@media (--bp-760){.wire-explain{order:-1;margin:9px 14px 0;font-size:12px}}

.intro{position:relative;z-index:1;padding:104px 38px 70px;max-width:1100px}
.intro p{font-weight:200;font-size:clamp(24px,3.4vw,46px);line-height:1.18;letter-spacing:-.5px;color:var(--ink-soft)}
.intro p em{font-style:normal;color:#fff}

section.block{position:relative;z-index:1;padding:40px 38px 96px}
.lbl{color:var(--faint);margin-bottom:20px}

.card{text-decoration:none;color:inherit;cursor:pointer;opacity:0;transform:translateY(20px);
  transition:opacity .8s var(--e),transform .8s var(--e)}
.card:visited{color:inherit}
.card.in{opacity:1;transform:none}

/* Mobile default: one consistent list — kicker + title, matching the
   .hero2-item treatment used by the "recent posts" list next to the
   featured hero. Narrow screens don't have room for a photo grid + a
   separate table without either shrinking the images to nothing or
   forcing a lot of scrolling, so mobile stays this one simple shape.
   Desktop overrides this back to real image cards + a table below
   (see the min-width:761px block further down) — restored at the site
   owner's request after the "unify to one shape" pass went too far by
   applying to every viewport, not just the narrow ones that needed it. */
.grid{display:flex;flex-direction:column;max-width:880px;margin:0 auto 64px;padding-bottom:56px;border-bottom:1px solid var(--line-soft)}
.no-results{padding:60px 0;text-align:center;color:var(--faint);font-size:15px;line-height:1.9}
.no-results button{margin-top:6px;background:none;border:none;color:var(--muted);font:inherit;cursor:pointer;
  text-decoration:underline;text-underline-offset:4px;transition:color .3s}
.no-results button:hover{color:#fff}
.grid .hero2-item:last-child{border-bottom:1px solid var(--line-soft)}
.tbl{display:none}

/* ── Desktop only: real image cards for the first 3 archive posts, a plain
   table for the rest. Paired with --bp-760 (max-width:760px) used
   elsewhere on this page — blog-index-client.js's isDesktop() branches at
   the same 761px so the rendered markup always matches which of these two
   rule sets is actually active. ── */
@media (min-width: 761px) {
  /* auto-fit (not auto-fill): with only 3 cards, auto-fill was reserving
     empty phantom column tracks to the right instead of letting the 3 real
     cards stretch to fill the row — the whole page read as "stuck on the
     left" because of it. auto-fit collapses those empty tracks so the 1fr
     cards actually expand to fill the available width. */
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:28px;
    max-width:none;margin:0 0 64px;padding-bottom:56px;border-bottom:1px solid var(--line-soft)}
  .no-results{grid-column:1/-1}
  .grid .card{display:block}
  .grid .card .ph{position:relative;aspect-ratio:16/10;overflow:hidden;background:#101012;border-radius:4px}
  /* Static stand-in for cards with no real photo (no heroImage set) — same
     gradient BlogPost.astro uses for its hero-art placeholder, so a missing
     image reads as an intentional treatment, not a broken load. */
  .grid .card .ph.noimg{background:
    radial-gradient(at 50% 32%,rgba(132,132,146,.30) 0%,rgba(70,70,80,.18) 38%,transparent 70%),
    linear-gradient(165deg,rgba(36,36,42,.95) 0%,rgba(10,10,12,.98) 100%)}
  .grid .card .ph::before{content:"";position:absolute;inset:0;z-index:1;
    background:linear-gradient(100deg,#161618 28%,#27272b 50%,#161618 72%);background-size:200% 100%;
    animation:shim 1.6s linear infinite;transition:opacity .7s ease;opacity:1}
  .grid .card .ph.loaded::before{opacity:0}
  @keyframes shim{0%{background-position:200% 0}100%{background-position:-200% 0}}
  .grid .card .ph img{width:100%;height:100%;object-fit:cover;display:block;position:relative;z-index:2;
    filter:grayscale(1) brightness(.78);opacity:0;
    transform:scale(1.03);transition:filter .7s var(--e),transform .9s var(--e),opacity .6s ease}
  .grid .card .ph.loaded img{opacity:1}
  .grid .card .ph::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,15,17,.05),rgba(15,15,17,.5))}
  .grid .card:hover .ph img{filter:grayscale(0) brightness(.94);transform:scale(1.06)}
  .grid .card .cbody{margin-top:16px}
  .grid .card .cmeta{display:flex;align-items:center;color:var(--faint);margin-bottom:8px;transition:color .3s}
  .grid .card .cmeta span+span::before{content:"·";margin:0 8px}
  .grid .card:hover .cmeta{color:var(--ink-soft)}
  .grid .card h2{font-family:var(--apple-sans);font-weight:600;font-size:clamp(19px,1.6vw,23px);line-height:1.2;letter-spacing:-.2px;color:var(--ink);
    position:relative;display:inline-block;transition:color .3s}
  .grid .card h2::after{content:"";position:absolute;left:0;bottom:-3px;width:0;height:1px;background:#fff;transition:width .5s var(--e)}
  .grid .card:hover h2{color:#fff}
  .grid .card:hover h2::after{width:100%}
  .grid .card .clead{margin-top:8px;font-family:var(--apple-sans);color:var(--faint);font-size:14px;line-height:1.6;transition:color .3s;
    display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
  .grid .card:hover .clead{color:var(--muted)}

  /* A literal date/category/title table, dividers instead of boxes, no
     imagery — capped and centered rather than letting the title column's
     1fr stretch across the whole page. */
  .tbl{display:flex;flex-direction:column;max-width:880px;margin:0 auto}
  .trow{display:grid;grid-template-columns:70px 180px 1fr;gap:20px;align-items:baseline;
    padding:16px 12px;margin:0 -12px;border-radius:5px;
    border-bottom:1px solid var(--line-soft);transition:background-color .25s}
  .trow-head{pointer-events:none}
  .trow-head span{color:var(--faint);font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase}
  a.trow:hover{background:rgba(var(--c-white),.07)}
  .trow-date,.trow-cat{color:var(--faint);font-size:13px;transition:color .25s}
  .trow-title{font-family:var(--apple-sans);font-weight:400;font-size:16px;line-height:1.4;color:var(--ink);transition:color .25s}
  a.trow:hover .trow-date,a.trow:hover .trow-cat{color:var(--ink-soft)}
  a.trow:hover .trow-title{color:#fff}
}

/* Filter/sort used to sit inside section.block, right before .grid, and
   inherited that section's own horizontal padding for free. Moved up to
   sit right under the featured post instead (inside .hero-wire-wrap,
   between .hero2 and .wire) — it needs its own horizontal padding now,
   matching what section.block/.hero2 use so the edges still line up. */
/* position+z-index needed, not optional: .hero2/.wire both set this same
   position:relative;z-index:1 because #gc (the nebula background canvas,
   position:absolute;z-index:0) paints above any *static* sibling
   regardless of DOM order — a positioned element beats a non-positioned
   one in stacking order even at z-index:0 vs "auto". Without this,
   .filter-count-wrap rendered fully invisible behind the canvas. */
.filter-count-wrap{position:relative;z-index:1;padding:28px 38px 0}
.filter{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:16px;
  border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft);padding:16px 0;margin-bottom:24px}
.tabs{display:flex;flex-wrap:wrap;gap:26px}
.tab{background:none;border:none;display:inline-flex;align-items:center;gap:9px;color:var(--muted);
  font-family:var(--sans);cursor:pointer;transition:color .3s}
.tab .ring{width:11px;height:11px;border-radius:50%;border:1px solid var(--faint);transition:all .3s}
.tab.on{color:#fff}.tab.on .ring{border-color:#fff;background:radial-gradient(circle,#fff 42%,transparent 46%)}
.tab:hover{color:var(--ink)}
.sortwrap{color:var(--faint)}
.sortwrap select{background:none;border:none;color:var(--ink);font-family:var(--sans);font-size:11px;
  font-weight:500;letter-spacing:2px;text-transform:uppercase;cursor:pointer}
.sortwrap select option{background:#222;text-transform:none}
.count{color:var(--faint);margin-bottom:30px}.count b{color:var(--muted);font-weight:500}
.tab-more{color:var(--muted)}.tab-more.on{color:#fff}

/* ── Filter dialog — "See more" panel for the secondary category set,
   same modal pattern as the homepage Signal "See more" dialog. ── */
.flt-dialog{position:fixed;inset:0;z-index:900;display:grid;place-items:center;padding:24px;
  opacity:0;visibility:hidden;transition:opacity .3s ease}
.flt-dialog[aria-hidden="false"]{opacity:1;visibility:visible}
.flt-dialog__backdrop{position:absolute;inset:0;background:rgba(4,4,8,.72);
  -webkit-backdrop-filter:blur(2px);backdrop-filter:blur(2px)}
.flt-dialog__panel{position:relative;z-index:1;width:min(560px,92vw);max-height:80vh;overflow-y:auto;
  background:#0a0a0f;border:1px solid var(--line-soft);border-radius:14px;padding:28px 28px 24px;
  transform:translateY(10px);transition:transform .35s var(--e)}
.flt-dialog[aria-hidden="false"] .flt-dialog__panel{transform:none}
.flt-dialog__close{position:absolute;top:14px;right:14px;width:28px;height:28px;display:grid;place-items:center;
  background:rgba(var(--c-white),.06);border:1px solid rgba(var(--c-white),.12);border-radius:50%;
  color:#dfe4f0;font-size:16px;line-height:1;cursor:pointer;transition:background .2s}
.flt-dialog__close::before{content:'';position:absolute;top:50%;left:50%;width:44px;height:44px;transform:translate(-50%,-50%)}
.flt-dialog__close:hover{background:rgba(var(--c-white),.12)}
.flt-dialog__title{font-weight:300;font-size:24px;color:#fff;margin-bottom:6px}
.flt-dialog__sub{color:var(--faint);margin-bottom:22px}
.flt-pill-grid{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:26px}
.flt-pill{font-family:var(--sans);font-size:11px;font-weight:500;letter-spacing:1.2px;text-transform:uppercase;
  color:var(--muted);background:none;border:1px solid var(--line-soft);border-radius:999px;
  padding:10px 16px;cursor:pointer;transition:color .2s,border-color .2s,background .2s}
.flt-pill:hover{color:var(--ink);border-color:var(--line)}
.flt-pill.on{color:#0a0a0f;background:#fff;border-color:#fff}
.flt-dialog__apply{display:block;margin-left:auto;background:#fff;color:#0a0a0f;border:none;border-radius:999px;
  padding:11px 24px;font-family:var(--sans);font-size:11px;font-weight:600;letter-spacing:1.5px;
  text-transform:uppercase;cursor:pointer;transition:transform .2s}
.flt-dialog__apply:hover{transform:translateY(-1px)}
@media (prefers-reduced-motion:reduce){.flt-dialog,.flt-dialog__panel{transition:none}}

footer{position:relative;z-index:1;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:30px 38px 50px;color:var(--faint)}
footer .f-links{display:flex;align-items:center;gap:14px;font-family:var(--sans);font-weight:500;font-size:10.5px;letter-spacing:.14em;text-transform:uppercase}
