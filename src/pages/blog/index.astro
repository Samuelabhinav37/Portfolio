---
import Motion from '../../components/Motion.astro';
import Glitches from '../../components/Glitches.astro';
import { getCollection } from 'astro:content';
import SiteMenu from '../../components/SiteMenu.astro';
import ClarityAnalytics from '../../components/ClarityAnalytics.astro';
import ErrorReporter from '../../components/ErrorReporter.astro';
import SkyBackground from '../../components/SkyBackground.astro';
import SkyLife from '../../components/SkyLife.astro';
import KaiSite from '../../components/KaiSite.astro';
import '../../styles/tokens.css';
import Fonts from '../../components/Fonts.astro';

// Translations (e.g. es/anatomy-of-a-supply-chain-attack) live under a
// locale subfolder and get their own index-free route — the grid here
// stays English-only; a translated post is reached via the language
// switcher on its English original, not by appearing twice in this list.
const posts = (await getCollection('blog', ({ id, data }) => !data.draft && !id.includes('/'))).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const year = new Date().getFullYear();

/* Field Notes: a featured post, then every other post as a tile in an
   edge-to-edge grid. No dates are shown. A post's frame shows its tileImage
   when it has one, and is a black placeholder until then. */
const WPM = 230;
/* Tiles share a width but not a height: each takes the next ratio in this
   cycle, so a row's frames end at slightly different lines. Same cycle in
   blog-fieldnotes.js. */
const RATIOS = ['16/9', '3/2', '13/9', '3/2', '29/20', '16/9', '9/7', '16/9', '3/2'];
/* A post's first tag names its series when other posts lead with it too
   ("Analog Dawn"), the same rule the post pages use; the rest of its tags are
   the concepts it covers. Parts are numbered by publish date, oldest first. */
const LEVELS = ['Basics', 'Intermediate', 'Advanced'];
const seriesOf = (p: (typeof posts)[number]) => {
  const t = p.data.tags[0];
  return t && posts.filter((q) => q.data.tags[0] === t).length > 1 ? t : null;
};
const byDate = [...posts].sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf());
const cards = posts.map((p) => {
  const words = (p.body || '').split(/\s+/).filter(Boolean).length;
  const series = seriesOf(p);
  const run = series ? byDate.filter((q) => q.data.tags[0] === series) : [];
  return {
    id: p.id,
    title: p.data.title,
    topic: p.data.category,
    level: p.data.level || null,
    levelN: p.data.level ? LEVELS.indexOf(p.data.level) + 1 : 0,
    concepts: series ? p.data.tags.slice(1) : p.data.tags,
    series,
    part: series ? run.indexOf(p) + 1 : 0,
    parts: run.length,
    mins: p.data.readTime || Math.max(1, Math.round(words / WPM)),
    desc: p.data.description,
    date: p.data.pubDate.toISOString(),
    img: p.data.tileImage || null,
    href: '/blog/' + p.id + '/',
  };
});
/* the filter menu: levels in their own order, then topics, then concepts */
const levels = LEVELS.filter((l) => cards.some((c) => c.level === l));
const topics = [...new Set(cards.map((c) => c.topic))];
const concepts = [...new Set(cards.flatMap((c) => c.concepts))].sort((a, b) => a.localeCompare(b));
/* the newest post leads as the featured card; the grid holds the rest */
const [featured, ...rest] = cards;
/* small pieces shared by the featured card, the tiles and their hover cards
   (blog-fieldnotes.js builds the same markup when it re-renders) */
const caption = (c: (typeof cards)[number]) => [c.level, c.topic].filter(Boolean).join(' · ');
const partLabel = (c: (typeof cards)[number]) => (c.series ? `${c.series} · Part ${c.part} of ${c.parts}` : '');
const SITE_URL = 'https://samuelabhinav.com';
const OG_IMAGE = SITE_URL + '/images/og-field-notes.png';
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Field Notes',
  url: SITE_URL + '/blog/',
  author: { '@type': 'Person', name: 'Samuel Abhinav', url: SITE_URL + '/' },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    headline: p.data.title,
    description: p.data.description,
    url: SITE_URL + '/blog/' + p.id + '/',
    datePublished: p.data.pubDate.toISOString(),
  })),
});
---

