---
import { getCollection } from 'astro:content';
import SiteMenu from '../../components/SiteMenu.astro';
import PortfolioLunaShell from '../../components/PortfolioLunaShell.astro';
import NebulaBackground from '../../components/NebulaBackground.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
const year = new Date().getFullYear();
/* Real posts don't carry a machine-readable category array in frontmatter
   (just the display `category` string) — map slugs to filter categories here. */
const POST_CATS: Record<string, string[]> = {
  'anatomy-of-a-supply-chain-attack': ['threatintel', 'malware'],
  'detecting-lateral-movement-active-directory': ['threatintel', 'dfir', 'network'],
  'honeypot-lab-aws-threat-intel': ['threatintel', 'cloud'],
};
const postCards = posts.map((p) => ({
  id: p.id,
  name: p.data.title,
  cats: POST_CATS[p.id] || ['threatintel'],
  kick: p.data.category + ' · ' + p.data.pubDate.getFullYear(),
  year: p.data.pubDate.getFullYear(),
  seed: p.id,
  img: p.data.cardImage || p.data.heroImage || null,
  lead: p.data.description,
  href: '/blog/' + p.id + '/',
}));
---

