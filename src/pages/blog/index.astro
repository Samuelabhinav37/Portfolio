<style is:global>
:root{
  --bg:#030307;--ink:#ededee;--ink-soft:#c9c9cc;--muted:#94949a;--faint:#67676d;
  --line:rgba(255,255,255,.26);--line-soft:rgba(255,255,255,.1);
  --sans:'Hanken Grotesk',-apple-system,sans-serif;--e:cubic-bezier(.22,1,.36,1);
}
*{box-sizing:border-box;margin:0;padding:0}
.lenis.lenis-smooth{scroll-behavior:auto!important}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);font-weight:400;
  min-height:100vh;overflow-x:hidden;-webkit-font-smoothing:antialiased}
.meta{font-size:11px;font-weight:500;letter-spacing:2px;text-transform:uppercase}
a:focus-visible,button:focus-visible,select:focus-visible,.card:focus-visible{
  outline:1px solid #fff;outline-offset:4px}

#luna-portal{position:fixed;right:18px;top:calc(66vh + 80px);width:120px;height:120px;border-radius:50%;
  z-index:998;pointer-events:none;opacity:0;
  background:radial-gradient(circle,rgba(160,195,255,0.22) 0%,rgba(130,170,245,0.10) 38%,rgba(120,160,240,0.03) 58%,transparent 72%);
  box-shadow:0 0 18px 2px rgba(120,170,255,0.10)}
#luna-portal.opening{animation:lunaPortal 1.3s cubic-bezier(0.22,1,0.36,1) forwards}
@keyframes lunaPortal{0%{opacity:0;transform:scale(1.12)}38%{opacity:0.55;transform:scale(1.00)}100%{opacity:0;transform:scale(0.97)}}

.hero{position:relative;height:100vh;min-height:640px;overflow:hidden}
.hero .bg{position:absolute;inset:-8% -2%;background-size:cover;background-position:center;
  filter:grayscale(1) contrast(1.05) brightness(.58);will-change:transform;opacity:0;transition:opacity .9s ease}
.hero.imgloaded .bg{opacity:1}
.hero::after{content:"";position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(22,22,24,.5),rgba(22,22,24,.15) 38%,rgba(27,27,30,.85))}
.frame{position:absolute;z-index:3;top:50%;left:50%;transform:translate(-50%,-46%);
  width:min(540px,80vw);height:min(420px,56vh);border:1px solid var(--line);padding:26px 28px;
  display:flex;flex-direction:column;justify-content:space-between;cursor:pointer;
  opacity:0;transition:opacity 1s var(--e),border-color .5s,background .5s}
.is-loaded .frame{opacity:1;transition-delay:.75s}
.frame:hover{border-color:#fff;background:rgba(255,255,255,.03)}
.frame .top{display:flex;justify-content:space-between;align-items:flex-start}
.frame .top .meta{color:#dcdce0}
.frame .ar{font-size:17px;color:#dcdce0;transition:transform .4s var(--e)}
.frame:hover .ar{transform:translate(3px,-3px)}
.frame h1{font-weight:300;font-size:clamp(32px,4.5vw,52px);line-height:1.02;letter-spacing:-1px;color:#fff}
.cue{position:absolute;bottom:24px;left:50%;transform:translateX(-50%);z-index:3;display:flex;
  flex-direction:column;align-items:center;gap:8px;color:#bdbdc2;opacity:.65}
.cue .ln{width:1px;height:34px;background:#bdbdc2;animation:drop 2s var(--e) infinite}
@keyframes drop{0%{transform:scaleY(0);transform-origin:top}45%{transform:scaleY(1);transform-origin:top}
  55%{transform:scaleY(1);transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}

/* ── THREAT WIRE — live ticker (NVD → CIRCL → static pills fallback).
   Awwwards-pattern mechanics: measured track duplication for a seamless
   loop, constant px/s velocity (duration computed from content width),
   pause on hover, edge fade masks, reduced-motion = static scrollable row. */
.wire{position:relative;z-index:1;display:flex;align-items:stretch;border-top:1px solid var(--line-soft);border-bottom:1px solid var(--line-soft)}
.wire-label{flex:0 0 auto;display:flex;align-items:center;gap:9px;padding:14px 22px;
  border-right:1px solid var(--line-soft);color:var(--muted);white-space:nowrap;user-select:none}
.wire-label .dot{width:6px;height:6px;border-radius:50%;background:#fff;animation:wpulse 2.2s ease-in-out infinite}
@keyframes wpulse{0%,100%{opacity:.9}50%{opacity:.25}}
.wire-view{flex:1;overflow:hidden;position:relative;
