<style is:global>
/* ══════════════ FIELD NOTES ══════════════
   A serif title floating on the sky with search under it, a featured post
   as the first, widest tile, then every other post as a tile in an
   edge-to-edge, three-column grid: square-cornered frames in slightly
   different heights, two short lines of caption under each, and numbered
   pages at the bottom. Everything under the title is set in one tight
   grotesk. Frames without art are black placeholders. */
:root{
  --bg:var(--c-bg);
  --ink:#e9ecf7; --muted:rgba(200,210,232,.74); --faint:rgba(200,210,232,.58);
  /* the search fields float over the sky: an opaque fill, a hairline top
     highlight and a long soft shadow underneath */
  --card-line:rgba(190,205,240,.11);
  --float:0 1px 0 rgba(255,255,255,.04) inset,0 22px 50px -26px rgba(0,0,0,.85),0 6px 16px -8px rgba(0,0,0,.5);
  --accent:#8fb3ff;
  --field:#0b1020;
  --sans:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
  --grot:'Inter Tight',var(--sans);
  /* the second line of every caption: .62 clears 4.5:1 on the frames */
  --dim:rgba(233,236,247,.62);
  --lvl:#bcd4ff;
  --serif:'Cormorant Garamond',Georgia,serif;
  --e:cubic-bezier(.2,.8,.2,1);
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--sans);min-height:100vh;min-height:100svh;
  overflow-x:hidden;-webkit-font-smoothing:antialiased}
a:focus-visible,button:focus-visible,select:focus-visible,input:focus-visible{outline:2px solid var(--accent);outline-offset:4px;border-radius:6px}

/* every content block is positioned so it paints above the fixed #sky
   (a positioned element with z-index:auto) and the jellyfish (z-index 2) */
.fn{position:relative;z-index:3;padding-bottom:96px;display:flex;flex-direction:column;gap:clamp(56px,7vw,92px)}

/* ── title + search ── */
.fn-hero{display:flex;flex-direction:column;align-items:center;gap:34px;width:100%;max-width:1240px;margin:0 auto;
  padding:clamp(120px,15vw,170px) max(20px, env(safe-area-inset-right, 0px)) 4px max(20px, env(safe-area-inset-left, 0px))}
/* the title keeps one serif moment, with the number of posts beside it like
   a shop menu's count and one quiet line of small capitals under it */
.fn-title{font-family:var(--serif);font-weight:400;font-size:clamp(72px,12vw,148px);line-height:.9;letter-spacing:-.03em;
  color:#eef2fb;text-align:center;text-wrap:balance;
  /* the glow is a filter on the whole heading, not a text-shadow: the line
     reveal clips each line, and a clipped shadow showed as a box */
  filter:drop-shadow(0 0 24px rgba(143,179,255,.28)) drop-shadow(0 0 70px rgba(110,150,240,.22));
  animation:fnDrift 9s ease-in-out infinite}
.fn-title em{font-style:italic;color:#cdd9f7}
.fn-title sup{font:500 .16em/1 var(--grot);letter-spacing:0;vertical-align:top;position:relative;top:.35em;margin-left:.12em;color:#c9d6ff}
.fn-tag{margin-top:-14px;font:600 11px/1 var(--grot);letter-spacing:.24em;text-transform:uppercase;text-align:center;
  color:rgba(226,232,250,.8);text-shadow:0 1px 8px rgba(3,6,16,.7)}
@keyframes fnDrift{0%,100%{transform:translateY(0)}50%{transform:translateY(-8px)}}
.fn-search{width:min(900px,100%);display:grid;grid-template-columns:minmax(0,1fr) 210px;gap:14px}
.fn-field{display:flex;align-items:center;gap:10px;height:52px;padding:0 16px;background:var(--field);
  border:1px solid var(--card-line);border-radius:8px;box-shadow:var(--float);
  transition:border-color .2s,box-shadow .2s}
.fn-field:focus-within{border-color:var(--accent);box-shadow:0 0 0 4px rgba(143,179,255,.16)}
.fn-field svg{width:17px;height:17px;flex:none;stroke:var(--muted);fill:none;stroke-width:2}
.fn-field input,.fn-field select{flex:1;min-width:0;border:0;outline:0;background:transparent;color:var(--ink);
  font:500 14px var(--grot);letter-spacing:-.02em}
.fn-field input:focus-visible,.fn-field select:focus-visible{outline:0}
.fn-field input::placeholder{color:var(--faint)}
.fn-field input::-webkit-search-cancel-button{filter:invert(.8)}
.fn-field select{appearance:none;-webkit-appearance:none;cursor:pointer}
.fn-field select option{background:#0c1330;color:var(--ink)}
@media (max-width:640px){.fn-search{grid-template-columns:1fr}.fn-field input,.fn-field select{font-size:16px}}

/* ── picture frames: a post's tileImage, or a black placeholder ── */
.fn-pic{position:relative;overflow:hidden;aspect-ratio:var(--r,16/9);
  background:#0a0d18;border:1px solid rgba(200,215,245,.1);
  transition:background .4s,border-color .4s}
a:hover .fn-pic{background:#0e1220;border-color:rgba(200,215,245,.2)}
.fn-pic .art{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}

/* ── shared pieces: the level, concept pills, the Read link ── */
.lvl{display:inline-flex;align-items:center;gap:7px;color:var(--lvl)}
/* three signal bars, as many lit as the level is deep */
.bars{display:inline-flex;align-items:flex-end;gap:2px;height:10px}
.bars i{width:3px;border-radius:1px;background:rgba(188,212,255,.25)}
.bars i:nth-child(1){height:4px}.bars i:nth-child(2){height:7px}.bars i:nth-child(3){height:10px}
.bars[data-n="1"] i:nth-child(-n+1),.bars[data-n="2"] i:nth-child(-n+2),.bars[data-n="3"] i{background:var(--lvl)}
.chips{list-style:none;display:flex;flex-wrap:wrap;gap:6px;max-height:24px;overflow:hidden}
.chips li{font:600 11px/1 var(--grot);letter-spacing:-.01em;padding:6px 10px;border-radius:999px;white-space:nowrap;
  color:#cdd9f2;background:rgba(188,212,255,.08);border:1px solid rgba(188,212,255,.16)}
.go{display:inline-flex;gap:6px;color:var(--ink);margin-left:auto}
.go span{color:var(--accent);transition:transform .25s}
a:hover .go span{transform:translateX(3px)}
.foot{display:flex;align-items:center;justify-content:space-between;gap:12px;padding-top:12px;
  border-top:1px solid rgba(200,215,245,.1);color:var(--dim)}

/* ── featured card ──
   A rounded card floating over the sky: text on the left, a rounded frame
   on the right. In reading order it becomes "Start here", the first post
   of all. */
.fn-feat{width:min(1200px,calc(100% - 40px));margin:0 auto;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);
  gap:clamp(20px,4vw,48px);align-items:center;background:#0d1222;border:1px solid var(--card-line);border-radius:22px;
  padding:14px 14px 14px clamp(20px,3.4vw,40px);text-decoration:none;color:inherit;box-shadow:var(--float);
  font:600 12px/1.2 var(--grot);letter-spacing:-.02em;transition:transform .35s var(--e),box-shadow .35s,filter .35s}
.fn-feat:hover{transform:translateY(-3px);box-shadow:0 1px 0 rgba(255,255,255,.05) inset,0 34px 70px -28px rgba(0,0,0,.9),0 10px 22px -10px rgba(0,0,0,.55)}
.fn-feat .fn-pic{order:2;aspect-ratio:16/10;border-radius:14px}
.fn-feat-txt{display:flex;flex-direction:column;min-width:0;padding-block:18px}
.fn-feat .top{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--dim)}
.fn-flag{color:var(--ink)}
.fn-feat h2{margin-top:18px;font-size:clamp(26px,2.8vw,36px);font-weight:600;line-height:1.15;letter-spacing:-.025em;text-wrap:balance}
.fn-feat .desc{margin-top:14px;max-width:52ch;color:var(--muted);font-size:16px;line-height:1.55;font-weight:500;letter-spacing:-.01em;
  display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:4;line-clamp:4;overflow:hidden}
.fn-feat .bottom{padding-top:22px}
.fn-feat .chips{margin-bottom:14px}
.fn-feat[hidden]{display:none}
@media (max-width:820px){.fn-feat{grid-template-columns:minmax(0,1fr);gap:4px;padding:14px}.fn-feat .fn-pic{order:0}.fn-feat-txt{padding:14px 8px 6px}}

/* ── the grid ──
   One type style for every line under the featured card: 12px, tight
   tracking, the second line at lower contrast. Tiles run edge to edge with
   hairline gaps. */
.fn-list,.fn-pg,footer{font:600 12px/1.2 var(--grot);letter-spacing:-.02em}
.fn-list{display:flex;flex-direction:column;gap:14px}
.fn-head{display:flex;align-items:baseline;gap:14px;padding:0 12px;scroll-margin-top:72px;text-shadow:0 1px 2px rgba(3,6,16,.85),0 0 14px rgba(3,6,16,.7)}
.fn-head h2{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
.fn-views{display:flex;gap:14px}
.fn-views button{font:inherit;letter-spacing:inherit;color:var(--dim);background:none;border:0;padding:0;cursor:pointer;transition:color .2s}
.fn-views button:hover,.fn-views button[aria-pressed="true"]{color:var(--ink)}
.fn-sort{display:flex;gap:14px;margin-left:auto}
.fn-sort button{font:inherit;letter-spacing:inherit;color:var(--dim);background:none;border:0;padding:0;cursor:pointer;transition:color .2s}
.fn-sort button:hover,.fn-sort button[aria-pressed="true"]{color:var(--ink)}
.fn-count{color:var(--dim)}
@media (max-width:560px){.fn-head{flex-wrap:wrap;row-gap:10px}.fn-count{display:none}}

/* ── index view ──
   A plain list of every post, fixed at the top left. The featured card and
   the tiles fade back; the post under the pointer (or keyboard focus, or a
   tap) comes forward and the page scrolls to it. Fading uses filter, not
   opacity: the reveal animation leaves an inline opacity on each tile. */
.fn-index{position:fixed;left:12px;top:96px;z-index:20;width:min(420px,calc(100% - 24px));max-height:calc(100vh - 120px);
  overflow:auto;overscroll-behavior:contain;padding:10px 12px;background:rgba(9,12,22,.94);border:1px solid rgba(200,215,245,.12);
  font:600 12px/1.2 var(--grot);letter-spacing:-.02em}
.fn-index[hidden]{display:none}
.fn-index ol{list-style:none}
.fn-index a{display:flex;gap:10px;padding:2.5px 0;color:var(--ink);text-decoration:none;white-space:nowrap;min-width:0}
.fn-index b{font-weight:inherit;flex:none;max-width:68%;overflow:hidden;text-overflow:ellipsis}
.fn-index span{color:var(--dim);overflow:hidden;text-overflow:ellipsis;transition:color .2s}
.fn-index a.is-on span{color:var(--ink)}
.fn-index a:focus-visible{outline-offset:2px;border-radius:2px}
.fn-tile{transition:filter .35s}
.fn.is-index .fn-tile,.fn.is-index .fn-feat{filter:opacity(.14)}
.fn.is-index .fn-tile.is-lit,.fn.is-index .fn-feat.is-lit{filter:none}
.fn.is-index .fn-tile,.fn.is-index .fn-feat{scroll-margin-top:90px}
/* phones and tablets: the list sits at the bottom, clear of Kai's button */
@media (max-width:900px){.fn-index{top:auto;bottom:12px;width:calc(100% - 104px);max-height:38vh}}
.fn-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));column-gap:6px;row-gap:clamp(36px,4vw,60px);align-items:start}
@media (max-width:900px){.fn-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media (max-width:560px){.fn-grid{grid-template-columns:minmax(0,1fr);row-gap:32px}}
.fn-tile{display:block;min-width:0;color:inherit;text-decoration:none}
.fn-tile:focus-visible{outline-offset:2px;border-radius:0}
/* hover card: pointing at a tile slides a panel over its frame (after
   Crunchyroll), laid out in three blocks (after TryHackMe's cards and
   Steam's tooltip): level and read time on top; the title and three lines
   of summary (cut with an ellipsis) in the middle; concept pills, the
   series and Read pinned to the bottom under a hairline. Pointer devices only; a tap just opens the post. */
.fn-peek{position:absolute;inset:0;display:flex;flex-direction:column;padding:clamp(14px,1.4vw,22px);
  background:linear-gradient(180deg,rgba(17,22,40,.97),rgba(9,12,22,.98));
  opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity .22s,transform .3s var(--e)}
.fn-peek .top{display:flex;align-items:center;justify-content:space-between;gap:12px;color:var(--dim)}
.fn-peek h4{margin-top:clamp(14px,1.6vw,22px);font-size:16px;font-weight:600;line-height:1.25;color:var(--ink);text-wrap:balance}
.fn-peek .desc{margin-top:8px;max-width:48ch;color:var(--muted);font-size:13px;line-height:1.5;font-weight:500;letter-spacing:-.01em;
  display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;line-clamp:3;overflow:hidden}
/* short frames keep the top and bottom blocks whole: the summary drops to
   two lines, then leaves */
.fn-tile .fn-pic{container-type:size}
@container (max-height:280px){.fn-peek .desc{-webkit-line-clamp:2;line-clamp:2}}
@container (max-height:225px){.fn-peek .desc{display:none}}
.fn-peek .bottom{margin-top:auto;padding-top:14px}
.fn-peek .chips{margin-bottom:12px}
@media (hover:hover){
  .fn-tile:hover .fn-peek,.fn-tile:focus-visible .fn-peek{opacity:1;transform:none;transition-delay:.12s}
}
/* the index view has its own way of pointing at a post */
.fn.is-index .fn-peek{display:none}
.fn-cap{display:flex;flex-direction:column;padding:12px 12px 0;
  /* captions sit straight on the sky: a soft dark halo keeps them readable over bright cloud */
  text-shadow:0 1px 2px rgba(3,6,16,.85),0 0 14px rgba(3,6,16,.7)}
.fn-cap h3{font:inherit;color:var(--ink)}
.fn-cap span{color:var(--dim)}
/* after a search or page change the new tiles settle in one after another */
.fn-tile.fn-in{animation:fnIn .55s var(--ease-out,cubic-bezier(.16,1,.3,1)) both;animation-delay:calc(var(--i,0)*50ms)}
@keyframes fnIn{from{opacity:0;transform:translateY(12px)}}
.fn-empty{grid-column:1/-1;padding:60px 12px;color:var(--dim)}

/* ── numbered pages ── */
.fn-pg{display:flex;gap:14px;flex-wrap:wrap;padding:0 12px}
.fn-pg[hidden]{display:none}
.fn-pg button{font:inherit;letter-spacing:inherit;color:var(--dim);background:none;border:0;padding:4px 0;cursor:pointer;transition:color .2s}
.fn-pg button:hover:not([disabled]),.fn-pg button[aria-current="page"]{color:var(--ink)}
.fn-pg button[disabled]{opacity:.4;cursor:default}

/* ── footer ── */
footer{position:relative;z-index:3;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:12px;padding:30px 12px 50px;color:var(--dim)}
footer .f-links{display:flex;align-items:center;gap:14px}
footer .f-links a{color:var(--dim);text-decoration:none;transition:color .25s;display:inline-flex;align-items:center;gap:6px}
footer .f-links a:hover{color:var(--ink)}
footer .f-links .fic{width:12px;height:12px;fill:currentColor;flex:none}

@media (prefers-reduced-motion: reduce){
  .fn-title{animation:none}
  .fn-pic,.fn-feat,.fn-feat-txt,.fn-tile,.fn-peek,.go span{transition:none}
  .fn-tile.fn-in{animation:none}
}
</style>
<style is:global>
</style>
<ErrorReporter />
<ClarityAnalytics />
