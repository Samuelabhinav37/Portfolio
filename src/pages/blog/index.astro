  .ldw-fu{font-family:var(--ldw-mono);font-weight:500;font-size:11px;letter-spacing:.02em;color:var(--ldw-dim);
    background:rgba(200,206,218,.06);border:1px solid rgba(200,206,218,.12);border-radius:999px;padding:6px 12px;transition:.18s;cursor:pointer}
  .ldw-fu:hover{color:var(--ldw-ink);background:rgba(200,206,218,.14);border-color:rgba(200,206,218,.28)}
  .ldw-fu .ldw-plus{color:rgba(200,206,218,.5);margin-right:5px}

  /* ── Luna's speech: a small quip card that docks directly over #luna-wrap
     (same right:18px anchor, positioned by "bottom" so it always clears her
     regardless of viewport). ── */
  #luna-quip{
    position:fixed; right:18px; top:auto; bottom:calc(34vh - 70px);
    z-index:999; max-width:min(180px,60vw); text-align:right; pointer-events:none;
