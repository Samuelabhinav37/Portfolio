---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import ProjectCase from '../../layouts/ProjectCase.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props as { project: CollectionEntry<'projects'> };
const { Content, headings } = await render(project);
---

<ProjectCase project={project} headings={headings}>
  <Content />
</ProjectCase>
