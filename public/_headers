/*
  # Content-Security-Policy is NOT set here — it moved to
  # functions/_middleware.js. The real script-src needs a per-build hash
  # list (see scripts/obfuscate.mjs) that runs well past the 2000-char
  # limit Cloudflare enforces per line in THIS file (confirmed via an
  # actual wrangler pages dev run: it silently drops any rule over that,
  # which would have shipped with no CSP at all). A Function response's
  # headers have no such limit, so that's where it lives now.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 0
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=(), browsing-topics=(), accelerometer=(), gyroscope=(), magnetometer=(), midi=(), fullscreen=(), picture-in-picture=(), clipboard-read=(), clipboard-write=(self)
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Cloudflare Pages' own platform default is "Access-Control-Allow-Origin: *"
  # on every response (page, asset, function) unless overridden here. Nothing
  # on this site is meant to be readable cross-origin via fetch/XHR — lock it
  # to the canonical origin, which is a no-op for same-origin requests (they
  # never needed a CORS header) and closes the wildcard off for everyone else.
  Access-Control-Allow-Origin: https://samuelabhinav.com

# Astro fingerprints every filename in here with a content hash, so the URL
# itself changes whenever the content does — safe to cache for a year as
# immutable, unlike the max-age=14400 Cloudflare Pages applies by default.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
